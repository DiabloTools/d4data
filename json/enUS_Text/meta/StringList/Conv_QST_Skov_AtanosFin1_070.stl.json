 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Those tremors! Are we too late?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCFFD",
   "szText": "Mephisto has entered the Pools of Creation... His followers rush heedless to join him—(winces). The Age of Hatred dawns...",
   "hLabel": 2457582095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCFFD",
   "szText": "Winded, in pain. Giving urgent, dire news.",
   "hLabel": 3803309532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BAE4",
   "szText": "Tyrael, you're bleeding.",
   "hLabel": 3718003623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.BAE4",
   "szText": "Concerned for Tyrael's wounds",
   "hLabel": 650842164
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCFFD",
   "szText": "It's nothing...and we've no time to lose. Follow me!",
   "hLabel": 470202197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCFFD",
   "szText": "Dismissive, driving through the pain",
   "hLabel": 1815929634
  }
 ],
 "ptMapStringTable": "0"
}
