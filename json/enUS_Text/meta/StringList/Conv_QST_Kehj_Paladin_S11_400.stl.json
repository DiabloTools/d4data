 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How did you know about your gift?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24B90B",
   "szText": "Well, I didn't think anything of the song I’d hear from the Light. It was all I knew. When word got out, I was swarmed.",
   "hLabel": 2439706554
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24B90B",
   "szText": "Young but not immature. ",
   "hLabel": 3785433991
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.24B90B",
   "szText": "I’m grateful to be safe. Still…I stand at a crossroads. The path ahead looks hard, but maybe it’ll be worth it.",
   "hLabel": 1171901490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.24B90B",
   "szText": "stuck in confusion, but finding her way and her voice.",
   "hLabel": 2631233951
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.24B90B",
   "szText": "Maybe I’ll take up the mantle as a paladin. It seems fitting.",
   "hLabel": 509441524
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.24B90B",
   "szText": "Sure. ",
   "hLabel": 1968773985
  }
 ],
 "ptMapStringTable": "0"
}
