{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_ToF_04_021.stl",
 "__snoID__": 2360089,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why would Achaia do this?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8BEB",
   "szText": "Few know of our burden, ephemeral as we are.",
   "hLabel": 2456032413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8BEB",
   "szText": "Our gift comes at great cost. Pain may dull, but scars remain. They sear beneath flesh. Echo in waking and dream.",
   "hLabel": 1793572447
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8BEB",
   "szText": "Achaia carried our suffering, our scars, long after my sisters turned to dust.",
   "hLabel": 1131112481
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1D8BEB",
   "szText": "I do not agree with her actions. But I understand them.",
   "hLabel": 468652515
  }
 ],
 "ptMapStringTable": "0"
}
