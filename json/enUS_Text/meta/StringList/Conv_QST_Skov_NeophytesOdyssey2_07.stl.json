 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Where is Adoné?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.228AA8",
   "szText": "She’s exploring a ruin in southern Lycander. Something dedicated to an ancient Askari prophet.",
   "hLabel": 538672912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.228AA8",
   "szText": "LYE-can-der, ask-arr-ee",
   "hLabel": 1998005373
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.228AA8",
   "szText": "She hopes to find the prophet’s old writings and relate them to Akarat’s own teachings. That way, she can bring more Askari into the fold.",
   "hLabel": 2846260310
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.228AA8",
   "szText": "Perhaps we should pay her a visit? She’d be happy to see you.",
   "hLabel": 3508720276
  }
 ],
 "ptMapStringTable": "0"
}
