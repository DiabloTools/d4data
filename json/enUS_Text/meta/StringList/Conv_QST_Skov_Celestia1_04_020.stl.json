{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Celestia1_04_020.stl",
 "__snoID__": 2246259,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Has something happened?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "Adreona is on the move. She’s not taking the confrontation lightly. You, Lorath, even Tyrael...",
   "hLabel": 1222839726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "We're the enemy now.",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCFFD",
   "szText": "Matter-of-fact.",
   "hLabel": 3140849566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "Well, we’ve been worse before. Just means we keep moving.",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.6D03F",
   "szText": "Unattached.",
   "hLabel": 1498731690
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCFFD",
   "szText": "You have the final piece of the blade, then?",
   "hLabel": 3530431878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.6D03F",
   "szText": "That we do.",
   "hLabel": 3606844771
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.6D03F",
   "szText": "Hint of pride.",
   "hLabel": 657604912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1DCFFD",
   "szText": "Reforging the blade will not be easy. It is the shattered bone of a demon, no simple smithy will suffice. But I have an idea.",
   "hLabel": 1852236997
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCFFD",
   "szText": "Not far from here is a Horadric Vault. The first we ever built. And inside...",
   "hLabel": 1189777031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.6D03F",
   "szText": "Oh, you clever man. There's a Cube just waiting for us in there.",
   "hLabel": 3275614788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.1DCFFD",
   "szText": "Indeed. The Vault is where we will forge the blade anew.",
   "hLabel": 836502082
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.1DCFFD",
   "szText": "with a knowing smile",
   "hLabel": 2295834543
  }
 ],
 "ptMapStringTable": "0"
}
