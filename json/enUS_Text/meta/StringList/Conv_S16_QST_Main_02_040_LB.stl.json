   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "We are the servants of Death! We suffer on so that all may join Him, not to waste our lives in failure!",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2808AB",
   "szText": "Angry, commanding",
   "hLabel": 3788381353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2808AB",
   "szText": "Death has fallen silent. Surely, He watches from his Fortress Eternal—disgusted by our weakness! Doubting our resolve!",
   "hLabel": 1780193950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2808AB",
   "szText": "Bitter, blaming (a touch of anxiety)",
   "hLabel": 3125921387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2808AB",
   "szText": "Send to Him this wanderer's soul, or yours will never know peace.",
   "hLabel": 1117733984
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2808AB",
   "szText": "Stern warning",
   "hLabel": 2463461421
  }
 ],
