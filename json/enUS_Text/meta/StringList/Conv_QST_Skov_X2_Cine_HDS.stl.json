 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "[PH] \"Speak with Lilith\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.FD852",
   "szText": "I am no longer a child.",
   "hLabel": 2792873125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.FD852",
   "szText": "Bitter, resentful.",
   "hLabel": 4138600562
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.FD852",
   "szText": "And I have learned the cost of your gifts.",
   "hLabel": 3663777705
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.FD852",
   "szText": "Bitter, resentful.",
   "hLabel": 714537846
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BD31C",
   "szText": "(sighs) My Rathma...",
   "hLabel": 1076092555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.BD31C",
   "szText": "Quiet, to herself.",
   "hLabel": 2421819992
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BD31C",
   "szText": "I gave him a weapon...",
   "hLabel": 3305993212
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.BD31C",
   "szText": "Lost in thought. Lilith has pulled a WEAPON out of the doorway entrance. This is a relic from her past. It was a gift she gave to her son. Something to protect him.",
   "hLabel": 873912873
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BD31C",
   "szText": "...to live without fear.",
   "hLabel": 1585989350
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BD31C",
   "szText": "He rejected it.",
   "hLabel": 4168925288
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.BD31C",
   "szText": "Hint of anger and disappointment.",
   "hLabel": 1219685429
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.BD31C",
   "szText": "But, if it can be restored, then this...this is what will end my father’s reign.",
   "hLabel": 205187975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.BD31C",
   "szText": "Confident, hint of menace - she knows this is something she can use against her father.",
   "hLabel": 1550915412
  }
 ],
 "ptMapStringTable": "0"
}
