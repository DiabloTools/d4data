 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"So! It seems I've caught a fish.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.21C82F",
   "szText": "W-w-what?! Huh? (scoffs) All day I've been out here, and you just—?! Ughh...how? Aiya...(curses)!",
   "hLabel": 2436183709
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.21C82F",
   "szText": "Shocked, confused, indignant",
   "hLabel": 3781911146
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4",
   "szText": "I enjoyed that, thank you. Here's your rod—",
   "hLabel": 3639732837
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.BAE4",
   "szText": "Smiling, satisfied. A little smug.",
   "hLabel": 572571378
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.21C82F",
   "szText": "(sighs) You keep it.",
   "hLabel": 1111263777
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.21C82F",
   "szText": "Dismissive, deflated. Done with it all.",
   "hLabel": 2456991214
  }
 ],
 "ptMapStringTable": "0"
}
