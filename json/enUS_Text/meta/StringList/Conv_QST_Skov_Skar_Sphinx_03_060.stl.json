 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.244C64",
   "szText": "I am not like you! I am not Firstborn. I cannot withstand...all this.",
   "hLabel": 1534591710
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir10.244C64",
   "szText": "shouting out at unseen spirits",
   "hLabel": 2993924171
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.24646F",
   "szText": "We are born from the same womb of Sanctuary. You think us different. But we ate. And sang. And danced.",
   "hLabel": 872152485
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.24646C",
   "szText": "And died.",
   "hLabel": 209692516
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir14.24646C",
   "szText": "giving directions",
   "hLabel": 1669024977
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line16.24646C",
   "szText": "We were not \"Firstborn.\" We were just men.",
   "hLabel": 3842199846
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir16.24646C",
   "szText": "softer now, trying to help him understand",
   "hLabel": 1006565011
  }
 ],
 "ptMapStringTable": "0"
}
