{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_08_060.stl",
 "__snoID__": 2260848,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"This victory belongs to you too. You deserve it.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.6D03F",
   "szText": "Do I? I don't know... With all that’s happened, I’ve no idea what I deserve.",
   "hLabel": 3606844771
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.6D03F",
   "szText": "Chuckling, tearful, moved",
   "hLabel": 657604912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.2161F6",
   "szText": "(squawk)",
   "hLabel": 2105333059
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.1DCFFD",
   "szText": "You'll have ample time to figure it out. You and I should stay a while longer...catch up. And help our new allies prepare to face our common enemy.",
   "hLabel": 1465894599
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.1DCFFD",
   "szText": "Warm, reassuring. Suggestive at \"catch up\"",
   "hLabel": 2925227060
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.1DCC9B",
   "szText": "Akarat... I cannot accept that my Queen is lost to that devil. No. I will go to her in Celestia, and try once more to reach her.",
   "hLabel": 803429879
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.1DCC9B",
   "szText": "\"Akarat\" said like a curse. Bitter, determined to reach her Queen.",
   "hLabel": 2262762340
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line49.6D03F",
   "szText": "I pray you can. Truly.",
   "hLabel": 2613154822
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir49.6D03F",
   "szText": "Sincere, hopeful",
   "hLabel": 3958882259
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line51.BAE4",
   "szText": "I should go on ahead too. The third piece of the blade is hidden in Celestia, and Mephisto will be looking for it.",
   "hLabel": 2490806808
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir51.BAE4",
   "szText": "Bracing for the next task.",
   "hLabel": 58726469
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line53.BAE4",
   "szText": "Perhaps we can share the road?",
   "hLabel": 2569077594
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir53.BAE4",
   "szText": "To Tharra, friendly",
   "hLabel": 136997255
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line55.1DCC9B",
   "szText": "I would be glad of the company. Especially since the road leads through Atanos... I'll see you there.",
   "hLabel": 3420202294
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir55.1DCC9B",
   "szText": "Gladly accepting, bracing for next step. Atanos is a cursed wasteland.",
   "hLabel": 584567459
  }
 ],
 "ptMapStringTable": "0"
}
