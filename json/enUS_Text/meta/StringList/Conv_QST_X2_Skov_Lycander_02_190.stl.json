   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I have a feeling we're close to the brambles' source.\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "Go. We’ll hold off the little ones.",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCC9B",
   "szText": "What? No. We have better odds of making it out alive if we three stick together.",
   "hLabel": 1132657409
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "That may be true for you and I. But not for them.",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCC9B",
   "szText": "Hm. Fair enough. I have questions for you anyway, Horadrim.",
   "hLabel": 4102704773
  }
 ],
