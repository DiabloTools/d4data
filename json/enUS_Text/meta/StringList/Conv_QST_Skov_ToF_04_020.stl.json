   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"We need to find and stop Achaia.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8BEB",
   "szText": "Easy to voice—the deed, less so. This is Achaia’s domain, and we are wise to remember it.",
   "hLabel": 2456032413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8BEB",
   "szText": "Centuries have granted her more than sight through blood. Her fingers bend perversions of fate.",
   "hLabel": 1793572447
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8BEB",
   "szText": "Be ready.",
   "hLabel": 1131112481
  }
 ],
