{
 "__fileName__": "enUS_Text/meta/StringList/Quest_QST_Kehj_Paladin_S11.stl",
 "__snoID__": 2383545,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Path of the Paladin",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "A Paladin needs aid rescuing a prodigy healer in the deserts of Kehijistan.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "I must go with Justelle to the Forsaken Chapel in Kehjistan. She believes there may be clues to the captured healer's whereabouts.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Travel to the Forsaken Chapel",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase8Description",
   "szText": "There are cultists outside who have come to attack us before we can get to the healer. We must slay these cultists.",
   "hLabel": 1557588493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback7Header",
   "szText": "Slay the Cultists",
   "hLabel": 2677071405
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase14Description",
   "szText": "I need to follow after Justelle, she's going to cleanse the chapel of demonic taint.",
   "hLabel": 4104776794
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback41Header",
   "szText": "Follow Justelle",
   "hLabel": 1248479483
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase17Description",
   "szText": "Justelle said that there would be clues within the chapel that might help us locate where they've taken the healer.",
   "hLabel": 2273576061
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback24Header",
   "szText": "Search the Forsaken Chapel for Clues",
   "hLabel": 1490376060
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase27Description",
   "szText": "Justelle has said that we must travel to a fiery pit in Kehjistan, there we will find the cultists and hopefully the healer still alive.",
   "hLabel": 3605204478
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback43Header",
   "szText": "Follow Justelle",
   "hLabel": 3831415421
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase30Description",
   "szText": "I must slay the cultists before they can complete their ritual and kill the healer.",
   "hLabel": 3483011544
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback29Header",
   "szText": "Rescue the imprisoned Prodigy",
   "hLabel": 3652748609
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase33Description",
   "szText": "I must journey to the west of Kehjistan, there I will meet with Justelle and we will prepare to rescue the healer.",
   "hLabel": 1651810811
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback32Header",
   "szText": "Travel to the Infernal Pit in Kehjistan",
   "hLabel": 2871177435
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase49Description",
   "szText": "I should speak with Justelle and make sure that the healer is okay.",
   "hLabel": 3616005058
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback48Header",
   "szText": "Speak with Justelle",
   "hLabel": 1698820674
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase55Description",
   "szText": "I need to speak to Justelle before I leave for the fiery pity in Kehjistan.",
   "hLabel": 1662611391
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback54Header",
   "szText": "Speak with Justelle",
   "hLabel": 496686111
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase58Description",
   "szText": "I've found the clues to where the healer must have been taken. I should speak with Justelle on what to do next.",
   "hLabel": 4126377954
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback57Header",
   "szText": "Speak with Justelle",
   "hLabel": 76122722
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase64Description",
   "szText": "Justelle is helping the healer get to safety, I should assist them.",
   "hLabel": 2172984287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback63Header",
   "szText": "Rescue the imprisoned Prodigy",
   "hLabel": 3168955455
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase67Description",
   "szText": "I need to speak with Justelle before we move to rescue the healer.",
   "hLabel": 341783554
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback66Header",
   "szText": "Speak with Justelle",
   "hLabel": 2748392066
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase75Description",
   "szText": "Justelle and I must move to save the healer from the grasp of the cultists.",
   "hLabel": 30900929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback74Header",
   "szText": "Rescue the imprisoned Prodigy",
   "hLabel": 4129193441
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase11Description",
   "szText": "I should speak with Justelle. She will know more about what we need to do at the Forsaken Chapel.",
   "hLabel": 1641010231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback10Header",
   "szText": "Speak with Justelle",
   "hLabel": 950701463
  }
 ],
 "ptMapStringTable": "0"
}
