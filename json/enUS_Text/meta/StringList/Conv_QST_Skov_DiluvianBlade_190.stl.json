{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_DiluvianBlade_190.stl",
 "__snoID__": 2479206,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25A7C5",
   "szText": "Sister, I beg you. Let us put all this behind us. You are the eldest, Koscythia. None will dare take your birthright from you.",
   "hLabel": 2440855998
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25A7C4",
   "szText": "Yet you remain a thorn in my side, dear sister. Everyone favors you! Lovely Pheonos, the best of us! And what am I to our people but a black sheep?",
   "hLabel": 1778396031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.25A7C4",
   "szText": "(a bit of contempt comes through in “dear sister”)",
   "hLabel": 3124123468
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25A7C5",
   "szText": "I will talk to them. Together, we—",
   "hLabel": 1115936066
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25A7C4",
   "szText": "The time for words is behind us, Pheonos.",
   "hLabel": 453476099
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.25A7C5",
   "szText": "What are you going to do, kill me?",
   "hLabel": 1206118383
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.25A7C5",
   "szText": "(incredulous, half joking)",
   "hLabel": 2665450844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.25A7C5",
   "szText": "Kos?",
   "hLabel": 543658417
  }
 ],
 "ptMapStringTable": "0"
}
