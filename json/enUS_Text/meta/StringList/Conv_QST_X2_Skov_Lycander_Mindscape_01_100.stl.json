{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_X2_Skov_Lycander_Mindscape_01_100.stl",
 "__snoID__": 2419489,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You know what he's planning.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BD31C",
   "szText": "They do this to themselves.",
   "hLabel": 1564184052
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.BD31C",
   "szText": "spitting venom",
   "hLabel": 3427071009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.BD31C",
   "szText": "They bathe in the Pools. They unknowingly become a part of his ritual to taint the waters. And they corrupt the very thing that gives them life.",
   "hLabel": 723057274
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BD31C",
   "szText": "All this...at his mere suggestion. Because they are weak. Stupid. And gullible.",
   "hLabel": 4147119990
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BD31C",
   "szText": "My children.",
   "hLabel": 3305993212
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BD31C",
   "szText": "This is it. This is his gift to me. He would show me that all I have made—all of it—is nothing.",
   "hLabel": 2435088632
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.BD31C",
   "szText": "struck with the horrible joke of it all",
   "hLabel": 3008293
  }
 ],
 "ptMapStringTable": "0"
}
