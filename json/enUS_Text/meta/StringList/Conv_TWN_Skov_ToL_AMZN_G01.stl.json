  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "[Amazon Gossip]",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23A7E9",
   "szText": "I used to love coming here on leave. Every year, first day of spring. Me, a wine-skin, and a soft patch of grass.",
   "hLabel": 2438484226
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.23A7E9",
   "szText": "Tired. Bitter. Her favorite spot is ruined.",
   "hLabel": 3784211663
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.23A7E9",
   "szText": "(scoffs) Not this year, eh?",
   "hLabel": 1776024260
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.23A7E9",
   "szText": "Humorless. Bitter. Hates what has happened here.",
   "hLabel": 3121751697
  }
 ],
