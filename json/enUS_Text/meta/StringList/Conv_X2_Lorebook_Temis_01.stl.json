{
 "__fileName__": "enUS_Text/meta/StringList/Conv_X2_Lorebook_Temis_01.stl",
 "__snoID__": 2499271,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Queen's Orders",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8FD7",
   "szText": "Send a unit to find the Oracle. Make sure she knows how precarious things are here.",
   "hLabel": 2456036693
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8FD7",
   "szText": "Tell her the people need her. Tell her I need her.",
   "hLabel": 1793576727
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8FD7",
   "szText": "Also, the route for Akarat’s procession has been planned. Station guards on every street.",
   "hLabel": 1131116761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1D8FD7",
   "szText": "Lastly. The rats. The canals are filthy. Send the catchers in with fire. I will not have our travelers greeted in Temis by the stink of droppings.",
   "hLabel": 468656795
  }
 ],
 "ptMapStringTable": "0"
}
