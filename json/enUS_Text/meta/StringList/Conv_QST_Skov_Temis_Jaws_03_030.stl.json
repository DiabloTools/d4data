   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How's the eel taste?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.241F1B",
   "szText": "It’s…a unique taste…",
   "hLabel": 2437994679
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.241F1B",
   "szText": "mouth full, teeth tight. Trying to hide her disgust.",
   "hLabel": 3783722116
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.244C28",
   "szText": "It’s terrible, is what it is. Like chewing the barnacles on the underside of a barge.",
   "hLabel": 1775639248
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.244C28",
   "szText": "Smug.",
   "hLabel": 3121366685
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.241F1B",
   "szText": "Once you bite through the charred outer shell, the moist, squishy meat really—(gags)—really shines.",
   "hLabel": 1113074747
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.241F1B",
   "szText": "Trying to seem refined, but disgusted. The gag should be obvious.",
