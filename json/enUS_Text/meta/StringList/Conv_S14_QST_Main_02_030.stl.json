{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S14_QST_Main_02_030.stl",
 "__snoID__": 2623818,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You were right to be suspicious. This new cult is practicing some sort of ritual.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "Wha—? They are?",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Disheartened. Didn't want to be right.",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.27ED42",
   "szText": "(sighs) Of course they are. I just... (scoffs) I prayed to the Light I had it wrong. What have you got?",
   "hLabel": 4088546471
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.27ED42",
   "szText": "Crestfallen",
   "hLabel": 1139306612
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.27ED42",
   "szText": "“Take heart, beloved. Your death will be the beginning...”",
   "hLabel": 1208681424
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.27ED42",
   "szText": "To self, reading quickly",
   "hLabel": 2668013885
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.27ED42",
   "szText": "Evil enough to try and talk folk over the edge...they want to take the rest of us with them.",
   "hLabel": 546221458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.27ED42",
   "szText": "Angry, tears welling",
   "hLabel": 2005553919
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.27ED42",
   "szText": "Hells with that. Listen, you’ve got to keep at them. Bring me whatever you find, and I’ll tack it up for all to see.",
   "hLabel": 4178728788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.27ED42",
   "szText": "Angry determination",
   "hLabel": 1343093953
  }
 ],
 "ptMapStringTable": "0"
}
