{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_06b_20a.stl",
 "__snoID__": 2105981,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Ouna made an oath. She knew the consequences when she broke it.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1F9FF1",
   "szText": "Indeed. And perhaps she knew we would be left to clean her mess? Bringing her beloved heads one-by-one, back to bondage on the Tree. Each a reminder of her, of your friend Lorath...",
   "hLabel": 1133524600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1F9FF1",
   "szText": "Grieving. Guessing at Ouna's reasons.",
   "hLabel": 2479252037
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.1F9FF1",
   "szText": "And yet this is our task. Follow the whispers, cleanse the rot...and restore every last head to the Tree. We cannot abandon it as Caidin has.",
   "hLabel": 139834651
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.1F9FF1",
   "szText": "Heavy. Somber. But resolute.",
   "hLabel": 1485562088
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1FA02A",
   "szText": "A witch...makes their own choices.",
   "hLabel": 4195131287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1FA02A",
   "szText": "Disjointed. Haunting.",
   "hLabel": 1359496452
  }
 ],
 "ptMapStringTable": "0"
}
