 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": " \"Why do you live apart from the other Oracles?\"  ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.219CC0",
   "szText": "It is the best for all of us. They rarely agree with my views, and I’ve grown tired of their endless opinions. They are content wasting precious years on diluted visions.",
   "hLabel": 2434722745
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.219CC0",
   "szText": "A little heated and jaded. She doesn't outwardly hate the oracles, but she has been frustrated by them over the years.",
   "hLabel": 3780450182
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.219CC0",
   "szText": "I have no place among them.",
   "hLabel": 1772262779
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.219CC0",
   "szText": "Matter of fact ",
   "hLabel": 3117990216
  }
 ],
 "ptMapStringTable": "0"
}
