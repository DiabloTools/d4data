 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How do you think they knew we'd be here?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.24B8C5",
   "szText": "Sometimes the Light whispers to me. I find darkness must do the same to its servants. But that doesn’t matter now.",
   "hLabel": 1171902039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.24B8C5",
   "szText": "She has theorized about this before. Anyway, it doesn't matter.",
   "hLabel": 2631234500
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.24B8C5",
   "szText": "We have what we need, and they’re silenced.",
   "hLabel": 509442073
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.24B8C5",
   "szText": "Confident.",
   "hLabel": 1968774534
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.24B8C5",
   "szText": "I'll meet you just by the pit.",
   "hLabel": 2496821971
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.24B8C5",
   "szText": "Directive.",
   "hLabel": 3956154432
  }
 ],
