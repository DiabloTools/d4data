  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Description",
   "szText": "Eons, implacable eons did the ichor survive. Each war and sin poured into the festering wound of Sanctuary! Absorbed again and again as an amalgam of animosity. Now what is left to color the ichor...other than the purest shade of contempt?",
   "hLabel": 2789670820
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Quote",
   "szText": "Let it spread and devour the dawn.",
   "hLabel": 138338510
  },
