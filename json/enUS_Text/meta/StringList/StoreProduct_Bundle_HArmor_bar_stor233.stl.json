  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Description",
   "szText": "Days had passed since Eiler smuggled the ancient armor home, yet he could not take his eyes off it. He skipped meals, ignored the door, and stayed awake all hours, transfixed by the helm's hollow gaze. On the sixth day, Eiler saw it nod. Reverently, he donned the armor, piece by piece, as it burned his flesh away.",
   "hLabel": 2789670820
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Quote",
   "szText": "All weakness burned to ash.",
   "hLabel": 138338510
  },
