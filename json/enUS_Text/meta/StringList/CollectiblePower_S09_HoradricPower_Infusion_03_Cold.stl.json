  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Description",
   "szText": "Your {c_important}Catalyst{/c} now deals Cold and or Frostbiting damage. Enemies damaged by it are {c_important}{u}Chilled{/u}{/c} for {c_random}[{SF_2}|%|]{/c}. This effect happens once per enemy every {c_number}{SF_4}{/c} second.\r\n\r\nWhile equipped, your Cold Damage Bonus is equal to that of your highest Damage Type Bonus.{if:SF_6}\r\n\r\nDeactivates monster {c_important}Explosive{/c} effects for {c_number}{SF_5}{/c} seconds.{/if}  ",
   "hLabel": 2789670820
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Next_Rank",
   "szText": "Chill Amount {icon:arrow,1.2} {c_random}[{SF_3}|%|]{/c}",
   "hLabel": 1850455274
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "HowToUnlock",
