   "szLabel": "Toast",
   "szText": "Tharra submits herself to the Council's verdict for who will become the next Queen of Skovos.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
