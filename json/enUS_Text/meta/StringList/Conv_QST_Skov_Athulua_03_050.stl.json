 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line57.24C67B",
   "szText": "Our island is finished, Leodora! Dead!",
   "hLabel": 2739904442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir57.24C67B",
   "szText": "Emphatic, frustrated, arguing",
   "hLabel": 4199236903
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line59.24C67C",
   "szText": "You want to go? Go! Follow the Queen, leave our home to burn!",
   "hLabel": 2077444477
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir59.24C67C",
   "szText": "Angry, dismissive",
   "hLabel": 3536776938
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line61.24C67B",
   "szText": "The Drowned have cut us off. We either break through together or stay and die!",
   "hLabel": 2386629493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir61.24C67B",
   "szText": "Tired of repeating herself. Angry, desperate to convince/save her friend.",
   "hLabel": 3845961954
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line63.1DCFFD",
   "szText": "Captains! We may have found another way.",
   "hLabel": 1742012167
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir63.1DCFFD",
   "szText": "Interjecting, offering an encouraging alternative",
   "hLabel": 3201344628
  }
 ],
 "ptMapStringTable": "0"
}
