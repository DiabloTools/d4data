 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Bovram! Are you all right?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25A36E",
   "szText": "Praise be, I feel...wonderful. Rejuvenated, in fact. Far stronger than I ever was...",
   "hLabel": 2440850205
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25A36E",
   "szText": "Once again I am in your debt, kind stranger!",
   "hLabel": 1778390239
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25A36E",
   "szText": "Allow me to give you this medallion, a token of my gratitude. Please, take it. I have no need for frivolous trinkets anymore.",
   "hLabel": 1115930273
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25A36E",
   "szText": "Truly, this is a blessed day. Fare thee well, friend. Perhaps we will meet again.",
   "hLabel": 453470307
  }
 ],
 "ptMapStringTable": "0"
}
