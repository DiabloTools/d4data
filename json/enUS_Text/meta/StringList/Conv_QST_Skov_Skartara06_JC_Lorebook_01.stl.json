   "szLabel": "DisembodiedVoice",
   "szText": "Jered Cain",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2558FF",
   "szText": "Skovos has a lesson for us: be wary of the Heavens and Hells alike. Neither understands us. Neither will allow us to grow.",
   "hLabel": 2439276007
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2558FF",
   "szText": "Perhaps Tyrael knows this. Perhaps it is why he brought us together, only to leave.",
   "hLabel": 1776816041
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2558FF",
   "szText": "Humanity is in its infancy. The Horadrim will be its coming-of-age.",
   "hLabel": 1114356075
  }
 ],
 "ptMapStringTable": "0"
}
