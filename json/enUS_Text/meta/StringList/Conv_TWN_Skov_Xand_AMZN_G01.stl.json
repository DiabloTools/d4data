 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.245AC9",
   "szText": "We were twenty years old when last I saw her. Fresh Amazons with itchy feet, complaining about guard duty.",
   "hLabel": 2438134591
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.245AC9",
   "szText": "Somber, nostalgic. Remembering when she and her friend were young and foolish.",
   "hLabel": 3783862028
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.245AC9",
   "szText": "She always talked about going to Xanderos...to make her family proud.",
   "hLabel": 1775674625
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.245AC9",
   "szText": "Somber, aching with grief",
   "hLabel": 3121402062
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.245AC9",
   "szText": "But I was always proud of her.",
   "hLabel": 1113214659
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.245AC9",
   "szText": "Somber, aching with grief",
   "hLabel": 2458942096
  }
 ],
