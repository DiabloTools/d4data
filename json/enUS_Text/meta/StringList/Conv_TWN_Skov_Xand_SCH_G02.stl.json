 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What do you know of this place?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23AD94",
   "szText": "Ah! Well, there are two prevailing theories. One, it is a sacred Firstborn tomb. Most likely, considering the grandeur and...security of the ruin.",
   "hLabel": 2438531774
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.23AD94",
   "szText": "Happy to explain. Confident in this theory.",
   "hLabel": 3784259211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line4.23AD94",
   "szText": "And two. If you meet Amazons in the tavern, they’ll say Xanderos is a “warrior’s proving ground,” brimming with deadly challenges.",
   "hLabel": 1444841825
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir4.23AD94",
   "szText": "Dubious, condescending ",
   "hLabel": 2790569262
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.23AD94",
   "szText": "Let's say I doubt it.",
   "hLabel": 451151876
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.23AD94",
   "szText": "Grinning, condescending. Thinks Player will naturally agree.",
   "hLabel": 1796879313
  }
 ],
 "ptMapStringTable": "0"
}
