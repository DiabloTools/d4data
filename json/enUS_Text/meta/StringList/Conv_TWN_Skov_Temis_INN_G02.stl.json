 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How long have you had this inn?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2446F4",
   "szText": "It was my Ma’s business. Lheesa here joined me when we wed.",
   "hLabel": 2438051921
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2446F5",
   "szText": "I tended bar on the mainland before. So it was an easy transition.",
   "hLabel": 1775591956
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2446F4",
   "szText": "...Well, except for that thing with the five blessings.",
   "hLabel": 1113131989
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2446F4",
   "szText": "teasing",
   "hLabel": 2458859426
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.2446F5",
   "szText": "Where I come from, it’s rude to serve an unblessed drink! How was I to know?",
   "hLabel": 450672024
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.2446F5",
