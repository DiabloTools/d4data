   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I saved the Anchor. But I could not save Ludea.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.243A4F",
   "szText": "I will return the Infernal Anchor to its proper place, restore balance to the Archive...but what if Ludea saw the truth? That Hell will win?",
   "hLabel": 2438061211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.243A4F",
   "szText": "Heavy, somber. Thinking dark thoughts.",
   "hLabel": 3783788648
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.243A4F",
   "szText": "Of course. So do I.",
   "hLabel": 119451330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.243A4F",
   "szText": "Putting on a brave face, but still scared.",
   "hLabel": 1465178767
  }
 ],
