 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You're being lied to. I saw Akarat's corpse myself.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.221DB9",
   "szText": "Shut up and let her speak!",
   "hLabel": 2435622235
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.22EDCE",
   "szText": "Spare them your ire. Their skepticism is natural. Akarat himself preaches the importance of doubt.",
   "hLabel": 1775031070
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.22EDCE",
   "szText": "That’s why you all must pilgrimage with me—so you can see the Prophet as I have! Drink of his miracles, as I have!",
   "hLabel": 1112571104
  }
 ],
 "ptMapStringTable": "0"
}
