 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"The curse is gone.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8BEB",
   "szText": "And with it, centuries of misguided vengeance.",
   "hLabel": 2456032413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8BEB",
   "szText": "I underestimated Achaia’s burden. She took it upon herself to carry our memories, our pain.",
   "hLabel": 1793572447
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8BEB",
   "szText": "Though her flesh remained unsullied, she eroded from within. An atrophy of her soul.",
   "hLabel": 1131112481
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1D8BEB",
   "szText": "But her anger was misplaced. Fate is not always warmly accepted, nor should it be.",
   "hLabel": 468652515
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "By those we guide...and ourselves.",
   "hLabel": 4101159845
  }
 ],
 "ptMapStringTable": "0"
}
