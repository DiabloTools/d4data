 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How does one have their fate stolen?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8BEB",
   "szText": "Fate is fixed. It cannot be seized. It cannot be \"stolen.\"",
   "hLabel": 2456032413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8BEB",
   "szText": "But it can be offered. Traded, as an Oracle trades flesh for sight.",
   "hLabel": 1793572447
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8BEB",
   "szText": "They offered their fate in the ceremony—blood served as binding currency.",
   "hLabel": 1131112481
  }
 ],
 "ptMapStringTable": "0"
}
