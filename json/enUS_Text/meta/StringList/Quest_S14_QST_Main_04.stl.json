 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Rising Tide, Setting Sun",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Something wakes in Pandemonium.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase35Description",
   "szText": "It is as I feared—the cult has awakened a reaper! It must be destroyed!",
   "hLabel": 3294321853
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback41Header",
   "szText": "Slay Seraziel",
   "hLabel": 1248479483
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback47Header",
   "szText": "Search for the source of the voice",
   "hLabel": 407352705
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase37Description",
   "szText": "The Úllo Sar are reaching out to more than just the dead in Pandemonium. I've heard it speak, but who knows if or when it will show itself. No choice but to keep fighting...and pray we never meet it.",
   "hLabel": 641865599
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback49Header",
   "szText": "Reach Torment 1",
   "hLabel": 2990288643
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase38Description",
   "szText": "Moments after I arrived in Zarbinzet, a rupture opened—right in front of the church. Whatever has awakened in Pandemonium, I'll not allow it to harm these people. I must face it head on.",
   "hLabel": 1463121120
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback51Header",
   "szText": "Enter the Pandemonium Threshold",
   "hLabel": 917249500
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase39Description",
   "szText": "I have been fighting the Úllo Sar with everything I have, but things have just gotten worse. The terrible voice I've heard in Pandemonium just spoke aloud—in our living world! I must return to Dannica. Warn her of what may be coming.",
   "hLabel": 2284376641
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback53Header",
   "szText": "Return to Dannica in Zarbinzet",
   "hLabel": 3500185438
  }
 ],
 "ptMapStringTable": "0"
}
