 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "Stay together and move quickly. The Drowned would love another chance to swarm us.",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCFFD",
   "szText": "Leading, caring and cautious",
   "hLabel": 3140849566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "After what you just did to them?",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.6D03F",
   "szText": "Surprised. He just saw Tyrael vaporize a horde of them.",
   "hLabel": 3210763048
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCFFD",
   "szText": "I can only do so much. I'm not what I used to be.",
   "hLabel": 560384514
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1DCFFD",
   "szText": "Serious. Feeling tired.",
   "hLabel": 2019716975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.6D03F",
   "szText": "Together, then.",
   "hLabel": 2735940191
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.6D03F",
   "szText": "Nodding, understanding",
   "hLabel": 4081667628
  }
 ],
 "ptMapStringTable": "0"
}
