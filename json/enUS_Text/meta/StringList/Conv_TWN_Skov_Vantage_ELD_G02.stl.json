 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2444DD",
   "szText": "And the property in Temis, to your brother?",
   "hLabel": 2438049725
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2444D7",
   "szText": "No! Write it down, big and clear. When I’m dead, the house goes to my cousin.",
   "hLabel": 1775589714
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2444D7",
   "szText": "slightly strained, coughing. She's dying",
   "hLabel": 3121317151
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2444CE",
   "szText": "Wow. What did he do to rankle you so, huh?",
   "hLabel": 1113129761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.2444D7",
   "szText": "Bastard sold off the family hound as soon as I left for my training. Then pissed away the money at a card table. My Dromas was worth more than the house, more than ten houses! (coughs)",
   "hLabel": 4083177112
  }
 ],
 "ptMapStringTable": "0"
}
