 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You're 'Kakkos?'\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B56B",
   "szText": "It’s a name I’ve not used for some time. These cowards thought I was responsible for the “rewards” of drowned children. Sullied my reputation.",
   "hLabel": 2440888317
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25B56B",
   "szText": "sincere, somewhat playful",
   "hLabel": 3786615754
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B56B",
   "szText": "They were fun to toy with, for a time—but never underestimate the zeal of the desperate and the daft.",
   "hLabel": 1778428351
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.25B56B",
   "szText": "wry",
   "hLabel": 3124155788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B56B",
   "szText": "Cowards have been the bane of your kind since my kin first borne you in these lands. Hm, you only survived because of your “heroes.” The real mischief makers.",
   "hLabel": 1115968385
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.25B56B",
   "szText": "sincere, wry",
   "hLabel": 2461695822
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25B56B",
   "szText": "Come. Let us chat outside. The children will see to Tymon.",
   "hLabel": 453508419
  }
 ],
 "ptMapStringTable": "0"
}
