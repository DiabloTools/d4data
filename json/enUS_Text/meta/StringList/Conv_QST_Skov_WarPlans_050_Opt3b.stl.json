 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I've been thinking. We should take Lorath's body down from the mountain. Give him a proper burial.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCFFD",
   "szText": "Tharra’s Amazons already took care of it. They built a fine memorial for him by the sea. Lorath's body lies inside...yet he remains incomplete.",
   "hLabel": 560384514
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1DCFFD",
   "szText": "Somber, hesitant",
   "hLabel": 2019716975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCFFD",
   "szText": "I saved this from the ashes of the Tree. It seems only fitting that you should return it to him.",
   "hLabel": 3530431878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1DCFFD",
   "szText": "Somber, sincere.",
   "hLabel": 694797043
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1DCFFD",
   "szText": "Make him whole again, hm?",
   "hLabel": 2867971912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1DCFFD",
   "szText": "Somber, hopeful.",
   "hLabel": 32337077
  }
 ],
 "ptMapStringTable": "0"
