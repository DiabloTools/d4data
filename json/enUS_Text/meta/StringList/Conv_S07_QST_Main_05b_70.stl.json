 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Could Ouna truly save the heads?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1F9FF1",
   "szText": "Even if she could, how many lives would it cost? I know you think of your friend Lorath and whether he might be spared the Tree, but would he value his life over thousands of others?",
   "hLabel": 1133524600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1F9FF1",
   "szText": "Rejecting the idea. Emphatic.",
   "hLabel": 2479252037
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1F9FF1",
   "szText": "I am taking this head back to the Tree, and so help me, it will tell me where Ouna is. You must continue to follow the whispers...lives depend on it.",
   "hLabel": 471064634
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1F9FF1",
   "szText": "Terse. Bitter. Determined.",
   "hLabel": 1816792071
  }
 ],
 "ptMapStringTable": "0"
}
