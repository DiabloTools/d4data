 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "The Fearful Passage",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Unknown",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "I am proud of you all. Fearfully, you left your lives to do what is right and kind. Yet, as all life fights to live, I know you are fearful still.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.2808AB",
   "szText": "Take heart, beloved. Your death will be the beginning of the end. The first sip of the needful cup that will carry humanity gently to rest.",
   "hLabel": 4177963665
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.2808AB",
   "szText": "And though I am proud, I envy you. For in the dream hereafter, you will sooner be welcomed home.",
   "hLabel": 2853043733
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.2808AB",
   "szText": "To the peace of our fortress eternal.",
   "hLabel": 3162228750
  }
 ],
 "ptMapStringTable": "0"
}
