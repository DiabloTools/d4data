   "szLabel": "MenuLabel",
   "szText": "\"I've studied all of the constellations.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2547DA",
   "szText": "Yes, the observatory is beginning to look like its old self again. Our history would likely be lost forever, if not for you.",
   "hLabel": 2439238910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2547DA",
   "szText": "Hopeful, extremely grateful and sincere.",
   "hLabel": 3784966347
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2547DA",
   "szText": "Tell me, did you find a connection to any of the legends?",
   "hLabel": 1776778944
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2547DA",
