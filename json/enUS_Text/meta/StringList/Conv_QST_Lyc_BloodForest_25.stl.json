 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"He was no pilgrim, just a pirate. I took care of him and his crew.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.249685",
   "szText": "Ugh, truly? People have flooded Skovos by the boatload and it's impossible to tell friend from foe.",
   "hLabel": 1775770123
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.249685",
   "szText": "angry at self for falling for the trap ",
   "hLabel": 3121497560
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.249685",
   "szText": "No one's ever who they seem. I wonder what you aren’t telling me...",
   "hLabel": 1113310157
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.249685",
   "szText": "joking, but lightly suspicious, offhand",
   "hLabel": 2459037594
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.249685",
   "szText": "Regardless, you deserve a reward for your trouble. Here.",
   "hLabel": 450850191
  }
 ],
