 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Warlock: Fang and Flame",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Bind the demon Abodian.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase5Description",
   "szText": "I must obtain a sacrificial heart to pass through the gates to the Hellhound's lair. A Fiend of Malice stalks the area. It will be my offering.",
   "hLabel": 3388789226
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback32Header",
   "szText": "Acquire the Heart of Malice",
   "hLabel": 2871177435
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase8Description",
   "szText": "I must enter into the Lair of Abodian, then use the Heart of Malice to act as tribute for the Hellhound.",
   "hLabel": 1557588493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback7Header",
   "szText": "Enter the Lair of Abodian",
   "hLabel": 2677071405
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase11Description",
   "szText": "I must enter the Lair of Abodian and find a way to bind the Hellhound to my will.",
   "hLabel": 1641010231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback10Header",
   "szText": "Bind the demon Abodian",
   "hLabel": 950701463
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase17Description",
   "szText": "The demon Abodian can be found somewhere in the Forsaken Ascent. I shall find this fiend and bind it to my will.",
   "hLabel": 2273576061
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback34Header",
   "szText": "Search for the demon Abodian in the Forsaken Ascent",
   "hLabel": 1159146077
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback16Header",
   "szText": "Search for the demon Abodian in the Forsaken Ascent",
   "hLabel": 109574685
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase20Description",
   "szText": "I must speak with Hattar to learn what I must do to bind the Hellhound to my will.",
   "hLabel": 2151383127
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback19Header",
   "szText": "Speak with Hattar",
   "hLabel": 3983978592
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase26Description",
   "szText": "I must return to Hattar to bring him the Heart of Malice. He will open the way to the Lair of Abodian.",
   "hLabel": 2783948957
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback25Header",
   "szText": "Return to Hattar",
   "hLabel": 2781844029
  }
 ],
