   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.244C6E",
   "szText": "Demon born of flame and flesh. Angel forged of light and sound. What is man made of?",
   "hLabel": 2438099391
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.244C6E",
   "szText": "giving a riddle, Sphinx-like",
   "hLabel": 3783826828
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.244C64",
   "szText": "That's simple! They're all the same.",
   "hLabel": 1775639376
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.244C64",
   "szText": "The Firstborn. Demons. Angels. They're all made of the same fundamental elements.",
   "hLabel": 450719444
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.244C6E",
   "szText": "Perhaps.",
   "hLabel": 1113179459
  }
 ],
 "ptMapStringTable": "0"
}
