   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{if:Mod.Upgrade1}{c_label}Generate Spirit:{/c_label} {c_resource}{SF_20}{/c_resource}\r\n{/if}{c_label}Cooldown: {/c}{c_resource}{Cooldown Time}{/c} seconds\r\nEncase all Nearby enemies in stone, Stunning them for {c_number}{buffduration:PETRIFIED}{/c} seconds. {c_important}Petrified{/c} enemies take {c_number}[SF_2*100|+%|]{/c} bonus Critical Strike Damage from you.",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": "\r\n{icon:bullet,1.2} {c_important}Petrify{/c} Critical Strike Damage {icon:arrow,1.2} {c_number}[SF_2*100|+%|]{/c}",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Description",
   "szText": "You deal {c_number}[{SF_2}*100|%x|]{/c} increased Critical Strike Damage to enemies affected by {c_important}Petrify{/c}. Against Bosses, the Critical Strike Damage bonus is increased to {c_number}[{SF_8}*100|%x|]{/c} and its duration is increased to {c_number}{buffduration:BUFF_PETRIFIED_BOSS_CRIT}{/c} seconds.",
   "hLabel": 628601524
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Name",
   "szText": "Prime Petrify",
   "hLabel": 2492006865
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod2_Description",
   "szText": "Killing an enemy affected by {c_important}Petrify{/c} reduces its Cooldown by {c_number}{SF_5}{/c} second. Hitting a Boss with {c_important}Petrify{/c} reduces its Cooldown by {c_number}{SF_9}{/c} seconds.",
   "hLabel": 1960229941
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod2_Name",
   "szText": "Supreme Petrify",
   "hLabel": 2531142258
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod3_Description",
   "szText": "Increase Petrify's duration by {c_number}[SF_14*100|%x|]{/c} and reduces the Cooldown by {c_number}[SF_12]{/c} seconds.",
   "hLabel": 3291858358
