   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What is Skovos' rarest catch?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.241F1B",
   "szText": "The Skartara Red Eel. Swims in the lava pools of Skartara. It’s my life’s goal to catch one.",
   "hLabel": 2437994679
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.241F1B",
   "szText": "excited for a curious/captive audience",
   "hLabel": 3783722116
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.244C28",
   "szText": "A daft, dangerous, and foolish goal.",
   "hLabel": 1113179282
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.244C28",
   "szText": "playful ribbing, but he believes his words",
   "hLabel": 2458906719
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.241F1B",
   "szText": "The parasites in a Kraken’s belly are the perfect bait. You get me some and I'll show you the eel's fishing grounds.",
   "hLabel": 1775534713
  }
 ],
