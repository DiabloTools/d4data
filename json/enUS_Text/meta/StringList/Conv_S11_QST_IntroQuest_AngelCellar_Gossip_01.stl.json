 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why haven't any other angels helped with Mephisto? Do you know what he's done?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24ADC2",
   "szText": "We are forced to abide by the rules of the High Heavens, every one of us.",
   "hLabel": 452339181
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.24ADC2",
   "szText": "Calm, maybe subtext is a sigh. There's nothing else they can do.",
   "hLabel": 1798066618
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24ADC2",
   "szText": "Even emerging for the Lesser Evils is risking my entire being. Meddling with Mephisto is yet another war they refuse to wage.",
   "hLabel": 1777259113
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24ADC2",
   "szText": "The Heavens have made up their minds—the fate of mortals is up to mortals.",
   "hLabel": 1114799147
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.24ADC2",
   "szText": "Matter of fact",
   "hLabel": 2460526584
  }
 ],
 "ptMapStringTable": "0"
}
