 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "name",
   "szText": "Storm Strike",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{if:SF_20}{c_label}Spirit Cost: {/c}{c_resource}{Resource Cost}{/c}\r\n{/if}{c_label}Generate Spirit:{/c_label} {c_resource}{SF_2}{/c_resource}\r\n{if:ADVANCED_TOOLTIP}{c_label}Lucky Hit Chance: {/c}{c_resource}[{Combat Effect Chance}|%|]{/c}\r\n{/if}Electricity gathers around your weapon, dealing {c_number}{if:Mod.UpgradeB}{payload:UPGRADEB_DAMAGE}{else}{payload:DAMAGE}{/if}{/c} damage to your target and chaining up to {c_number}{SF_3}{/c} times to targets nearby.",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": "\r\n{icon:bullet,1.2} Damage {icon:arrow,1.2} {c_number}{payload:DAMAGE}{/c}",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Description",
   "szText": "{c_important}Storm Strike{/c} chains {c_number}[SF_26]{/c} additional times. {c_important}Storm Strike's{/c} chain damage increases by {c_number}[SF_27 * 100]%{/c} each time it chains.",
   "hLabel": 628601524
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Name",
   "szText": "Chain Reaction",
   "hLabel": 2492006865
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod8_Description",
   "szText": "{c_important}Storm Strike{/c} deals {c_number}{payload:UPGRADEB_DAMAGE}{/c} Lightning damage and can be cast from range becoming a swift projectile.\r\n\r\nAdditionally, {c_important}Storm Strike{/c} Immobilizes enemies for {c_number}{buffduration:UPGRADEB_IMMOBILIZE}{/c} seconds. May occur once every {c_number}[SF_15]{/c} seconds per enemy.",
   "hLabel": 1360065851
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod8_Name",
   "szText": "Storm Hammer",
   "hLabel": 2765954616
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod9_Description",
   "szText": "{c_important}Storm Strike{/c} chaining will always prioritize the same target until that target dies. Chaining to the same target deals {c_number}[{SF_28} * 100|%x|]{/c} increased damage.",
   "hLabel": 2691694268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod9_Name",
   "szText": "Focused Strike",
   "hLabel": 2805090009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod10_Description",
   "szText": "You gain {c_number}[SF_9 * 100]%{/c} Armor for {c_number}[SF_10]{/c} seconds when dealing damage.",
   "hLabel": 2741697796
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod10_Name",
   "szText": "Armor",
   "hLabel": 3070117409
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod11_Description",
   "szText": "{c_important}Storm Strike{/c} may chain {c_number}[SF_11]{/c} additional time.",
   "hLabel": 4073326213
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod11_Name",
   "szText": "Additional Chain",
   "hLabel": 3109252802
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod12_Description",
   "szText": "{c_important}Storm Strike{/c} grants {c_number}[SF_12]{/c} stack of {c_important}{u}Ferocity{/u}{/c} when first dealing damage.",
   "hLabel": 1109987334
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod12_Name",
   "szText": "Ferocity",
   "hLabel": 3148388195
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod13_Description",
   "szText": "{c_important}Storm Strike{/c} grants {c_number}[SF_13]{/c} Spirit when a single enemy is hit at least {c_number}[SF_14]{/c} times per cast.",
   "hLabel": 2441615751
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod13_Name",
   "szText": "Spirit",
   "hLabel": 3187523588
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod14_Description",
   "szText": "{c_important}Storm Strike{/c} deals {c_number}{payload:UPGRADEC_DAMAGE}{/c} Physical damage in a cone shape in front of you and no longer chains. {c_important}Storm Strike{/c} is now an Earth skill.",
   "hLabel": 3773244168
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod14_Name",
   "szText": "Stone Strike",
