 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Memoir of Philios",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Memoir of Philios",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2289FE",
   "szText": "If a warrior does not die in battle, what happens to him? His beard turns white, his body shrinks, and one day all his glories are behind him.",
   "hLabel": 2435827143
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2289FE",
   "szText": "Serious, grim. Describing a pitiable fate.",
   "hLabel": 3781554580
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2289FE",
   "szText": "Some call this victory, including my Askarra, but nay. It is surrender. And I cannot simply sheathe my sword and wait to die, like everyone seems to want.",
   "hLabel": 1773367177
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2289FE",
   "szText": "Defiant, indignant, stubborn",
   "hLabel": 3119094614
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2289FE",
   "szText": "I am Philios. Protector of these isles. I must train harder, beyond my limits, for as long as I draw breath, and if I should die in the effort? So be it.",
   "hLabel": 1110907211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2289FE",
   "szText": "Proud, determined. Believes this must be done.",
   "hLabel": 2456634648
  }
 ],
 "ptMapStringTable": "0"
}
