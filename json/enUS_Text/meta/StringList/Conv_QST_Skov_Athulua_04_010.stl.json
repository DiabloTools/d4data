{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_04_010.stl",
 "__snoID__": 1949338,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Captain. We must speak of the Foundering Caverns.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.24C67B",
   "szText": "A Drowned took a swing at me. I didn’t see it. Leodora pushed me out of the way...",
   "hLabel": 1171934391
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.24C67B",
   "szText": "Not answering. Exhausted, in shock, grieving",
   "hLabel": 2631266852
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1DCFFD",
   "szText": "May she walk with Askarra. But more will follow her if we do not act.",
   "hLabel": 527317065
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.1DCFFD",
   "szText": "Empathetic. Encouraging her to answer.",
   "hLabel": 1986649526
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.24C67B",
   "szText": "Fine, the Caverns. What is it you propose?",
   "hLabel": 818659442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.24C67B",
   "szText": "Relenting, focusing",
   "hLabel": 2277991903
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.6D03F",
   "szText": "Empty them! Draw the wretches out into the open and crush them, all at once.",
   "hLabel": 3785511583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.6D03F",
   "szText": "Determined, eager to crush the Drowned",
   "hLabel": 836271724
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD",
   "szText": "You should be resting.",
   "hLabel": 3806549446
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD",
   "szText": "Gentle, worried",
   "hLabel": 970914611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.6D03F",
   "szText": "Someone had to tend the wounded.",
   "hLabel": 361448867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.6D03F",
   "szText": "Flat, terse",
   "hLabel": 1707176304
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.6D03F",
   "szText": "What would it take, captain?",
   "hLabel": 2944384805
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.6D03F",
   "szText": "Eager for an answer",
   "hLabel": 4290112242
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.24C67B",
   "szText": "(scoffs) Call out the Drowned? We’d need every Amazon left on the island, and most of what we had went to the eastern flank.",
   "hLabel": 2772971891
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.24C67B",
   "szText": "Weary, scoffing. What they ask is impossible.",
   "hLabel": 4232304352
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.BAE4",
   "szText": "That’s where Tharra went! If we ride there and gather her Amazons...",
   "hLabel": 1277609625
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.BAE4",
   "szText": "Realizing",
   "hLabel": 3140496582
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.6D03F",
   "szText": "We'll have...what we need...",
   "hLabel": 1742250242
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.6D03F",
   "szText": "Agreeing, suddenly woozy from the exertion (blood loss)",
   "hLabel": 3087977679
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.1DCFFD",
   "szText": "My friend, your wounds have opened.",
   "hLabel": 803434633
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.1DCFFD",
   "szText": "Concerned.",
   "hLabel": 2262767094
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line49.6D03F",
   "szText": "Ugh, so they have. You two go, then.",
   "hLabel": 2613154822
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir49.6D03F",
   "szText": "Exhausted, relenting",
   "hLabel": 3958882259
  }
 ],
 "ptMapStringTable": "0"
}
