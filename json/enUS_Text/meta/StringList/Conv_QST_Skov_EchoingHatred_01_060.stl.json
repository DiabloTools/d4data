 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are all the dead lost to hatred?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.251FCD",
   "szText": "At times, I hear clear voices ring out from the chaos. Amazons who died to protect us...who fight to protect us still.",
   "hLabel": 2439182252
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.251FCD",
   "szText": "Not all are lost. She's both proud of them and worried for them.",
   "hLabel": 3784909689
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.251FCD",
   "szText": "Their courage endures, but I fear not for long. Please, find them if you can.",
   "hLabel": 1776722286
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.251FCD",
   "szText": "Both proud and worried. Humbly asking for help.",
   "hLabel": 3122449723
  }
 ],
 "ptMapStringTable": "0"
}
