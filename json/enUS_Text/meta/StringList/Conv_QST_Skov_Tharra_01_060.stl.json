{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Tharra_01_060.stl",
 "__snoID__": 2383551,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "[Take Counsel]",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.245EB7",
   "szText": "You join this Council at a most critical time. Our islands are in chaos with no queen to defend them. A successor must be chosen.",
   "hLabel": 2438138912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.245EB7",
   "szText": "Captains. Each of you have been elected by your cohorts for the crown. Therefore you must each endure the Passage.",
   "hLabel": 450759014
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.245EB7",
   "szText": "Captain Tharra, have you chosen your witness?",
   "hLabel": 209711348
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "My chosen witness has just arrived, if they will have me.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.245EB7",
   "szText": "Very well. Let the Passage begin.",
   "hLabel": 872171314
  }
 ],
 "ptMapStringTable": "0"
}
