{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Celestia2_02_200.stl",
 "__snoID__": 2493530,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What of the Pools? Are we too late?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "The Pools break the surface. Atanos trembles... old bones cracking, crashing, spilling Hatred.",
   "hLabel": 4101159845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1D8BEB",
   "szText": "Only half-aware of Player, still in the vision. Disturbed by what she sees.",
   "hLabel": 1151919986
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1D8BEB",
   "szText": "His flock rush to embrace him... Blood in the waters... Black...black black...",
   "hLabel": 1221294798
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1D8BEB",
   "szText": "Tearful, exhausted...trailing off",
   "hLabel": 2680627259
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCC9B",
   "szText": "\"Akarat's miracle...\" Can you stop him? Do you have Lilith's blade?",
   "hLabel": 560379760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4",
   "szText": "I can, and I do... Thanks to Lorath.",
   "hLabel": 1776443800
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCC9B",
   "szText": "Tyrael told me... We'll mourn the dead later—go now and avenge them. I'll be right behind you.",
   "hLabel": 3530427124
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1DCC9B",
   "szText": "Burying grief, focusing on the present.",
   "hLabel": 694792289
  }
 ],
 "ptMapStringTable": "0"
}
