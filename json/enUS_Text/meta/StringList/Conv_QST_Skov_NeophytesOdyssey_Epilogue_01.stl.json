{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_NeophytesOdyssey_Epilogue_01.stl",
 "__snoID__": 2379850,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Bnatros? Is that you?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.228AA8",
   "szText": "Light above! My friend—I wasn’t sure I’d ever see you again.",
   "hLabel": 2435870493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.228AA8",
   "szText": "I took your advice. My pilgrimage has ended here in Samuk. The locals were wary at first, but then Senak allowed me to tend to the sick within the community. And, well…",
   "hLabel": 1773410527
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.228AA8",
   "szText": "This is my home now. I've learned so much about Akarat from the elders. I have found hope.",
   "hLabel": 1110950561
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.228AA8",
   "szText": "There is something you should see. To the south. Look for a wooden marker by the carts.",
   "hLabel": 4080997925
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.228AA8",
   "szText": "Tell her I said, “Hello.”",
   "hLabel": 1201132878
  }
 ],
 "ptMapStringTable": "0"
}
