{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Celestia2_01_080.stl",
 "__snoID__": 2148051,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Lower your spears, Amazons. I have no wish to fight you.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.254108",
   "szText": "I don't care what you wish, demon!",
   "hLabel": 1776770653
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.254108",
   "szText": "Hostile, barking, on edge",
   "hLabel": 3122498090
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BAE4",
   "szText": "Akarat is the demon. He promises you salvation, yet Skovos burns. He preaches against hate, yet sows division—",
   "hLabel": 3718003623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.BAE4",
   "szText": "Emphasis on \"Akarat.\" Calm, firm, trying to convince",
   "hLabel": 650842164
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.254108",
   "szText": "We are not divided, we stand with Queen Adreona! She named you our enemy. Where is she?",
   "hLabel": 451850721
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.254108",
   "szText": "A little distant.",
   "hLabel": 1797578158
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "Adreona is dead.",
   "hLabel": 4101159845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1D8BEB",
   "szText": "A bitter fact. Somber, grieving.",
   "hLabel": 1151919986
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.254108",
   "szText": "What...? You lie!",
   "hLabel": 1204493004
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.254108",
   "szText": "Confusion then anger",
   "hLabel": 2663825465
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1D8BEB",
   "szText": "It was her fear that decided her fate.",
   "hLabel": 558834832
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1D8BEB",
   "szText": "Sad, regretful.",
   "hLabel": 2018167293
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1D8BEB",
   "szText": "She used to cradle my head, when I was a child. When the visions roared between my ears. Through the din I’d hear her voice...so strong and yet so afraid for me.",
   "hLabel": 4191342162
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1D8BEB",
   "szText": "Somber, remembering, loving",
   "hLabel": 1355707327
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1D8BEB",
   "szText": "She was afraid for us all. For Skovos... Akarat took her fear and pressed it into his palm until it turned to hatred.",
   "hLabel": 3528882196
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1D8BEB",
   "szText": "Somber, speaking truth",
   "hLabel": 693247361
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.254108",
   "szText": "Silence!",
   "hLabel": 2849620436
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.254108",
   "szText": "Tearful, barked in denial",
   "hLabel": 13985601
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1D8BEB",
   "szText": "She chose him, and he drove her to madness—just as he drives you now.",
   "hLabel": 3175607247
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1D8BEB",
   "szText": "Pressing on, sincere, looking into the Amazon's eyes",
   "hLabel": 339972412
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1D8BEB",
   "szText": "You can still choose, sister. Let go of your hatred before he takes you too.",
   "hLabel": 2513147281
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1D8BEB",
   "szText": "Pleading, sincere, looking into the Amazon's eyes",
   "hLabel": 3972479742
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.230CE3",
   "szText": "What? Is that—?",
   "hLabel": 1831426125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.230CE3",
   "szText": "Confused, then excited",
   "hLabel": 3290758586
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.254108",
   "szText": "The eclipse! It's happening!",
   "hLabel": 1171425555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.254108",
   "szText": "Alarmed, excited",
   "hLabel": 2630758016
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1D8BEB",
   "szText": "Too late...",
   "hLabel": 525767383
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.1D8BEB",
   "szText": "To self, fearful, regretful",
   "hLabel": 1985099844
  }
 ],
 "ptMapStringTable": "0"
}
