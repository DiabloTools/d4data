   "szLabel": "MenuLabel",
   "szText": "My Absolution, Part 4",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Unknown",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "The earth trembled with a malice I had never known, and once it had passed, I heard the cries of man, louder than ever before.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.2808AB",
   "szText": "I wept. For days into weeks. Begging for death to silence their pain and to at last put an end to mine.",
   "hLabel": 545456335
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.2808AB",
   "szText": "And then, he answered.",
   "hLabel": 4177963665
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.2808AB",
   "szText": "Revelation.",
   "hLabel": 1342328830
  }
 ],
 "ptMapStringTable": "0"
}
