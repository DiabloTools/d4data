 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I'm sorry, Bnatros.\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.228AA8",
   "szText": "They’ve been smelted like ore. Stripped of their humanity to extract the Hatred within. And all that is left behind…is a Morlu.",
   "hLabel": 1773410527
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.228AA8",
   "szText": "Stunned, horrified. Saying this as he looks over demonic contraptions used to turn humans into Morlu.",
   "hLabel": 3119137964
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.228AA8",
   "szText": "These…these were brave souls. They endured this fate rather than embrace evil.",
   "hLabel": 1110950561
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.228AA8",
   "szText": "Trying to find something noble in their deaths.",
   "hLabel": 2456677998
  }
 ],
 "ptMapStringTable": "0"
}
