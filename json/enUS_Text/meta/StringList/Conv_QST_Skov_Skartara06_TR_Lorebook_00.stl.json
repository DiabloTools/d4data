 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Tal Rasha",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.255902",
   "szText": "How can one stop destruction incarnate? How can Baal ever be contained if all he touches will crumble?",
   "hLabel": 2439275262
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.255902",
   "szText": "Thinking, vexed",
   "hLabel": 3785002699
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.255902",
   "szText": "Perhaps Baal's myopia is his weakness. Give him a target. A nemesis to focus his energies from wanton chaos to a single, infuriating point.",
   "hLabel": 1114355330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.255902",
   "szText": "A promising idea forms",
   "hLabel": 2460082767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.255902",
   "szText": "It will not divert him long. But thousands might be spared.",
   "hLabel": 451895364
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.255902",
   "szText": "Troubled, pensive",
   "hLabel": 1797622801
  }
 ],
 "ptMapStringTable": "0"
}
