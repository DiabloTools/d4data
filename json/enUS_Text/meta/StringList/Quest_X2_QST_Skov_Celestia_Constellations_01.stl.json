 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "The Observatory lies in ruins, its knowledge destroyed.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "A Tapestry of Heroes and Legends",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "The Observatory and most of its records have been lost in the Amazon siege. I have agreed to help Agmali rebuild the lost knowledge.\r\n\r\nThe history of Skovos will reveal itself if I use Astrolabes to study the seven Askari constellations.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback34Header",
   "szText": "Find the History of Skovos {DONE_OVER_NEEDED}",
   "hLabel": 1159146077
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase6Description",
   "szText": "I have studied all seven Askari constellations. I should return to Agmali and tell her what I have collected.",
   "hLabel": 4210044747
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback23Header",
   "szText": "Speak with Agmali",
   "hLabel": 198908091
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase11Description",
   "szText": "Agmali has asked that I choose a constellation whose legend speaks to me.",
   "hLabel": 1641010231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback10Header",
   "szText": "Speak with Agmali to choose a Constellation",
   "hLabel": 950701463
  }
