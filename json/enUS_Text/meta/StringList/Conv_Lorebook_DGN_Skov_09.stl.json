  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.228089",
   "szText": "\"The Oracle did not warn our queen, nor did we save her from death. This 'Akarat' did. Shouldn't I rejoice to have seen such a miracle?! To serve a true savior?",
   "hLabel": 2435815780
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.228089",
   "szText": "Simmering rage, confusion.",
   "hLabel": 3781543217
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.228089",
   "szText": "Yet I clutch my spear so tightly, my palms tear on the grip. I have never felt such rage. Both for my failure...and for those who still deny his Light!\"",
