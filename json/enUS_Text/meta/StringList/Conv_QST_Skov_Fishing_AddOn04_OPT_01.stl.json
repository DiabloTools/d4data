 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What's the story with that ruby?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.21C82F",
   "szText": "Ha, well, you might’ve guessed it involved a woman. She was beautiful and gentle, but she had been claimed by another.",
   "hLabel": 4171493458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.21C82F",
   "szText": "Somber. Regretful.",
   "hLabel": 1335858623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line24.21C82F",
   "szText": "Ohh, he was a mighty wicked bastard. So, of course, I had to steal her away from him! Not because I cared but...just to prove I could.",
   "hLabel": 2162068594
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir24.21C82F",
   "szText": "Somber. Regretful.",
   "hLabel": 3621401055
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line26.21C82F",
   "szText": "I won her heart with this ruby, a-and ran away to toast my cleverness. (chuckles) Then that devil killed her! And everyone else I had...",
   "hLabel": 1499608628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir26.21C82F",
   "szText": "Somber. Regretful.",
   "hLabel": 2958941089
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line28.21C82F",
   "szText": "Heh, I trapped him in this ruby. Then he escaped, and I trapped him again! (laughs) Y-You know, I think he’s still in there... Hellooo old friend! Did you have fun in the fish? (laughs)",
   "hLabel": 837148662
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir28.21C82F",
   "szText": "Summing up briefly, then mocking the demon inside the ruby",
   "hLabel": 2296481123
  }
 ],
 "ptMapStringTable": "0"
}
