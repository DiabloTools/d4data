 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What do you make of this 'Fearful Passage'?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "Other than making me sad and furious? Well, he talks like a cult leader. Praising isolation, assuaging fears, promising “dreams hereafter.”",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Contempt, then thinking aloud",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27ED42",
   "szText": "But every such leader has a personal angle... He writes of this “fortress eternal” with a hell of a yearning. What’s in it for him, I wonder?",
   "hLabel": 1780959073
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.27ED42",
   "szText": "Thinking aloud",
   "hLabel": 3126686510
  }
 ],
 "ptMapStringTable": "0"
}
