 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What is the Sword of Horazon?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23AE2D",
   "szText": "It's the blade used to cut off Bartuc's head at the end of the Mage Clan Wars long ago. Bartuc's brother's blade.",
   "hLabel": 2438532680
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.23AE2D",
   "szText": "The demons must have been hiding it all these years.",
   "hLabel": 1113612748
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.23AE2D",
   "szText": "It's obviously important. The scholar, Alafar the Elder, has helped us in the past. Perhaps he might know something.",
   "hLabel": 451152782
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.23AE2D",
   "szText": "I need to prepare. Meet me at the Caldeum Library when you're ready.",
   "hLabel": 4083660112
  }
 ],
 "ptMapStringTable": "0"
}
