  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BAE4.Nec",
   "szText": "I... There is something you should know, but...",
   "hLabel": 2200621547
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BAE4.Rog",
   "szText": "I... There is something you should know, but...",
