 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Tyrael?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "You are troubled. I can feel it.",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCFFD",
   "szText": "Attentive, probing",
   "hLabel": 3140849566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BAE4.Bar",
   "szText": "I... There is something you should know, but...",
   "hLabel": 2200608362
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.BAE4.Bar",
   "szText": "Hesitant, not sure how to tell Tyrael about Lilith",
   "hLabel": 3113939319
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BAE4.Dru",
   "szText": "I... There is something you should know, but...",
