   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"They took her to a pit in Kehjistan.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.24B8C5",
   "szText": "A pit... I know where they took her. They're going to commence the ritual there.",
   "hLabel": 1834362005
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.24B8C5",
   "szText": "After \"a pit\", it's realization. There is urgency. Must act quickly. Not commanding, just matter of fact. Let's get a move on. ",
   "hLabel": 3293694466
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.24B8C5",
   "szText": "Let me cleanse the place quickly before we leave. Once I do it, they may sense the purging.",
   "hLabel": 1171902039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.24B8C5",
   "szText": "Do you mind keeping watch?",
   "hLabel": 509442073
  }
 ],
 "ptMapStringTable": "0"
}
