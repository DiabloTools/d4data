{
 "__fileName__": "enUS_Text/meta/StringList/Quest_S16_DSQ_QST_Main_05_Cellar.stl",
 "__snoID__": 2690062,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Under the Cold Earth",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "He's taken Tyrael! Buried him alive in the Fractured Peaks! He marked it out on the map. The trap is obvious, but I have no choice! I've lost everyone else, I won't lose Tyrael too.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Search for Tyrael",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase5Description",
   "szText": "I entered the tomb and found Tyrael's sword, sticking out of a pile of rubble! He must be under there, I have to get him out! Fast!",
   "hLabel": 3388789226
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback4Header",
   "szText": "Rescue Tyrael",
   "hLabel": 3097634794
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase8Description",
   "szText": "The moment I tried to dig for Tyrael, the Nameless sprung his trap. A reaper. I have to kill it and quickly. Tyrael doesn't have much time.",
   "hLabel": 1557588493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback7Header",
   "szText": "Slay the Fractured Reaper",
   "hLabel": 2677071405
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase11Description",
   "szText": "The moment I tried to dig for Tyrael, the Nameless sprung his trap. A reaper. I have to kill it and quickly. Tyrael doesn't have much time.",
   "hLabel": 1641010231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback10Header",
   "szText": "Slay the Fractured Reaper",
   "hLabel": 950701463
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase19Description",
   "szText": "The reaper is finished. I have to get Tyrael out. Please let him still be alive...",
   "hLabel": 3916087103
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback18Header",
   "szText": "Rescue Tyrael",
   "hLabel": 2692510623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase22Description",
   "szText": "He lives! Thank fate, I made it in time. He's in poor shape, but we need to talk.",
   "hLabel": 3793894169
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback21Header",
   "szText": "Speak with Tyrael",
   "hLabel": 1910939449
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase25Description",
   "szText": "Tyrael is all right for the moment. Now to search the tomb...maybe find something useful out of this mess.",
   "hLabel": 1962693436
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback24Header",
   "szText": "Search the tomb for clues",
   "hLabel": 1490376060
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase28Description",
   "szText": "There is writing scratched into the wall. Huge, ecstatic letters, declaring that \"no angel of Heaven, no demon of Hell,\" will be our salvation. I'd guess the Nameless wrote this after he was freed. I should speak with Tyrael.",
   "hLabel": 131492703
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback27Header",
   "szText": "Speak with Tyrael",
   "hLabel": 1069812671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase31Description",
   "szText": "According to Tyrael, the words in the tomb cast doubt on the return of Malthael as the Aspect of Death. But the truth will have to wait. I need to get Tyrael to safety.",
   "hLabel": 9299769
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback30Header",
   "szText": "Leave the tomb with Tyrael",
   "hLabel": 288241497
  }
 ],
 "ptMapStringTable": "0"
}
