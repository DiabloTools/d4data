 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What is this 'Chamber of Calling' exactly?\"  ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.219CC0",
   "szText": "Young Seers were once brought here. The trial awakened their sight. If they could not withstand their first vision, they were culled. It was a mercy.",
   "hLabel": 2434722745
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.219CC0",
   "szText": "Grave and reflective",
   "hLabel": 3780450182
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.219CC0",
   "szText": "As First Oracle Seryn wrote, \"We must be able to command the visions, not merely see.\"",
   "hLabel": 1772262779
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.219CC0",
   "szText": "I have always wondered if I would endure.",
   "hLabel": 1109802813
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.219CC0",
   "szText": "Soft and reflective. She is genuinely unsure",
   "hLabel": 2455530250
  }
 ],
 "ptMapStringTable": "0"
}
