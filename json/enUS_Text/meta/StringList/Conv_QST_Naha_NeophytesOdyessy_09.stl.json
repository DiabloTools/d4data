 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "(Listen to Adoné and Bnatros).",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.22B189",
   "szText": "Bnatros, I never asked. Where do you come from?",
   "hLabel": 1202588608
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.228AA8",
   "szText": "Kehjistan. My kin are of the Zakarum faith.",
   "hLabel": 4171180242
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.22B189",
   "szText": "You are Zakarum as well?",
   "hLabel": 3510176006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.22B189",
   "szText": "Intrigued",
   "hLabel": 674541171
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.228AA8",
   "szText": "In a way, I suppose. I simply follow Akarat's teachings, wherever they lead me.",
   "hLabel": 2846260310
  }
 ],
