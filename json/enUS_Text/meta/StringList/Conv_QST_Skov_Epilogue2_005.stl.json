   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.789BF",
   "szText": "The whispers said someone would come for Lorath. A man who is not quite man. You must be Tyrael.",
   "hLabel": 1511616375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.789BF",
   "szText": "Slightly on guard--but more curious than suspicious. PRONUNCIATION: teer-ee-uhl",
   "hLabel": 3374503332
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "And you must be the witch he told me of. Taissa. A shame to meet under these circumstances.",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCFFD",
   "szText": "Calm, friendly. Pronunciation: tie-ee-suh",
   "hLabel": 3140849566
  }
 ],
 "ptMapStringTable": "0"
}
