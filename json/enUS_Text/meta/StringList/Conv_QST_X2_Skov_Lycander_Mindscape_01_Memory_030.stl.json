 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1D8FD7",
   "szText": "I had hoped this would be a small ceremony. But it seems you have brought the whole world to my doorstep.",
   "hLabel": 468656795
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1D8FD7",
   "szText": "muttered, bitter",
   "hLabel": 1814384232
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8FD7",
   "szText": "Can you hear them? Calling your name? “Akarat.” The Zakarum wielded that name as a sword. Will you be that sword?",
   "hLabel": 4101164125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1D8FD7",
   "szText": "close proximity",
   "hLabel": 1151924266
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1D90EA",
   "szText": "(sighs) Of course not. The Zakarum didn’t know their own history. Not as the Askari do.",
   "hLabel": 1221276284
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1D8FD7",
   "szText": "You think compliments will win you my trust?",
   "hLabel": 558839112
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1D90EA",
   "szText": "No. The truth will.",
   "hLabel": 4191323648
  }
 ],
 "ptMapStringTable": "0"
}
