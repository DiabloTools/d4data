  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.FD852",
   "szText": "It is done. A bit strange, staring myself in the face. The thing doesn’t have any of my scars.",
   "hLabel": 1568933264
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.FD852",
   "szText": "But that’s the point, isn’t it? This place needs a guardian. Someone strong, healthy.",
   "hLabel": 4151869202
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.FD852",
   "szText": "Perhaps I’ll wrap it up in stone. Let it sleep a while.",
   "hLabel": 727806486
  }
 ],
 "ptMapStringTable": "0"
}
