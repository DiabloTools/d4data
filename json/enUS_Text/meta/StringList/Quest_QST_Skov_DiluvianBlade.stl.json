{
 "__fileName__": "enUS_Text/meta/StringList/Quest_QST_Skov_DiluvianBlade.stl",
 "__snoID__": 2471513,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Diluvian Blade",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "A mysterious aquatic stranger is haunted by her distant past.  ",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "An injured merfolk is lying on the ground while a strange ghost stands idly nearby. I should help her.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback8Header",
   "szText": "Heal Kos",
   "hLabel": 3968539374
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase11Description",
   "szText": "This merfolk that I helped can speak? This is unusual. I should learn more about her.",
   "hLabel": 1641010231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback10Header",
   "szText": "Speak with Kos",
   "hLabel": 950701463
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase14Description",
   "szText": "Kos wants to find the ghost that was watching over her earlier. I should help her.",
   "hLabel": 4104776794
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback55Header",
   "szText": "Find the ghost",
   "hLabel": 1788154080
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback54Header",
   "szText": "Find the ghost",
   "hLabel": 496686111
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback53Header",
   "szText": "Find the ghost",
   "hLabel": 3500185438
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase17Description",
   "szText": "We have tracked down the ghost that was standing by Kos. Maybe I can speak with the ghost and get answers.",
   "hLabel": 2273576061
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback16Header",
   "szText": "Speak with the ghost",
   "hLabel": 109574685
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase20Description",
   "szText": "The ghost didn't respond, but she screamed and vanished. Perhaps she's still nearby and we can find her.",
   "hLabel": 2151383127
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback19Header",
   "szText": "Follow the ghost",
   "hLabel": 3983978592
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase23Description",
   "szText": "We've been ambushed by Drowned while looking for the ghost. ",
   "hLabel": 320182394
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback22Header",
   "szText": "Follow the ghost",
   "hLabel": 3202407418
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase26Description",
   "szText": "The ghost has dropped a special blade. It might lead us to more answers.",
   "hLabel": 2783948957
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback25Header",
   "szText": "Pick up the {ITEM:QST_Skov_DiluvianBlade_Item}",
   "hLabel": 2781844029
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase29Description",
   "szText": "The ghost has dropped a special blade and told us to show it to Kos. ",
   "hLabel": 952748224
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback28Header",
   "szText": "Speak with Kos about the {ITEM:QST_Skov_DiluvianBlade_Item}",
   "hLabel": 2361280640
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase32Description",
   "szText": "The blade triggered a memory for Kos. She is now seeking out her home. We should find her.",
   "hLabel": 830555290
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback89Header",
   "szText": "Find Kos",
   "hLabel": 1665368711
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback90Header",
   "szText": "Find Kos",
   "hLabel": 2595828895
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback91Header",
   "szText": "Find Kos",
   "hLabel": 3887296864
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase38Description",
   "szText": "Kos has led us to a sunken villa that was her home long ago. We should enter it and learn more.",
   "hLabel": 1463121120
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback37Header",
   "szText": "Enter the {WORLD:QST_Skov_DiluvianBlade_Cellar}",
   "hLabel": 738582688
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase70Description",
   "szText": "Now that the Drowned are dead, we should try to speak with the ghost again.",
   "hLabel": 219590620
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback69Header",
   "szText": "Approach the ghost",
   "hLabel": 2327828677
  }
 ],
 "ptMapStringTable": "0"
}
