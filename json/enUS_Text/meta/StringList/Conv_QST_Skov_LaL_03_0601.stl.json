 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You're a demon who does not celebrate mortal death?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B56B",
   "szText": "Why would I? Expiration of my audience? Does a farmer favor a famine?",
   "hLabel": 2440888317
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25B56B",
   "szText": "curt, wry, somewhat playful",
   "hLabel": 3786615754
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B56B",
   "szText": "That’s why I separated myself from my kin ages ago. Wanton death and destruction give me little to work with.",
   "hLabel": 1778428351
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B56B",
   "szText": "Sorrow snuffs the flame of foolery.",
   "hLabel": 1115968385
  }
 ],
 "ptMapStringTable": "0"
}
