 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"We have brought what you asked: the killers' eyes.\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.258D43",
   "szText": "The dead do not rise, but their blood is answered.",
   "hLabel": 2439430033
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.258D43",
   "szText": "Flat and hollow - voice drained from previous sobbing and yelling",
   "hLabel": 3785157470
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.258D43",
   "szText": "Our sight is paid in suffering. This trial, when it was whole, was the hardest of the three.",
   "hLabel": 452050135
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.258D43",
   "szText": "Quiet and spent",
   "hLabel": 1797777572
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.258D43",
   "szText": "To surrender what you hold most to the cliffs and sever all earthly ties. For to see is to be untethered from the earth.",
   "hLabel": 4084557465
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.258D43",
   "szText": "Tiredly reciting sacred doctrine",
   "hLabel": 1135317606
  }
 ],
 "ptMapStringTable": "0"
}
