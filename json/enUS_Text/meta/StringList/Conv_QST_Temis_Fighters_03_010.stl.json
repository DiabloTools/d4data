   "szLabel": "MenuLabel",
   "szText": "\"Is Cleon inside?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.221DAD",
   "szText": "Likely, unless he’s already skipped town.",
   "hLabel": 2435622245
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.221DAD",
   "szText": "None of this is Cleon’s fault…but he’s our best shot at getting to Marcellus and stopping these grotesque Morlu fights. We have to arrest him, for the good of Temis.",
   "hLabel": 1773162279
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.221DAD",
   "szText": "If he tries to get past me, I need you to grab him. Let's go.",
   "hLabel": 1110702313
  }
 ],
