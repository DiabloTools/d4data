 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I have a message from the leader of the Úllo Sar. He claims you buried him alive. That you know why he has no name.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCFFD",
   "szText": "Buried alive? No...name...",
   "hLabel": 2457582095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCFFD",
   "szText": "Shock, horror in recognition",
   "hLabel": 3803309532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line6.1DCFFD",
   "szText": "I...can't tell you. I swore an oath. I dare not break it, not until I am sure...",
   "hLabel": 801432180
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir6.1DCFFD",
   "szText": "Hesitant, processing what to do",
   "hLabel": 2147159617
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCFFD",
   "szText": "I must go. Continue the fight while I'm away, and I promise you...we'll find our way clear of this.",
   "hLabel": 4102709527
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1DCFFD",
   "szText": "Brusque, hurried to leave",
   "hLabel": 1153469668
  }
 ],
 "ptMapStringTable": "0"
}
