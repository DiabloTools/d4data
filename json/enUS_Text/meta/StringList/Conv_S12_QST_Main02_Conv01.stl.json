{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S12_QST_Main02_Conv01.stl",
 "__snoID__": 2517910,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I have the blood.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.262312",
   "szText": "Excellent! I'll begin experiments with this immediately.",
   "hLabel": 1835001773
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.262312",
   "szText": "Ah, our next experiment! But in the meantime, I've another task for you. While you were gone, we discovered that a small fragment of the shrine can open a portal. Stepping through that portal should allow a controlled use of the shrine's magic.",
   "hLabel": 2440346871
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.262312",
   "szText": "Explaining what Player must do next. ",
   "hLabel": 3786074308
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.262253",
   "szText": "We haven't even been able to test this. We can't risk such recklessness again!",
   "hLabel": 1777885949
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.262253",
   "szText": "Warning. ",
   "hLabel": 3123613386
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.262312",
   "szText": "This IS the test! Heh, much like the shrine, I am fully confident we will see different results when our friend here attempts it.",
   "hLabel": 1115426939
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.262312",
   "szText": "Emphasis on \"IS\" amd full of confidence. ",
   "hLabel": 2461154376
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.262253",
   "szText": "Wait, you intend for the transformation to happen again?!",
   "hLabel": 543148334
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.262253",
   "szText": "Shocked, emphasis on \"again\" ",
   "hLabel": 2002480795
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.262312",
   "szText": "I intend for our friend to be imbued with the power to resist and defeat Mephisto, who is the true danger we face!",
   "hLabel": 3513196654
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.262312",
   "szText": "Confident, will not be dissuaded. ",
   "hLabel": 677561819
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.262312",
   "szText": "I understand why you're concerned. I'm not ignorant of the danger this magic represents. But you must believe me, I have all of this under control.",
   "hLabel": 3159921705
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.262312",
   "szText": "Softer here. ",
   "hLabel": 324286870
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.262253",
   "szText": "I need...I need some space. Wanderer, please be careful!",
   "hLabel": 2497460783
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.262253",
   "szText": "Almost overcome, must step away. ",
   "hLabel": 3956793244
  }
 ],
 "ptMapStringTable": "0"
}
