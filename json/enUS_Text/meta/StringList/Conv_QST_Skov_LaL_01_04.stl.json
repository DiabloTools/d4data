 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"They're offering the children to someone...or something.\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B56B",
   "szText": "That’s the tale! The brigands who offered children to the sea for promise of luck and riches. The “Zelos.”",
   "hLabel": 2440888317
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25B56B",
   "szText": "epiphany from player's clue",
   "hLabel": 3786615754
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B5D8",
   "szText": "That was just a story to keep children cautious of the sea…right?",
   "hLabel": 1115969861
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25B56B",
   "szText": "Looks like some have taken it to heart…but this tale’s ending has yet to be written. If we are swift, we can see it return to fable.",
   "hLabel": 453508419
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.25B56B",
   "szText": "cold realisation, turning encouraging/supportive",
   "hLabel": 1799235856
  }
 ],
