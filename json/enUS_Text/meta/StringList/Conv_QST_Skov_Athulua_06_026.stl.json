{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_06_026.stl",
 "__snoID__": 2411447,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Is there any hope for Adreona?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "When I last saw my Queen, she was the most afraid I’d ever seen her. Not for herself, but for Skovos.",
   "hLabel": 1222839726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCC9B",
   "szText": "Somber, worried for her Queen",
   "hLabel": 2682172187
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCC9B",
   "szText": "When she died in Temis and “Akarat” brought her back... He became her only answer to the fear.",
   "hLabel": 560379760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1DCC9B",
   "szText": "Somber, worried for her Queen. Bitter on \"Akarat.\"",
   "hLabel": 2019712221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.6D03F",
   "szText": "I should have seen his trickery. I never meant to—",
   "hLabel": 2735940191
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.6D03F",
   "szText": "Bitter regret, apologetic",
   "hLabel": 4081667628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCC9B",
   "szText": "We have all been tricked, including her. But is she lost to us? I don't know.",
   "hLabel": 3530427124
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1DCC9B",
   "szText": "Reassuring, forgiving. Hopeful for Adreona.",
   "hLabel": 694792289
  }
 ],
 "ptMapStringTable": "0"
}
