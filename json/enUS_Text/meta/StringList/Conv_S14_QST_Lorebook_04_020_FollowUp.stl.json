 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"That letter I found...to Brother Jacobin.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "Yeah, I knew him. Thought I did anyway.",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Bitter grief",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27ED42",
   "szText": "They’d wheeled me back to town on a manure cart—Nangari spearhead stuck in my back, spitting, cursing...begging everyone in earshot to just put an end to me.",
   "hLabel": 1780959073
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.27ED42",
   "szText": "Worst day of her life",
   "hLabel": 3126686510
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27ED42",
   "szText": "And up walks Brother Jaco, smiling that smile. “Look Dannica, it’s like you said! Fight for the Light, land in the shite.”",
   "hLabel": 1118499107
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.27ED42",
   "szText": "Bittersweet",
   "hLabel": 2464226544
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.27ED42",
   "szText": "Despite everything, I laughed. He kept me laughing through it all...‘til he left.",
   "hLabel": 456039141
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.27ED42",
   "szText": "Sad, betrayed",
   "hLabel": 1801766578
  }
 ],
 "ptMapStringTable": "0"
}
