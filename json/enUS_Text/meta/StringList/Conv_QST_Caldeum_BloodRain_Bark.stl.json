 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4.Bar",
   "szText": "Blood from the sky...a foul omen if ever there was one.",
   "hLabel": 1929402854
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4.Dru",
   "szText": "The sky is rent open, bleeding...Sanctuary is torn asunder.",
   "hLabel": 1929405596
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4.Nec",
   "szText": "A rain of blood...intriguing. Another piece of the prophecy?",
   "hLabel": 1929416039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4.Rog",
   "szText": "Blood rain...not good. Time’s running out on this job.",
   "hLabel": 1929420729
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.BAE4.Rog",
   "szText": "shaken",
   "hLabel": 2842751686
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4.Sor",
   "szText": "Blood from the sky...no mortal magic holds this power.",
   "hLabel": 1929421829
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4.Spi",
   "szText": "Red sky, bleeding rain. Spirits, guide my steps through this place.",
   "hLabel": 1929421853
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4.Pal",
   "szText": "Blood rain. Is it Heaven crying, or is it Hell?",
   "hLabel": 1929418094
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4.War",
   "szText": "\"Tears of blood.\" Raining on a desert jewel. We're running out of time.",
   "hLabel": 1929425723
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.BAE4.War",
   "szText": "Pensive, grim. Recalling the prophecy, realizing it's coming true.",
   "hLabel": 2842756680
  }
