  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase181Description",
   "szText": "Who is this \"Tyrael\"? He is powerful, beyond doubt...and I've never seen Lorath so happy to see anyone. Questions abound.",
