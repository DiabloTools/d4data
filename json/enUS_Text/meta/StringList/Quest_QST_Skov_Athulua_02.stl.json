   "hLabel": 3347219666
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase186Description",
   "szText": "No sooner had we met Tyrael, when the Drowned attacked us in force. We'll put this stranger to the test.",
