{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Tharra_03_DSQ_150.stl",
 "__snoID__": 2475717,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "[Experience Memory]",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "Rumor has it you met someone, my Queen. A Horadrim. I was hoping we might be introduced.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCC9B",
   "szText": "Younger Tharra. Teasing and probing. ",
   "hLabel": 3140844812
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8FD7",
   "szText": "Hefaetrus below, I don’t comment on everyone you take to bed. It was nothing. He’s gone from Skovos now.",
   "hLabel": 1131116761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1D8FD7",
   "szText": "Hefaetrus = Huh-fay-truss           Young Adreona . Exasperated. Trying to brush her friend off. Doesn't want to admit she cares about the lover Tharra is speaking about.",
   "hLabel": 2476844198
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "I don’t sit here for hours writing letters to nothing. How many drafts has that been?",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "Still trying to be playful",
   "hLabel": 1815924880
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8FD7",
   "szText": "Those are for me alone. I wouldn’t even know where to send them.",
   "hLabel": 4101164125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1D8FD7",
   "szText": "Opening up and being vulnerable. A small pause after “alone”",
   "hLabel": 1151924266
  }
 ],
 "ptMapStringTable": "0"
}
