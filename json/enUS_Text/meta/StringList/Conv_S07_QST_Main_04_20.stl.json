{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_04_20.stl",
 "__snoID__": 2124821,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You can simply ask? Won't that cost you your head?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1FA02A",
   "szText": "I made my oath to the Tree long ago. A child is full of questions... The heads taught me everything I know. Isn’t that right, Azarine?",
   "hLabel": 2459821538
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1FA02A",
   "szText": "Somber.",
   "hLabel": 3805548975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.207D85",
   "szText": "Yes, child.",
   "hLabel": 1108544693
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.207D85",
   "szText": "Flat acknowledgement.",
   "hLabel": 2454272130
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.1FA017",
   "szText": "Ouna... I had no idea.",
   "hLabel": 1556313831
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir10.1FA017",
   "szText": "Shock. Sadness.",
   "hLabel": 3015646292
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1FA02A",
   "szText": "Azarine, can you see the head of your twin, and tell us where he is?",
   "hLabel": 562623957
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1FA02A",
   "szText": "Ignoring Caidin's reaction. Calmly asking Azarine a question.",
   "hLabel": 2021956418
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.207D85",
   "szText": "Hm. He is digging...in sand. Palm trees above. The south sea nearby.",
   "hLabel": 4168774374
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.207D85",
   "szText": "Disjointed. Squinting to see.",
   "hLabel": 1333139539
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1FA017",
   "szText": "Sounds like Kehjistan...maybe round Gea Kul way? Why don't you go there and start the search, wanderer? I'll catch up.",
   "hLabel": 3532671246
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1FA017",
   "szText": "Thinking aloud. Asking for a favor.",
   "hLabel": 697036411
  }
 ],
 "ptMapStringTable": "0"
}
