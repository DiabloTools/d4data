{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Epilogue2_090.stl",
 "__snoID__": 2397716,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2525C5",
   "szText": "Stay away, damn you!",
   "hLabel": 1776704815
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2525C5",
   "szText": "Frightened, hissing. The heads on the Tree of Whispers know what we're about to do--burn it all down--and they don't like it.",
   "hLabel": 3122432252
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25257F",
   "szText": "Lorath made a deal!",
   "hLabel": 1114243446
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.25257F",
   "szText": "Frightened, hissing. The heads on the Tree of Whispers know what we're about to do--burn it all down--and they don't like it.",
   "hLabel": 2459970883
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.8DD12",
   "szText": "You cannot redeem him! He is ours!",
   "hLabel": 673301904
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.8DD12",
   "szText": "Elias, Lorath's former apprentice, speaks from the Tree. He is upset about this turn of events. Condescending.",
   "hLabel": 2536188861
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "Cannot be...redeem...ours...",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.6D03F",
   "szText": "Lorath speaks, but his soul is broken. He is not fully present. Mumbling, drawing the words out.",
   "hLabel": 821729151
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCFFD",
   "szText": "There. There he is.",
   "hLabel": 1222844480
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCFFD",
   "szText": "Tyrael has seen Lorath's head. This line should be heart-broken. It isn't a joyful reunion. More like seeing a beloved friend who has wasted away.",
   "hLabel": 2682176941
  }
 ],
 "ptMapStringTable": "0"
}
