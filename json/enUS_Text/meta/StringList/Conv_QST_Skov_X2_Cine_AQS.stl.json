{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_X2_Cine_AQS.stl",
 "__snoID__": 2270714,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Approach Temis Plaza",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8FD7",
   "szText": "On this day, a pilgrim comes to our shores.",
   "hLabel": 2456036693
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1D8FD7",
   "szText": "delivering a speech. commanding, ceremonial",
   "hLabel": 3801764130
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line109.1D8FD7",
   "szText": "Let him wash in the waters, so that he might prove himself worthy of the sand.",
   "hLabel": 3115445726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir109.1D8FD7",
   "szText": "delivering a speech. commanding, ceremonial",
   "hLabel": 4028776683
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D90EA",
   "szText": "Many of you walked with me through the fires of the mainland. Now, your faith will be rewarded.",
   "hLabel": 1793553933
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1D90EA",
   "szText": "delivering a speech. inspiring ",
   "hLabel": 3139281370
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line107.1D90EA",
   "szText": "The Pools of Creation, the path to a better future, is near! And by the grace of Queen Adreona, we will reach it!",
   "hLabel": 3777882898
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir107.1D90EA",
   "szText": "delivering a speech. inspiring ",
   "hLabel": 396246559
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "Adreona!",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.6D03F",
   "szText": "Adreona.",
   "hLabel": 670873552
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8FD7",
   "szText": "Lorath? Now, of all times?",
   "hLabel": 4101164125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1D8FD7",
   "szText": "a little laugh in her voice, exasperated",
   "hLabel": 1151924266
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1D90EA",
   "szText": "It seems a new pilgrim has joined us!",
   "hLabel": 1221276284
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1D90EA",
   "szText": "to the crowd, placating",
   "hLabel": 2680608745
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "Listen. He’s a demon. The mainland burns because of him.",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.6D03F",
   "szText": "urgent, hushed",
   "hLabel": 1498731690
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1D90EA",
   "szText": "Hm. Lies.",
   "hLabel": 3528863682
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1D90EA",
   "szText": "quiet, only Lorath and Adreona can hear",
   "hLabel": 693228847
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line93.6D03F",
   "szText": "You’re in danger.",
   "hLabel": 1798131685
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1D8FD7",
   "szText": "I don't understand. The people say he’s a saint. What proof do you have?",
   "hLabel": 4191346442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1D8FD7",
   "szText": "wary, considering",
   "hLabel": 1355711607
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.6D03F",
   "szText": "You have my word.",
   "hLabel": 3606844771
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.6D03F",
   "szText": "urgent, certainty by necessity",
   "hLabel": 657604912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1D8FD7",
   "szText": "As a Horadrim?",
   "hLabel": 3175611527
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1D8FD7",
   "szText": "scoffs – she’s heard it before",
   "hLabel": 339976692
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.6D03F",
   "szText": "As someone you once called friend.",
   "hLabel": 4116741566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.6D03F",
   "szText": "desperation mounting",
   "hLabel": 1167501707
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.BD9D3",
   "szText": "That will be enough.",
   "hLabel": 1254767536
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.6D03F",
   "szText": "Heh, afraid I’ll spoil your show?",
   "hLabel": 3785511583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.BD9D3",
   "szText": "Not at all.",
   "hLabel": 2125672116
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.BD9D3",
   "szText": "spoken with a pitying smile",
   "hLabel": 3471399553
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.BD9D3",
   "szText": "I barely knew you existed until today. But now you've stepped onto my stage, and you thought there would be no consequences?",
   "hLabel": 413640758
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line103.6D03F",
   "szText": "(grunts)",
   "hLabel": 3544463917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line80.BD9D3",
   "szText": "You are but a man.",
   "hLabel": 2602116948
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line95.6D03F",
   "szText": "(grunts)",
   "hLabel": 86100327
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.6D03F",
   "szText": "Dammit. (grunts)",
   "hLabel": 2944384805
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.6D03F",
   "szText": "panic rising in his throat. with a sense of finality",
   "hLabel": 4290112242
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line85.BD9D3",
   "szText": "And men are just...",
   "hLabel": 469522201
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line87.BD9D3",
   "szText": "So small.",
   "hLabel": 3052458139
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir87.BD9D3",
   "szText": "growling, almost lascivious",
   "hLabel": 103218280
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line98.6D03F",
   "szText": "(grunts)",
   "hLabel": 3960504234
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.1D90EA",
   "szText": "(gasps)",
   "hLabel": 2789246335
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.1D90EA",
   "szText": "(gasps, gurgles)",
   "hLabel": 2126786369
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.1D90EA",
   "szText": "Oh, Lorath.",
   "hLabel": 801866437
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.1D90EA",
   "szText": "softly",
   "hLabel": 2261198898
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line49.1D8FD7",
   "szText": "(exhales)",
   "hLabel": 139429265
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir49.1D8FD7",
   "szText": "dying, her last labored breath",
   "hLabel": 1598761726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line78.6D03F",
   "szText": "No...",
   "hLabel": 327996904
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir78.6D03F",
   "szText": "pure horror. he desperately doesn't want to believe what he's seeing",
   "hLabel": 1673724341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line51.1D90EA",
   "szText": "Enough!",
   "hLabel": 448591488
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir51.1D90EA",
   "szText": "booming, voice of god",
   "hLabel": 1907923949
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line53.1D90EA",
   "szText": "I have brought blood to this city. Blood. And hate.",
   "hLabel": 4081098818
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir53.1D90EA",
   "szText": "genuine heartbreak. a tidal wave of sorrow",
   "hLabel": 1245463983
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line55.1D90EA",
   "szText": "No more.",
   "hLabel": 3418638852
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir55.1D90EA",
   "szText": "to Adreona's body, remorseful",
   "hLabel": 583004017
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line57.1D8FD7",
   "szText": "(gasps, breathing)",
   "hLabel": 2756201680
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir57.1D8FD7",
   "szText": "back from death, gulping down air",
   "hLabel": 4215534141
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line59.1D8FD7",
   "szText": "You–",
   "hLabel": 2093741714
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir59.1D8FD7",
   "szText": "shivering",
   "hLabel": 3553074175
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line61.1D8FD7",
   "szText": "You really are what they say.",
   "hLabel": 2402926731
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir61.1D8FD7",
   "szText": "whispered, shocked, almost a question – she's reevaluating Akarat's character",
   "hLabel": 3862259192
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line63.1D90EA",
   "szText": "Show mercy.",
   "hLabel": 1740443971
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir63.1D90EA",
   "szText": "to Adreona, softly",
   "hLabel": 3199776432
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line65.1D90EA",
   "szText": "We must all show mercy!",
   "hLabel": 1077984005
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir65.1D90EA",
   "szText": "to the crowd",
   "hLabel": 2537316466
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line71.1D90EA",
   "szText": "My Queen, let him walk free, so that all who look upon him will be reminded of what hate can do.",
   "hLabel": 62249090
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir71.1D90EA",
   "szText": "to the crowd",
   "hLabel": 1521581551
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line74.1D90EA",
   "szText": "It is in our nature to hate.",
   "hLabel": 3363526437
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line69.BAE4",
   "szText": "Lorath...",
   "hLabel": 4095357921
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir69.BAE4",
   "szText": "concerned",
   "hLabel": 1663277582
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line105.1D90EA",
   "szText": "And that is why I've brought you here! To change that nature!",
   "hLabel": 145375568
  }
 ],
 "ptMapStringTable": "0"
}
