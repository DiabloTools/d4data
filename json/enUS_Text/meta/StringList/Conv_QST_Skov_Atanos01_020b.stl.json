{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Atanos01_020b.stl",
 "__snoID__": 2481217,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"My heart is eager for the truth.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1D90EA",
   "szText": "And yet, you stand here in a lie.",
   "hLabel": 2866403716
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1D90EA",
   "szText": "Turning serious, cold.",
   "hLabel": 30768881
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1D90EA",
   "szText": "These good people look upon you and see a human, like them—blind to the evil that you hide within. Blind to her.",
   "hLabel": 3175588733
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1D90EA",
   "szText": "Terse, cold, passing judgment",
   "hLabel": 339953898
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1D90EA",
   "szText": "It is she who slaughtered the Fractured Peaks, burned Scosglen, bled Caldeum, corrupted blessed Nahantu!",
   "hLabel": 2513128767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1D90EA",
   "szText": "Mounting outrage",
   "hLabel": 3972461228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1D90EA",
   "szText": "Let the truth be revealed.",
   "hLabel": 1850668801
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.1D90EA",
   "szText": "Cold, solemn, about to seize the demon (Lilith) inside Player.",
   "hLabel": 3310001262
  }
 ],
 "ptMapStringTable": "0"
}
