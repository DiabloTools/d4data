 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.22B189",
   "szText": "If we travel to the south, we can work our way through the backstreets.",
   "hLabel": 4082453655
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.228AA8",
   "szText": "You know Skovos well. Is there anywhere else I should visit?",
   "hLabel": 538672912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.22B189",
   "szText": "Are you a sightseer or a pilgrim?",
   "hLabel": 1202588608
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.228AA8",
   "szText": "(chuckles) Can’t I be both?",
   "hLabel": 3508720276
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.228AA8",
   "szText": "Playful",
   "hLabel": 673085441
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.22B189",
   "szText": "Well, the Temples are something to behold. I visited the Temple of Life once, when I was only a girl. I still remember the smell of the forest.  Like a perfume.",
   "hLabel": 4172635972
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.22B189",
   "szText": "Reminiscing",
   "hLabel": 1337001137
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.228AA8",
   "szText": "The Temple of Life... I’ll make sure I see it too, my friend.",
   "hLabel": 2846260310
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.228AA8",
   "szText": "Partly to self, comitting it to memory, genuine, kind",
   "hLabel": 10625475
  }
 ],
 "ptMapStringTable": "0"
}
