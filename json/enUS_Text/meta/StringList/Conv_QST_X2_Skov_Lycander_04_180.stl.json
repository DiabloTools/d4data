   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You don't really believe Akarat is who he says he is. Right?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCC9B",
   "szText": "A mainlander comes to Skovos, leading a tour of starving zealots? I’d thought him a swindler of the highest order.",
   "hLabel": 2457577341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCC9B",
   "szText": "bristling",
   "hLabel": 3803304778
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "But then I saw him wrench the Queen back from the arms of the dead.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCC9B",
   "szText": "Forget belief. I’ll rest on facts, for now.",
   "hLabel": 1132657409
  }
 ],
