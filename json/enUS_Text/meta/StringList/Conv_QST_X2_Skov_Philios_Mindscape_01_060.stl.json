   "hLabel": 2096896017
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line42.BD31C",
   "szText": "Listen close, for I shall not say this again.",
   "hLabel": 2214997353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line44.BD31C",
   "szText": "Without me, you have nothing. No armies. No allies. You will accept what I offer, and you will obey my word. Because you must.",
   "hLabel": 502965995
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line46.BAE4.Bar",
   "szText": "And you expect me to—",
   "hLabel": 86312383
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir46.BAE4.Bar",
   "szText": "exasperated",
   "hLabel": 161462892
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line46.BAE4.Dru",
   "szText": "(scoffs) And you expect me to—",
   "hLabel": 86315125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line46.BAE4.Nec",
   "szText": "(scoffs) And you expect me to—",
   "hLabel": 86325568
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line46.BAE4.Pal",
   "szText": "(scoffs) And you expect me to—",
   "hLabel": 86327623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line46.BAE4.Rog",
   "szText": "(scoffs) And you expect me to—",
   "hLabel": 86330258
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line46.BAE4.Sor",
   "szText": "(scoffs) And you expect me to—",
   "hLabel": 86331358
