   "szLabel": "name",
   "szText": "Wind Shear",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{if:SF_25}{c_label}Spirit Cost: {/c}{c_resource}{Resource Cost}{/c}\r\n{/if}{c_label}Generate Spirit:{/c_label} {c_resource}{SF_5}{/c_resource}\r\n{if:ADVANCED_TOOLTIP}{c_label}Lucky Hit Chance: {/c}{c_resource}[{Combat Effect Chance}|%|]{/c}\r\n{/if}Conjure a piercing blade of wind, dealing {c_number}{Payload:DAMAGE}{/c} damage to enemies hit.",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": "\r\n{icon:bullet,1.2} Damage {icon:arrow,1.2} {c_number}{payload:DAMAGE}{/c}",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod0_Description",
   "szText": "{c_important}Wind Shear{/c} returns to you and deals {c_number}[SF_39 * 100]%{/c} bonus damage to enemies already hit by this {c_important}Wind Shear{/c}.",
   "hLabel": 3591940403
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod0_Name",
   "szText": "Boomerang",
   "hLabel": 2452871472
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Description",
   "szText": "Launch {c_number}2{/c} additional projectiles that deal {c_number}{payload:UPGRADEB_DAMAGE}{/c} damage. Additionally, you gain a {c_number}[SF_40*100|+%|]{/c} Movement Speed bonus for {c_number}[SF_44]{/c} seconds after casting.",
   "hLabel": 628601524
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Name",
   "szText": "Wind Swept",
   "hLabel": 2492006865
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod7_Description",
   "szText": "{c_important}Wind Shear{/c} automatically seeks enemies and spawns a {c_important}{u}Dancing Bolt{/u}{/c} when it hits an enemy dealing {c_number}{payload:UPGRADEC_DANCINGBOLT_DAMAGE}{/c}. {c_important}Wind Shear{/c} may only hit {c_number}[SF_32]{/c} targets and may hit the same target.",
   "hLabel": 28437434
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod7_Name",
   "szText": "Solar Wind",
   "hLabel": 2726819223
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod8_Description",
   "szText": "{c_important}Wind Shear{/c} restores {c_resource}[SF_7]{/c} Spirit each time it hits an enemy.",
   "hLabel": 1360065851
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod8_Name",
   "szText": "Spirit",
   "hLabel": 2765954616
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod10_Description",
   "szText": "{c_important}Wind Shear{/c} grants a {c_important}{u}Barrier{/u}{/c} for {c_number}[SF_10 * 100]%{/c} of your Maximum Life for each enemy hit up to a maximum of {c_number}[SF_12*100|%|]{/c}.",
