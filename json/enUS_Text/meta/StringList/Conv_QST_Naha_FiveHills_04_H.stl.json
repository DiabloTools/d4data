{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Naha_FiveHills_04_H.stl",
 "__snoID__": 1653773,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Ney Leaves Eru Alive",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.6DE47",
   "szText": "Oh, Eru.  He picked a fight he knew he wouldn’t win. Bringing Mephisto into the Vault nearly killed him.",
   "hLabel": 2735997894
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.6DE47",
   "szText": "And when it didn’t, he asked us to finish him. To end his pain.",
   "hLabel": 1023966536
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4.Bar",
   "szText": "You’re sure this is the right move? Letting him go.",
   "hLabel": 2065005608
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4.Dru",
   "szText": "You’re sure this is the right move? Letting him go.",
   "hLabel": 2065008350
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4.Pal",
   "szText": "Don't you think he should face justice for what he did?",
   "hLabel": 2065020848
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4.Nec",
   "szText": "You’re sure this is the right move? Letting him go.",
   "hLabel": 2065018793
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4.Rog",
   "szText": "You’re sure this is the right move? Letting him go.",
   "hLabel": 2065023483
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4.Sor",
   "szText": "You’re sure this is the right move? Letting him go.",
   "hLabel": 2065024583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4.Spi",
   "szText": "You’re sure this is the right move? Letting him go.",
   "hLabel": 2065024607
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4.War",
   "szText": "Don't you think we should?",
   "hLabel": 2065028477
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.BAE4.War",
   "szText": "Unsure. Kind of wants to kill Eru.",
   "hLabel": 2978359434
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6DE47",
   "szText": "I...know how it feels. To carry the guilt of hurting someone. And I know too well what it’s like to wrestle with the Lord of Hatred. Eru made the only choice he thought he could.",
   "hLabel": 1512058033
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.6DE47",
   "szText": "It’s infuriating. It’s crushing. But he’s already done the worst he can do to us.",
   "hLabel": 670931255
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6DE47",
   "szText": "Let him wrestle with himself, now. It’s what Akarat would want. If we kill him, we rob him of the choice to be better.",
   "hLabel": 3253867193
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6DE47",
   "szText": "It’s time we returned to the Horadric Vault. It might have something, anything that could help us against Mephisto.",
   "hLabel": 1865093314
  }
 ],
 "ptMapStringTable": "0"
}
