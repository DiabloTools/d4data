   "szLabel": "Toast",
   "szText": "A wayward miner sows chaos in Skartara. Is it madness or something more?",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "Maera in Fool's Quarry is in need of assistance with a delicate matter. She won't share the details out in the open.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback7Header",
   "szText": "Enter the Ramshackle Depot",
   "hLabel": 2677071405
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase10Description",
   "szText": "Korax has likely gone into hiding in the mine where he has staked his claim. I'll need to find it. ",
   "hLabel": 819754710
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback9Header",
