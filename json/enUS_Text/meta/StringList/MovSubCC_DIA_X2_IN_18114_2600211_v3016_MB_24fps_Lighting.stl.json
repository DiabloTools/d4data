  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0008",
   "szText": "{56333-62433}[Mephisto] All those who touch the stone\r\nmeet the same fate.",
   "hLabel": 1778888
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0009",
   "szText": "{62500-64433}[Neyrelle] No! No.",
   "hLabel": 1778889
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0010",
   "szText": "{65167-67000}I need more time!",
   "hLabel": 1778913
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0011",
   "szText": "{67800-69467}[coughs]",
   "hLabel": 1778914
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0012",
   "szText": "{69533-71533}[panting shakily]",
   "hLabel": 1778915
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0013",
   "szText": "{72400-74033}[birds cooing]",
   "hLabel": 1778916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0014",
   "szText": "{82533-84533}I just need more time.",
   "hLabel": 1778917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0015",
   "szText": "{86900-87933}-[Akarat] Time?\r\n-[gasps]",
   "hLabel": 1778918
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0016",
   "szText": "{89333-92833}Nothing in those scrolls\r\nwill save you, Neyrelle.",
   "hLabel": 1778919
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0017",
   "szText": "{92900-94533}[footsteps approaching]",
   "hLabel": 1778920
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0018",
   "szText": "{94600-95733}But I can.",
   "hLabel": 1778921
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0019",
   "szText": "{95800-97133}[wings flapping]",
   "hLabel": 1778922
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0020",
   "szText": "{98333-100400}I want nothing from you.",
   "hLabel": 1778946
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0021",
   "szText": "{100467-101500}[coughs]",
   "hLabel": 1778947
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0022",
   "szText": "{102500-103767}[sighs]",
   "hLabel": 1778948
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0023",
   "szText": "{103833-106133}You've seen what awaits.",
   "hLabel": 1778949
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0024",
   "szText": "{106200-108200}You are a part of me.",
   "hLabel": 1778950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0025",
   "szText": "{109100-111733}But I can make better use of you.",
   "hLabel": 1778951
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0026",
   "szText": "{111800-114433}I have seen what awaits.",
   "hLabel": 1778952
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0027",
   "szText": "{114500-115500}I will stop you!",
   "hLabel": 1778953
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0028",
   "szText": "{115567-116533}[grunts]",
   "hLabel": 1778954
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0029",
   "szText": "{116600-118067}[Akarat] I am untouchable.",
   "hLabel": 1778955
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0030",
   "szText": "{118133-120133}[Neyrelle whimpers]",
   "hLabel": 1778979
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0031",
   "szText": "{125800-128733}[Mephisto] You think you have power here?",
   "hLabel": 1778980
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0032",
   "szText": "{129300-131700}[Neyrelle gasps] No, no, no, no, no!",
   "hLabel": 1778981
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0033",
   "szText": "{131767-133367}[screams]",
   "hLabel": 1778982
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0034",
   "szText": "{134167-135167}[groans]",
   "hLabel": 1778983
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0035",
   "szText": "{135233-138200}[Akarat] I could do this\r\nfor an eternity, Neyrelle.",
   "hLabel": 1778984
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0036",
   "szText": "{139233-141767}I don't see that you have a choice,",
   "hLabel": 1778985
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0037",
   "szText": "{142267-145567}but I'd like you to say yes.",
   "hLabel": 1778986
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0038",
   "szText": "{151400-152400}You're right.",
   "hLabel": 1778987
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0039",
   "szText": "{152467-155933}[chuckles wryly] I am a part of you.",
   "hLabel": 1778988
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0040",
   "szText": "{156633-158633}I was trapped in your mind.",
   "hLabel": 1779012
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0041",
   "szText": "{159967-161500}You dream.",
   "hLabel": 1779013
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0042",
   "szText": "{162733-164233}And when you do,",
   "hLabel": 1779014
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0043",
   "szText": "{164300-168667}an ocean of twisted horrors\r\nfloods your mind.",
   "hLabel": 1779015
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0044",
   "szText": "{169667-172833}I saw the sun blotted from the sky.",
   "hLabel": 1779016
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0045",
   "szText": "{173767-178067}And the darker it got,\r\nthe brighter the rage of man burned.",
   "hLabel": 1779017
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0046",
   "szText": "{179233-180967}Hatred would reign.",
   "hLabel": 1779018
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0047",
   "szText": "{182333-184000}I was lost.",
   "hLabel": 1779019
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0048",
   "szText": "{185167-187767}But in that chaos,",
   "hLabel": 1779020
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0049",
   "szText": "{187833-190767}I found your greatest fear.",
   "hLabel": 1779021
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0050",
   "szText": "{190833-193367}And I will tell everyone.",
   "hLabel": 1779045
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0051",
   "szText": "{193433-197833}[Akarat] Oh, child,\r\nwhat could I possibly fear?",
   "hLabel": 1779046
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0052",
   "szText": "{199200-201700}\"And the weak were made strong.",
   "hLabel": 1779047
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0053",
   "szText": "{202300-204767}The pack of lambs would feast\r\non their shepherd.\"",
   "hLabel": 1779048
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0054",
   "szText": "{204833-206367}The Prophecy?",
   "hLabel": 1779049
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0055",
   "szText": "{206867-208533}Oh, be careful, little one.",
   "hLabel": 1779050
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0056",
   "szText": "{208600-211900}\"Then comes a spear of light,\r\npiercing Hatred's heart.\"",
   "hLabel": 1779051
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0057",
   "szText": "{211967-214833}-No.\r\n-\"Raised to the ground by a murdered son.\"",
   "hLabel": 1779052
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0058",
   "szText": "{214900-217733}-Stop. Stop!\r\n-[Neyrelle reciting indistinctly]",
   "hLabel": 1779053
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0059",
   "szText": "{217800-219567}I command you!",
   "hLabel": 1779054
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0060",
   "szText": "{219633-220933}[wings flapping]",
   "hLabel": 1779078
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0061",
   "szText": "{231200-233967}You could have been so much more.",
   "hLabel": 1779079
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0062",
   "szText": "{235067-236067}[body thuds]",
   "hLabel": 1779080
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0063",
   "szText": "{240433-241433}[Akarat scoffs]",
   "hLabel": 1779081
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0064",
   "szText": "{246633-248067}[paper rustles]",
   "hLabel": 1779082
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0065",
   "szText": "{251433-253100}[suspenseful music]",
   "hLabel": 1779083
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0066",
   "szText": "{253967-256233}Oh, what have you done?",
   "hLabel": 1779084
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0067",
   "szText": "{256300-258267}[menacing music glitching]",
   "hLabel": 1779085
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0068",
   "szText": "{259400-260767}What have you done?",
   "hLabel": 1779086
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0069",
   "szText": "{263667-265667}[suspenseful music builds]",
   "hLabel": 1779087
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0070",
   "szText": "{267067-268067}[exhales]",
   "hLabel": 1779111
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0071",
   "szText": "{272167-273833}Let them come.",
   "hLabel": 1779112
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0072",
   "szText": "{273900-275900}[menacing music]",
   "hLabel": 1779113
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0073",
   "szText": "{282967-285300}[Mephisto] Let them rise up,",
   "hLabel": 1779114
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0074",
   "szText": "{285367-288700}feeding the flames of unrest.",
   "hLabel": 1779115
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0075",
   "szText": "{288767-290133}[wings flapping]",
   "hLabel": 1779116
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0076",
   "szText": "{292167-294167}It will not matter.",
   "hLabel": 1779117
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "0077",
