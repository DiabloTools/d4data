 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Approach the Shelter",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BD31C",
   "szText": "My father is bound to you through me.",
   "hLabel": 2435088632
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.BD31C",
   "szText": "sharp, with urgency",
   "hLabel": 3008293
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.BD31C",
   "szText": "If you are to live...",
   "hLabel": 723057274
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BD31C",
   "szText": "...you must sever the bond.",
   "hLabel": 3305993212
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.BD31C",
   "szText": "I gave my children a world, and the strength to make it their own.",
   "hLabel": 1254759367
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.BD31C",
   "szText": "soft, contemplative",
   "hLabel": 2600486804
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.BD31C",
   "szText": "And all I have to show for it...",
   "hLabel": 205187975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.BD31C",
   "szText": "...is you.",
   "hLabel": 3837695305
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.BD31C",
   "szText": "with venom",
   "hLabel": 888455446
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.BD31C",
   "szText": "Fight!",
   "hLabel": 2996568527
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4",
   "szText": "(gasps)",
   "hLabel": 1776443800
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4",
   "szText": "(grunts, surprised)",
   "hLabel": 1854714586
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.BD31C",
   "szText": "Sever the bond!",
   "hLabel": 2125663947
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4",
   "szText": "(grunts with effort)",
   "hLabel": 1932985372
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4",
   "szText": "(roars)",
   "hLabel": 2911370197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.BD31C",
   "szText": "(gasps)",
   "hLabel": 3506465322
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.BD31C",
   "szText": "Lilith's just been stabbed.",
   "hLabel": 557225463
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BD31C",
   "szText": "Take your birthright...",
   "hLabel": 4168925288
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.BD31C",
   "szText": "sharp, a call to action",
   "hLabel": 1219685429
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.BD31C",
   "szText": "...and make this Sanctuary yours.",
   "hLabel": 2456893930
  }
 ],
 "ptMapStringTable": "0"
}
