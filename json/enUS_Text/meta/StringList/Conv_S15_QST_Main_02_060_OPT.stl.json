 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why would Tal Rasha go to the Fractured Peaks?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27B44D",
   "szText": "Of our three dark wanderers, Tal Rasha is the only one who knew the risks of containing a Prime Evil within himself. He prepared as thoroughly as any mortal could.",
   "hLabel": 2443259006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27B44D",
   "szText": "Deeply respects Tal Rasha.",
   "hLabel": 3788986443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27B44D",
   "szText": "Perhaps his soul remains strong, seeking the Horadrim in effort to contain Baal’s evil? Or perhaps Baal simply drives him to aimless destruction?",
   "hLabel": 1780799040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.27B44D",
   "szText": "Describing a half-remembered nightmare",
   "hLabel": 3126526477
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27B44D",
   "szText": "Whatever the case, Tal Rasha must be stopped. We owe him that much.",
   "hLabel": 1118339074
  }
 ],
 "ptMapStringTable": "0"
}
