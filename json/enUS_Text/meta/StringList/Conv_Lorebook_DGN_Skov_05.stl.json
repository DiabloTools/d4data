   "szLabel": "DisembodiedVoice",
   "szText": "Seer's Report",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.228085",
   "szText": "\"The hatred here is beyond ancient. Faint, until I laid my hands on the soil disturbed by the woodsmen. Then upon me came a vision of blood. A massacre of hundreds, all demons, felled by one of their own kind. A female.",
   "hLabel": 2435815776
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.228085",
   "szText": "Deadly serious, ominous.",
   "hLabel": 3781543213
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.228085",
   "szText": "Their rage for her taints every living thing in these woods. Warnings must be posted.\" – Nyria",
   "hLabel": 1773355810
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.228085",
   "szText": "Deadly serious, ominous. Emphasis on \"her\"",
