 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What is this device?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.21FCD5",
   "szText": "Not entirely sure. Seems Horadric. See here, there was a ward placed on it, once. Lapsed, now. Should’ve guessed the Order was involved.",
   "hLabel": 2436339948
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.21FCD5",
   "szText": "Whatever it is, it’s...tugging. Like it’s trying to show me something.",
   "hLabel": 117730067
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.B79B1",
   "szText": "(screams)",
   "hLabel": 624142300
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line6.21FCD5",
   "szText": "Ach. Another wounded. I’ll see if I can find them. Take this device in the meantime—maybe it’ll lead you to the source of the demons.",
   "hLabel": 780190033
  }
 ],
 "ptMapStringTable": "0"
}
