   "szLabel": "MenuLabel",
   "szText": "\"What is this place?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.244C6E",
   "szText": "It bears no history, no song, no stone. It is nowhere important. Just a hole deep enough to place bodies.",
   "hLabel": 872131793
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir12.244C6E",
