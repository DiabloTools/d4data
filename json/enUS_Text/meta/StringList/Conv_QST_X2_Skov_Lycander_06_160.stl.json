 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"We can't let Mephisto slow us down any more.\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6D03F",
   "szText": "You're right. No use sulking.",
   "hLabel": 1512000330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "The Queen needs to know.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "You think she’ll listen?",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "To you? No. To me?",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCC9B",
   "szText": "She has to.",
   "hLabel": 4102704773
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "In the meanwhile, if what you seek can kill that thing, then you’ll have my aid in finding it.",
   "hLabel": 1222839726
  }
 ],
 "ptMapStringTable": "0"
}
