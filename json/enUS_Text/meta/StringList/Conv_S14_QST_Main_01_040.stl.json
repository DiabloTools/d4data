{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S14_QST_Main_01_040.stl",
 "__snoID__": 2623673,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Who wrote this? Who are the Úllo Sar?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "No idea! But their cheery tidings are plastered all over town. All over every town, what I hear, and it ain’t just talk.",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Despair, worry",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line18.27ED42",
   "szText": "Folk are disappearing. Suppers uneaten, candles burned down... They just walked off into the night to do Light-knows-what, but the Crusaders of Zakarum couldn't give a wet shite!",
   "hLabel": 3185038839
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir18.27ED42",
   "szText": "Grim, worried, then frustrated and loud for the Crusaders to hear.",
   "hLabel": 349404004
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line20.27ED42",
   "szText": "So saddle my horse! Fetch me my steel! I’ll find them lost souls and knock the faith back into them.",
   "hLabel": 3494223856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir20.27ED42",
   "szText": "Mocking her own anger, deflating",
   "hLabel": 658589021
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line22.27ED42",
   "szText": "Second thought, why don’t you go?",
   "hLabel": 2831763890
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir22.27ED42",
   "szText": "Suddenly drained",
   "hLabel": 4291096351
  }
 ],
 "ptMapStringTable": "0"
}
