  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What has happened?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1F9FF1",
   "szText": "The head from Ouna’s den, it said she hides in the Wastes! I told Caidin we needed to prepare to face her, but the fool ran off without me!",
   "hLabel": 2458444532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1F9FF1",
   "szText": "Heart racing. Urgent. Stress.",
   "hLabel": 3804171969
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1F9FF1",
   "szText": "We must get to the Wastes! Now!",
   "hLabel": 1795984566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1F9FF1",
   "szText": "Terse. Urgent. Let's go!",
   "hLabel": 3141712003
  }
 ],
