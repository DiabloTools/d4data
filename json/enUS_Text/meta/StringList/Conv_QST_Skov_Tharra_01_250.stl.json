   "szLabel": "Line9.246535",
   "szText": "Captain... (dying breath)",
   "hLabel": 4083248456
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.246535",
   "szText": "Gasping and raw. Dies while saying this line.",
   "hLabel": 1134008597
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "I'm here, sister, I’m here.",
   "hLabel": 1222839726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCC9B",
   "szText": "Breathless (post combat) and urgent. Running over to help, then pauses once Tharra realizes she is dead.",
   "hLabel": 2682172187
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCC9B",
   "szText": "You fought well. Your spirit will find its way to our foremothers.",
   "hLabel": 4192887090
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1DCC9B",
   "szText": "Somber. Quiet. ",
   "hLabel": 1357252255
  }
 ],
