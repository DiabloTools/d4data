{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Prologue00_0034.stl",
 "__snoID__": 2326175,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"It's time for some answers, Lorath.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BAE4",
   "szText": "What is this place?",
   "hLabel": 3718003623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.BAE4",
   "szText": "On edge, desperate. We know something is wrong--something bad has happened to Neyrelle. But this is a new, unfamiliar environment. Subtext is: why was Neyrelle here?",
   "hLabel": 650842164
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "An old Kehjistani archive. Neyrelle found something here. A lead. A way to stop Mephisto. To “break the cycle.”",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.6D03F",
   "szText": "Somber. He knows he will have to deliver bad news soon. ",
   "hLabel": 1662855929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6D03F",
   "szText": "That’s how she put it in her letter.",
   "hLabel": 1512000330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.6D03F",
   "szText": "Voice cracking",
   "hLabel": 3374887287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.6D03F",
   "szText": "I came here as fast as I could. I thought I’d find her huddled over scrolls, but...",
   "hLabel": 670873552
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.6D03F",
   "szText": "Pick-up: more of voice cracking, he's on the verge of tears.",
   "hLabel": 2533760509
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "She's dead.",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.6D03F",
   "szText": "Pick-up: more of voice cracking, he's on the verge of tears.",
   "hLabel": 821729151
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4",
   "szText": "Dead? What—what happened?",
   "hLabel": 1776443800
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.BAE4",
   "szText": "Grasping for words. Disbelief, shock",
   "hLabel": 3639330757
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "He got to her. He took her from us.",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.6D03F",
   "szText": "Pick-up: more of voice cracking, he's on the verge of tears.",
   "hLabel": 1498731690
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "I’ve, uh, said my goodbyes. It’s your turn now. Go on.",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.6D03F",
   "szText": "Pick-up: more of voice cracking, he's on the verge of tears.",
   "hLabel": 3210763048
  }
 ],
 "ptMapStringTable": "0"
}
