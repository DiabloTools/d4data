   "szLabel": "MenuLabel",
   "szText": "Inspect",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Horadric Librarian",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22B55C",
   "szText": "“Here lie the ruins of Ahb Bukeir, the City of Walking Dunes.\"",
   "hLabel": 2437330522
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.22B55C",
   "szText": "The monument from which this piece came commemorated the Order’s first real success—the first sealing of a Prime Evil.",
   "hLabel": 1112410590
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.22B55C",
   "szText": "But it also mourned our first failure. For Mephisto’s capture leveled a city and killed thousands.",
   "hLabel": 449950624
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.22B55C",
   "szText": "Tal Rasha had this made to remind us that Sanctuary has no future if we do not tend to her present. The sand has since swallowed the city’s ruins.",
   "hLabel": 4082457954
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.22B55C",
   "szText": "I will see that we remember.",
   "hLabel": 1202592907
  }
 ],
 "ptMapStringTable": "0"
}
