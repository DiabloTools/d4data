   "szLabel": "MenuLabel",
   "szText": "\"Tell us everything and this ends.\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25A12C",
   "szText": "You shall know me by my fruits. I have taken these lost, motherless lambs and given them purpose. By your hands a throne was left unguarded. Many shall labor to fill it.",
