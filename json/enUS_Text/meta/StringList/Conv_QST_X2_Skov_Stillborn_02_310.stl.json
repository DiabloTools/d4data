  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25A12C",
   "szText": "Go to the Birthing Pit by the ocean. Close to the city that wears a crown of spires shall the birth-cry be heard.",
