 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"It's not safe here, you should go.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24044B",
   "szText": "I can't \"go,\" I have to tend the grounds! Like my father before me, and his father, and his father...",
   "hLabel": 2437904391
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24044B",
   "szText": "Mildly offended. Proud.",
   "hLabel": 3783631828
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24044B",
   "szText": "(scoffs) Fifteen generations of pig-headed gardeners. I can't let it end with me.",
   "hLabel": 1775444425
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24044B",
   "szText": "Scoffing. Summoning the courage to keep going.",
   "hLabel": 3121171862
  }
 ],
 "ptMapStringTable": "0"
}
