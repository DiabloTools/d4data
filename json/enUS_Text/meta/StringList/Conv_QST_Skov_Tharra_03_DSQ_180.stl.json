{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Tharra_03_DSQ_180.stl",
 "__snoID__": 2475728,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCC9B",
   "szText": "But I didn’t challenge her when it mattered.  She was a bull, and I decided a long time ago it was easier to let her exhaust herself.",
   "hLabel": 2457577341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCC9B",
   "szText": "Start resigned and rueful, then tighten into clipped, self-directed anger. Harsh emphasis on “easier,”",
   "hLabel": 3803304778
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "I called it loyalty.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCC9B",
   "szText": "Anger drains into quiet, embarrassed resignation. Softer, like a whispered admission",
   "hLabel": 3140844812
  }
 ],
 "ptMapStringTable": "0"
}
