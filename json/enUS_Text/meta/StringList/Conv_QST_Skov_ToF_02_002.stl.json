 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How did Mikkos create a fate urn?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.235BFC",
   "szText": "He’s always trying to mimic me. He’d be my shadow if his arms only reached far enough. (chuckle)",
   "hLabel": 2436949900
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.235BFC",
   "szText": "reminiscing, trying to stay positive",
   "hLabel": 3782677337
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.235BFC",
   "szText": "It was foolish to think he wouldn’t follow us.",
   "hLabel": 449570002
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.235BFC",
   "szText": "sombre, regretful",
   "hLabel": 1795297439
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.235C4A",
   "szText": "I’m sorry, Rhea. I tried to look inside the urn, but cut my finger on the stone. It was just a drop.",
   "hLabel": 4082076769
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.235C4A",
   "szText": "I tried to clean it up, but it was gone.",
   "hLabel": 1202211722
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.235BFC",
   "szText": "Hush, lamb. You did nothing wrong.",
   "hLabel": 539752319
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.235BFC",
   "szText": "soothing",
   "hLabel": 1999084780
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.235BFC",
   "szText": "It was our fault...my fault for going to that place.",
   "hLabel": 4172259649
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.235BFC",
   "szText": "cold, blaming self",
   "hLabel": 1336624814
  }
 ],
 "ptMapStringTable": "0"
}
