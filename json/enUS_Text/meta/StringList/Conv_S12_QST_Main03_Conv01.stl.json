 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"This is not the way.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.262312",
   "szText": "The secret was your blood.",
   "hLabel": 2440346871
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.262312",
   "szText": "Dismissing Player's surprise. ",
   "hLabel": 3786074308
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.262312",
   "szText": "(chuckles) Oh, don't look so surprised. I told you. I'm exceptionally well-informed.",
   "hLabel": 1115426939
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.262312",
   "szText": "Dismissing Player's surprise. ",
   "hLabel": 2461154376
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.262312",
   "szText": "After observing the stability of your last transformation, I knew we possessed all of the necessary pieces.",
   "hLabel": 452966973
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.262312",
   "szText": "I transfused the demon blood you brought me with my own. I have even more demonic blood flowing through my veins than you do, my friend.",
   "hLabel": 1777886905
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.262312",
   "szText": "(laughs) Now I have the same capacity—no, a greater capacity—for this demonic power. I'll be able to stand against the full force of the Burning Hells!",
   "hLabel": 4085474303
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.262312",
   "szText": "Excited at end, maybe too much so. ",
   "hLabel": 1136234444
  }
 ],
 "ptMapStringTable": "0"
}
