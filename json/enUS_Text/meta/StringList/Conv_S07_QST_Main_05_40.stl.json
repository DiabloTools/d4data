   "szLabel": "Line11.1F9FF1",
   "szText": "Ouna! What have you done?!",
   "hLabel": 1223706917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1F9FF1",
   "szText": "Shock. Horror. ",
