  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1FA017",
   "szText": "I--I have to stop her!",
   "hLabel": 4104948895
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1FA017",
   "szText": "Panic. Desperation.",
   "hLabel": 1155709036
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1F9FF1",
   "szText": "Caidin, get back here, damn you!",
   "hLabel": 561246951
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1F9FF1",
   "szText": "Barking command. Furious. Shouting after Caidin running away.",
   "hLabel": 2020579412
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line16.1F9FF1",
   "szText": "(groans) Help me, wanderer! Cut them down!",
