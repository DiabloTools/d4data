 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What were the first Horadrim like?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCFFD",
   "szText": "They were the greatest thinkers of their time. But also unruly, unpredictable. I tried to temper them, to point them towards a greater good.",
   "hLabel": 3530431878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1DCFFD",
   "szText": "But...all of that is in the histories. I doubt I could tell you much more.",
   "hLabel": 2867971912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.6D03F",
   "szText": "Never known Tyrael to pass up a good yarn.",
   "hLabel": 1533805628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.6D03F",
   "szText": "mumbled, a little perplexed",
   "hLabel": 2879533065
  }
 ],
 "ptMapStringTable": "0"
}
