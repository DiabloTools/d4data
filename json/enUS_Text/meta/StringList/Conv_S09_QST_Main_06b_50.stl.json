 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"The Druids aren't mad at Bryona?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.229BD8",
   "szText": "Oh, no, they’re furious. But they also know that they were wrong. And they’re not so proud they can’t admit that.",
   "hLabel": 1201170003
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.229BD8",
   "szText": "I’m just glad she didn’t kick the bucket. Thought I was gonna lose her, sour wit and all.",
   "hLabel": 538710037
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.21FCD5",
   "szText": "Ha. You’ll have to try a lot harder than that to get rid of my ribbing.",
   "hLabel": 4081467380
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.229BD8",
   "szText": "Wouldn’t trade it for the world, you old harpy.",
   "hLabel": 4171217367
  }
 ],
 "ptMapStringTable": "0"
}
