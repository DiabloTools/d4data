 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How are the fish biting today?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line38.21C82F",
   "szText": "Ohhh, terrible! I might as well bait the hook with an old sock! (laughs)",
   "hLabel": 2791461111
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir38.21C82F",
   "szText": "Cheerful, content",
   "hLabel": 4250793572
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line40.21C82F",
   "szText": "Ahh, do you know, I completely forgot I was holding the rod? (chuckles) The sea is so lovely today. (inhales) Ahh...",
   "hLabel": 3100646128
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir40.21C82F",
   "szText": "Smiling, content",
   "hLabel": 265011293
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line42.21C82F",
   "szText": "I caught a few, but that thieving cat got them! (chuckles) He's far quicker than he claims...",
   "hLabel": 2438186162
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir42.21C82F",
   "szText": "Cheerful, playful. Admires that little stinker of a cat.",
   "hLabel": 3897518623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.21C82F",
   "szText": "They’ve been biting all day! Although I keep throwing them back, so it might be just one very stupid fish...or very brave, huh?",
   "hLabel": 1444496213
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.21C82F",
   "szText": "Cheerful, playful",
   "hLabel": 2903828674
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line48.21C82F",
   "szText": "Funny thing I’ve learned about fishing...the fish aren’t that important. It’s more about the company.",
   "hLabel": 450806264
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir48.21C82F",
   "szText": "Smiling, content. Glad to see the player.",
   "hLabel": 1910138725
  }
 ],
 "ptMapStringTable": "0"
}
