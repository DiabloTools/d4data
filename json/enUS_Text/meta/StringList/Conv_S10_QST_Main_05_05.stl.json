 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Did the book reveal anything more about the sword?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23AE2D",
   "szText": "I learned that the sword has a spiritual link with Bartuc, a type of curse.",
   "hLabel": 2438532680
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.23AE2D",
   "szText": "I don't know the extent of the connection. But I do know that if I can get close to it, we can use it to find Bartuc.",
   "hLabel": 1113612748
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.23AE2D",
   "szText": "That could be why they want to keep it hidden.",
   "hLabel": 1776072714
  }
 ],
 "ptMapStringTable": "0"
}
