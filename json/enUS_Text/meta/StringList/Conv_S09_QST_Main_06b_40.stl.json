 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Scosglen still bears scars. The Druids need your help.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.21FCD5",
   "szText": "I think I owe them, anyway. For how awfully Hluttred was mangled by that ritual at the Scar. They’ll need another way to clean up Nafain’s blood.",
   "hLabel": 2436339948
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.21FCD5",
   "szText": "Very well. Davish, I’m afraid you’re stuck with me for now.",
   "hLabel": 1111420016
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.229BD8",
   "szText": "I better be! I was afraid I’d have to suffer old Ardreth’s endless mumbling on my own.",
   "hLabel": 1201170003
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.21FCD5",
   "szText": "Perish the thought.",
   "hLabel": 4081467380
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.21FCD5",
   "szText": "dry",
