{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_ToF_02_001.stl",
 "__snoID__": 2359851,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Do you recognize these urns?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8BEB",
   "szText": "The shape is familiar—uncannily so. Yet the old urns were carved in reverence of fate, not scorn.",
   "hLabel": 2456032413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8BEB",
   "szText": "Whoever fashioned these did so with enmity. Blood the paint, hatred the brush.",
   "hLabel": 1131112481
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1D8BEB",
   "szText": "The curse is punishment, mirror to its maker. There is a lesson here.",
   "hLabel": 468652515
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1D8BEB",
   "szText": "contemplative",
   "hLabel": 1814379952
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "The ceremony was performed at the Naos of Fate, a long forgotten reliquary of fates.",
   "hLabel": 4101159845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1D8BEB",
   "szText": "It is time an Oracle returns to its halls for answers.",
   "hLabel": 1221294798
  }
 ],
 "ptMapStringTable": "0"
}
