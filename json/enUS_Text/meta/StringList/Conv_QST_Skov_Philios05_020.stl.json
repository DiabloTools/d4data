{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Philios05_020.stl",
 "__snoID__": 2290699,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are you all right?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "I am dozens of bodies, some aching, some soaring, some fighting to be born.",
   "hLabel": 4101159845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1D8BEB",
   "szText": "distracted",
   "hLabel": 1151919986
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1D8BEB",
   "szText": "This body is old and weary, but yet unhurt. Thank you for your concern, friend.",
   "hLabel": 1221294798
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1D8BEB",
   "szText": "warm",
   "hLabel": 2680627259
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.24FBCE",
   "szText": "You fight well, mainlander. We could use your help culling the rest of the Morlu.",
   "hLabel": 818816624
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.24FBCD",
   "szText": "Oracle Cyra, we should—",
   "hLabel": 1834551538
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1D8BEB",
   "szText": "Yes. Yes, we should return to the safety of the Sanctum.",
   "hLabel": 1188227349
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1D8BEB",
   "szText": "Child of Lilith. I have seen a hundred bloody sunsets swallow these isles. But you carry within you the hope of another dawn.",
   "hLabel": 525767383
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.1D8BEB",
   "szText": "Nurture that hope. All Sanctuary depends on it.",
   "hLabel": 3142539798
  }
 ],
 "ptMapStringTable": "0"
}
