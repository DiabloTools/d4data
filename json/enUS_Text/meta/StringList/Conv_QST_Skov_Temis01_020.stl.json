{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Temis01_020.stl",
 "__snoID__": 2135402,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24FBB2",
   "szText": "Mark Akarat’s words, better days are on the horizon! Look, you can see it in the sky.",
   "hLabel": 2439896553
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24FBC8",
   "szText": "An eclipse is coming. So what?",
   "hLabel": 1777436626
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24FBB2",
   "szText": "The eclipse heralds a new beginning! You haven’t seen the madness we’ve escaped from.",
   "hLabel": 1114976621
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24FBB2",
   "szText": "Tell me, pilgrims, what have you seen?",
   "hLabel": 452516655
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.24FBBC",
   "szText": "Babies born backwards!",
   "hLabel": 4085024034
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.24FBB3",
   "szText": "Rain as thick as tar!",
   "hLabel": 1205158939
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.24FBC0",
   "szText": "Dead livestock, falling from the sky!",
   "hLabel": 542699003
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.24FBB2",
   "szText": "It’s all over the mainland, and it’s coming here next. But Akarat will lead us through the eclipse and into a new age!",
   "hLabel": 4175206302
  }
 ],
 "ptMapStringTable": "0"
}
