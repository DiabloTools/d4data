   "szLabel": "Line3.24A3D2",
   "szText": "Father, your faith has blinded you! Can't you see Alni has been infected by a demon?",
   "hLabel": 1777205785
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24A3D2",
   "szText": "exasperated",
   "hLabel": 3122933222
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24A3E4",
   "szText": "Nonsense, Olaros! Alni has been blessed with a gift from Akarat himself.",
   "hLabel": 1114745854
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.24A3E4",
   "szText": "trying to convince, but also has said this several times. Getting tired. ",
   "hLabel": 2460473291
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24A3D2",
   "szText": "This is no gift. It is a curse!",
   "hLabel": 452285853
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.24A3D2",
   "szText": "Spat, to herself, but ensuring her father can hear. ",
   "hLabel": 1798013290
  }
