{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Celestia2_01_030.stl",
 "__snoID__": 2438659,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Where is your captain?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.229670",
   "szText": "Back in Athulua, with the garrison. Our Queen sent orders to march them here for the eclipse.",
   "hLabel": 538660628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.229670",
   "szText": "Reporting, tense. ",
   "hLabel": 1997993089
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCFFD",
   "szText": "\"Akarat's orders,\" you mean. What was Captain Tharra's answer?",
   "hLabel": 4192891844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1DCFFD",
   "szText": "Contempt, then eager for news",
   "hLabel": 1357257009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.229670",
   "szText": "She didn't give one...but she sent me ahead to observe.",
   "hLabel": 3508707992
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.229670",
   "szText": "Cautious, then hushed. Doesn't want to be heard by other Amazons.",
   "hLabel": 673073157
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.229670",
   "szText": "The Queen’s forces stand ready for battle. Against what enemy, no one knows, but...they’ve arrested the Oracle.",
   "hLabel": 2846248026
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.229670",
   "szText": "Continuing, hushed. Delivering ominous news.",
   "hLabel": 10613191
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1DCFFD",
   "szText": "Where?",
   "hLabel": 3177156929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1DCFFD",
   "szText": "Concerned, terse",
   "hLabel": 341522094
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.229670",
   "szText": "In the Observatory, at spearpoint. (sighs) The disgrace of it...",
   "hLabel": 2492973077
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.229670",
   "szText": "Bitter disdain",
   "hLabel": 3952305538
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1DCFFD",
   "szText": "The worst has yet to come. Scout, I must speak with Captain Tharra. Take me to her.",
   "hLabel": 1852236997
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.1DCFFD",
   "szText": "Grim, terse, direct",
   "hLabel": 3311569458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCFFD",
   "szText": "As for you, see to the Oracle, and avoid violence. These Amazons are not the enemy...and we’ll need every soul we can muster to move against Mephisto.",
   "hLabel": 1189777031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.1DCFFD",
   "szText": "To Player, terse, focused. (He leaves immediately after this)",
   "hLabel": 2649109492
  }
 ],
 "ptMapStringTable": "0"
}
