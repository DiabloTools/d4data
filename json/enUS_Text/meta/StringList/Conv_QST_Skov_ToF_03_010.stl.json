{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_ToF_03_010.stl",
 "__snoID__": 2359967,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"The urns have disappeared?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8BEB",
   "szText": "They’ve returned to their creator. The blood binds them to her, sustains her.",
   "hLabel": 2456032413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8BEB",
   "szText": "Life offered for sight. The Oracle pact, repaid in kind.",
   "hLabel": 1131112481
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.235BFC",
   "szText": "So what do we do now?",
   "hLabel": 449570002
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "We use her guile against her. The urns will return to Achaia, and we will follow.",
   "hLabel": 4101159845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.235BFC",
   "szText": "But, only Petros and Mikkos—",
   "hLabel": 1202212285
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1D8BEB",
   "szText": "Yes, two urns remain. And it seems Petros intends to force fate.",
   "hLabel": 558834832
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1D8BEB",
   "szText": "cold, blunt",
   "hLabel": 2018167293
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.235BFC",
   "szText": "Mikkos!",
   "hLabel": 4172259649
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.235BFC",
   "szText": "slow realisation; horrfied",
   "hLabel": 1336624814
  }
 ],
 "ptMapStringTable": "0"
}
