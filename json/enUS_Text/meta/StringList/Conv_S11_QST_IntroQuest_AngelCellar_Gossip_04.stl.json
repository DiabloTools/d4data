 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Does an angel fear death? Finality?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24ADC2",
   "szText": "There is no fear. A slain angel does not truly die.",
   "hLabel": 452339181
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24ADC2",
   "szText": "There is banishment and transcendence through the light and song—a veil between moments.",
   "hLabel": 1777259113
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24ADC2",
   "szText": "The longer beings roam Sanctuary, the more I’ve observed. I thought their death was quiet and still, but I am no longer sure of that.",
   "hLabel": 1114799147
  }
 ],
 "ptMapStringTable": "0"
}
