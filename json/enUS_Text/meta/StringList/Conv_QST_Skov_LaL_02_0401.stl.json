   "szLabel": "MenuLabel",
   "szText": "\"The children were silent. Eerily so.\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B56B",
   "szText": "You’ve seen your fair share of suffering, I wager. Toughened to it. Children have no such luxury. Each horror is a first.",
   "hLabel": 2440888317
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25B56B",
