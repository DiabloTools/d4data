{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_06b_10.stl",
 "__snoID__": 2105977,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I am sorry for what happened with Ouna.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1F9FF1",
   "szText": "I devoted my life to serving this swamp. A harsh place...but one of fairness. Give and take. Oaths and debts.",
   "hLabel": 2458444532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1F9FF1",
   "szText": "Grieving. Tired. Heavy.",
   "hLabel": 3804171969
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1F9FF1",
   "szText": "And for the swamp, I killed that young woman. Cut her head from her body and gave it to that Tree...to watch me for the rest of my days.",
   "hLabel": 561246951
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1F9FF1",
   "szText": "Grieving. Holding back tears.",
   "hLabel": 2020579412
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line18.1F9FF1",
   "szText": "It had to be done. She accepted it and...velek isha, she tried to comfort me as I drew the blade.",
   "hLabel": 3200064332
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir18.1F9FF1",
   "szText": "A moment of self-reassurance, then a tear falls.",
   "hLabel": 364429497
  }
 ],
 "ptMapStringTable": "0"
}
