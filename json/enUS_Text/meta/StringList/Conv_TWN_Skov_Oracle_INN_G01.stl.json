   "szLabel": "MenuLabel",
   "szText": "\"I notice many here are missing eyes, fingers, toes. Why?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.237BF0",
   "szText": "To witness the future, seers give something of themselves. Offer a finger, and in return, prophecy.",
   "hLabel": 2437021723
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.240DCC",
   "szText": "Offer a heart, and in return, (hics) a broken heart.",
