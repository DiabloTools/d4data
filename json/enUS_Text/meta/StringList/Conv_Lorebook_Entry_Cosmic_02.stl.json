   "szLabel": "DisembodiedVoice",
   "szText": "Lycander's Message",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22902A",
   "szText": "Through this Eye we may meet again, and each time we will say farewell. One of these will be our last. But when that time comes, do not be troubled.",
   "hLabel": 2435851559
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.22902A",
   "szText": "Narrating a goodbye letter. Somber, honest, comforting.",
   "hLabel": 3781578996
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.22902A",
   "szText": "Eternity is a desert, dear Philios. Love is a drop of water. That which cannot last is precious above all.",
   "hLabel": 1773391593
  },
