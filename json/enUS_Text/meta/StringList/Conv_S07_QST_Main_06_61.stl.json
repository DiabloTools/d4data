 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "I didn't stop the ritual.",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1FA02A",
   "szText": "I knew the Tree would never forgive me for what I have done. I hope you someday can.",
   "hLabel": 4104948970
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1FA02A",
   "szText": "Heavy. Somber. Beyond sorry.",
   "hLabel": 1155709111
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1FA017",
   "szText": "No! We can’t give her head to the Tree! Tell her, Gelena...Gelena!",
   "hLabel": 3532671246
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1FA017",
   "szText": "Angry denial.",
   "hLabel": 697036411
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1F9FF1",
   "szText": "A witch makes their own choices. She has made hers.",
   "hLabel": 2458444532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1F9FF1",
   "szText": "Holding back tears. Supporting Ouna.",
   "hLabel": 3804171969
  }
 ],
