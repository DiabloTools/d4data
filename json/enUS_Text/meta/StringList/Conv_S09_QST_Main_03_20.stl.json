  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BF6E6",
   "szText": "What irony, to find the roots of little Túr Dúlra watered once again with my lifeblood.",
   "hLabel": 1564260864
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BF6E6",
   "szText": "You can take me from this place. The Druids can grow their little trees. But I’ll be back to raze it all down again. Whether it’s in one year or a hundred hence...",
   "hLabel": 4147196802
  }
 ],
 "ptMapStringTable": "0"
