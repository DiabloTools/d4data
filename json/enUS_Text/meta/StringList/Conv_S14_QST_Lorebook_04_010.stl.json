 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "The Good Son of Hawezar",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Unknown",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "Brother Jacobin of Zarbinzet, we absolve you of your name and relieve you of its weight.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2808AB",
   "szText": "Sincere, somber",
   "hLabel": 3788381353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.2808AB",
   "szText": "Selflessly, you have given comfort to the sick, the wounded, the broken, and the dying, and each time heaped their pain upon your soul.",
   "hLabel": 545456335
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.2808AB",
   "szText": "The time has come to let it end.",
   "hLabel": 4177963665
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.2808AB",
   "szText": "Comforting",
   "hLabel": 1342328830
  }
 ],
 "ptMapStringTable": "0"
}
