 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I can't go with you. I need to find Lorath.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.24C67B",
   "szText": "Last I saw your old fool, he was riding like hell for the Temple of Courage. Tharra was with him...Ancients know why.",
   "hLabel": 1834394357
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.24C67B",
   "szText": "Relenting. No time to argue.",
   "hLabel": 3293726818
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.24C67B",
   "szText": "Go with fortune. And...thank you.",
   "hLabel": 1171934391
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.24C67B",
   "szText": "Sincere then hesitant. Doesn't often thank people, but knows she owes the Player.",
   "hLabel": 2631266852
  }
 ],
 "ptMapStringTable": "0"
}
