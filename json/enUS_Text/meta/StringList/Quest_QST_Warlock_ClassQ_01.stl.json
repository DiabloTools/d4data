  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase11Description",
   "szText": "The warlock Hattar has summoned me to the Wayward Plains, hinting at a hidden way to bind more demons to my will.",
   "hLabel": 1641010231
