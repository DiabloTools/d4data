 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What does my soul look like?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.244C6E",
   "szText": "Your soul is a great vine. Twisted around a trellis no longer there.",
   "hLabel": 2438099391
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.244C6E",
   "szText": "stoic, like reading Tarot",
   "hLabel": 3783826828
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.244C6E",
   "szText": "You drank deeply from the waters of Hatred. It has left your leaves stained red and scarred your branches black.",
   "hLabel": 1775639425
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.244C6E",
   "szText": "But still, you endure.",
   "hLabel": 1113179459
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.244C6E",
   "szText": "approving",
   "hLabel": 2458906896
  }
 ],
 "ptMapStringTable": "0"
}
