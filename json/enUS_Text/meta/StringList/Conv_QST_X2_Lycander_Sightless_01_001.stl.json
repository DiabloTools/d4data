   "szLabel": "Line1.1D8BEB",
   "szText": "The Great Eye is silent, Athrpa. In your eagerness, you have become blind.",
   "hLabel": 2456032413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1D8BEB",
   "szText": "CYRA is a tired mom in this scene. She's been arguing with ATHRPA for a while.",
   "hLabel": 3801759850
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.219CC0",
   "szText": "And in your restraint, we are all blind. If the Eye is not restored, we will never see clearly again!",
