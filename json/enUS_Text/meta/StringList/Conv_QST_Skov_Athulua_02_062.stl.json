{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_02_062.stl",
 "__snoID__": 2460762,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I've met an angel before. You seem different.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCFFD",
   "szText": "Perhaps because I’m not an angel. Not any more, at least.",
   "hLabel": 2514696963
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1DCFFD",
   "szText": "Shrugging. Amiable.",
   "hLabel": 3974029424
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.BAE4.Pal",
   "szText": "But you were the Archangel of Justice... How did you become a mortal?",
   "hLabel": 1940445347
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.BAE4.Pal",
   "szText": "Puzzled. Curious but trying to be respectful.",
   "hLabel": 2015595856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.6D03F",
   "szText": "The Heavens didn’t like him helping mankind. So he tore off his own wings. Cast himself down to live as a mortal, here in the muck with us. Very dramatic.",
   "hLabel": 2404710208
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.6D03F",
   "szText": "Weary but grinning. Teasing Tyrael.",
   "hLabel": 3750437645
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCFFD",
   "szText": "I've had my moments. What other angel have you met?",
   "hLabel": 1189777031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.1DCFFD",
   "szText": "Smiling, gently teasing.",
   "hLabel": 2649109492
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.6D03F",
   "szText": "Inarius.",
   "hLabel": 3275614788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.6D03F",
   "szText": "Grinning.",
   "hLabel": 326374929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.1DCFFD",
   "szText": "Heh, and you call me dramatic?",
   "hLabel": 836502082
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.1DCFFD",
   "szText": "Regretful, hiding shame then redirecting.",
   "hLabel": 2295834543
  }
 ],
 "ptMapStringTable": "0"
}
