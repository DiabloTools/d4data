   "szLabel": "MenuLabel",
   "szText": "Inspect",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Horadric Librarian",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22B55C",
   "szText": "I believe this epistle speaks for itself.",
   "hLabel": 2437330522
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.22B55C",
   "szText": "“Iben. I cannot count the tears I shed for our Tal Rasha.\"",
   "hLabel": 1774870556
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.22B55C",
   "szText": "\"Tyrael has led us nobly. But have we followed him too unquestioningly? An angel he may be, but angels are one half of the very Conflict we seek to end.\"",
   "hLabel": 1112410590
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.22B55C",
   "szText": "\"He claimed the soulstone was our salvation. Yet, you write that Baal shattered it like glass.\"",
   "hLabel": 449950624
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.22B55C",
   "szText": "\"I am grateful for Tyrael’s wisdom—but perhaps, wisdom lies in other places, too. Unexpected places. My travels to these southern jungles have challenged all I knew.\"",
   "hLabel": 4082457954
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.22B55C",
   "szText": "\"I will tell all upon my return. Your friend, Cathan.”",
   "hLabel": 1202592907
  }
 ],
 "ptMapStringTable": "0"
}
