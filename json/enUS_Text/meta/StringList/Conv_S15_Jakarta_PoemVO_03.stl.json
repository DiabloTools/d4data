 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Deckard Cain",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27B44D",
   "szText": "Enshrined in their holiest temple he waited,",
   "hLabel": 2443259006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27B44D",
   "szText": "And silently poisoned their faith with his Hatred.",
   "hLabel": 1780799040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27B44D",
   "szText": "Three Evils gathered, the abyss yawning wide,",
   "hLabel": 1118339074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.27B44D",
   "szText": "No Light could deny them.",
   "hLabel": 455879108
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.27B44D",
   "szText": "No mortal dare try.",
   "hLabel": 4088386438
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.27B44D",
   "szText": "Feels like \"or so they thought\"",
   "hLabel": 1139146579
  }
 ],
 "ptMapStringTable": "0"
}
