  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "To end the Suffering of our kind, we must first inflict it. Life has ever fought to live, so we must wage war for Death.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2808AB",
   "szText": "Unfortunate truth",
   "hLabel": 3788381353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2808AB",
   "szText": "We must delve the wicked places of the world, unleash the monsters within, and add them to our war against the living.",
   "hLabel": 1780193950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2808AB",
   "szText": "It will be terrible, but for only a breath of time. Insignificant in the eternal peace hereafter.",
   "hLabel": 1117733984
  },
