 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Lilith, Mephisto, and now this... Will it ever end?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCFFD",
   "szText": "If only... But such is the Eternal Conflict. It is why Lilith and Inarius hoped to escape it. Each end, a new beginning. With each victory, another threat.",
   "hLabel": 2457582095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCFFD",
   "szText": "Tired, somber, heavy",
   "hLabel": 3803309532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "You had no choice but to banish Mephisto. We could not have known that his final scream would wake the dead...and perhaps Death itself.",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCFFD",
   "szText": "Reassuring",
   "hLabel": 3140849566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCFFD",
   "szText": "But Death too shall pass, if we make it so. Do not lose hope.",
   "hLabel": 1132662163
  }
 ],
 "ptMapStringTable": "0"
}
