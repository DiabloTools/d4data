   "szLabel": "MenuLabel",
   "szText": "\"Did your crew shipwreck here?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24467C",
   "szText": "Aye, aye. Us and maybe a dozen other wrecks off these shores. Summoned by that foul seductress, same as we.",
   "hLabel": 2438050417
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24467C",
   "szText": "All of them poor wretches died though. We only lived ‘cause of you. (ragged laugh)",
   "hLabel": 1775590451
  }
 ],
 "ptMapStringTable": "0"
}
