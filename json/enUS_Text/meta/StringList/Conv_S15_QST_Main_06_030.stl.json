{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S15_QST_Main_06_030.stl",
 "__snoID__": 2660046,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "(Place the Splinter of Hatred.)",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27B44D",
   "szText": "Now then... Only one remains.",
   "hLabel": 2443259006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27B44D",
   "szText": "Somber, heavy. The last wanderer was a close friend.",
   "hLabel": 3788986443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27B44D",
   "szText": "Aidan was one of the bravest I have ever known. He came to me in Old Tristram when his brother had gone missing...taken by Diablo.",
   "hLabel": 1780799040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27B44D",
   "szText": "He risked his title, his life, and his very soul to save him. But Diablo claimed him too, in the end.",
   "hLabel": 1118339074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.27B44D",
   "szText": "Deckard feels responsible for this. Guilty.",
   "hLabel": 2464066511
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.27B44D",
   "szText": "In the night, somehow, I have heard his voice. Struggling, fighting, screaming in pain from the far North. A ruined church in the wilds, overgrown with green.",
   "hLabel": 455879108
  }
 ],
 "ptMapStringTable": "0"
}
