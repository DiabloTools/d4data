   "szLabel": "MenuLabel",
   "szText": "\"Where is the rest of your cult? What are you trying to bring to Sanctuary?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24EE87",
   "szText": "Burning Hells swallow you! The rest are in south Atanos. They mean to come by boat.",
   "hLabel": 452482604
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24EE87",
