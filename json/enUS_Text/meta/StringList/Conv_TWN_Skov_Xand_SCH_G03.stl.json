 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Who is Philios to the Askari?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23AD94",
   "szText": "Philios? Well, he is broadly known as the founding father of Skovos. He and his wife Askarra are said to have given birth to Amazon and Oracle.",
   "hLabel": 2438531774
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.23AD94",
   "szText": "Surprised. Thought everyone knew this. Explains like a teacher.",
   "hLabel": 3784259211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.23AD94",
   "szText": "(scoffs) He is also said to have vanquished a giant serpent and romanced the angel Lycander...but who can separate history from myth?",
   "hLabel": 1776071808
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.23AD94",
   "szText": "Grinning, dubious. ",
   "hLabel": 3121799245
  }
 ],
 "ptMapStringTable": "0"
}
