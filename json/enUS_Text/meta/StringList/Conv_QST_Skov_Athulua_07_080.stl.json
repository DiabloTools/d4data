{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_07_080.stl",
 "__snoID__": 2314774,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Stop!\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line36.24CCC2",
   "szText": "I'm sorry, my Lord! We’ve failed— (gasps)",
   "hLabel": 3457527232
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir36.24CCC2",
   "szText": "Crying out, despairing—suddenly gasping (breath only) when her body is seized by Mephisto",
   "hLabel": 621892397
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line38.BD9D3",
   "szText": "Hush now. It matters not.",
   "hLabel": 1705108727
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir38.BD9D3",
   "szText": "Calm, mockingly paternal",
   "hLabel": 3050836164
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line40.BAE4",
   "szText": "Mephisto. You lose again.",
   "hLabel": 1160203446
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir40.BAE4",
   "szText": "Seething in recognition, defiant",
   "hLabel": 3023090403
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line42.BD9D3",
   "szText": "Ahh, but I have enjoyed watching this drama unfold... The proud, sacrificed. The weak, slaughtered. The last Horadrim, brought to the brink.",
   "hLabel": 2215005522
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir42.BD9D3",
   "szText": "Condescending, care free. Relishing the horror he brought to Athulua.",
   "hLabel": 3560732959
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line44.BD9D3",
   "szText": "All for a shard of bone. Do you still want it?",
   "hLabel": 502974164
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir44.BD9D3",
   "szText": "Condescending, mocking",
   "hLabel": 1848701601
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line46.BD9D3",
   "szText": "Then take it.",
   "hLabel": 3085910102
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir46.BD9D3",
   "szText": "A challenge. Another of his games.",
   "hLabel": 136670243
  }
 ],
 "ptMapStringTable": "0"
}
