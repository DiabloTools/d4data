  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2558FF",
   "szText": "Tal Rasha would bring the others to task. But Fahd is too suspicious, and Kulle is too arrogant. Tal Rasha tries to kindle the fire in their hearts, without seeing that they burn each other.",
   "hLabel": 2439276007
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2558FF",
   "szText": "But he is right to try. Too much is at stake.",
   "hLabel": 1776816041
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2558FF",
   "szText": "If I must force them to cooperate, so be it.",
   "hLabel": 1114356075
  }
 ],
