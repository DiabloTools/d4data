{
 "__fileName__": "enUS_Text/meta/StringList/Conv_X2_Collectibles_Skov_Atanos_01.stl",
 "__snoID__": 2467294,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DB735",
   "szText": "What is all this?",
   "hLabel": 1132573313
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DB735",
   "szText": "Childlike wonder",
   "hLabel": 2478300750
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.84B74",
   "szText": "The Pools of Creation. Where you, and all Firstborn, were made.",
   "hLabel": 1512701728
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.84B74",
   "szText": "Fatherly pride that his son is taking an interest",
   "hLabel": 3375588685
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.1DB735",
   "szText": "But, this isn't where you or Mother come from?",
   "hLabel": 138883364
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.1DB735",
   "szText": "Confused/inquisitive",
   "hLabel": 1484610801
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.84B74",
   "szText": "We are two sides of the eternal Divine, brought together through a powerful bond.",
   "hLabel": 574269040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir10.84B74",
   "szText": "Thoughtful, patient",
   "hLabel": 1919996477
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.84B74",
   "szText": "It was our dream to bring great things to this realm. Starting with you, Linarian.",
   "hLabel": 1445173620
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir14.84B74",
   "szText": "Quiet pride",
   "hLabel": 2790901057
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line16.1DB735",
   "szText": "If you and Mother have always been, but the Firstborn had to be made...does that mean we don't belong?",
   "hLabel": 3861573011
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir16.1DB735",
   "szText": "Confused, but wanting to know more.",
   "hLabel": 1025938176
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line18.84B74",
   "szText": "No, son. It means you have the power to create your own destiny.",
   "hLabel": 2316078200
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir18.84B74",
   "szText": "Thoughtful, sincere",
   "hLabel": 3661805637
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line20.84B74",
   "szText": "It's a power most only dream of.",
   "hLabel": 243039057
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir20.84B74",
   "szText": "Passionate, sincere",
   "hLabel": 1588766494
  }
 ],
 "ptMapStringTable": "0"
}
