{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_01b_02.stl",
 "__snoID__": 2109571,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Who do we have here? Members of the Coven?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1F9FF1",
   "szText": "(sighs) They are. Wanderer, this is Caidin and Ouna. We will be working together to restore the Tree and punish whatever, or whoever, has defiled it. Is that not right, Caidin?",
   "hLabel": 2458444532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1F9FF1",
   "szText": "Tired but doing her duty. Terse with Caidin.",
   "hLabel": 3804171969
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1FA017",
   "szText": "We’re the ones fool enough to answer the call, anyway. Reckon that includes you, wanderer! (scoffs) Welcome to the Coven.",
   "hLabel": 1797361497
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1FA017",
   "szText": "Grumbling. Flippant. Cynical.",
   "hLabel": 3143088934
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1FA02A",
   "szText": "Servant of the Tree... Follower of whispers.",
   "hLabel": 472441640
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1FA02A",
   "szText": "Recognizing player. Contemplating.",
   "hLabel": 1818169077
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1F9FF1",
   "szText": "Indeed. You are not unlike a witch, wanderer. In payment for your efforts, we can make you more so.",
   "hLabel": 1223706917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1F9FF1",
   "szText": "Taking control. Confident. Friendly. ",
   "hLabel": 2683039378
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1F9FF1",
   "szText": "Choose from among our altars, and lay down proof of your efforts. We will teach you our craft.",
   "hLabel": 561246951
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1F9FF1",
   "szText": "Presenting the altars. Enticing.",
   "hLabel": 2020579412
  }
 ],
 "ptMapStringTable": "0"
}
