{
 "__fileName__": "enUS_Text/meta/StringList/Conv_DSQ_Skov_Philios_TheCostofMiracles_GC04.stl",
 "__snoID__": 2410110,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24A3E0",
   "szText": "Father! How could this happen?!",
   "hLabel": 1777205816
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24A3E0",
   "szText": "Hysterical. Too much has happened too fast. ",
   "hLabel": 3122933253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24A3D2",
   "szText": "He chose his fate, Alni. There was nothing we could have done.",
   "hLabel": 1114745819
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.24A3D2",
   "szText": "struggling to keep it together",
   "hLabel": 2460473256
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.24A3E0",
   "szText": "No! I—He— (sobs)",
   "hLabel": 4084793214
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.24A3E0",
   "szText": "Can barely think, breaks into sobs at the end.",
   "hLabel": 1135553355
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24A3D2",
   "szText": "(sniffles) In time, wanderer, she will thank you for saving her life. As will I.",
   "hLabel": 452285853
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.24A3D2",
   "szText": "On the verge of tears, but knows the Player deserves thanks. ",
   "hLabel": 1798013290
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.24A3D2",
   "szText": "For now, take this, and leave us.",
   "hLabel": 1204928136
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.24A3D2",
   "szText": "resigned, genuinely appreciative, but struggling with her emotions",
   "hLabel": 2664260597
  }
 ],
 "ptMapStringTable": "0"
}
