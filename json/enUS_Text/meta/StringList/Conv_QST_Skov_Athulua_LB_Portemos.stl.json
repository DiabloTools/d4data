  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.25D849",
   "szText": "My dearest Leodora. We waited as long as we could for your Amazons. The Drowned are coming, and soon not even Temis will be safe.",
   "hLabel": 2465010770
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.25D849",
   "szText": "Somber, anxious",
   "hLabel": 3924343231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.25D849",
   "szText": "We have boarded up the house your great-grandmother built and packed all that we could to go west. To follow Akarat.",
   "hLabel": 2774195787
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.25D849",
   "szText": "Somber, anxious",
   "hLabel": 4233528248
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.25D849",
   "szText": "Mamá and I hope to see you there. We love you, Leo.",
   "hLabel": 2111735821
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.25D849",
   "szText": "Somber, aching",
