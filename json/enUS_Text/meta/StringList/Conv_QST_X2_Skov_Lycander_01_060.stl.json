   "szLabel": "MenuLabel",
   "szText": "\"This all reminds me of what he did to Nahantu.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6D03F",
   "szText": "Nahantu was invaded. Infected.",
