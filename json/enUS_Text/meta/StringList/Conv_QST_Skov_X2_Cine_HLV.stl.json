   "szLabel": "MenuLabel",
   "szText": "[PH] Awaken Lilith",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BAE4",
   "szText": "Lilith, your father—",
   "hLabel": 3874545195
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.BAE4",
   "szText": "Quick and to the point.",
   "hLabel": 807383736
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BD31C",
   "szText": "He walks your world.",
   "hLabel": 1917219333
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.BD31C",
   "szText": "Icy.",
   "hLabel": 3262946770
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.BD31C",
   "szText": "You laid his path.",
   "hLabel": 205187975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4",
   "szText": "Your father walks Skovos.",
   "hLabel": 1776443800
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.BAE4",
   "szText": "Emphasis on \"Skovos.\"",
   "hLabel": 3639330757
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BD31C",
   "szText": "Skovos.",
   "hLabel": 1076092555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.BD31C",
   "szText": "Quiet, to herself. Pondering.",
   "hLabel": 2421819992
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4",
   "szText": "I cannot stop his schemes alone.",
   "hLabel": 1932985372
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BD31C",
   "szText": "No. You need me.",
   "hLabel": 1585989350
  }
 ],
