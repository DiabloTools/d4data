 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "This Morlu attack tells me we’re on the right trail. Mephisto doesn’t want you talking to Lilith.",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.6D03F",
   "szText": "begrudgingly",
   "hLabel": 4245791867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.6D03F",
   "szText": "How was that, anyway?",
   "hLabel": 670873552
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BAE4",
   "szText": "I got the sense she was hiding things from me. Things about Skovos, her father, and the Pools of Creation.",
   "hLabel": 1619902228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "She's got the stronger hand. She knows every secret these Isles have to offer. She made them, after all.",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "Keep pressing. She'll have to come around eventually, if she wants to see this place saved.",
   "hLabel": 153004253
  }
 ],
 "ptMapStringTable": "0"
}
