 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are you an archivist? I have information about the Firstborn.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B10F",
   "szText": "Shhh! Not so loud!",
   "hLabel": 2440883767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25B10F",
   "szText": "panicked shushing",
   "hLabel": 3786611204
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B10F",
   "szText": "The Archive is not as it once was. Good records are being burned while fanatics of Akarat rewrite history.",
   "hLabel": 1778423801
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.25B10F",
   "szText": "whispered, hushed",
   "hLabel": 3124151238
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B10F",
   "szText": "Your knowledge is valuable, and appreciated. But the Archive has eyes and ears everywhere.",
   "hLabel": 1115963835
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.25B10F",
   "szText": "Hushed",
   "hLabel": 2461691272
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25B10F",
   "szText": "If you find more information to share, bring it to me and me alone. I will keep it safe.",
   "hLabel": 453503869
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.25B10F",
   "szText": "excitement bleeding through",
   "hLabel": 1799231306
  }
 ],
