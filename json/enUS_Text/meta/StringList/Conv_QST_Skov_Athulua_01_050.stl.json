{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_01_050.stl",
 "__snoID__": 2266762,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What happened, Tharra? Where is Lorath?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.1DCC9B",
   "szText": "He... Well, he was alive when I saw him last.",
   "hLabel": 3144084726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.1DCC9B",
   "szText": "Hesitant. It's not good news.",
   "hLabel": 308449891
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.1DCC9B",
   "szText": "We arrived in Athulua together—saw the Drowned had invaded. So we rode straight here to counsel the Queen.",
   "hLabel": 2481624760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.1DCC9B",
   "szText": "Gathering thoughts, telling the story.",
   "hLabel": 3940957221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.1DCC9B",
   "szText": "She was furious when she saw him. Ordered me to stay outside while they spoke in her tent.",
   "hLabel": 2790809777
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.1DCC9B",
   "szText": "Unsettled. Never saw her beloved Queen that angry.",
   "hLabel": 4250142238
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.1DCC9B",
   "szText": "I could not help overhearing...",
   "hLabel": 2128349811
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.1DCC9B",
   "szText": "Bracing for the hard part of the story",
   "hLabel": 3587682272
  }
 ],
 "ptMapStringTable": "0"
}
