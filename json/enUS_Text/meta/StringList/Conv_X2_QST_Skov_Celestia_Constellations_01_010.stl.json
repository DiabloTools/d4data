 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Is there something I can do to help?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2547DA",
   "szText": "In fact, there is. Skovos’s history was recorded on these shelves. Centuries of knowledge gone in an instant.",
   "hLabel": 2439238910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2547DA",
   "szText": "Polite, but saddened by the Observatory's losses. ",
   "hLabel": 3784966347
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2547DA",
   "szText": "But our legends remain in the stars. The constellations can tell you of our history and legends. I can rebuild what was lost from your findings.",
   "hLabel": 1776778944
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2547DA",
   "szText": "Polite, somewhat hopeful. ",
   "hLabel": 3122506381
  }
 ],
 "ptMapStringTable": "0"
}
