{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_08_040.stl",
 "__snoID__": 2260840,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Here it is. The second piece of Lilith's blade.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.1DCFFD",
   "szText": "Well done.",
   "hLabel": 2128354565
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.1DCFFD",
   "szText": "Smiling, warm, proud.",
   "hLabel": 3587687026
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.6D03F",
   "szText": "You've carried us through once again...when I could not.",
   "hLabel": 3606844771
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.6D03F",
   "szText": "Grateful, colored by regret",
   "hLabel": 657604912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCC9B",
   "szText": "AMAZONS! Eyes and ears, on me.",
   "hLabel": 2514692209
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1DCC9B",
   "szText": "Shouting to crowd, commanding, proud",
   "hLabel": 3974024670
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1DCC9B",
   "szText": "As Antia, our First Amazon Queen, taught us, “In victory, give honor to your dead, good wine to your living—",
   "hLabel": 527312311
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.1DCC9B",
   "szText": "Projected to crowd, reverent, smiling at \"good wine\"",
   "hLabel": 1986644772
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.2508DB",
   "szText": "(cheering)",
   "hLabel": 818016239
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.2508DB",
   "szText": "Medium cheer",
   "hLabel": 2277348700
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.1DCC9B",
   "szText": "—and solemn gratitude to your allies.”",
   "hLabel": 174037362
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.1DCC9B",
   "szText": "Back to reverent",
   "hLabel": 1633369823
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCC9B",
   "szText": "To the mainlander who rode with us into battle and cast the Drowned from our island.",
   "hLabel": 3806544692
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCC9B",
   "szText": "Reverent, sincere, grateful",
   "hLabel": 970909857
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.1DCC9B",
   "szText": "To the mighty Tyrael who stood beside them and pulled us from despair.",
   "hLabel": 3144084726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.1DCC9B",
   "szText": "Reverent, sincere, grateful",
   "hLabel": 308449891
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.1DCC9B",
   "szText": "And to Lorath...who spoke truth to our Queen, healed our wounded, and rained Askari fire upon the heads of our enemies!",
   "hLabel": 2481624760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.1DCC9B",
   "szText": "Softening, sincere, then celebratory. ",
   "hLabel": 3940957221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.2508DB",
   "szText": "(cheering)",
   "hLabel": 2772328688
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.2508DB",
   "szText": "Biggest cheer",
   "hLabel": 4231661149
  }
 ],
 "ptMapStringTable": "0"
}
