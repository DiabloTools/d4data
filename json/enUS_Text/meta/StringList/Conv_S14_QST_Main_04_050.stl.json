{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S14_QST_Main_04_050.stl",
 "__snoID__": 2623964,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I interrupted some sort of ritual in Pandemonium. After, I heard a...voice.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "What sort of voice? Human? Demon?",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Wary, serious",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.27ED42",
   "szText": "“Beneath their cowls, the darkness stared empty. No visage of man nor semblance of pity...”",
   "hLabel": 1208681424
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.27ED42",
   "szText": "To self, unsettled. Reciting an old, chilling passage she once read.",
   "hLabel": 2668013885
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line16.27ED42",
   "szText": "In an old book, maybe? Listen mate, I hate to ask you to go back there, but I doubt anyone else can stop—whatever this is.",
   "hLabel": 3847498805
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir16.27ED42",
   "szText": "Thinking aloud, anxious",
   "hLabel": 1011863970
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line18.27ED42",
   "szText": "I've got some reading to do. And praying, for what it’s worth.",
   "hLabel": 3185038839
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir18.27ED42",
   "szText": "Anxious",
   "hLabel": 349404004
  }
 ],
 "ptMapStringTable": "0"
}
