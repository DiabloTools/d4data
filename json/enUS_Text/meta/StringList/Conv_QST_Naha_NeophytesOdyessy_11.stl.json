 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"The Light led you here?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.228AA8",
   "szText": "Chaos has engulfed Kehjistan, and many other lands. But in that darkness, I felt the Light stir in my heart. Pushing me forward.",
   "hLabel": 1201132878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.228AA8",
   "szText": "Recounting the hardneships of his homeland.",
   "hLabel": 2660465339
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.228AA8",
   "szText": "I guess it came down to hope. Akarat’s teachings have always given me that. When I heard that he walked again—in the flesh—what could I do, but seek him out?",
   "hLabel": 4171180242
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.228AA8",
   "szText": "Kind-hearted, faithful",
   "hLabel": 1335545407
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.228AA8",
   "szText": "All this talk of him being a demon… it can't be true. The Light led me to Skovos for him. For a greater purpose. And I must find what that purpose is.",
   "hLabel": 3508720276
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.228AA8",
   "szText": "Kind-hearted, faithful",
   "hLabel": 673085441
  }
 ],
 "ptMapStringTable": "0"
}
