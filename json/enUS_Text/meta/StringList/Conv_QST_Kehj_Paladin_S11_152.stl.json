   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How did you know of the Prodigy?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24B8C5",
   "szText": "Her gift from the Light was far too special. Her last kin knew she was vulnerable.",
   "hLabel": 2439707103
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24B8C5",
   "szText": "Informative. ",
   "hLabel": 3785434540
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24B8C5",
   "szText": "Tried to bring her to safety but the cultists struck first.",
   "hLabel": 1777247137
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24B8C5",
   "szText": "Honest.",
   "hLabel": 3122974574
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.24B8C5",
   "szText": "She’s young, yet her gift runs deep. The Light moves in her. You can feel it.",
   "hLabel": 3159281937
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.24B8C5",
   "szText": "In awe. ",
