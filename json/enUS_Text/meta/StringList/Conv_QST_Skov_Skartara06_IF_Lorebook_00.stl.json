 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Iben Fahd",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.255901",
   "szText": "At times I wonder if I am the only mage here with a shred of caution. Tyrael presents us with three stones—fragments of the World Stone itself—and who do we hand them to?",
   "hLabel": 2439275261
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.255901",
   "szText": "Weary, irritated.",
   "hLabel": 3785002698
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.255901",
   "szText": "Zoltun Kulle. He is the most gifted transmutationalist among us, true, but the man reeks of ambition...and he looks at those stones like a wolf in a henhouse.",
   "hLabel": 1114355329
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.255901",
   "szText": "Suspicious, deeply concerned",
   "hLabel": 2460082766
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.255901",
   "szText": "I will be keeping an eye on him.",
   "hLabel": 451895363
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.255901",
   "szText": "Resolute.",
   "hLabel": 1797622800
  }
 ],
 "ptMapStringTable": "0"
}
