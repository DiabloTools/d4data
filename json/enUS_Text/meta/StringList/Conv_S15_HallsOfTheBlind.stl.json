{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S15_HallsOfTheBlind.stl",
 "__snoID__": 2660625,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Aidan",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2896F4",
   "szText": "\"I can see what you see not. \r\nVision milky, then eyes rot.\"",
   "hLabel": 2442975290
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2896F4",
   "szText": "\"When you turn they will be gone, \r\nWhispering their hidden song.\"",
   "hLabel": 1780515324
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2896F4",
   "szText": "\"Then you see what cannot be,\r\nShadows move where light should be.\"",
   "hLabel": 1118055358
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.2896F4",
   "szText": "\"Out of darkness, out of mind,\r\nCast down into the Halls of the Blind.\"",
   "hLabel": 455595392
  }
 ],
 "ptMapStringTable": "0"
}
