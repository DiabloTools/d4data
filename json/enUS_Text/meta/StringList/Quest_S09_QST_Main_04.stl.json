 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase33Description",
   "szText": "We've reached the entrance to the ritual site. The Druids await me in the circle within. ",
   "hLabel": 1651810811
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase39Description",
   "szText": "The ritual was a disaster. I should check in on the Druids and ensure they're all right.",
   "hLabel": 2284376641
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Reopening the Wound",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "To purge the blood, we must delve into its heart.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "The Druids are preparing for the ritual to purify Astaroth's blood. Bryona awaits me in Tirmair. ",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Speak with Bryona in Tirmair",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase8Description",
   "szText": "Bryona and I must journey to the Scar for the druids' ritual. Demons will be drawn to the blood contained in the Wayfinder—I must ensure Bryona makes the trek safely. ",
   "hLabel": 1557588493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase30Description",
   "szText": "Davish is waiting outside the Scar to greet us.",
   "hLabel": 3483011544
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback42Header",
   "szText": "Speak with Bryona",
   "hLabel": 2539947452
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback32Header",
   "szText": "Enter the Scar",
   "hLabel": 2871177435
  },
  {
