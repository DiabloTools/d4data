   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "“How is he?”",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.789BF",
   "szText": "I don’t know yet. He wandered around for hours until the tea wore off. A long journey through the swamp is more rewarding than a short one.",
   "hLabel": 1864651656
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.789BF",
   "szText": "Yours was even longer, it seems. Did you face your inner demons as the Horadrim did?",
   "hLabel": 152620298
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4.Bar",
   "szText": "Yes. Hopefully for the last time.",
   "hLabel": 1896109275
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.BAE4.Bar",
   "szText": "Knowingly, but hiding the truth of their encounter with Mephisto from Taissa.",
   "hLabel": 1971259784
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4.Dru",
   "szText": "Yes. Hopefully for the last time.",
