 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Who is 'Kakkos?'\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B5D8",
   "szText": "An ancient demon, common to childhood stories. But Kakkos is a demon of mischief, not sacrifice…",
   "hLabel": 2440889793
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25B5D8",
   "szText": "informative, confused",
   "hLabel": 3786617230
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B56B",
   "szText": "A common misconception with so much brine between the ears.",
   "hLabel": 1778428351
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.25B56B",
   "szText": "wry, playful",
   "hLabel": 3124155788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B5D8",
   "szText": "There’s a hidden shrine to Kakkos beneath the northern cascades. That’s where they’ll be… That’s where they’ve taken the children!",
   "hLabel": 1115969861
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.25B5D8",
   "szText": "recognition into excitment; character runs off at end",
   "hLabel": 2461697298
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25B56B",
   "szText": "Hero or fool, Tymon will prove himself today. The lamb has become a lion.",
   "hLabel": 453508419
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.25B56B",
   "szText": "warm, proud",
   "hLabel": 1799235856
  }
 ],
 "ptMapStringTable": "0"
}
