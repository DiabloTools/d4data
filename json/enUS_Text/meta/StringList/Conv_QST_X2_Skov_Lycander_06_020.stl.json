{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_X2_Skov_Lycander_06_020.stl",
 "__snoID__": 2419809,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"We found what we needed.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCC9B",
   "szText": "And what, exactly, is that?",
   "hLabel": 2457577341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "Information. A pathway to stopping Akarat for good.",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "And it starts in Lycander. Do you know of any place where the Firstborn known as Rathma made his home?",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.6D03F",
   "szText": "Repeating a clue he learned from earlier. He doesn't have all the answers--the clue was more of a riddle about seeking Rathma's \"old abode.\"",
   "hLabel": 4245791867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "Hm. The old stories say he loved these woods. There is an area not far, untouched for centuries.",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "Thinking, pulling from her memories.",
   "hLabel": 1815924880
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1DCC9B",
   "szText": "Odd statues guard the woods. You walk for hours and...end up back where you began. We can begin our search there.",
   "hLabel": 2867967158
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1DCC9B",
   "szText": "Thinking, pulling from her memories.",
   "hLabel": 32332323
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "We?",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "You didn’t think I’d just let you go, did you?",
   "hLabel": 1222839726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCC9B",
   "szText": "You seem well-meaning, for a proven criminal. That makes you the most dangerous kind of person to trust.",
   "hLabel": 560379760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCC9B",
   "szText": "I will see for myself where your path leads.",
   "hLabel": 4192887090
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.6D03F",
   "szText": "Then let's move quickly.",
   "hLabel": 1023908833
  }
 ],
 "ptMapStringTable": "0"
}
