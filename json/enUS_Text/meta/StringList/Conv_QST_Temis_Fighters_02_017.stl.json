   "szLabel": "MenuLabel",
   "szText": "\"Who is Marcellus?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.221DAD",
   "szText": "A \"Hand” of Akarat, and a deeply unpleasant one. Big smile, bad temper.",
   "hLabel": 2435622245
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.221DAD",
   "szText": "dismissive on \"Hand\"",
   "hLabel": 3781349682
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.221DAD",
   "szText": "He's climbed their ranks suspiciously fast. I knew he had some dirt under his nails, but so far he's been careful to keep up appearances.",
   "hLabel": 1773162279
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.221DAD",
   "szText": "Violence isn't our play here. We need to stem the influx of Morlu, not just let one of his cronies take over in his absence.",
   "hLabel": 1110702313
  }
 ],
 "ptMapStringTable": "0"
