   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Have you seen Captain Tharra?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24AD3F",
   "szText": "Whoever you are, you're just in time. Captain Tharra’s group needs aid.",
   "hLabel": 2439717547
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24AD3F",
   "szText": "Post combat, eager to send help to Tharra",
   "hLabel": 3785444984
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "Where?",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24AD3F",
   "szText": "East! The Bridge of Portemos! If it falls, Temis is next!",
   "hLabel": 1114797615
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.24AD3F",
   "szText": "Urgent",
   "hLabel": 2460525052
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCFFD",
   "szText": "Bless you, soldier! We’re off!",
