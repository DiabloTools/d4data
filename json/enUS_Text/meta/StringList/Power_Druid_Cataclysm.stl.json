  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod3_Description",
   "szText": "{c_important}Cataclysm{/c} spawns double the Twister and Lightning Bolts. In addition, Lighting Bolt strikes have a {c_number}[SF_57*100|%|]{/c} chance to spawn {c_number}2-4{/c} {c_important}{u}Dancing Bolts{/u}{/c} that deal {c_number}{payload:UPGRADEA_TOOLTIP_DBOLT_DAMAGE}{/c} damage.",
   "hLabel": 3291858358
