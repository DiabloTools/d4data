  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{c_label}Cooldown: {/c}{c_resource}{Cooldown Time}{/c} seconds\r\n{if:ADVANCED_TOOLTIP}{c_label}Lucky Hit Chance: {/c}{c_resource}[{Combat Effect Chance}|%|]{/c}\r\n{/if}A massive storm follows you for {c_number}{buffduration:TORNADO_SPAWNING}{/c} seconds. Twisters Knock Back enemies dealing {c_number}{payload:TORNADO_DAMAGE}{/c} damage, and lightning strikes wildly dealing {c_number}{payload:LIGHTNING_STRIKE}{/c} damage.",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": "\r\n{icon:bullet, 1.2} Twister Damage {icon:arrow, 1.2} {c_number}{payload:TORNADO_DAMAGE}{/c}\r\n{icon:bullet, 1.2} Lightning Damage {icon:arrow, 1.2} {c_number}{payload:LIGHTNING_STRIKE}{/c}",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod2_Description",
   "szText": "{c_important}Cataclysm's{/c} duration is increased by {c_number}{SF_23}{/c} seconds.",
   "hLabel": 1960229941
  },
  {
