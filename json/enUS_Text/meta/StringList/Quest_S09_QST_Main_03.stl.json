  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Bryona needs my help to hunt down another blood relic.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase10Description",
   "szText": "I should return to Cerrigar and speak with Bryona. She may have uncovered a means to purge Astaroth's blood once and for all.",
   "hLabel": 819754710
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback12Header",
   "szText": "Speak with Bryona",
   "hLabel": 3533637401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback42Header",
   "szText": "Return to Bryona in Cerrigar",
   "hLabel": 2539947452
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase14Description",
   "szText": "The blood relic I recovered was but one of several, each a vessel of Astaroth's power hidden across Sanctuary. As long as these relics remain, so does Astaroth.\r\n\r\nBryona believes the Horadrim sealed these relics within Strongrooms - protected chambers buried deep within Nightmare Dungeons. I need to use a Nightmare Sigil to access these chambers.",
   "hLabel": 4104776794
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback62Header",
   "szText": "Use a Nightmare Sigil to find a Strongroom",
   "hLabel": 1877487486
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback65Header",
   "szText": "Retrieve a {ITEM:S09_QST_Main_DGN_AstarothBloodItem} from a Strongroom",
   "hLabel": 1456924097
  }
 ],
