 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I have ended your corruption. Soon you will rest.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2857C6",
   "szText": "My “savior”...(coughs) I see the judgment plain on your pigs-born face! You imagine yourself my better?! That you would have done any differently given my choices?",
   "hLabel": 2442832534
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2857C6",
   "szText": "Sneering, furious, defensive",
   "hLabel": 3788559971
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2857C6",
   "szText": "There is no Light, no salvation! We are forsaken things! And rather than die like a dog in the filth, I took such power as was offered.",
   "hLabel": 1780372568
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2857C6",
   "szText": "Excuses",
   "hLabel": 3126100005
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2857C6",
   "szText": "Here then, hypocrite! Take it for yourself...with my blessing.",
   "hLabel": 1117912602
  }
 ],
 "ptMapStringTable": "0"
}
