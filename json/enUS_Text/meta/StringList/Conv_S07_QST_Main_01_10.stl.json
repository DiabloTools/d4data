{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_01_10.stl",
 "__snoID__": 2096583,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"And who might you be?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1F9FF1",
   "szText": "The people call me “witch” when they’re being polite, but my name is Gelena. I have come to this vile city in search of a head. One that belongs to the Tree of Whispers.",
   "hLabel": 1795984566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1F9FF1",
   "szText": "Friendly introduction. Air of mystery. ",
   "hLabel": 3141712003
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1F9FF1",
   "szText": "Not yours, of course. But this particular head will prove difficult for me to collect alone.",
   "hLabel": 2458444532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1F9FF1",
   "szText": "Grinning. Clarifying her aims.",
   "hLabel": 3804171969
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1F9FF1",
   "szText": "I propose a deal. Help me to find this head and take it back to the Tree, and I will owe you a witch’s debt. What say you?",
   "hLabel": 1133524600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1F9FF1",
   "szText": "Friendly. Simple proposal.",
   "hLabel": 2479252037
  }
 ],
 "ptMapStringTable": "0"
}
