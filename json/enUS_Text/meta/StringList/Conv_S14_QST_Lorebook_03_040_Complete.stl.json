 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Unto Him Hereafter",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Unknown",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "O Death, our constant and watchful companion, forgive us who have spurned you.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.2808AB",
   "szText": "At the hands of the Hells, and the Heavens, and ourselves, we have languished in our folly.",
   "hLabel": 545456335
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.2808AB",
   "szText": "O Death, we gather at last to embrace you on behalf of all who yet live.",
   "hLabel": 4177963665
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.2808AB",
   "szText": "We open wide the gates to our last and eternal home, where too your place is prepared.",
   "hLabel": 3515503699
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.2808AB",
   "szText": "Arise! We beg you, arise O Death! Out of the well, anew!",
   "hLabel": 2853043733
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.2808AB",
   "szText": "Hasten forth the final day we join you in Pandemonium. In our fortress. Forever saved inside.",
   "hLabel": 3162228750
  }
 ],
 "ptMapStringTable": "0"
}
