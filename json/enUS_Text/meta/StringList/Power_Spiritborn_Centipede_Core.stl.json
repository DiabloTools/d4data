  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{c_label}Vigor Cost:{/c_label} {c_resource}{Resource Cost}{/c_resource}\r\n{if:ADVANCED_TOOLTIP}{c_label}Lucky Hit Chance: {/c}{c_resource}[{Combat_Effect_Chance_Script_Formula_Override:17}|%|]{/c}\r\n{/if}Strike a small area, dealing {c_number}{payload:IMPACT}{/c} damage to enemies within as well as all surrounding Poisoned enemies.",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": "\r\n{icon:bullet,1.2} Damage {icon:arrow,1.2} {c_number}{payload:IMPACT}{/c}",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod5_Description",
   "szText": "If {c_important}Stinger{/c} strikes a {c_important}{u}Vulnerable{/u}{/c} enemy it Heals you for {c_number}[{SF_12}*100|%|]{/c} of your Maximum Life {c_number}([Max(1,PlayerHealthMax() * {SF_12})]){/c}. If you are {c_important}{u}Healthy{/u}{/c} it makes enemies {c_important}{u}Vulnerable{/u}{/c} for {c_number}{SF_13}{/c} seconds.",
   "hLabel": 1660147896
  },
  {
   "__type__": "StringTableEntry",
