 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"The common folk need a champion, Horadrim or not. Fight for them.\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.21FCD5",
   "szText": "I think I owe them, anyway. So many died at Eldhaime, when I should’ve been there. Donan would’ve wanted me to watch over this place, and its people.",
   "hLabel": 2436339948
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.21FCD5",
   "szText": "Very well. Davish, you’ll come visit me, I assume?",
   "hLabel": 1111420016
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.229BD8",
   "szText": "Of course, and I’ll complain about the trek every damn time.",
   "hLabel": 1201170003
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.21FCD5",
   "szText": "Ha! I’d expect no less!",
   "hLabel": 4081467380
  }
 ],
 "ptMapStringTable": "0"
}
