 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why are pilgrims being attacked?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.22B189",
   "szText": "When Akarat and his pilgrims first arrived in Skovos, they were considered a nuisance.",
   "hLabel": 2847716040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.22B189",
   "szText": "But then we all saw Queen Adreona brought back to life. I was there. The people believed in Akarat.",
   "hLabel": 2494441091
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.22B189",
   "szText": "Things changed after the eclipse. Everything turned to madness. Akarat and anyone who follows him are looked upon as bad luck.",
   "hLabel": 1831981125
  }
 ],
 "ptMapStringTable": "0"
}
