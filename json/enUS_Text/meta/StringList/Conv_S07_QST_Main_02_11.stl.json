{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_02_11.stl",
 "__snoID__": 2136474,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Here is the head of Belith the Elder.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1FA02A",
   "szText": "You saved her from the rot... Thank you, wanderer.",
   "hLabel": 1797361572
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1FA02A",
   "szText": "Relieved. Grateful. Hopeful.",
   "hLabel": 3143089009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1F9FF1",
   "szText": "Well done indeed. Now to learn the Tree’s old name from our dear Belith, then prepare for the cleansing ritual.",
   "hLabel": 1133524600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1F9FF1",
   "szText": "Impressed. Then to business.",
   "hLabel": 2479252037
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1FA017",
   "szText": "The Tree won’t mind? Us asking a question of one of its heads?",
   "hLabel": 472441565
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1FA017",
   "szText": "Nervous. Looking up at the Tree.",
   "hLabel": 1818169002
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1F9FF1",
   "szText": "The Tree has larger concerns. Speaking of those, wanderer, keep following the whispers. If they led to Belith’s head, they will lead you to more.",
   "hLabel": 4103571964
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1F9FF1",
   "szText": "Dismissive. On to practical matters.",
   "hLabel": 1154332105
  }
 ],
 "ptMapStringTable": "0"
}
