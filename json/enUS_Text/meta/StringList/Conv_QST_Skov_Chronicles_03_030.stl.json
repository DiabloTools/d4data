   "szLabel": "MenuLabel",
   "szText": "\"Are you all right?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B10F",
   "szText": "Why would a follower…of Akarat…summon demons? It makes no sense!",
   "hLabel": 2440883767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
