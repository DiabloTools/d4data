 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Mephisto's Huntsman",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2498FF",
   "szText": "I have started to dream of the Horadrim. Last night they came to me, bellies ripped, bones broken.",
   "hLabel": 2438233834
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2498FF",
   "szText": "He wants them dead. I don’t know why, and I don’t really care. I kill them, and maybe I start dreaming my own dreams again.",
   "hLabel": 1775773868
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2498FF",
   "szText": "The beast knows the old man’s scent. We leave at dawn.",
   "hLabel": 1113313902
  }
 ],
 "ptMapStringTable": "0"
}
