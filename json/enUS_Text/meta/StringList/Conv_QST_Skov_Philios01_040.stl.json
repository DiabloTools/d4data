{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Philios01_040.stl",
 "__snoID__": 2138210,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What do you mean?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1D8BEB",
   "szText": "I’ve seen you die a hundred different ways. Strangled. Drowned. Crushed beneath Mephisto’s heel.",
   "hLabel": 4191342162
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.6D03F",
   "szText": "Then you know the evil we face, Oracle.",
   "hLabel": 4116741566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.6D03F",
   "szText": "wary",
   "hLabel": 1167501707
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.1D8BEB",
   "szText": "Yes. And the way you hope to best it. You seek a weapon.",
   "hLabel": 172492434
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1D8BEB",
   "szText": "I know not where it is. But you’ve brought what we’ll need to find it.",
   "hLabel": 1850687315
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.6D03F",
   "szText": "The Sightless Eye. Can you use it to help us?",
   "hLabel": 692678850
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1D8BEB",
   "szText": "Not I, no. I saw it broken in Hell, when Lilith met its gaze, and bent it inwards towards your mind.",
   "hLabel": 525767383
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.1D8BEB",
   "szText": "It peers there still, and will forevermore. To you, and the demon that sleeps within your blood.",
   "hLabel": 834952400
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.6D03F",
   "szText": "Wait. You don’t mean—",
   "hLabel": 2073480225
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.1D8BEB",
   "szText": "It's time to wake her. Come with me to the Sanctum.",
   "hLabel": 3142539798
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.1D8BEB",
   "szText": "smiling",
   "hLabel": 306904963
  }
 ],
 "ptMapStringTable": "0"
}
