{
 "__fileName__": "enUS_Text/meta/StringList/Conv_X2_Collectibles_Skov_Celestia_01.stl",
 "__snoID__": 2457388,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.84B74",
   "szText": "You are certain none of you were followed?",
   "hLabel": 1512701728
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.84B74",
   "szText": "Serious, anxious. Trying to be in control.",
   "hLabel": 3375588685
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.22902A",
   "szText": "(sigh) For the last time, “yes,” Inarius. What is this about?",
   "hLabel": 1773391593
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.22902A",
   "szText": "Irritated and impatient but willing to listen.",
   "hLabel": 3119119030
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.84B74",
   "szText": "It is time we faced the truth of our sin. We were naive to think that angel and demon could ever live as one.",
   "hLabel": 2383606308
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.84B74",
   "szText": "Grim, regretful, anxious",
   "hLabel": 4246493265
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.84B74",
   "szText": "And that sin has born terrible fruit. Children with the strength of Heaven, the fury of Hell...and soon more power than both.",
   "hLabel": 671574950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.84B74",
   "szText": "Grim, anxious. A dire warning.",
   "hLabel": 2534461907
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.22902A",
   "szText": "Interesting how you can fear their power yet so discount their spirit.",
   "hLabel": 4080978991
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.22902A",
   "szText": "Disappointed in Inarius. ",
   "hLabel": 1131739132
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.84B74",
   "szText": "We can ill afford to do otherwise! We either take control or invite our own damnation!",
   "hLabel": 1865737009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.84B74",
   "szText": "Clapping back. This is serious!",
   "hLabel": 3211464446
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.84B74",
   "szText": "What say you?",
   "hLabel": 2736641589
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.84B74",
   "szText": "Challenging the group. Hopes they're with him.",
   "hLabel": 4082369026
  }
 ],
 "ptMapStringTable": "0"
}
