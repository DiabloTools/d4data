   "szText": "Chronicles of Creation",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Kallinos",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B10F",
   "szText": "To my research assistant, if you’re reading this, then...I have failed.",
   "hLabel": 2440883767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25B10F",
   "szText": "Sad, nervous. Having trouble saying the words.",
   "hLabel": 3786611204
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B10F",
   "szText": "I have sent word to the Archives in Caldeum and am awaiting their response. I need to know if they support Akarat before sending my—no, our findings.",
   "hLabel": 1115963835
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B10F",
   "szText": "I know the madness that has overtaken the other scholars will pass one day, but until that time, you need to keep this safe. The truth lives with you, friend. Take good care of it.",
   "hLabel": 1778423801
  }
 ],
 "ptMapStringTable": "0"
}
