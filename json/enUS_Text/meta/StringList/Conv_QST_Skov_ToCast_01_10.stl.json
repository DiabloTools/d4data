{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_ToCast_01_10.stl",
 "__snoID__": 2434682,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Captain Migoso",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24ED2C",
   "szText": "I am trapped. My men—what used to be my men—give me no peace. I hear them. Screaming in these inhuman voices. Nails clawing at the wood at my door.",
   "hLabel": 1777401293
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24ED2C",
   "szText": "Fearful, at the end of her rope, ready to give up",
   "hLabel": 3123128730
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24ED2C",
   "szText": "It must have been the damned Tear of the Firstborn.",
   "hLabel": 1114941327
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.24ED2C",
   "szText": "Angry",
   "hLabel": 2460668764
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24ED2C",
   "szText": "Drollon is a fool for wanting it. For dooming me and my crew. If anyone finds this, destroy that cursed artifact. It is evil.",
   "hLabel": 452481361
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.24ED2C",
   "szText": "\"Damn you Drollon!\"",
   "hLabel": 1798208798
  }
 ],
 "ptMapStringTable": "0"
}
