   "szLabel": "MenuLabel",
   "szText": "\"It felt like my fate was being rewritten. And I could do nothing to stop it.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BD31C",
   "szText": "Such thinking is caustic to life—because it is so close to the truth.",
   "hLabel": 1076092555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BD31C",
   "szText": "This very thought, this terrible realization—it is why I made Sanctuary.",
