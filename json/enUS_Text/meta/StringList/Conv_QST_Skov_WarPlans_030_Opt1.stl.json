{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_WarPlans_030_Opt1.stl",
 "__snoID__": 2495946,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How fares Skovos? Are the Amazons recovering?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCFFD",
   "szText": "Mephisto cut deep wounds into these islands. Wounds that still fester with the remnants of his Hatred.",
   "hLabel": 560384514
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1DCFFD",
   "szText": "Somber",
   "hLabel": 2019716975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCFFD",
   "szText": "Yet you'd be amazed by the Amazons' resilience. Despite all they’ve suffered, they are regrouping, training fresh recruits, gaining ground...",
   "hLabel": 4192891844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1DCFFD",
   "szText": "Proud, admiring",
   "hLabel": 1357257009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4",
   "szText": "No doubt thanks to Tharra.",
   "hLabel": 1854714586
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.BAE4",
   "szText": "Grim, focused",
   "hLabel": 3717601543
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1DCFFD",
   "szText": "A rare soul, that woman. One in a hundred generations...",
   "hLabel": 2867971912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1DCFFD",
   "szText": "Fond, wistful",
   "hLabel": 32337077
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1DCFFD",
   "szText": "(clears throat) Skovos is fortunate to have her.",
   "hLabel": 3177156929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1DCFFD",
   "szText": "Shaking off his feelings, respectful",
   "hLabel": 341522094
  }
 ],
 "ptMapStringTable": "0"
}
