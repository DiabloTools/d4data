 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You said you were chasing leads. What happened?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6D03F",
   "szText": "At first, I did what I could to keep the Cathedral off Neyrelle’s back. Once they got wise to it, I tried a different tack. I rummaged through the Vault and every library I knew of. I even tried finding Tyrael.",
   "hLabel": 1512000330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.6D03F",
   "szText": "Somber. ",
   "hLabel": 3374887287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "All I came back with was empty hands.",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.6D03F",
   "szText": "Somber",
   "hLabel": 4245791867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "The truth is…I hoped it didn’t matter. You were with Neyrelle and you’re a hell of a lot more help than I would ever be. I was ready to be done with it all.",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.6D03F",
   "szText": "Somber",
   "hLabel": 1662855929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.6D03F",
   "szText": "And then…a bird landed at my feet with a message.",
   "hLabel": 670873552
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.6D03F",
   "szText": "Somber",
   "hLabel": 2533760509
  }
 ],
 "ptMapStringTable": "0"
}
