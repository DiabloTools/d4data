   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Dunaxys, Abythos, Coruphar. Does that mean anything to you?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6D03F",
   "szText": "An old scholar's tongue. It matches the phrase written here. Power born of Hell begets Corruption. Dunaxys, Abythos, Coruphar.",
   "hLabel": 1512000330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.6D03F",
   "szText": "Mulling it over, intrigued",
   "hLabel": 3374887287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "Did...did Lilith tell you that?",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.6D03F",
   "szText": "Leaning in, wary",
