 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why have you done this?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.235C4D",
   "szText": "Asked by one who has experienced so little. A handful of water questioning the will of the sea.",
   "hLabel": 2436949340
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8BEB",
   "szText": "And what are we? A drop? An Oracle sees fewer moons than Amazons at war.",
   "hLabel": 1793572447
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.235C4D",
   "szText": "Yes. And they are forgotten by the rise of the sun.",
   "hLabel": 1112029408
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.235C4D",
   "szText": "Those who misprize their sacrifice deserve anathema. A fate befitting the flippant.",
   "hLabel": 449569442
  }
 ],
 "ptMapStringTable": "0"
}
