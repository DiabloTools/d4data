 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line26.251FCD",
   "szText": "Back so soon? Well, you still have your life. That is a blessing.",
   "hLabel": 1502607171
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir26.251FCD",
   "szText": "Puzzled then consiliatory. Warm.",
   "hLabel": 2961939632
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.251FCD",
   "szText": "You were barely gone a moment! Although in there, I imagine it felt like forever.",
   "hLabel": 508917222
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.251FCD",
   "szText": "Confused then rationalizing. Sympathetic.",
   "hLabel": 1968249683
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line32.251FCD",
   "szText": "You’re back! Oh, and shaking like a leaf, poor thing!",
   "hLabel": 486872256
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir32.251FCD",
   "szText": "Surprised then concerned when she sees Player.",
   "hLabel": 1946204717
  }
 ],
 "ptMapStringTable": "0"
