   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You're free, you can flee.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.23FAD1",
   "szText": "These people, they captured me because…well, because I know too much. Yes, too much is what I know!",
   "hLabel": 4083837040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.23FAD1",
   "szText": "Half insane.",
   "hLabel": 1134597181
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.23FAD1",
   "szText": "Demons everywhere! Do you know why? What allows them to slip into Sanctuary?",
   "hLabel": 451329710
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.23FAD1",
   "szText": "Mephisto. The Lord of Hatred walks the land and will come for us all!",
   "hLabel": 1203971993
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.23FAD1",
   "szText": "(whispers)",
   "hLabel": 2663304454
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.23FAD1",
   "szText": "These fools worship Bartuc, but a greater evil rules over them!",
   "hLabel": 541512027
  }
 ],
