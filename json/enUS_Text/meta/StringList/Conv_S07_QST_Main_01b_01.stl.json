   "szLabel": "Line1.1FA017",
   "szText": "Hatred has done this, Gelena! Swamp’s Oath, aren’t you supposed to be a seer?",
   "hLabel": 2459821463
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1FA017",
   "szText": "Arguing. Frustrated. Provoking. He's had a few drinks.",
   "hLabel": 3805548900
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1F9FF1",
   "szText": "I see a frightened old witch who needs to put away his bottle and focus.",
   "hLabel": 1795984566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1F9FF1",
