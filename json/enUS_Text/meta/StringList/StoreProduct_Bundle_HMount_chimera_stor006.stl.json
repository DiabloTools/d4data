   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Description",
   "szText": "A stranger called up to the dragon and asked, \"Oh Dragon Lord, why are you so distraught?\" The dragon told him, \"Seeking power, I killed my brother. But without him, I am lost.\" The stranger replied, \"You have inflicted wounds upon yourself, but now you must heal. Walk on two feet as I do. Find value in humility, then you will find peace.\"",
   "hLabel": 2789670820
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Quote",
   "szText": "Forged in the dragon's breath!",
