 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Am I interrupting?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1FA017",
   "szText": "Bah, I can’t see a damn thing wrong with these heads! But, “if the rot is still in them, they could taint the Tree!” You don't have to tell me again.",
   "hLabel": 562623882
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1FA017",
   "szText": "Frustrated. Grumbling.",
   "hLabel": 2021956343
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1FA017",
   "szText": "(sighs) I’ll need to examine one of the buggers out there in the wild... See if Ouna's got a lead on one, would you? Worked out last time.",
   "hLabel": 3179396297
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1FA017",
   "szText": "Admitting defeat. Grudgingly accepting next steps.",
   "hLabel": 343761462
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1FA02A",
   "szText": "Hmm, nothing certain in the whispers, but... I could ask the Tree directly.",
   "hLabel": 2516936406
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1FA02A",
   "szText": "Thinking. Hesitant yet offering an idea.",
   "hLabel": 3976268867
  }
 ],
 "ptMapStringTable": "0"
}
