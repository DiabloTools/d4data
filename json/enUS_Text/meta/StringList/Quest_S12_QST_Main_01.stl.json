 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "A Taste of Power",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Demonic shrines are appearing in every corner of Sanctuary. What price will we pay for their presence?",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "When I entered the city, a stranger called out for help. I should approach and speak with her to see what she needs.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase16Description",
   "szText": "I should follow Teyana to the Umbral Study. ",
   "hLabel": 1452320540
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback15Header",
   "szText": "Travel to The Umbral Study",
   "hLabel": 3113074012
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase23Description",
   "szText": "The ritual turned me into a Butcher. I should speak with Khulrami and learn more. ",
   "hLabel": 320182394
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback25Header",
   "szText": "Speak with Khulrami",
   "hLabel": 2781844029
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase29Description",
   "szText": "I should make haste and speak with him to learn more.",
   "hLabel": 952748224
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback31Header",
   "szText": "Speak with Khulrami",
   "hLabel": 1579709466
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase46Description",
   "szText": "I got a strange item from the slaughterhouse. I should see if anyone might have use for it. ",
   "hLabel": 1152238495
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback52Header",
   "szText": "Travel to Gea Kul",
   "hLabel": 2208717469
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback219Header",
   "szText": "Buy an item from the Vendor",
   "hLabel": 2484047922
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase47Description",
   "szText": "Teyana is waiting for me outside the workshop. I will speak with her.",
   "hLabel": 1973494016
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback54Header",
   "szText": "Speak with Teyana",
   "hLabel": 496686111
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase49Description",
   "szText": "I should make haste and speak with him to learn more.",
   "hLabel": 3616005058
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback60Header",
   "szText": "Speak with Khulrami",
   "hLabel": 3589518844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback74Header",
   "szText": "Speak with Teyana",
   "hLabel": 4129193441
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase67Description",
   "szText": "I've found him in a strange place. I must try to speak with him and stop this before it's too late.",
   "hLabel": 341783554
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback76Header",
   "szText": "Speak with Khulrami",
   "hLabel": 2417162083
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase68Description",
   "szText": "I agreed to help Teyana and stop Khulrami. I must go into the workshop and confront him.",
   "hLabel": 1163039075
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback80Header",
   "szText": "Enter The Umbral Study",
   "hLabel": 2927058878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase65Description",
   "szText": "He transformed. I must stop this by force. ",
   "hLabel": 2994239808
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback85Header",
   "szText": "Kill the Butcher",
   "hLabel": 794464131
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase101Description",
   "szText": "II have the blood. I must return it to Khulrami.",
   "hLabel": 3793763495
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback103Header",
   "szText": "Speak with Khulrami",
   "hLabel": 1702092234
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase107Description",
   "szText": "I have the blood. I must return it to Khulrami.",
   "hLabel": 131362029
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback109Header",
   "szText": "Travel to The Umbral Study",
   "hLabel": 860965456
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase126Description",
   "szText": "I have the blood. I must return it to Khulrami.",
   "hLabel": 1973363342
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback209Header",
   "szText": "Return to Gea Kul",
   "hLabel": 2815277905
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase48Description",
   "szText": "Khulrami wants me to complete a slaughterhouse to better understand the transformation. ",
   "hLabel": 2794749537
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback58Header",
   "szText": "Use a Slaughterhouse Key to Complete a Slaughterhouse",
   "hLabel": 1367590691
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase169Description",
   "szText": "Khulrami wants me to collect blood from demons summoned by the Butcher shrines. I must go to Helltide.",
   "hLabel": 1173708981
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback168Header",
   "szText": "Summon Demons at a Shrine of Slaughter in Helltide",
   "hLabel": 1877084885
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback213Header",
   "szText": "Slay these demons and collect their Blood",
   "hLabel": 3325174700
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase181Description",
   "szText": "Khulrami and Teyana want me to participate in a ritual. I should activate the shrine as they ask. ",
   "hLabel": 1561888943
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback188Header",
   "szText": " Activate the Shrine",
   "hLabel": 1214624919
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback196Header",
   "szText": "Slay Demons",
   "hLabel": 2595426294
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback199Header",
   "szText": "Monsters Slaughtered: {DONE}",
   "hLabel": 2174862905
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback230Header",
   "szText": "Take the portal in The Umbral Study to find Khulrami",
   "hLabel": 3083278123
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase183Description",
   "szText": "I should slay the demons summoned by the ritual. ",
   "hLabel": 3204399985
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback262Header",
   "szText": "Kill the Butcher",
   "hLabel": 377556816
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback234Header",
   "szText": "Speak with the Stranger in Gea Kul",
   "hLabel": 3954182703
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase266Description",
   "szText": "He changed back. Perhaps I can talk some sense into him and Teyana.",
   "hLabel": 3998974515
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback265Header",
   "szText": "Speak with Khulrami",
   "hLabel": 4251960723
  }
 ],
