 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What do you know of the reapers?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "Nothing encouraging. The histories say they murdered well over half of humankind...led by the Angel of Death hisself.",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Grim",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27ED42",
   "szText": "But my old gran said it was mortals who managed to stop them. Heroes...",
   "hLabel": 1780959073
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.27ED42",
   "szText": "Trying to find an upside",
   "hLabel": 3126686510
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27ED42",
   "szText": "I reckoned it all a tall tale for babes and halfwits, ‘til you came round.",
   "hLabel": 1118499107
  }
 ],
 "ptMapStringTable": "0"
}
