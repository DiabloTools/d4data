 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "(Akarat)",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4",
   "szText": "(cries out in pain)",
   "hLabel": 2989640983
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.BAE4",
   "szText": "Sudden, seizing agony. Can't move.",
   "hLabel": 557560644
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.25DC91",
   "szText": "(gasps, screams)",
   "hLabel": 1835665237
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.25DC91",
   "szText": "Shocked, terrified",
   "hLabel": 3294997698
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1D90EA",
   "szText": "Look! See the Hatred behind their mask!",
   "hLabel": 1188208835
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.1D90EA",
   "szText": "Announced to the crowd. Fire and brimstone.",
   "hLabel": 2647541296
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.BD9D3",
   "szText": "They will all see it soon. Everyone you have fought to save, turned against you, simply by hearing the truth.",
   "hLabel": 3327806679
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.BD9D3",
   "szText": "In Player's mind. Smiling, sinister, certain.",
   "hLabel": 378566820
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.BD9D3",
   "szText": "That you have been hiding the Daughter of Hatred inside of you. Hiding me...",
   "hLabel": 1254767536
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.BD9D3",
   "szText": "In Player's mind. Smiling, sinister...leaning in close.",
   "hLabel": 2600494973
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.BD31C",
   "szText": "ENOUGH!",
   "hLabel": 3837695305
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.BD31C",
   "szText": "Shouting, furious. Spoken aloud from Player's body.",
   "hLabel": 888455446
  }
 ],
 "ptMapStringTable": "0"
}
