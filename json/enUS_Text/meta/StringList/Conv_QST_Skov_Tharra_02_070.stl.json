{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Tharra_02_070.stl",
 "__snoID__": 2457749,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I've carved my name into the clay.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCC9B",
   "szText": "Adreona’s name is here. She walked this path after she won queenship through combat.",
   "hLabel": 2457577341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCC9B",
   "szText": "Tight and clipped. Bitter. ",
   "hLabel": 3803304778
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "She swore the same oaths, and forsook every last one of them.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCC9B",
   "szText": "Yet even now I…I feel the loss of her. I would wish that you had known her before. But maybe I was too blind to see what she always was.",
   "hLabel": 1132657409
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DCC9B",
   "szText": "Voice low and uneven. Struggling to stay composed as grief and resentment blur together. Not an emotional meltdown. ",
   "hLabel": 2478384846
  }
 ],
 "ptMapStringTable": "0"
}
