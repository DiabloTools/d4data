   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.1D8FD7",
   "szText": "People of Skovos, the fires of the mainland have at last spread to our shores. Our Amazons fight valiantly against them, but we are not equal to this threat.",
   "hLabel": 2480084112
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.1D8FD7",
   "szText": "Sober, sincere.",
   "hLabel": 3939416573
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.1D8FD7",
   "szText": "We must place our hope and our lives in Akarat’s hands. Follow him, with me, to Atanos. And I swear upon my shield, the darkness will pass.",
   "hLabel": 2789269129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.1D8FD7",
   "szText": "Confident, reassuring.",
   "hLabel": 4248601590
  }
 ],
