{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Fishing_Unlock01_02.stl",
 "__snoID__": 2213938,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are the fish not biting today?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.21C82F",
   "szText": "Eh? Uh, come again?",
   "hLabel": 2436183709
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.21C82F",
   "szText": "Didn't hear what Player said, annoyed by the interruption",
   "hLabel": 3781911146
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4",
   "szText": "I asked, are the fish not biting?",
   "hLabel": 3639732837
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.BAE4",
   "szText": "Speaking up for the old man to hear. Polite.",
   "hLabel": 572571378
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.21C82F",
   "szText": "Uh um, fish not biting? (scoffs) Well, how could they? What with you stomping around in your big fat boots, shouting at the top of your lungs! Ughh!",
   "hLabel": 1201446094
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.21C82F",
   "szText": "Irritated, ranting. Letting out frustration.",
   "hLabel": 2660778555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.21C82F",
   "szText": "No respect or sense at all... No wonder the world's gone to Hell!",
   "hLabel": 538986128
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.21C82F",
   "szText": "Grumbling irritation",
   "hLabel": 1998318589
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.BAE4",
   "szText": "True enough. I'd best be going.",
   "hLabel": 3796274409
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.BAE4",
   "szText": "Mildly offended, turning to leave. (Player does have more important things to do)",
   "hLabel": 729112950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.21C82F",
   "szText": "Ohh and no patience, either huh? (scoffs) Why don’t you take the rod? Cast the line and be still for a damn moment (chuckles). We'll see if the fish will bite for you.",
   "hLabel": 4081311141
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.21C82F",
   "szText": "Annoyed, eager to teach Player a lesson",
   "hLabel": 1132071282
  }
 ],
 "ptMapStringTable": "0"
}
