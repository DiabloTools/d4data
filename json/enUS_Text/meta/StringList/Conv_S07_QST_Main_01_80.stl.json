{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_01_80.stl",
 "__snoID__": 2118188,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You owe me an explanation. What was that thing?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.1F9FF1",
   "szText": "I apologize for not telling the whole story. But I thought it better to show you what we are up against.",
   "hLabel": 892476934
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir12.1F9FF1",
   "szText": "Catching breath. Genuine. Foreboding.",
   "hLabel": 2351809395
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.1F9FF1",
   "szText": "This head was stolen from the Tree of Whispers. By who or what, I do not know, but it was attached to dead flesh and this...rot was allowed to spread.",
   "hLabel": 1554936900
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir10.1F9FF1",
   "szText": "Grim. Deadly serious.",
   "hLabel": 3014269361
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.1F9FF1",
   "szText": "It was not the only one, either. Please, return this head to the Tree and see for yourself what has happened. I will give you my teaching as promised.",
   "hLabel": 230016968
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir14.1F9FF1",
   "szText": "Foreboding. Emphatic.",
   "hLabel": 1689349429
  }
 ],
 "ptMapStringTable": "0"
}
