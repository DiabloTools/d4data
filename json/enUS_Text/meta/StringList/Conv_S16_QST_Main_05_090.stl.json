 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Easy, my friend. Are you hurt?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCFFD",
   "szText": "I should have told you everything. I swore an oath of secrecy...but it was guilt that prevented me.",
   "hLabel": 2457582095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCFFD",
   "szText": "Catching breath, heavy with regret",
   "hLabel": 3803309532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line6.1DCFFD",
   "szText": "The Nameless. He was a young man when I found him in the wilds, gathering forbidden knowledge. I judged him dangerous, yet...promising.",
   "hLabel": 801432180
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir6.1DCFFD",
   "szText": "heavy with regret",
   "hLabel": 2147159617
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.1DCFFD",
   "szText": "I brought him among my first Horadrim, hoping to give him purpose. But to fulfill it, he committed atrocities, he...made himself immortal.",
   "hLabel": 138972214
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.1DCFFD",
   "szText": "heavy with regret",
   "hLabel": 1484699651
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.1DCFFD",
   "szText": "We could not kill him, so we buried him alive... But how has he returned? Who does he serve? I don't—",
   "hLabel": 1554074463
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir10.1DCFFD",
   "szText": "heavy with regret, then confused",
   "hLabel": 3013406924
  }
 ],
 "ptMapStringTable": "0"
}
