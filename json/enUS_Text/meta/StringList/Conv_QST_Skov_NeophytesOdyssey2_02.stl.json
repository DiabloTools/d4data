   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Having some trouble with your preaching?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.228AA8",
   "szText": "It’s good to see you again. Every day, I thank the Light you came to my aid in Temis.",
   "hLabel": 2435870493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.228AA8",
   "szText": "TEM-iss                   Happy to see the Player--happy to have an excuse to stop preaching.",
   "hLabel": 3781597930
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.228AA8",
   "szText": "Do you mind taking a walk? My sermon is a disaster… I could use an excuse to leave.",
   "hLabel": 1773410527
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.228AA8",
