 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You've carried much of this burden yourself.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "Aye, it's a wonder, innit? Why me who’s got every reason to just sit by and let it come?",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Bitter",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27ED42",
   "szText": "I lost someone, all right? He helped me when I was lost. Talked me into thinking there was still Light to be had in this life.",
   "hLabel": 1780959073
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.27ED42",
   "szText": "Grief",
   "hLabel": 3126686510
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27ED42",
   "szText": "Then he walked off into the night with the rest of them. Bloody hypocrite... He doesn’t get to do this.",
   "hLabel": 1118499107
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.27ED42",
   "szText": "Grief and anger",
   "hLabel": 2464226544
  }
 ],
 "ptMapStringTable": "0"
