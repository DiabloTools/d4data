{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Tharra_03_DSQ_290.stl",
 "__snoID__": 2475777,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How do you feel?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCC9B",
   "szText": "I don’t know why all this has come to pass.  I wish others were meant to bear it. But it is mine to hold.",
   "hLabel": 2457577341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCC9B",
   "szText": "Emotionally raw. ",
   "hLabel": 3803304778
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "I will return to Temis for the Council’s decision. But there is something I must do alone first.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCC9B",
   "szText": "I will hold a funeral for Adreona, along the beach she once loved. I would not ask you there after what she did to your friend.",
   "hLabel": 1132657409
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DCC9B",
   "szText": "Quiet, exhausted, and raw",
   "hLabel": 2478384846
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "I will mourn what she once was. For me.",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "“For me.” - the most vulnerable and soft",
   "hLabel": 1815924880
  }
 ],
 "ptMapStringTable": "0"
}
