{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_NeophytesOdyssey3_09.stl",
 "__snoID__": 2366785,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Adoné?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22B189",
   "szText": "Good. You’re here—both of you. There is much to be done if we are to complete Akarat’s work here on Skovos. Come, and I—",
   "hLabel": 2437326223
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.22B189",
   "szText": "Determined, ready to work. She sees the Player and Bnatros as helpers. She is not speaking like a villain: she truly believes she is doing something good.",
   "hLabel": 3783053660
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.228AA8",
   "szText": "Adoné! Stop.",
   "hLabel": 1110950561
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.228AA8",
   "szText": "Cutting her off. He can't see his former friend do these things anymore. He's going to speak some truth to her.",
   "hLabel": 2456677998
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.22B189",
   "szText": "What’s wrong, brother?",
   "hLabel": 449946325
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.22B189",
   "szText": "Perplexed that Bnatros seems worried",
   "hLabel": 1795673762
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.228AA8",
   "szText": "What’s wrong? This is all wrong.",
   "hLabel": 4080997925
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.228AA8",
   "szText": "I wish I had seen it earlier, but the stories were true. The Akarat who came to Skovos was a demon. This is what he left behind. We have to destroy all of it.",
   "hLabel": 3155445327
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.22B189",
   "szText": "(scoffs) Destroy His beautiful work?",
   "hLabel": 1202588608
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.22B189",
   "szText": "Offended",
   "hLabel": 2661921069
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.228AA8",
   "szText": "Come with us. You remember the Temple of Life, right? The smell of the forests? We can—",
   "hLabel": 2492985361
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.228AA8",
   "szText": "Trying to break through to Adone and appeal to whatever is left of her true self.",
   "hLabel": 3952317822
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.22B189",
   "szText": "Agh, heretic! You will not ruin this beautiful future Akarat has planned!",
   "hLabel": 540128642
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.22B189",
   "szText": "Furious. She sees Bnatros as a threat to her \"holy\" work.",
   "hLabel": 1999461103
  }
 ],
 "ptMapStringTable": "0"
}
