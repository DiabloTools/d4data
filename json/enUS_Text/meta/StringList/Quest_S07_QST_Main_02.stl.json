 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "In the Name of the Tree",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Gelena needs my aid in retrieving a missing head.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase8Description",
   "szText": "The witches aim to perform a cleansing ritual for the Tree, one that invokes its Old Name. Belith the Elder knew this name, though her head is lost like the rest. I should seek her out at the Silent Roothold in the Fractured Peaks.",
   "hLabel": 1557588493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback7Header",
   "szText": "Enter the {WORLD:S07_DGN_Witcher_Frac}",
   "hLabel": 2677071405
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback93Header",
   "szText": "Acquire {ITEM:QST_S07_Main_02_TrueNameHead}",
   "hLabel": 2175265506
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase18Description",
   "szText": "Each member of the Coven has trained in different schools of witchcraft. They've offered to teach me of their ways.",
   "hLabel": 3094831582
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback17Header",
   "szText": "Speak with Gelena",
   "hLabel": 1401042654
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase34Description",
   "szText": "I returned to the Tree to find Gelena in the company of two others. Who could they be?",
   "hLabel": 2473066332
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback48Header",
   "szText": "Speak with Gelena",
   "hLabel": 1698820674
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase32Description",
   "szText": "Each member of the Coven has trained in different schools of witchcraft. They've offered to teach me of their ways.",
   "hLabel": 830555290
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback60Header",
   "szText": "Inspect one of the Altars of Witchcraft",
   "hLabel": 3589518844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase84Description",
   "szText": "I claimed Belith's head. Now, the witches may perform the cleansing ritual.",
   "hLabel": 541273825
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback83Header",
   "szText": "Bring {ITEM:QST_S07_Main_02_TrueNameHead} to the Coven",
   "hLabel": 2506495489
  }
 ],
