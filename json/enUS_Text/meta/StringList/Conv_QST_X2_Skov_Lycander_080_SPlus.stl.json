{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_X2_Skov_Lycander_080_SPlus.stl",
 "__snoID__": 2506794,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"There's something wrong with me.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line71.6D03F",
   "szText": "Wrong? How do you mean?",
   "hLabel": 4172623009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir71.6D03F",
   "szText": "(grave, got a bad feeling) ",
   "hLabel": 1223383150
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4",
   "szText": "(grunts)",
   "hLabel": 3639732837
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line73.1DCC9B",
   "szText": "Lorath?",
   "hLabel": 3696319862
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir73.1DCC9B",
   "szText": "(a warning) ",
   "hLabel": 860685027
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BAE4",
   "szText": "(cries out)",
   "hLabel": 3718003623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BD9D3",
   "szText": "Ah. Finally. Now we’re alone.",
   "hLabel": 3306001381
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.BD9D3",
   "szText": "one-on-one, intimate",
   "hLabel": 873921042
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line67.BD9D3",
   "szText": "Calm yourself. I don’t intend to hurt you—not yet. I just want to talk.",
   "hLabel": 3714918105
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BAE4",
   "szText": "Get out of my head!",
   "hLabel": 1619902228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.BAE4",
   "szText": "forceful, in pain",
   "hLabel": 3482789185
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.6D03F",
   "szText": "Woah—easy.",
   "hLabel": 1023908833
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line75.6D03F",
   "szText": "What’s going on?",
   "hLabel": 748560293
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir75.6D03F",
   "szText": "Deep concern. ",
   "hLabel": 2094287730
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.BAE4",
   "szText": "Lorath...we’re running out of time. Get to Athulua. Find the blade. I can deal with this on my own. Trust me.",
   "hLabel": 64412442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.BAE4",
   "szText": "(winded, shaky, but forceful) ",
   "hLabel": 1927299399
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.6D03F",
   "szText": "Are you sure?",
   "hLabel": 361448867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.6D03F",
   "szText": "(with emphasis)",
   "hLabel": 1707176304
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line77.6D03F",
   "szText": "(sighs) ...All right.",
   "hLabel": 3331496231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir77.6D03F",
   "szText": "grudgingly.",
   "hLabel": 382256372
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.1DCC9B",
   "szText": "They are not well. If we leave them here—",
   "hLabel": 2481624760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.1DCC9B",
   "szText": "concerned, a bit baffled by Lorath's choice to leave",
   "hLabel": 3940957221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.6D03F",
   "szText": "They know what they’re doing. And Mephisto’s not going to give us any room to breathe.",
   "hLabel": 871345662
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.6D03F",
   "szText": "Besides, you need to tell Adreona what you saw here.",
   "hLabel": 3454281600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.6D03F",
   "szText": "a bit reluctant. he's not eager to see Adreona again, and he doesn't want to leave Player behind",
   "hLabel": 505041741
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line79.6D03F",
   "szText": "C’mon.",
   "hLabel": 1619464873
  }
 ],
 "ptMapStringTable": "0"
}
