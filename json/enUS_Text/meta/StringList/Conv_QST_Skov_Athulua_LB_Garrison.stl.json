   "szText": "Scout's Journal",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Scout Koraki",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.229670",
   "szText": "It feels like only yesterday, I was standing in the Temple of Courage. Shoulder to shoulder with my chosen sisters.",
   "hLabel": 2459905628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.229670",
   "szText": "Somber, reflective",
   "hLabel": 3919238089
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.229670",
   "szText": "I can still feel the sun on my face, smell the goat’s blood on my cheeks. And hear Captain Tharra’s pride when she first called us “Amazons.”",
   "hLabel": 781710747
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.229670",
   "szText": "Somber, reflective",
   "hLabel": 2241043208
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line49.229670",
   "szText": "Now smoke rises from our Temple. How did we let this happen? Why do I feel so ashamed?",
   "hLabel": 119250781
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir49.229670",
   "szText": "Anguish, shame",
   "hLabel": 1578583242
  }
 ],
