{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Philios01_001.stl",
 "__snoID__": 2254950,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Lorath, what happened in there?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6D03F",
   "szText": "I saw...he was...I walked right into his trap.",
   "hLabel": 1512000330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.6D03F",
   "szText": "shell shocked",
   "hLabel": 3374887287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "This is how he wants me. Confused. Panicked. With the blood of my friend all over my own damn hands.",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BAE4",
   "szText": "So, what next? We can't give up now. Neyrelle died to get us here.",
   "hLabel": 3718003623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.6D03F",
   "szText": "(sighs) You’re right...you’re right. What’s done is done.",
   "hLabel": 670873552
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.6D03F",
   "szText": "Still in shock, trying to compose himself, taking time to process everything.",
   "hLabel": 2533760509
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "Neyrelle said to seek the Oracle. That’s why I've lugged around the Sightless Eye.",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.6D03F",
   "szText": "Still taking time to process things.",
   "hLabel": 3210763048
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "Let me try to get my bearings. If memory serves, her Sanctum won’t be far.",
   "hLabel": 3253809490
  }
 ],
 "ptMapStringTable": "0"
}
