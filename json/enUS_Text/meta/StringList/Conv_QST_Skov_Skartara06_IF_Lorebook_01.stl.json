  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.255901",
   "szText": "Tal, I hate to complain, but our last delivery of pipe-leaf was abysmal. One breath, and such a painful fog descended that I became lost in my own chambers.",
   "hLabel": 2439275261
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.255901",
   "szText": "Complaining, indignant.",
   "hLabel": 3785002698
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.255901",
   "szText": "For our next order, might we stipulate that the leaf be “Caldean” in origin? Tarsarak is no substitute.",
   "hLabel": 1114355329
  }
 ],
