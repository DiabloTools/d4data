{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_X2_Skov_Lycander_04_130.stl",
 "__snoID__": 2414936,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What exactly happened here?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23785E",
   "szText": "A-A group of pilgrims came—",
   "hLabel": 2436974421
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.237867",
   "szText": "Not just pilgrims. They called themselves the Hands of Akarat.",
   "hLabel": 1774514442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.23785E",
   "szText": "Yes. Hands. A few wanted access to the archives, so we let them below the Temple.",
   "hLabel": 1112054489
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.23785E",
   "szText": "The others wanted to tour the grounds. That’s when it started. The...the...",
   "hLabel": 4082101853
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line16.237867",
   "szText": "The violence.",
   "hLabel": 3841054174
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.6D03F",
   "szText": "Can you get us into the archives?",
   "hLabel": 3156503580
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir12.6D03F",
   "szText": "Gently",
   "hLabel": 207263721
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.23785E",
   "szText": "The Curator had the key. He...didn’t make it.",
   "hLabel": 208546857
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.237867",
   "szText": "But we will help. Right, everyone? We’ll find the body.",
   "hLabel": 449594510
  }
 ],
 "ptMapStringTable": "0"
}
