 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Bnatros, are you all right?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.228AA8",
   "szText": "You were right about this “false Akarat” back in Temis. If I’d only listened to you. I just...I wanted to see for myself. I wanted to believe.",
   "hLabel": 2435870493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.228AA8",
   "szText": "Troubled by everything he's scene, but coming to a realization. Steeling himself. Pronunciation: TEM-iss",
   "hLabel": 3781597930
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.228AA8",
   "szText": "I swear to you, an oath of the Light. I-no, we will make these demons suffer.",
   "hLabel": 1110950561
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.228AA8",
   "szText": "Confident, determined",
   "hLabel": 2456677998
  }
 ],
 "ptMapStringTable": "0"
}
