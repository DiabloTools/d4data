  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You were sent here to grieve Adreona. You have just grown angrier.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "Grieve her? What should I grieve? She died long before you ran her through!",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "Heated, escalating anger at every line",
   "hLabel": 1815924880
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "After handing Skovos to Mephisto. Corrupting the whole of the Amazons! Murdering Lorath!",
   "hLabel": 1222839726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCC9B",
   "szText": "Emotion spiral from disbelief to fury from beginning to end. ",
   "hLabel": 2682172187
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCC9B",
   "szText": "I grieve I didn't get to kill her myself!",
   "hLabel": 560379760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1DCC9B",
   "szText": "Unrestrained emotion",
   "hLabel": 2019712221
  }
 ],
