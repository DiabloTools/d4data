   "szLabel": "MenuLabel",
   "szText": "\"What is this?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.20FFCC",
   "szText": "I'm recording all I can gather about these Apparition attacks. Looking for patterns, clues to Belial's plans.",
   "hLabel": 2435157307
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.20FFCC",
   "szText": "Bring me anything you find out about them. I'll share with you any useful weapons or artifacts that my research unearths.",
   "hLabel": 1772697341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.20FFCC",
   "szText": "Go. Return to me when you've made progress.",
