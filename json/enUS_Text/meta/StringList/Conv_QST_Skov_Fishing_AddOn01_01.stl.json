{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Fishing_AddOn01_01.stl",
 "__snoID__": 2313238,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Thank you for the fishing rod. Is there some way I can repay you?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.21C82F",
   "szText": "I have no use for your gold or your pity. If you want to repay me, just leave me alone. Catch all the fish in Skovos if you like!",
   "hLabel": 4171493458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.21C82F",
   "szText": "Dejected, dismissive. Last sentence interrupted by an idea.",
   "hLabel": 1335858623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.21C82F",
   "szText": "Em, uhh, don't go! O-On second thought, perhaps I could use your beginner’s luck? Go and catch me a few fish. Th-the stranger, the better, eh? (chuckles)",
   "hLabel": 2846573526
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.21C82F",
   "szText": "Scheming, cryptic",
   "hLabel": 10938691
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4",
   "szText": "You want strange fish... Nothing in particular?",
   "hLabel": 2911370197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.BAE4",
   "szText": "A little confused",
   "hLabel": 479289858
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.21C82F",
   "szText": "Shiny scales, devious eyes, I-I’ll know it when I see it. Off you go!",
   "hLabel": 2493298577
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.21C82F",
   "szText": "Describing a hazy dream, then dismissing the Player",
   "hLabel": 3952631038
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.229CD1",
   "szText": "(meows)",
   "hLabel": 1830563602
  }
 ],
 "ptMapStringTable": "0"
}
