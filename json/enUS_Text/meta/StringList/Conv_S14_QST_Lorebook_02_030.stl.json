   "szLabel": "MenuLabel",
   "szText": "My Absolution, Part 3",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Unknown",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "As the pitiless earth pressed down on me, I shouted until my voice fell silent. Such devastating silence. Yet once it settled, I came faintly to hear the world above.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2808AB",
   "szText": "Somber",
   "hLabel": 3788381353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.2808AB",
   "szText": "Cries of pain. Wails of despair. Ebbing and flowing and ebbing, century after century...until I heard the scream.",
   "hLabel": 545456335
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.2808AB",
   "szText": "Somber, heavy. Then a glimmer of hope.",
   "hLabel": 2004788796
  }
 ],
 "ptMapStringTable": "0"
}
