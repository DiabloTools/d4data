   "szLabel": "DisembodiedVoice",
   "szText": "Florid Letter",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.228086",
   "szText": "\"Can a man fall in love with a voice? Oft, I've been slandered for loving mine own, but this–THIS! Her song is gossamer, drifting on the ocean breeze!",
   "hLabel": 2435815777
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.228086",
   "szText": "Excited, passionate. A young man in love.",
   "hLabel": 3781543214
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.228086",
   "szText": "I am taking my lute...we shall sing together, this creature and I, or I shall die of a shattered heart! Wish me luck!\" –Fereatos the Bard",
   "hLabel": 1773355811
  },
