   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.6D03F",
   "szText": "The city was built around an old coliseum, just southeast of here. That’s where we should look first.",
   "hLabel": 692678850
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.6D03F",
   "szText": "slightly winded, on the move",
   "hLabel": 2038406287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.6D03F",
   "szText": "The Askari have tried to settle here for years. These homes, they were the most recent attempt.",
   "hLabel": 3275614788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.6D03F",
   "szText": "But the curse is in the soil. Crops wither. People starve. Foul things grow where nothing else will.",
   "hLabel": 1202575645
  }
 ],
 "ptMapStringTable": "0"
}
