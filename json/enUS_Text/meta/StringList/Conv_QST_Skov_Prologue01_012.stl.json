{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Prologue01_012.stl",
 "__snoID__": 2389402,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.20872F",
   "szText": "But beware those who sully Akarat's name. They walk these very docks.",
   "hLabel": 2433451408
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.20872F",
   "szText": "Preaching to a crowd. Not fire and brimstone--he has a firm and gentle tone. Projected a bit to speak to a crowd of two dozen people.",
   "hLabel": 3779178845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.20872F",
   "szText": "Don’t they, old man?",
   "hLabel": 1108531476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.20872F",
   "szText": "Not fire and brimstone--he has a firm and gentle tone. He has noticed Lorath walking on the docs, and he calls out to him.",
   "hLabel": 2454258913
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.6D03F",
   "szText": "Me?",
   "hLabel": 670873552
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.6D03F",
   "szText": "Annoyed he is being called out, but trying to hide it and stay peaceful.",
   "hLabel": 2533760509
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.20872F",
   "szText": "Yes. Do you truly seek Akarat’s favor? Or are you driven by darker impulses?",
   "hLabel": 4078578840
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.20872F",
   "szText": "Ah-kah-raht",
   "hLabel": 1129338981
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "No dark impulses in this heart, my friend. I only seek the truth.",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.6D03F",
   "szText": "Playing it cool. He doesn't want to make a scene. LINE PICK-UP: Projected more.",
   "hLabel": 1662855929
  }
 ],
 "ptMapStringTable": "0"
}
