 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Rathma",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.FD852",
   "szText": "I feel a strange emptiness, seeing this place.",
   "hLabel": 1080841767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.FD852",
   "szText": "Did she deserve this? Perhaps. The world is choked with corpses but...she did it all for us.",
   "hLabel": 3663777705
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.FD852",
   "szText": "No, that is not quite the truth, is it? She did it for me.",
   "hLabel": 1590738562
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.FD852",
   "szText": "A queasy cognitive dissonance",
   "hLabel": 2936465999
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.FD852",
   "szText": "Oh, what a bitter knowing.",
   "hLabel": 4173674500
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.FD852",
   "szText": "unable to stomach the thought, overcome with emotion",
   "hLabel": 1224434641
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.FD852",
   "szText": "The blade will remain here. It belongs here.",
   "hLabel": 2461643142
  }
 ],
 "ptMapStringTable": "0"
}
