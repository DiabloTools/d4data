 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"The whole island is burning. Climbing the mountain now seems like suicide.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.1DCFFD",
   "szText": "Perhaps. But we must reforge the blade, and the Vault is our best chance.",
   "hLabel": 1465894599
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.1DCFFD",
   "szText": "close proximity",
   "hLabel": 2925227060
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line49.1DCFFD",
   "szText": "In all the history of the Horadrim, every attempt to deal with Mephisto has ended in disaster. If we can banish him to the Void...it is worth any risk.",
   "hLabel": 140974667
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.6D03F",
   "szText": "So, (grunts) we best move now. Before things get any worse.",
   "hLabel": 30218884
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.6D03F",
   "szText": "stretching",
   "hLabel": 1375946321
  }
