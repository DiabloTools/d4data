   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I'm sorry, Tharra.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCC9B",
   "szText": "Their blood is on my hands. I should have stopped Adreona when I had the chance. None of this might have happened.",
   "hLabel": 4102704773
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1DCC9B",
   "szText": "Low and shaken. Guilt-laden",
   "hLabel": 1153464914
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCC9B",
   "szText": "It is an ill omen for the start of a Passage. I need to tend to the dead before I continue my trials with you.",
   "hLabel": 4192887090
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCC9B",
   "szText": "Once I’ve honored them, then I will meet you in Philios.",
   "hLabel": 3530427124
  }
 ],
 "ptMapStringTable": "0"
}
