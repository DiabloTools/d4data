   "szLabel": "MenuLabel",
   "szText": "\"If Mephisto sent you to bait me, he sent you to die.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24B304",
