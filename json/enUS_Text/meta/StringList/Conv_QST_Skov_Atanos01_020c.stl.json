{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Atanos01_020c.stl",
 "__snoID__": 2481222,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You promise salvation and leave death in your wake. You sow division. You are Hatred.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1D90EA",
   "szText": "Ohh, such bitter words. Tell me, can you even be sure they are yours?",
   "hLabel": 2866403716
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1D90EA",
   "szText": "Shaking head, somber, seemingly empathetic",
   "hLabel": 30768881
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1D90EA",
   "szText": "Or do they belong to the evil inside you—who has claimed you as her vessel?",
   "hLabel": 3175588733
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1D90EA",
   "szText": "Incisive, knowing. Referring to Lilith.",
   "hLabel": 339953898
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1D90EA",
   "szText": "It is she who leaves death in her wake. She who slaughtered the Fractured Peaks, burned Scosglen, bled Caldeum, corrupted blessed Nahantu!",
   "hLabel": 2513128767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1D90EA",
   "szText": "Darkening, mounting outrage. About to seize the demon (Lilith) inside Player.",
   "hLabel": 3972461228
  }
 ],
 "ptMapStringTable": "0"
}
