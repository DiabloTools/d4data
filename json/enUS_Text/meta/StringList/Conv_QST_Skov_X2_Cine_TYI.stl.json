{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_X2_Cine_TYI.stl",
 "__snoID__": 2221125,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Have you lost your mind? You could have been killed!\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.6D03F",
   "szText": "And what if I had? What difference would it make?",
   "hLabel": 3785511583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.6D03F",
   "szText": "Shrugging, dejected. Tired it all.",
   "hLabel": 836271724
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.BAE4",
   "szText": "Lorath, you can't let Mephisto win. We can't...I need you with me.",
   "hLabel": 64412442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.BAE4",
   "szText": "Pleading, emphatic. Lorath is the only friend they have left.",
   "hLabel": 1927299399
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.6D03F",
   "szText": "Yes, just as Elias needed me. And Donan, and Neyrelle...and now, Adreona. I had only to warn her about Mephisto, and ended up slashing her throat.",
   "hLabel": 361448867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.6D03F",
   "szText": "Snapping, tearful, ranting. ",
   "hLabel": 1707176304
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.6D03F",
   "szText": "(sniffs) She was right. Given every chance, I have failed my people and my duty as Horadrim. I am not worthy of the mark.",
   "hLabel": 2944384805
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.6D03F",
   "szText": "Deflating, giving up. ",
   "hLabel": 4290112242
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.6D03F",
   "szText": "I warned them. Why won’t they ever listen?",
   "hLabel": 670873552
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.6D03F",
   "szText": "Speaking aloud, but to himself. Dejected, feeling hopeless.",
   "hLabel": 2533760509
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.6D03F",
   "szText": "(sighing)",
   "hLabel": 2404710208
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.6D03F",
   "szText": "weak, labored",
   "hLabel": 3750437645
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "Ah, there you are. I was wondering when the Tree would send you.",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.6D03F",
   "szText": "Quiet, exhausted",
   "hLabel": 3210763048
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BAE4",
   "szText": "Back! Back!",
   "hLabel": 3874545195
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.BAE4",
   "szText": "shouting at the crows as they shoo them away",
   "hLabel": 807383736
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4",
   "szText": "Get away from him!",
   "hLabel": 3561462051
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.BAE4",
   "szText": "shouting at the crows as they shoo them away",
   "hLabel": 494300592
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "(sighs) Don’t bother. This is my fate.",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.6D03F",
   "szText": "Quiet, exhausted",
   "hLabel": 1498731690
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCFFD",
   "szText": "Lorath. Is that you?",
   "hLabel": 4192891844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1DCFFD",
   "szText": "Disbelief, hint of suspicion",
   "hLabel": 1357257009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.6D03F",
   "szText": "Mephisto, no more damn tricks!",
   "hLabel": 3606844771
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.6D03F",
   "szText": "Suspicious, angry. He thinks this is another trick by Mephisto - it can't actually be Tyrael that is standing before his eyes. That would be too good to be true.",
   "hLabel": 657604912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1DCFFD",
   "szText": "You have let his hate cloud your eyes, old friend.",
   "hLabel": 3177156929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1DCFFD",
   "szText": "Even, calm",
   "hLabel": 341522094
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.6D03F",
   "szText": "Tyrael.",
   "hLabel": 4116741566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.6D03F",
   "szText": "Realization, awe. Lorath knows that this is no illusion - his beloved old mentor Tyrael is REALLY here.",
   "hLabel": 1167501707
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCFFD",
   "szText": "You once knew a better way.",
   "hLabel": 1189777031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.1DCFFD",
   "szText": "Even, calm",
   "hLabel": 2649109492
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.6D03F",
   "szText": "I’m sorry...",
   "hLabel": 3275614788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.6D03F",
   "szText": "Weak, labored",
   "hLabel": 326374929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.6D03F",
   "szText": "I’ve made a mess of things... (exhales)",
   "hLabel": 1202575645
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.6D03F",
   "szText": "Weak, labored, trailing off as he falls unconscious",
   "hLabel": 2548303082
  }
 ],
 "ptMapStringTable": "0"
}
