   "szLabel": "Name",
   "szText": "Favor for a Favor",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Our friendly fisherman has an odd request.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase13Description",
   "szText": "I've caught three unique fish! At least I've never seen them before. I should bring them back to Shi Yugong and see what he thinks.",
   "hLabel": 3283521273
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback12Header",
   "szText": "Speak with Shi Yugong",
   "hLabel": 3533637401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "It was nice to catch a fish, but there seems to be something bothering Shi Yugong. I should speak with him.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback20Header",
   "szText": "Speak with Shi Yugong",
   "hLabel": 619471480
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase23Description",
   "szText": "Shi Yugong said he wants me to catch unique fish from around Skovos. He didn't say which fish exactly, so I hope at least one of them will satisfy.",
   "hLabel": 320182394
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback25Header",
   "szText": "Fish a Kokalodon",
   "hLabel": 2781844029
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback82Header",
   "szText": "Fish a Silverbelly",
   "hLabel": 1215027520
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback83Header",
   "szText": "Fish a Darkling",
   "hLabel": 2506495489
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase88Description",
   "szText": "I caught a fish! I should bring the fishing rod back to the old fisherman...and let him know it works just fine. ",
   "hLabel": 3826295909
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback90Header",
   "szText": "Speak with Shi Yugong",
   "hLabel": 2595828895
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase109Description",
   "szText": "I have a rod now. I should give fishing a try and see what I can catch.",
   "hLabel": 1773873071
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback132Header",
   "szText": "Catch a Fish and add it to your collection",
   "hLabel": 3711901612
  }
 ],
