  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.BAE4",
   "szText": "shell-shocked, breathing heavily",
   "hLabel": 494300592
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCFFD",
   "szText": "You fell unconscious, and would not wake. Lorath went to find you aid.",
