{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Atanos01_010.stl",
 "__snoID__": 2434818,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Akarat is here?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.24E1A1",
   "szText": "He is! On the old steps by the shore. Where the Pools of Creation will rise.",
   "hLabel": 2850197038
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.24E1A1",
   "szText": "Intrigued.",
   "hLabel": 14562203
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1DCC9B",
   "szText": "(scoffs) \"Rise?\" From the bottom of the sea?",
   "hLabel": 3177152175
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.24E1A1",
   "szText": "Yes, sister. But not until the eclipse. You still have time. Go to Akarat and—",
   "hLabel": 2496922089
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.24E1A1",
   "szText": "Smiling, emphatic. Happy Tharra made it in time.",
   "hLabel": 3956254550
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1DCC9B",
   "szText": "Is the Queen with him?",
   "hLabel": 1852232243
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.1DCC9B",
   "szText": "Interrupting, terse, direct.",
   "hLabel": 3311564704
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.24E1A1",
   "szText": "Not yet. She's at the Observatory, wasting words on the Oracle.",
   "hLabel": 1172002157
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.24E1A1",
   "szText": "Deflating, confused. Disappointed by Tharra's lack of interest.",
   "hLabel": 2631334618
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1DCC9B",
   "szText": "Good. We must speak with them both.",
   "hLabel": 527312311
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.1DCC9B",
   "szText": "Terse, direct. Eager to move on.",
   "hLabel": 1986644772
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.BAE4",
   "szText": "Perhaps I should stay? Hear what Akarat is telling his flock.",
   "hLabel": 4202838166
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.BAE4",
   "szText": "To Tharra. A counterpoint. Shrewd. Hiding true intention from the guard.",
   "hLabel": 1770757827
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.1DCC9B",
   "szText": "Very well. But tread softly.",
   "hLabel": 174037362
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.1DCC9B",
   "szText": "Agreeing, cautious. Leaves immediately after.",
   "hLabel": 1633369823
  }
 ],
 "ptMapStringTable": "0"
}
