 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You really think we're fortunate to have Lilith's help?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCFFD",
   "szText": "Yes. In truth, I have always felt a strange...kinship with Lilith. She was the only immortal to truly care for Sanctuary, to see its people as they were.",
   "hLabel": 2457582095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "At times, I wondered if I was following in her footsteps.",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BD31C",
   "szText": "He is too soft for that.",
   "hLabel": 2435088632
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCFFD",
   "szText": "Though I suspect she would think me too soft.",
   "hLabel": 470202197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCFFD",
   "szText": "with a self-effacing smile",
   "hLabel": 1815929634
  }
 ],
 "ptMapStringTable": "0"
}
