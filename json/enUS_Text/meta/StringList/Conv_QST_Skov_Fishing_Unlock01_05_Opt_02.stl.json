   "szLabel": "MenuLabel",
   "szText": "\"Are you all right?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.21C82F",
   "szText": "Oh go on, I’ll be fine! Me and all those fish out there (scoffs).",
   "hLabel": 2436183709
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.21C82F",
   "szText": "Dismissive, deflated. Looking out sadly at the sea.",
   "hLabel": 3781911146
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.229CD1",
