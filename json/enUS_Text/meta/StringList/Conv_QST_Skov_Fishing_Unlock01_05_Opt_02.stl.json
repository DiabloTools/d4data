  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.229CD1",
   "szText": "Inquisitive. Shares Player's concern.",
   "hLabel": 3119176171
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.21C82F",
