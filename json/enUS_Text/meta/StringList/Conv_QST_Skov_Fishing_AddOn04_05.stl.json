{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Fishing_AddOn04_05.stl",
 "__snoID__": 2313536,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"A ruby. Does this bring back any memories?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.21C82F",
   "szText": "Memories, oh yes. All of them. Years upon years! Victories. Ha, failures...and everything in between! (chuckles)",
   "hLabel": 4171493458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.21C82F",
   "szText": "Tearful relief. Bittersweet.",
   "hLabel": 1335858623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line24.21C82F",
   "szText": "(scoffs) I could have sworn I was famous! A master crafter of jewels, huh? A trickster...and a thief.",
   "hLabel": 2162068594
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir24.21C82F",
   "szText": "Pretending offense, playful, then somber.",
   "hLabel": 3621401055
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line26.21C82F",
   "szText": "This...this, this ruby... It’s a shiny reminder of all the pain I caused. (chuckles) Ah yes, I carried it around for ages, until I got sick of it! Brought it here to Skovos where it all began!",
   "hLabel": 1499608628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir26.21C82F",
   "szText": "Somber, regretful",
   "hLabel": 2958941089
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line28.21C82F",
   "szText": "I-I tossed it into that stupid cave hoping to forget it all! Well, I guess it worked.",
   "hLabel": 837148662
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir28.21C82F",
   "szText": "Laughing at himself",
   "hLabel": 2296481123
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line30.BAE4",
   "szText": "A bit too well... So what now, my friend? What will you do?",
   "hLabel": 4163702773
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir30.BAE4",
   "szText": "Amused, then warm and friendly",
   "hLabel": 1731622434
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line32.21C82F",
   "szText": "What? Now that I remember I’ve lost everything I knew and loved? (laughs) I have no idea! But that's being human for you...",
   "hLabel": 483873713
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir32.21C82F",
   "szText": "Laughing at himself and life.",
   "hLabel": 1943206174
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line34.21C82F",
   "szText": "Listen, take my advice. Try to enjoy life when you can, eh? (chuckles) Maybe go fishing from time to time, hm?",
   "hLabel": 4116381043
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir34.21C82F",
   "szText": "Smiling, sincere, playful",
   "hLabel": 1280746208
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line36.229CD1",
   "szText": "(meows)",
   "hLabel": 3453646068
  }
 ],
 "ptMapStringTable": "0"
}
