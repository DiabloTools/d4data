{
 "__fileName__": "enUS_Text/meta/StringList/Conv_X2_Collectibles_Skov_Philios_01.stl",
 "__snoID__": 2447673,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BD31C",
   "szText": "It was just a dream, love.",
   "hLabel": 1564184052
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DB735",
   "szText": "No! You don't understand. I dreamed of you, Mother. You were killing people. Twisting them, hurting them.",
   "hLabel": 1795033279
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BD31C",
   "szText": "And did they fight back?",
   "hLabel": 2435088632
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DB735",
   "szText": "No, but—",
   "hLabel": 470113347
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BD31C",
   "szText": "Did they do anything at all to prove they were worthy of the lives I gave them?",
   "hLabel": 3305993212
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DB735",
   "szText": "No.",
   "hLabel": 1222755630
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DB735",
   "szText": "through clenched teeth",
   "hLabel": 2682088091
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.BD31C",
   "szText": "Then of course I killed them.",
   "hLabel": 205187975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.BD31C",
   "szText": "with a shrug",
   "hLabel": 1550915412
  }
 ],
 "ptMapStringTable": "0"
}
