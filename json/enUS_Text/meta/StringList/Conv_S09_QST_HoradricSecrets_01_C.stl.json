 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Inspect",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Horadric Librarian",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22B55C",
   "szText": "Inscribed here is part of the oath our Order’s initiates once took:",
   "hLabel": 2437330522
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.22B55C",
   "szText": "\"Knowledge, lifeblood of light. Magick, open palm of justice. Perseverance, challenger of fate.\"",
   "hLabel": 1774870556
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.22B55C",
   "szText": "Much has been written on justice and light. Not so much on fate, and the challenging of it.",
   "hLabel": 1112410590
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.22B55C",
   "szText": "Our history is riddled with failures—how could it not be? Yet it is also rich with moments of defiance in the face of despair, rejections of the concept of futility.",
   "hLabel": 449950624
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.22B55C",
   "szText": "We may fail. But we shall always rise to try, and fight, again.",
   "hLabel": 4082457954
  }
 ],
 "ptMapStringTable": "0"
}
