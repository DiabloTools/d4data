 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What was Braega like?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.21FCD5",
   "szText": "My sister was the sun itself. She smiled, and the whole world woke. She’d ramble on about any old thing, and people would flock to listen. She was a historian, see.",
   "hLabel": 2436339948
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.21FCD5",
   "szText": "fond",
   "hLabel": 3782067385
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.21FCD5",
   "szText": "Ancient trade disputes, long dead currencies... I used to roll my eyes. But what I’d give to hear her tell her dusty stories again...",
   "hLabel": 1773879982
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.21FCD5",
   "szText": "smiling",
   "hLabel": 3119607419
  }
 ],
 "ptMapStringTable": "0"
}
