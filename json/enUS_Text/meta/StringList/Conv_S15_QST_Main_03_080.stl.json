 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "(Approach Tal Rasha.)",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.255902",
   "szText": "Only this battle took place long ago, didn’t it? Took place when, despite all my strength and wit and design, I could no longer contain the Lord of Destruction.",
   "hLabel": 2439275262
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.255902",
   "szText": "Somber",
   "hLabel": 3785002699
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.255902",
   "szText": "(sighs) I failed...as each mortal must against them, and his evil...drove a splinter into my soul. I thank you for pulling it free of me. Yet, I am sorry that you must now carry it.",
   "hLabel": 1776815296
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.255902",
   "szText": "Somber, grateful, then regretful",
   "hLabel": 3122542733
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.255902",
   "szText": "For the hope of Sanctuary, eh?",
   "hLabel": 1114355330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.255902",
   "szText": "Weary smile",
   "hLabel": 2460082767
  }
 ],
