   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Any idea where Ouna could have gone?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1F9FF1",
   "szText": "We will search for Ouna. Caidin and I alone. She is a Coven matter.",
   "hLabel": 1133524600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1F9FF1",
   "szText": "Terse. Seething. Determined.",
   "hLabel": 2479252037
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1FA017",
   "szText": "It's a bitter drop to swallow, but she's right. We'll need you to follow the whispers, keep the Headrotten at bay...while we deal with their maker.",
   "hLabel": 4104948895
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1FA017",
   "szText": "Dejected. Accepting what must be done.",
   "hLabel": 1155709036
  }
 ],
