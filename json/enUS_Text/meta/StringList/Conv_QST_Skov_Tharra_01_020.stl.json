   "szLabel": "MenuLabel",
   "szText": "\"The Council of Veterans? What is that?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.245E3E",
   "szText": "When an Amazon queen dies without appointing a successor, the Council is convened to choose one.",
   "hLabel": 2438137407
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.245E3E",
   "szText": "To be summoned is a high honor, especially for a mainlander.",
   "hLabel": 1775677441
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.245E3E",
   "szText": "\"especially for a mainlander\" not vitriolic. Player is very respected by the Amzons.",
   "hLabel": 3121404878
  }
