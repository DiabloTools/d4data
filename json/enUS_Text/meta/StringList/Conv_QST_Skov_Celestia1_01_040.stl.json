{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Celestia1_01_040.stl",
 "__snoID__": 2144300,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"It's true. But I trust Lilith no more than you do. I want the same thing as you, to save Sanctuary from Hatred.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8FD7",
   "szText": "I see.",
   "hLabel": 2456036693
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1D8FD7",
   "szText": "contemplative",
   "hLabel": 3801764130
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8FD7",
   "szText": "For days, I have been sailing my people through this storm, fighting a foe I could not see. Now the clouds part and there you are.",
   "hLabel": 1793576727
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8FD7",
   "szText": "A strange relief. Stranger still, you think yourself a hero. The histories teach us: the Daughter of Hatred will always lie to those who are willing to listen.",
   "hLabel": 1131116761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1D8FD7",
   "szText": "with a bitter smile",
   "hLabel": 2476844198
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1D8FD7",
   "szText": "I cannot let you leave.",
   "hLabel": 468656795
  }
 ],
 "ptMapStringTable": "0"
}
