   "szLabel": "MenuLabel",
   "szText": "\"This polearm...\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1DCFFD",
   "szText": "This is Lorath's.",
   "hLabel": 2867971912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4",
   "szText": "He wouldn’t leave it behind.",
   "hLabel": 2911370197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.BAE4",
   "szText": "creeping dread",
   "hLabel": 479289858
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4",
   "szText": "Dammit.",
   "hLabel": 2989640983
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCFFD",
   "szText": "I shall find another way. Go, Lorath can’t be far!",
   "hLabel": 1189777031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4",
   "szText": "Lorath?",
   "hLabel": 3639732837
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.BAE4",
   "szText": "calling. desperation rising",
   "hLabel": 572571378
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8FD7",
   "szText": "The man never knew when to stop...",
   "hLabel": 1131116761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1D8FD7",
   "szText": "softly, half to herself",
   "hLabel": 2476844198
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1D8FD7",
   "szText": "Damn fool. Like the rest of you.",
   "hLabel": 468656795
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BAE4",
   "szText": "Step away from him!",
   "hLabel": 3874545195
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.BAE4",
   "szText": "with a tremor, desperate",
   "hLabel": 807383736
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BAE4",
   "szText": "(inhales sharply)",
   "hLabel": 1619902228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.BAE4",
   "szText": "heartbroken",
