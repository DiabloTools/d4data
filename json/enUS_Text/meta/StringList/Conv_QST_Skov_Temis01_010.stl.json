{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Temis01_010.stl",
 "__snoID__": 2132832,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Eavesdrop on Queen Adreona",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "Nor can it be prayed away. Is it really wise to entertain this... \"prophet\"?",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "heavy with skepticism",
   "hLabel": 1815924880
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8FD7",
   "szText": "I’d be a fool to make a martyr of him with all his sycophants in our city.",
   "hLabel": 1793576727
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCC9B",
   "szText": "And...",
   "hLabel": 4102704773
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8FD7",
   "szText": "And what?",
   "hLabel": 1131116761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "And a small part of you wants to believe him.",
   "hLabel": 1222839726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1D8FD7",
   "szText": "(sighs) What's that line? “Rare is the sunlight that dares to dance the lakebed.” You see through me.",
   "hLabel": 558839112
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1D8FD7",
   "szText": "weary",
   "hLabel": 2018171573
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1D8FD7",
   "szText": "Oh, Tharra. Between the famines and the wars, madness swallows Sanctuary. What if this madman is our answer?",
   "hLabel": 4191346442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCC9B",
   "szText": "Let's see him for ourselves, then. Though...we’ll be without the Oracle. I just got word she won’t be attending.",
   "hLabel": 3530427124
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1D8FD7",
   "szText": "Tch, seen three Oracles come and go, and only this one has dared to shirk her duty to our people this many times over.",
   "hLabel": 2866426510
  }
 ],
 "ptMapStringTable": "0"
}
