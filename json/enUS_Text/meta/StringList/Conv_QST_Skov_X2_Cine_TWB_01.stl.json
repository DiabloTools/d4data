 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "The Tree of Whispers Burns",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.BAE4",
   "szText": "I keep thinking of that day I walked into his cabin. I brought him into this mess.",
   "hLabel": 3796274409
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.BAE4",
   "szText": "Reminiscing, a bit somber",
   "hLabel": 729112950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCFFD",
   "szText": "No one brings Lorath into anything. You know that. He made a choice, despite what it would cost him.",
   "hLabel": 2457582095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCFFD",
   "szText": "Somber, but speaking admiringly of his old friend, Lorath",
   "hLabel": 3803309532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCFFD",
   "szText": "Just as all Horadrim do, and I loved them for it.",
   "hLabel": 1222844480
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCFFD",
   "szText": "saying goodbye",
   "hLabel": 2682176941
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCFFD",
   "szText": "They fought for a world that has no right to exist.",
   "hLabel": 560384514
  }
 ],
 "ptMapStringTable": "0"
}
