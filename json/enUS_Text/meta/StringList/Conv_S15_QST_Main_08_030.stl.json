 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "(Place the Splinter of Terror.)",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27B44D",
   "szText": "Terror. The last piece of our task and a bitter reminder of where it all began...so the Eternal Conflict turns, on and on.",
   "hLabel": 2443259006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27B44D",
   "szText": "Measured relief",
   "hLabel": 3788986443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27B44D",
   "szText": "(chuckles) The Eternal Question! I fear my borrowed time among you is running short. I intend to use it well—helping you to preserve Sanctuary for another generation.",
   "hLabel": 1118339074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.27B44D",
   "szText": "Much evil has risen in the wake of these nightmares...and I am afraid we already possess the only means to contain it.",
   "hLabel": 124649125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.27B44D",
   "szText": "Choose one of the splinters, but only one. To carry more would prove too great a risk.",
   "hLabel": 1539751374
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir10.27B44D",
   "szText": "Wary",
   "hLabel": 2999083835
  }
 ],
 "ptMapStringTable": "0"
}
