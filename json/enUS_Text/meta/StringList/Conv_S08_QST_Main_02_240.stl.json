   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What more can you tell me about these powers?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.20FFCC",
   "szText": "There's much potential in them. And much we don't know.",
   "hLabel": 2435157307
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.20FFCC",
   "szText": "You'll discover new powers from the strongest of Belial's minions.",
   "hLabel": 1772697341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.20FFCC",
   "szText": "When you defeat his Apparitions, be vigilant for any trace of Spectral Ash.",
   "hLabel": 1110237375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.20FFCC",
   "szText": "The ash can be used to intensify the powers.",
