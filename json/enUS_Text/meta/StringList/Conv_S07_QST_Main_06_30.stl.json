 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What do you think you're doing, Caidin?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1FA017",
   "szText": "Oh, I thought I’d visit the Wastes and scream at the dirt. I’m trying to find Ouna, dimwit!",
   "hLabel": 472441565
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1FA017",
   "szText": "Heated. Sarcastic. Barking.",
   "hLabel": 1818169002
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1F9FF1",
   "szText": "Let's put aside who has lost his wits! Ouna has cast an illusion here, look for shrouding charms!",
   "hLabel": 2458444532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1F9FF1",
   "szText": "Barking back. Angry. Commanding.",
   "hLabel": 3804171969
  }
 ],
