 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Úllo Sar Missive - My Truth",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "The Nameless",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "Oh, my wandering friend. The \"Archangel of Justice\" refused to tell you the truth, didn't he?",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2808AB",
   "szText": "Sympathetic, knowing",
   "hLabel": 3788381353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2808AB",
   "szText": "After all, how could he admit that I was one of his first, precious Horadrim? That in his service, I had unlocked the ability to endure the Eternal Conflict. Immortality.",
   "hLabel": 1780193950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2808AB",
   "szText": "Such a feat required sacrifice, as any war does, yet Tyrael called it a crime. So he and my brethren condemned me to darkness! Erased me from their legacy.",
   "hLabel": 1117733984
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2808AB",
   "szText": "Indignation",
   "hLabel": 2463461421
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.2808AB",
   "szText": "That is Tyrael's \"hope.\" He will use you until he buries you, one way or another...and the world suffers on.",
   "hLabel": 455274018
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.2808AB",
   "szText": "Bitter contempt, sewing doubt",
   "hLabel": 1801001455
  }
 ],
 "ptMapStringTable": "0"
}
