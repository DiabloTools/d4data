{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S15_QST_Main_02_050_OPT.stl",
 "__snoID__": 2659273,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Where did you come from?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27B44D",
   "szText": "I hail from Tristram, originally, born and raised. And it was in New Tristram where I...where I believe I died.",
   "hLabel": 2443259006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27B44D",
   "szText": "Joking a little, then somber",
   "hLabel": 3788986443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27B44D",
   "szText": "Yet, somehow I awoke. It felt like a nightmare at first. Walking through a shattered land, dark and cold, in a procession of souls...a great tear of light before us.",
   "hLabel": 1780799040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.27B44D",
   "szText": "Describing a half-remembered nightmare",
   "hLabel": 3126526477
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27B44D",
   "szText": "Behind, there was a great fortress. And within, I felt a presence looming over us, watching us...neither wicked nor benevolent.",
   "hLabel": 1118339074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.27B44D",
   "szText": "Foreboding",
   "hLabel": 2464066511
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.27B44D",
   "szText": "Perhaps...it was Death itself?",
   "hLabel": 455879108
  }
 ],
 "ptMapStringTable": "0"
}
