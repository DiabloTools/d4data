   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How do we get the sword out of there?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23AE2D",
   "szText": "We don't have to take the sword. I just need some time with it to get the necessary information.",
   "hLabel": 2438532680
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.23AE2D",
   "szText": "This will surely alert him to our presence. Make sure I'm not interrupted.",
   "hLabel": 1776072714
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.23AE2D",
   "szText": "When you're ready, touch the barrier.",
