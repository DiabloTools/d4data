  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22808A",
   "szText": "\"We built our dream under the stars of Celestia, and it was beautiful. Like all dreams, it came to an end.",
   "hLabel": 2435815820
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.22808A",
   "szText": "Somber, grieving, projecting hope.",
   "hLabel": 3781543257
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.22808A",
   "szText": "We who survive pledge here to return when the earth has calmed at last. We shall sweep away the ash, and our dream shall breathe again.\"",
   "hLabel": 1773355854
  }
 ],
 "ptMapStringTable": "0"
}
