{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Temis_Jaws_01_Intro_010.stl",
 "__snoID__": 2367378,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How did you lose your arm?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.244C28",
   "szText": "Don’t ask her that. She’ll flap her gums till the tides come in.",
   "hLabel": 1775639248
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.244C28",
   "szText": "good-natured, but tired of the story",
   "hLabel": 3121366685
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.241F1B",
   "szText": "Bah, I can tell it short. See, there’s a dead Kraken rotting on the Philios shore. Turns out, just because the body’s dead don’t mean the heads are too.",
   "hLabel": 1113074747
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.241F1B",
   "szText": "Has had this discussion before, but happy to tell the story. ",
   "hLabel": 2458802184
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.241F1B",
   "szText": "One bit my arm clean off, it did!",
   "hLabel": 450614781
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.241F1B",
   "szText": "Playing up the drama of the story",
   "hLabel": 1796342218
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.244C28",
   "szText": "Cow shite, Myveli. There is no way a head can survive without a body; Kraken or not.",
   "hLabel": 4083226646
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.244C28",
   "szText": "Has said this before and will say it again",
   "hLabel": 1133986787
  }
 ],
 "ptMapStringTable": "0"
}
