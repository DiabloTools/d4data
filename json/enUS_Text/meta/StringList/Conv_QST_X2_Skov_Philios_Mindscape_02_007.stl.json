 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What did you see, in your sleep?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BD31C",
   "szText": "Precious little.",
   "hLabel": 1076092555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line28.BD31C",
   "szText": "I saw the temple. Wilted petals on weeping stone.",
   "hLabel": 2036330541
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line30.BD31C",
   "szText": "I saw an old man, cowering in sweat-stained robes.",
   "hLabel": 4258258694
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BD31C",
   "szText": "I saw a river of blood and tar. I saw my son. And I saw you.",
   "hLabel": 4168925288
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.BD31C",
   "szText": "But that is all.",
   "hLabel": 2456893930
  }
 ],
 "ptMapStringTable": "0"
}
