{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Epilogue2_010.stl",
 "__snoID__": 2265046,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"We have come to burn the Tree. Will you try to stop us?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.789BF",
   "szText": "The Tree has bidden me to stop you...but I will not.",
   "hLabel": 1511616375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.789BF",
   "szText": "PLAYER LEAD IN: \"We have come to burn the Tree. Will you try to stop us?\" -- Resigned to the task, this is a heavy choice to make.",
   "hLabel": 3374503332
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "I thought the witches of Hawezar serve the Tree unto death. Why the change of heart?",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCFFD",
   "szText": "Curious. Pronunciation: hou-iz-ahr",
   "hLabel": 3140849566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.789BF",
   "szText": "My \"service\" condemned many souls to suffer. Then it was my turn, on a slab in Mount Civo. It seemed just. And yet, Lorath spared me.",
   "hLabel": 2382520955
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.789BF",
   "szText": "Honest. Somber.",
   "hLabel": 4245407912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.789BF",
   "szText": "I have carried this debt long enough. To him, to the others... Let fire settle it.",
   "hLabel": 1864651656
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.789BF",
   "szText": "Uncomfortable. Ready for it all to end.",
   "hLabel": 3210379093
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCFFD",
   "szText": "Then we thank you, Taissa.",
   "hLabel": 470202197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCFFD",
   "szText": "We’ll go when you're ready, friend.",
   "hLabel": 4102709527
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1DCFFD",
   "szText": "Speaking to the Player",
   "hLabel": 1153469668
  }
 ],
 "ptMapStringTable": "0"
}
