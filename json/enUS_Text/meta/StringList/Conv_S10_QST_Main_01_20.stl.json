   "szLabel": "MenuLabel",
   "szText": "\"Who are you?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.23AE2D",
   "szText": "I am called Shyan. These Chaos Rifts are appearing all over Sanctuary. I fear they herald the return of Bartuc the Bloody.",
   "hLabel": 1776072714
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.23AE2D",
   "szText": "I know who you are, wanderer. If you would be of help in this, meet me in Yelesna.",
   "hLabel": 1203795065
  }
 ],
