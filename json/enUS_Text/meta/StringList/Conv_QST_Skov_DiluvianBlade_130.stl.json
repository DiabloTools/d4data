 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Do you recognize this blade?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25A7C4",
   "szText": "Blade... Yes, I remember it. It was my blade, long ago.",
   "hLabel": 2440855997
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25A7C4",
   "szText": "speech is just ever so slightly more cogent",
   "hLabel": 3786583434
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25A7C4",
   "szText": "Memories. Too many. I see a city. I see a flood.",
   "hLabel": 1778396031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25A7C4",
   "szText": "And I see...an angel.",
   "hLabel": 1115936065
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25A7C4",
   "szText": "Home! I remember home! Need to go home!",
   "hLabel": 453476099
  }
 ],
 "ptMapStringTable": "0"
}
