  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod9_Description",
   "szText": "{c_important}Trample{/c} sunders the earth forming rock pillars along the path and around your target location that deal {c_number}{payload:UPGRADE_B_TOOLTIP}{/c}  damage.\r\n\r\n{c_important}Trample{/c} is now an {c_important}Earth{/c} Skill.",
