  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{c_label}Generates Spirit:{/c} {c_resource}{SF_8}{/c}\r\n{c_label}Cooldown: {/c}{c_resource}{Cooldown Time}{/c} seconds\r\n{if:ADVANCED_TOOLTIP}{c_label}Lucky Hit Chance: {/c}{c_resource}[{Combat Effect Chance}|%|]{/c}\r\n{/if}Shapeshift and charge forward, dealing {c_number}{payload:PAYLOAD_DAMAGE}{/c} damage and Knocking Back enemies.",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": " \r\n{icon:bullet,1.2} Damage {icon:arrow,1.2} {c_number}{payload:PAYLOAD_DAMAGE}{/c}",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Description",
   "szText": "{c_important}Trample{/c} deals {c_number}[SF_19 * 100|%x|]{/c} bonus damage. This bonus is reduced by {c_number}[SF_20 * 100|%x|]{/c} for each enemy hit after the first.",
   "hLabel": 628601524
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Name",
