   "hLabel": 2531142258
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod8_Description",
   "szText": "Trample deals {c_number}[SF_23 * SF_24 * 100|%|]{/c} bonus damage to the first target. Each subsequent target hit reduces this bonus by {c_number}[SF_23*100|%|]{/c}.",
   "hLabel": 1360065851
