  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod2_Description",
   "szText": "Casting {c_important}Trample{/c} grants {c_number}[{SF_10}*100|%|]{/c} of your Maximum Life {c_number}([Max(1,{fortified:MOD_FORTIFY})|0|]){/c} as {c_important}{u}Fortify{/u}{/c}.",
   "hLabel": 1960229941
