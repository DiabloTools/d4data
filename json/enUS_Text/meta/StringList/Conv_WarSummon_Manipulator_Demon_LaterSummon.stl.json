   "szLabel": "Line18.25DB9B",
   "szText": "The abyss welcomes them.",
   "hLabel": 3182629095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir18.25DB9B",
   "szText": "Smug, eerie, unsettling.",
   "hLabel": 346994260
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line20.25DB9B",
   "szText": "I will savor their screams.",
   "hLabel": 3491814112
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir20.25DB9B",
   "szText": "Focused, unsettling. If a power-crazed Galadriel (a la Lord of the Rings) were crossed with a shark.",
   "hLabel": 656179277
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line22.25DB9B",
   "szText": "I shall feast upon their fear.",
   "hLabel": 2829354146
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir22.25DB9B",
   "szText": "Sinister, otherworldly, unsettlingly collected as she focuses in for the kill.",
