   "szLabel": "DisembodiedVoice",
   "szText": "Memory of Rathma",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.FD852",
   "szText": "I loved our Mother, and I hated her. I saw what we would do in her hands. The way to Hell, torn asunder.",
   "hLabel": 1568933264
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.FD852",
   "szText": "Somber. Grim.",
   "hLabel": 3431820221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.FD852",
   "szText": "And so I broke the blade you seek. I would not become her instrument. Will you?",
   "hLabel": 4151869202
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.FD852",
   "szText": "Cold. Confronting.",
   "hLabel": 1719788863
  }
 ],
