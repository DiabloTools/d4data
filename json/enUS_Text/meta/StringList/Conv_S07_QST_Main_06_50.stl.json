 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Ouna. You must stop this.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1FA02A",
   "szText": "All the heads did was ask questions. No answers are worth an eternity of suffering.",
   "hLabel": 1797361572
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1FA02A",
   "szText": "Dejected. Holding back tears.",
   "hLabel": 3143089009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1FA02A",
   "szText": "I thought I could cut their bond to the Tree...but the rot always spills from the wound. I failed them.",
   "hLabel": 1134901606
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1FA02A",
   "szText": "Dejected. Tears start to fall.",
   "hLabel": 2480629043
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1FA02A",
   "szText": "I cannot give them the freedom they deserve, but I can help you stop this now. We must return them to the Tree.",
   "hLabel": 472441640
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1FA02A",
   "szText": "Stops tears. Gets to her feet. Bracing herself to fight.",
   "hLabel": 1818169077
  }
 ],
 "ptMapStringTable": "0"
}
