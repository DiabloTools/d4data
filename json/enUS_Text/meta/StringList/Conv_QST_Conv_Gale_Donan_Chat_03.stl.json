 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "“Is that your Horadric amulet on the table?”",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.7FA05",
   "szText": "Yes. I bet Lorath still wears his. The Order’s mission was his lifeblood.",
   "hLabel": 1513311338
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.7FA05",
   "szText": "A beat after \"Yes,\" like he's taking it in, reflecting on his life.",
   "hLabel": 3376198295
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.7FA05",
   "szText": "I couldn’t give up my life for it, not like him. I wanted to be a man. I left to chase family, fellowship, glory...",
   "hLabel": 4096247276
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.7FA05",
   "szText": "And for what? You saw how that ended. My son...",
   "hLabel": 2384215918
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.7FA05",
   "szText": "(choked back effort)",
   "hLabel": 4247102875
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.7FA05",
   "szText": "I can’t do it. It wouldn’t work anyway.",
   "hLabel": 672184560
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4",
   "szText": "Donan...",
   "hLabel": 1776443800
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.7FA05",
   "szText": "You don't understand. The stuff soulstones are made of, they're old as the Eternal Conflict itself. With magic so primordial, you need faith, you need spirit. I have none.",
   "hLabel": 3255120498
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4.Bar",
   "szText": "What you lack in faith, you have in allies.",
   "hLabel": 2031712029
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4.Dru",
   "szText": "What you lack in faith, you have in allies.",
   "hLabel": 2031714771
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4.Nec",
   "szText": "What you lack in faith, you have in allies.",
   "hLabel": 2031725214
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4.Pal",
   "szText": "What you lack in faith, you have in allies.",
   "hLabel": 2031727269
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4.Rog",
   "szText": "What you lack in faith, you have in allies.",
   "hLabel": 2031729904
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4.Sor",
   "szText": "What you lack in faith, you have in allies.",
   "hLabel": 2031731004
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4.Spi",
   "szText": "What you lack in faith, you have in allies.",
   "hLabel": 2031731028
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4.War",
   "szText": "I don't know about faith...but you have allies.",
   "hLabel": 2031734898
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.BAE4.War",
   "szText": "Slightly awkward, trying to encourage. (Warlock has never had \"faith\" and doesn't understand it.)",
   "hLabel": 2106885407
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.7FA05",
   "szText": "(scoff) Who? You?",
   "hLabel": 1866346619
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.7FA05",
   "szText": "Skeptical",
   "hLabel": 3212074056
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4.Bar",
   "szText": "Yes. You’re the only one who can help us.",
   "hLabel": 3862349208
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.BAE4.Bar",
   "szText": "sincere",
   "hLabel": 3937499717
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4.Dru",
   "szText": "Yes. You’re the only one who can help us.",
   "hLabel": 3862351950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4.Nec",
   "szText": "Yes. You’re the only one who can help us.",
   "hLabel": 3862362393
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4.Pal",
   "szText": "Yes. You’re the only one who can help us.",
   "hLabel": 3862364448
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4.Rog",
   "szText": "Yes. You’re the only one who can help us.",
   "hLabel": 3862367083
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4.Sor",
   "szText": "Yes. You’re the only one who can help us.",
   "hLabel": 3862368183
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4.Spi",
   "szText": "Yes. You’re the only one who can help us.",
   "hLabel": 3862368207
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4.War",
   "szText": "That's why I'm here. You're the only one who can help us.",
   "hLabel": 3862372077
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.7FA05",
   "szText": "Hmm. Unfortunately, you may be right.",
   "hLabel": 154315261
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.7FA05",
   "szText": "Ah, I can't make any promises. Really. But...",
   "hLabel": 3608155779
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.7FA05",
   "szText": "(long sigh)",
   "hLabel": 658915920
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.7FA05",
   "szText": "I can try. For you two, I’ll try. Let’s hear what the old man has to say.",
   "hLabel": 4118052574
  }
 ],
 "ptMapStringTable": "0"
