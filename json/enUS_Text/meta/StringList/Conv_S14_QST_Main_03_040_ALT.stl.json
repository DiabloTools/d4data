{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S14_QST_Main_03_040_ALT.stl",
 "__snoID__": 2627263,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"The cult is using Realmwalkers in their rituals, opening portals to...somewhere else.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "That... Well, mad as it is, that makes a kind of sense.",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line20.27ED42",
   "szText": "What do we know about the walkers? They pass between our world and elsewhere, yeah?",
   "hLabel": 3494223856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line22.27ED42",
   "szText": "The Úllo Sar promise peace in the hereafter. Maybe they’re using the walkers to open up the way? To Pandemonium.",
   "hLabel": 2831763890
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.27ED42",
   "szText": "Said it was mad, didn't I? Madder still, you've got to stop anything worse from coming through.",
   "hLabel": 1175613975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.27ED42",
   "szText": "Hates to ask. Feels guilty.",
   "hLabel": 2634946436
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.27ED42",
   "szText": "I’ll keep banging the war drum—keep you supplied. It's the least I can do.",
   "hLabel": 822339026
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.27ED42",
   "szText": "Pensive on \"least I can do.\" Hates that she can't do more.",
   "hLabel": 2281671487
  }
 ],
 "ptMapStringTable": "0"
}
