   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8FD7",
   "szText": "Oh, Tharra.",
   "hLabel": 1793576727
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1D8FD7",
