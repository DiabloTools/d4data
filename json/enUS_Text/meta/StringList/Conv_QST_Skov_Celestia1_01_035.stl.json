   "hLabel": 3139304164
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BD31C",
   "szText": "She knows.",
   "hLabel": 2435088632
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8FD7",
   "szText": "You have all seen what I have. The world is dying. And Hatred is its cause.",
   "hLabel": 4101164125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1D8FD7",
   "szText": "projected, for the crowd to hear",
   "hLabel": 1151924266
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1D8FD7",
   "szText": "You blame Akarat. But I ask you to consider another possibility.",
   "hLabel": 1221299078
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1D8FD7",
   "szText": "Mainlander, are the rumors true? Do you carry Lilith, the Daughter of Hatred, within you?",
   "hLabel": 558839112
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1D8FD7",
   "szText": "an accusation",
   "hLabel": 2018171573
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.1DCC9B",
   "szText": "What?",
   "hLabel": 836497328
  },
