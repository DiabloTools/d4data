   "szLabel": "MenuLabel",
   "szText": "\"Why are you here? Has Bartuc returned?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23AE2D",
   "szText": "We banished Bartuc from Sanctuary. Now he resides with the Infernal Hordes.",
   "hLabel": 2438532680
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.23AE2D",
   "szText": "I obtained this Chaos Armor that has a trace of Bartuc about it. I'll leave it with you, wanderer.",
   "hLabel": 1113612748
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.23AE2D",
   "szText": "You might well find it useful if you intend to confront Bartuc in the Infernal Hordes.",
