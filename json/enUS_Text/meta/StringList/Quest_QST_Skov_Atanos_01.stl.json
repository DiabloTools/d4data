  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase77Description",
   "szText": "Following the trail north, we encountered a group of Amazon sentries. They seem strangely happy to see us... What is going on?",
   "hLabel": 1673411971
  },
