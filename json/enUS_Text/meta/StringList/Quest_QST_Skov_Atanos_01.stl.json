  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase32Description",
   "szText": "Mephisto seized control of me in front of the crowd and forced Lilith to speak! Soon all will know that she lives inside of me. I have to get to the Celestia Observatory. If the Queen learns my secret, all of Skovos may turn against me.",
