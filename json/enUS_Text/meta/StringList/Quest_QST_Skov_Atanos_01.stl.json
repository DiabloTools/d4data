   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase91Description",
   "szText": "So this is where \"Akarat\" led his followers—to the forsaken shores of Atanos. It seems he is about to deliver a sermon. Tharra will continue on to meet the Queen...but I must hear what the devil has to say.",
   "hLabel": 3704102975
  },
