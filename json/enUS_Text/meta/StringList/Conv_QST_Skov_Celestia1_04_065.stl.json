   "szLabel": "MenuLabel",
   "szText": "\"Yes.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.BD31C",
   "szText": "You are honest, at least. Perhaps I owe you honesty as well.",
   "hLabel": 3208687302
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.BD31C",
   "szText": "You are strong of will, but you use that strength for petty ends. You cling to the world you know.",
   "hLabel": 1496655944
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line16.BD31C",
   "szText": "Still, there is something to be admired in your obstinance.",
   "hLabel": 4079591882
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir16.BD31C",
   "szText": "with grudging fondness",
   "hLabel": 1130352023
  }
 ],
 "ptMapStringTable": "0"
}
