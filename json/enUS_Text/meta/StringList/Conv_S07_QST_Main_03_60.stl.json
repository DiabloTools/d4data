{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_03_60.stl",
 "__snoID__": 2105310,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What happens now?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1F9FF1",
   "szText": "Now, we may breathe a little easier. With hatred purged from the Tree, we can assure the heads’ safe return.",
   "hLabel": 1133524600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1F9FF1",
   "szText": "Relieved. Grateful for a win.",
   "hLabel": 2479252037
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1FA02A",
   "szText": "Returned, yes... But they must be cleansed of the rot before they rejoin the branches. We cannot let the Tree become tainted.",
   "hLabel": 2459821538
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1FA02A",
   "szText": "Correcting. A little anxious.",
   "hLabel": 3805548975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1FA017",
   "szText": "Wise notion. Reckon that means we’ve another “cleansing ritual” to look forward to.",
   "hLabel": 472441565
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1FA017",
   "szText": "Nodding agreement, then grumbling. Not looking forward to another ritual.",
   "hLabel": 1818169002
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1FA017",
   "szText": "As for you, wanderer, best keep following them whispers. You find more heads, we'll add them to the pile.",
   "hLabel": 4104948895
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1FA017",
   "szText": "Putting aside his own gripes, happy to boss the player around",
   "hLabel": 1155709036
  }
 ],
 "ptMapStringTable": "0"
}
