 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are those the 'children' we saved?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B56B",
   "szText": "They are my actors, masquerading where mischief is required. In truth, the children were already dead when you and Tymon first took to the hunt.",
   "hLabel": 2440888317
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B56B",
   "szText": "But it is not my place to deal with mortal quibbles—that is a task for mortals alone.",
   "hLabel": 1778428351
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.25B56B",
   "szText": "sincere, wry",
   "hLabel": 3124155788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B56B",
   "szText": "While I always welcome the opportunity for a grand tale and mischief along the way, I hope you can avoid the fate of a “true hero,” friend.",
   "hLabel": 1115968385
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.25B56B",
   "szText": "warm, sincere, playful undertone",
   "hLabel": 2461695822
  }
 ],
 "ptMapStringTable": "0"
}
