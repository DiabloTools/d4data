  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase43Description",
   "szText": "Astaroth has tormented Sanctuary for long enough. It's up to me to end him.",
   "hLabel": 2983439228
