  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "In my moment of “triumph,” I was discovered by those closest to me. My flesh profaned by blood and bile and sin, they dragged me from the circle.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2808AB",
   "szText": "Somber regret",
   "hLabel": 3788381353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.2808AB",
   "szText": "I screamed like a newborn, and in a way I was, when they pronounced my sentence: My name, erased. My works, expunged. My body...to be buried forever alive.",
   "hLabel": 545456335
  },
  {
   "__type__": "StringTableEntry",
