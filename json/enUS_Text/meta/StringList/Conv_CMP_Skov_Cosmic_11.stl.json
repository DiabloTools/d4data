   "szLabel": "Line1.243A4F",
   "szText": "Where is the Curator?!",
   "hLabel": 2438061211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.243A4F",
   "szText": "Rushing into the room. Alarmed, scared.",
   "hLabel": 3783788648
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4",
   "szText": "Corrupted! She stole the Infernal Anchor!",
   "hLabel": 3639732837
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.BAE4",
   "szText": "Intense, active, dire.",
   "hLabel": 572571378
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.243A4F",
   "szText": "What?! We have to find her! But where could—",
   "hLabel": 1113141279
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.243A4F",
   "szText": "Shock, confusion, trying to think",
   "hLabel": 2458868716
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.243A4F",
   "szText": "The Angelic Anchor! If she takes it too, the balance is lost! This way!",
   "hLabel": 450681313
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.243A4F",
   "szText": "Realizing, alarmed, urgently leading Player onward",
