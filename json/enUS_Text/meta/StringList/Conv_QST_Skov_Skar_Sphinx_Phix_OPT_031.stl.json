   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Then why do you return?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.244C6E",
   "szText": "Grief is the ocean, stained one. I was nearly drowned by it, if not for you finding me.",
   "hLabel": 872131793
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir12.244C6E",
   "szText": "somber, reflective",
   "hLabel": 2331464254
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.244C6E",
   "szText": "But there is still beauty in its movements. In watching it crash upon the shore.",
