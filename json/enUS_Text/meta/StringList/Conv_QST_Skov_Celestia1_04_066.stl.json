   "szLabel": "MenuLabel",
   "szText": "\"No.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.BD31C",
   "szText": "(laughs bitterly)",
   "hLabel": 3208687302
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.BD31C",
   "szText": "Had you chosen to stand at my side in Hell, I would have thought nothing of you. Another useful idiot. And after I took the throne, you would have been the first to die.",
   "hLabel": 1496655944
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line16.BD31C",
   "szText": "But it is because you killed me...that I feel anything for you at all.",
   "hLabel": 4079591882
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir16.BD31C",
   "szText": "struck with the terrible irony",
   "hLabel": 1130352023
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line18.BD31C",
   "szText": "It seems I was doomed to be either dead or disappointed.",
   "hLabel": 2367560524
  }
 ],
 "ptMapStringTable": "0"
}
