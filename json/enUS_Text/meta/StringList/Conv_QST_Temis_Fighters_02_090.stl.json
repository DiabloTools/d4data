 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What's the problem?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22CDED",
   "szText": "Stand aside, derelict. How did you do it, Cleon? A poison needle?",
   "hLabel": 2437419227
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.22CDED",
   "szText": "The second half is to Cleon",
   "hLabel": 3783146664
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.22BEBE",
   "szText": "I don’t have to take this slander! It was a fair fight, and my fighter won! We all saw it.",
   "hLabel": 1774924315
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.22CDED",
   "szText": "It takes six of my crew to capture that beast, and your prize pig here knocks it dead without breathing heavy? I don’t think so.",
   "hLabel": 1112499295
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.22BEBE",
   "szText": "Think what you like…but pay up.",
   "hLabel": 450004383
  }
 ],
 "ptMapStringTable": "0"
}
