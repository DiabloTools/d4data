 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "(Place the Splinter of Destruction.)",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27B44D",
   "szText": "Uncanny! It holds a form not unlike a soulstone. Although, it appears neither physical nor ephemeral...rather like myself, in my current state.",
   "hLabel": 2443259006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27B44D",
   "szText": "Fascinated",
   "hLabel": 3788986443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27B44D",
   "szText": "Yet, the presence within is unmistakable. The very essence of Destruction which stained Tal Rasha’s soul long beyond Baal’s defeat.",
   "hLabel": 1780799040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27B44D",
   "szText": "You feel it keenly, don’t you? This is not your first encounter with the demonic...",
   "hLabel": 1118339074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.27B44D",
   "szText": "Knowing, eyebrow raised",
   "hLabel": 2464066511
  }
 ],
