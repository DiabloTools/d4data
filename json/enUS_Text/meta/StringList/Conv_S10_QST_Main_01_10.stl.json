   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What happened? What did you see?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24256F",
   "szText": "I thought traveling near the shore might be safer. But this...hole...opened out of thin air, and demons started pouring out!",
   "hLabel": 1775517458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24256F",
   "szText": "Like he's trying to understand what he's witnessed, getting agitated when he talks about the demons. ",
   "hLabel": 3121244895
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.24256F",
   "szText": "I barely made it here alive.",
   "hLabel": 1203239809
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.24256F",
   "szText": "Shell-shocked. ",
   "hLabel": 2662572270
  }
 ],
