 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "(Inspect Inarius.)",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BD31C",
   "szText": "What did you tell him? Answer me!",
   "hLabel": 3305993212
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.BD31C",
   "szText": "driving her boot into Inarius' face",
   "hLabel": 873912873
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.84B74",
   "szText": "I told him...how it began. How we made this world. The birth of our children, the Pools of Creation...",
   "hLabel": 153705651
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.84B74",
   "szText": "exhausted, broken",
   "hLabel": 1499433088
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BD31C",
   "szText": "All our secrets...",
   "hLabel": 2788123913
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.BD31C",
   "szText": "shocked, horrified",
   "hLabel": 4133851350
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4",
   "szText": "These Pools...what are they?",
   "hLabel": 2989640983
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.BAE4",
   "szText": "grave",
   "hLabel": 557560644
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.84B74",
   "szText": "They are the font of life. From whence...you draw your nature...",
   "hLabel": 2405411606
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BD31C",
   "szText": "You worm.",
   "hLabel": 3659028493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.BD31C",
   "szText": "deep disgust. this is hitting her hard",
   "hLabel": 709788634
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.BD31C",
   "szText": "You do not even realize what you have done, do you? Our children stand at a precipice, and it is because of YOU.",
   "hLabel": 744862572
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.BD31C",
   "szText": "furious",
   "hLabel": 2090590009
  }
 ],
 "ptMapStringTable": "0"
}
