{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Fishing_AddOn03_02.stl",
 "__snoID__": 2313482,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Hello again. What are you doing in a barrel?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.21C82F",
   "szText": "(stammers) Well...the stupid cat threw up in here. But when I crawled into it to wipe it out, I had the distinct feeling I’ve been here before...",
   "hLabel": 4171493458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.21C82F",
   "szText": "Mildly embarassed, trying to explain",
   "hLabel": 1335858623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.21C82F",
   "szText": "But never mind that! You have fish to show me, huh? Let's see 'em!",
   "hLabel": 2846573526
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.21C82F",
   "szText": "Getting to the point",
   "hLabel": 10938691
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.21C82F",
   "szText": "Eugh! Well, uhh, they’re not exactly fresh. (chuckles) B-But they are unique, I’ll give you that. Look at the scales on this one... Oh, oh, so red! Oh, they shine, like...",
   "hLabel": 2493298577
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.21C82F",
   "szText": "Disgusted, then intrigued",
   "hLabel": 3952631038
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.21C82F",
   "szText": "Ohhh! Oh, that's it!",
   "hLabel": 1830838611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.21C82F",
   "szText": "Eureka!",
   "hLabel": 3290171072
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line28.BAE4",
   "szText": "The fish of your dreams?",
   "hLabel": 3185317948
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir28.BAE4",
   "szText": "Surprised, hopeful",
   "hLabel": 753237609
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line30.21C82F",
   "szText": "Uhh, yes! I-I mean, no! But I know where to find him! I remember a cave...here on the map!",
   "hLabel": 1146333679
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir30.21C82F",
   "szText": "Giddy excitement",
   "hLabel": 2605666140
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line32.21C82F",
   "szText": "Make haste! Catch me that damned fish!",
   "hLabel": 483873713
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir32.21C82F",
   "szText": "Giddy excitement",
   "hLabel": 1943206174
  }
 ],
 "ptMapStringTable": "0"
}
