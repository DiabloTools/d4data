   "szLabel": "Line9.6D03F",
   "szText": "The Horadrim are gone, Mephisto is winning. Nothing I’ve done has—",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.6D03F",
   "szText": "Exhausted, tearful, confessing sins",
   "hLabel": 821729151
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCFFD",
   "szText": "Easy, old friend. All is not lost.",
   "hLabel": 2514696963
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1DCFFD",
   "szText": "Sincere. Comforting, but holding back sadness. It's hard to see his old friend like this.",
   "hLabel": 3974029424
  }
 ],
