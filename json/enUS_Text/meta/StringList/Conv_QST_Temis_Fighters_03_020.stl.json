 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Did Marcellus do this?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22BEBE",
   "szText": "Not...personally. Marcellus sent his underlings. Couldn't pay them off, so...here we are.",
   "hLabel": 2437384281
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.22BEBE",
   "szText": "Weakly, dying",
   "hLabel": 3783111718
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.221DAD",
   "szText": "Cleon, we need to know where he’s getting the Morlu.",
   "hLabel": 1773162279
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.22BEBE",
   "szText": "He’s got a…hunting camp in…Skartara. Oh, curse it, that hurts.",
   "hLabel": 1112464349
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.22BEBE",
   "szText": "Weakly, dying",
   "hLabel": 2458191786
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.221DAD",
   "szText": "Where in Skartara? We’ll see that he pays for this.",
   "hLabel": 448242347
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.22BEBE",
   "szText": "Under the ruined bridge, north of the…crossroads. Be careful, he’s…well-guarded.",
   "hLabel": 4082511713
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.22BEBE",
   "szText": "weakly, dying",
   "hLabel": 1133271854
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.22BEBE",
   "szText": "Thanks for fighting for me, friend. If you get my coins from…Marcellus…you can keep forty percent…ha ha…",
   "hLabel": 1202646666
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
