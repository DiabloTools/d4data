 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Deckard! What's wrong?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27B44D",
   "szText": "Oh, my friend... Nothing is wrong. (chuckles) Only the natural order of things.",
   "hLabel": 2443259006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27B44D",
   "szText": "Weak, dying, smiling",
   "hLabel": 3788986443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27B44D",
   "szText": "I went to my grave having lived a long, full life...filled to the brim with regrets. I am grateful I had the chance to set a few right.",
   "hLabel": 1118339074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.27B44D",
   "szText": "Weak, dying, smiling",
   "hLabel": 2464066511
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.27B44D",
   "szText": "I am most grateful for you, my friend. Fight well. Live in hope. And may you too find peace.",
   "hLabel": 455879108
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.27B44D",
   "szText": "Fading fast, hard to talk",
   "hLabel": 1801606545
  }
 ],
