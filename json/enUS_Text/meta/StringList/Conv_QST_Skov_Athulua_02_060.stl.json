 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.6D03F",
   "szText": "(groans)",
   "hLabel": 692678850
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.6D03F",
   "szText": "Collapsing, exhausted and wounded",
   "hLabel": 2038406287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.1DCFFD",
   "szText": "Be still! Let me see it.",
   "hLabel": 3144089480
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.1DCFFD",
   "szText": "Sees Lorath, rushes to help him. Winded but calm, focused.",
   "hLabel": 308454645
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.6D03F",
   "szText": "Ugh, I'm fine.",
   "hLabel": 2944384805
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.6D03F",
   "szText": "In pain but dismissive.",
   "hLabel": 4290112242
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.1DCFFD",
   "szText": "You’re bleeding, badly. We need to bind these wounds, then find you a bed.",
   "hLabel": 2790814531
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.1DCFFD",
   "szText": "Direct, focused, remaining calm.",
   "hLabel": 4250146992
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.1DCFFD",
   "szText": "The Athulua garrison is close enough. We'll get moving in a moment.",
   "hLabel": 2128354565
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.1DCFFD",
   "szText": "Thinking aloud, comforting, confident.",
   "hLabel": 3587687026
  }
 ],
 "ptMapStringTable": "0"
}
