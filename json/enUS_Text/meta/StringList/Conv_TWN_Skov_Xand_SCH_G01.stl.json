 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What brings you here?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23AD94",
   "szText": "(chuckles) Revelation, my friend! Long have the Askari people gazed upon these walls, yearning for the truth within.",
   "hLabel": 2438531774
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.23AD94",
   "szText": "Jovial, inspired. A scholar on the cusp of discovery.",
   "hLabel": 3784259211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.23AD94",
   "szText": "The sheer variety of the dead here can attest to that. But at last, Xanderos is safe! And I, Master Andres Votaleas, shall be the first to probe its secrets!",
   "hLabel": 1776071808
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.23AD94",
   "szText": "Academic, excited, exultant",
   "hLabel": 3121799245
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.23AD94",
   "szText": "First to probe and survive, of course.",
   "hLabel": 1113611842
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.23AD94",
   "szText": "Amused by his own joke (irreverent, given all the corpses)",
   "hLabel": 2459339279
  }
 ],
 "ptMapStringTable": "0"
}
