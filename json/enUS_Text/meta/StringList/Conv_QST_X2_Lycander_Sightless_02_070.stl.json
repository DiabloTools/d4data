 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why do you hate coming back here so much?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.219CC0",
   "szText": "Seeing Laurel like that…it isn’t fair. The visions are cruel things. Most children’s first memories are of their parents. Mine are of flame and ruin.",
   "hLabel": 2434722745
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.219CC0",
   "szText": "Vulnerable. Opening up emotionally.",
   "hLabel": 3780450182
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.219CC0",
   "szText": "Ugh, why am I even saying this? I need to stay steadfast.",
   "hLabel": 1772262779
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.219CC0",
   "szText": "Pushing down her vulnerability and refocusing on her mission.",
   "hLabel": 3117990216
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.219CC0",
   "szText": "This is the waterfall. Philios’ vault must be near. Let the Eye lead our steps.",
   "hLabel": 1109802813
  }
 ],
 "ptMapStringTable": "0"
}
