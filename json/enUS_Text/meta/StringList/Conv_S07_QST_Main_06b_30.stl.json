 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Letter from Caidin",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Caidin's Letter",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1FA017",
   "szText": "Sorry I called you a dimwit. You’re a good sort, wanderer. You treated us kindly, fought for us... Tried to do what’s right, especially by our Ouna.",
   "hLabel": 1797361497
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1FA017",
   "szText": "Sincere. Light in the beginning, then somber.",
   "hLabel": 3143088934
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1FA017",
   "szText": "I’ve brewed an elixir for you that I hope helps you fix things. But once they’re fixed, you should ask yourself why you serve that bloody Tree. And do what’s right when the time comes.",
   "hLabel": 562623882
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1FA017",
   "szText": "Offering help. Bitter. Sincerely hopes Player burns it down.",
   "hLabel": 2021956343
  }
 ],
 "ptMapStringTable": "0"
}
