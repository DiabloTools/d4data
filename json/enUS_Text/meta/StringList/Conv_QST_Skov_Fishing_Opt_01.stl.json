   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I didn't catch your name, friend.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.21C82F",
   "szText": "(scoffs) I didn't throw it. But you can call me Shi Yugong, if you must.",
   "hLabel": 4171493458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.21C82F",
   "szText": "Gruff, grudging. \"Shi Yugong\" means \"Rock\" + \"Stupid Old Man\" in Chinese.",
   "hLabel": 1335858623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.229CD1",
   "szText": "(meows)",
   "hLabel": 3508758483
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.229CD1",
   "szText": "Insistant, hungry",
   "hLabel": 673123648
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.21C82F",
   "szText": "Eh...that's Trunk. But don't listen to him! He's already had his lunch.",
