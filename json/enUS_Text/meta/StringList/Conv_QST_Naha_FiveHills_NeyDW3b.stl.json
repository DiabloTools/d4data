   "szLabel": "MenuLabel",
   "szText": "\"Can you hear me, Neyrelle?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6DE47",
   "szText": "I’m sorry. I’m so sorry. I didn’t mean it. I know you’re trying just as hard as I am.",
