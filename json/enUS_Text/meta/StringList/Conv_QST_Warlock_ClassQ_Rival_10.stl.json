   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Hattar, what have you done?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.256815",
   "szText": "It…has broken me… Its power will be mine only if I find a worthy sacrifice.",
   "hLabel": 2439310146
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.256815",
   "szText": "There is no going back now, I have succumbed to the demon’s will. The only way for me to know peace is to do as it asks, and I…intend to.",
   "hLabel": 1776850180
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.256815",
   "szText": "Know that if I fall here...my fate…the hell that I live…is your future.",
   "hLabel": 1114390214
  }
 ],
 "ptMapStringTable": "0"
}
