{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Skar_Sphinx_02_040.stl",
 "__snoID__": 2453161,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": " \"Phix, Thales needs you to remove the sight you gave him.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.244C6E",
   "szText": "No. I cannot do that.",
   "hLabel": 872131793
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.244C64",
   "szText": "What?! Oh please, Phix. Whatever it is, I'll-I'll...",
   "hLabel": 1534591710
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.244C6E",
   "szText": "Your eyes are opened, little sieve. I could wrap you in shade, but that will not kill the Sun.",
   "hLabel": 209671827
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line16.244C64",
   "szText": "Then there is nothing I can do.",
   "hLabel": 3842179108
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir16.244C64",
   "szText": "defeated, hopeless",
   "hLabel": 1006544273
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line18.244C6E",
   "szText": "There is a ritual that my pupils once—",
   "hLabel": 3179719191
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line22.244C64",
   "szText": "Anything!",
   "hLabel": 2826444193
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line24.244C6E",
   "szText": "Then find the temple swallowed by the mountain. Perform its rites.",
   "hLabel": 2163984276
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line26.244C6E",
   "szText": "I hope it gives you what you seek.",
   "hLabel": 1501524310
  }
 ],
 "ptMapStringTable": "0"
}
