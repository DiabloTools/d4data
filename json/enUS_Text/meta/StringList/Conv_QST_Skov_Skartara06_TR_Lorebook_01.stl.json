 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Tal Rasha",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.255902",
   "szText": "Such a dream I’ve had. I was driving my father's wagon through a burning wilderness. Suddenly, the horses stopped and would not be moved again.",
   "hLabel": 2439275262
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.255902",
   "szText": "Cold sweat, writing quickly while he remembers the dream",
   "hLabel": 3785002699
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.255902",
   "szText": "I turned round to shout for my mother and father, but when I remembered they were dead, I felt a touch on my shoulder.",
   "hLabel": 1114355330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.255902",
   "szText": "Remembering fear, confusion",
   "hLabel": 2460082767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.255902",
   "szText": "It was Jered, sitting next to me. The others sat atop the horses, ready to pull me onward. Through.",
   "hLabel": 451895364
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.255902",
   "szText": "Relief, hope. Feels like he's on the right path with his allies.",
   "hLabel": 1797622801
  }
 ],
 "ptMapStringTable": "0"
}
