{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Naha_NeophytesOdyessy_04.stl",
 "__snoID__": 2275831,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Your audience is gone. I advise you join them.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22B160",
   "szText": "Another mainlander.",
   "hLabel": 2437326148
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.22B160",
   "szText": "Annoyed",
   "hLabel": 3783053585
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.22B160",
   "szText": "Not a pilgrim though, are you? Not with those scars…",
   "hLabel": 1112406216
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.22B160",
   "szText": "Still annoyed, but realizing the Player is tough. Appraising the Player.",
   "hLabel": 2458133653
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.22B160",
   "szText": "Fine. He’s yours. But mark my words, you’ll regret defending scum like him.",
   "hLabel": 449946250
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.22B160",
   "szText": "Annoyed, but trying to save face and play it cool.",
   "hLabel": 1795673687
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.22B189",
   "szText": "You’re lucky to be alive.",
   "hLabel": 4082453655
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.22B189",
   "szText": "Concerned",
   "hLabel": 1133213796
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.228AA8",
   "szText": "(coughs) Not luck. It was Akarat’s Light that shielded me…through both of you.",
   "hLabel": 1201132878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.228AA8",
   "szText": "Injured from the beating, but relieved he is alive.",
   "hLabel": 2660465339
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.228AA8",
   "szText": "I'm Bnatros. I only just arrived in Skovos.",
   "hLabel": 4171180242
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.228AA8",
   "szText": "With a smile, warm",
   "hLabel": 1335545407
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.22B189",
   "szText": "And I’m Adoné.",
   "hLabel": 3510176006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.22B189",
   "szText": "Warm, but curious about this visitor",
   "hLabel": 674541171
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.22B189",
   "szText": "If you’re looking for Akarat, I’m afraid he’s gone. Some folks say he was not who he claimed to be.",
   "hLabel": 3156901057
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.22B189",
   "szText": "Hushed for the second part of the line.",
   "hLabel": 321266222
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.BAE4",
   "szText": "It’s true. The \"Akarat\" who walked Skovos was a demon.",
   "hLabel": 3146182555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.228AA8",
   "szText": "It was no demon that drew me here. The Light is at work.",
   "hLabel": 2846260310
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.228AA8",
   "szText": "Convinced. He doesn't want to believe the stories that Akarat was evil.",
   "hLabel": 10625475
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.228AA8",
   "szText": "I seek a band of pilgrims—they're said to be gathering in the Xaera Amphitheater. Might either of you know the way?",
   "hLabel": 505605463
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.22B189",
   "szText": "Xaera? You can't go there alone. It's a dangerous path.",
   "hLabel": 1831981125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.22B189",
   "szText": "Concerned",
   "hLabel": 3291313586
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.22B189",
   "szText": "Are you for hire as a bodyguard, mainlander? I’m no fighter, and the way to the Xaera Amphitheater is through a rough part of town.",
   "hLabel": 2494441091
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.22B189",
   "szText": "To the Player, beseeching them for aid",
   "hLabel": 3953773552
  }
 ],
 "ptMapStringTable": "0"
}
