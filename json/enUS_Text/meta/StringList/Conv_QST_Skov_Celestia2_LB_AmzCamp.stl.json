  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.254108",
   "szText": "Early Morning: Queen Adreona prepares to depart Celestia Observatory. Three orders given:",
   "hLabel": 2463278038
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.254108",
   "szText": "Sober, sincere.",
   "hLabel": 3922610499
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.254108",
   "szText": "Queen’s Guard to remain in Celestia while her majesty travels West, at the behest of holy Akarat.",
   "hLabel": 2772463055
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.254108",
   "szText": "Confident, reassuring.",
   "hLabel": 4231795516
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.254108",
   "szText": "Oracle Cyra and attendants to be arrested, pending trial for treason.",
   "hLabel": 2110003089
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.254108",
   "szText": "Captain Tharra to be summoned, along with her garrison. Must obey, on pain of death.",
   "hLabel": 1447543123
  }
 ],
