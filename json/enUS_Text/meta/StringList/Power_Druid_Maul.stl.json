  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{if:SF_14}{c_label}Spirit Cost: {/c}{c_resource}{Resource Cost}{/c}\r\n{/if}{c_label}Generate Spirit:{/c_label} {c_resource}{SF_0}{/c_resource}\r\n{if:ADVANCED_TOOLTIP}{c_label}Lucky Hit Chance: {/c}{c_resource}[{Combat Effect Chance}|%|]{/c}\r\n{/if}Shapeshift into a Werebear and maul enemies in front of you, dealing {c_number}{payload:TOOLTIP_DAMAGE}{/c} damage. ",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "simple_desc",
   "szText": "Basic Skill: Turn into a Werebear and maul an enemy.",
   "hLabel": 4074669608
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": "\r\n{icon:bullet,1.2} Damage {icon:arrow,1.2} {if:Mod.UpgradeC}{c_number}{payload:UPGRADEC_DAMAGE}{/c}{else}{c_number}{payload:DAMAGE}{/c}{/if}",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod0_Description",
   "szText": "If an enemy is hit by {c_important}Maul{/c}, then {c_important}{u}Fortify{/u}{/c} for {c_number}[{SF_2}*100|%|]{/c} of your Maximum Life {c_number}([Max(1,{fortified:FORTIFY_CASTER})|0|]){/c}. ",
   "hLabel": 3591940403
  },
  {
