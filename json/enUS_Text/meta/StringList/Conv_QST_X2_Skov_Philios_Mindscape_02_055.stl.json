 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"It's Mephisto, isn't it? He's trying to find you.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BD31C",
   "szText": "My father and I share a bond. We are tethered to one another, drawn together.",
   "hLabel": 1076092555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.BD31C",
   "szText": "I always knew the bond was strong, but this...",
   "hLabel": 1254759367
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BD31C",
   "szText": "We can use this.",
   "hLabel": 3659028493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.BD31C",
   "szText": "realization dawning",
   "hLabel": 709788634
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4",
   "szText": "What are you planning?",
   "hLabel": 2911370197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.BAE4",
   "szText": "on-guard",
   "hLabel": 479289858
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BD31C",
   "szText": "The only thing you should concern yourself with is finding that blade. I will handle the rest.",
   "hLabel": 4168925288
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.BD31C",
   "szText": "Go. To the Temple of Life.",
   "hLabel": 3837695305
  }
 ],
 "ptMapStringTable": "0"
}
