 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How did you know this was down here?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.6D03F",
   "szText": "I had a hunch.",
   "hLabel": 1023908833
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.6D03F",
   "szText": "No one knew how Inarius banished Lilith. And no one knew how the curse began. Thought the blade might be our missing link.",
   "hLabel": 692678850
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.BD31C",
   "szText": "Inarius was reckless. The blade was broken, a jagged edge where it should have been honed.",
   "hLabel": 3327798510
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.BD31C",
   "szText": "Darkly.",
   "hLabel": 378558651
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.BD31C",
   "szText": "To use it like this would always leave a scar.",
   "hLabel": 3837695305
  }
 ],
 "ptMapStringTable": "0"
}
