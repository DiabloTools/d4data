   "szLabel": "DisembodiedVoice",
   "szText": "Iben Fahd",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.255901",
   "szText": "Perception is a knife with a bladed handle. To see, hear, smell, taste, touch, and sense all that surrounds us is both an incredible power and a path to the asylum.",
   "hLabel": 2439275261
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.255901",
   "szText": "Weary, anxious.",
   "hLabel": 3785002698
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.255901",
   "szText": "The Ammuit mages understood this dichotomy...enough to teach us to wield perception, but precious little for putting it down.",
   "hLabel": 1114355329
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.255901",
   "szText": "How I wish that I could.",
   "hLabel": 451895363
  }
 ],
 "ptMapStringTable": "0"
}
