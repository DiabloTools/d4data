 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What's going on?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.249D87",
   "szText": "My family has been slaughtered by pirates and SHE refuses to lift even a finger!",
   "hLabel": 4083407617
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.249D87",
   "szText": "Pleading, emphasis on \"SHE\"",
   "hLabel": 1134167758
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.249685",
   "szText": "And as I have told you, I cannot leave my post.",
   "hLabel": 1775770123
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.249685",
   "szText": "Sympathetic but growing frustrated.",
   "hLabel": 3121497560
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.249D87",
   "szText": "Please, they aren't far. I just want to lay them to rest. No one deserves to rot under a pirate’s boot.",
   "hLabel": 1113360253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.249D87",
   "szText": "Growing desperate. ",
   "hLabel": 2459087690
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.249685",
   "szText": "(sighs) Would you look into this on my behalf?",
   "hLabel": 1203492474
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.249D87",
   "szText": "Oh, Akarat bless you! I’ll meet you there once it’s safe.",
   "hLabel": 541082604
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.249D87",
   "szText": "thankful",
   "hLabel": 2000415065
  }
 ],
 "ptMapStringTable": "0"
}
