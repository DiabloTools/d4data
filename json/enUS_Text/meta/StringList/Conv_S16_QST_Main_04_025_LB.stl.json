  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2808AB",
   "szText": "We now stand prepared to open the artery—to Pandemonium—and spread Death's mercy across the face of the world.",
   "hLabel": 1780193950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2808AB",
   "szText": "One choice remains to you. Accept His mercy, or suffer His judgment.",
