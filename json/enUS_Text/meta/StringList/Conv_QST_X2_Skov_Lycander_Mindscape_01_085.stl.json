  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4.Bar",
   "szText": "Why would Mephisto choose to remember this?",
   "hLabel": 3997951962
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4.Dru",
   "szText": "Why would Mephisto choose to remember this?",
   "hLabel": 3997954704
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4.Nec",
   "szText": "Why would Mephisto choose to remember this?",
   "hLabel": 3997965147
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4.Pal",
   "szText": "Why would a demon choose to remember an angel?",
   "hLabel": 3997967202
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4.Rog",
   "szText": "Inarius was a dunce. Why would Mephisto choose to remember him?",
   "hLabel": 3997969837
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4.Sor",
   "szText": "Why would Mephisto choose to remember this?",
   "hLabel": 3997970937
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4.Spi",
   "szText": "Mephisto chose to remember this. Why?",
   "hLabel": 3997970961
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4.War",
   "szText": "Inarius was a short-sighted fool. Why would Mephisto choose to remember him?",
   "hLabel": 3997974831
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BD31C",
   "szText": "A fine question.",
   "hLabel": 3305993212
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BD31C",
   "szText": "Inarius was tortured here. And perhaps eventually, his frailty won out...",
   "hLabel": 1917219333
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line67.BD31C",
   "szText": "You told him something, didn’t you?",
   "hLabel": 3714909936
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir67.BD31C",
   "szText": "to Inarius, a realization",
   "hLabel": 765670077
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line69.84B74",
   "szText": "I beg of you...",
   "hLabel": 1951396254
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir69.84B74",
   "szText": "whispered, hoarse",
   "hLabel": 3297123691
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line71.BD31C",
   "szText": "What did you tell him?",
   "hLabel": 4224806731
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line73.84B74",
   "szText": "No more...",
   "hLabel": 2461293049
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line75.BD31C",
   "szText": "Speak!",
   "hLabel": 800744015
  }
 ],
