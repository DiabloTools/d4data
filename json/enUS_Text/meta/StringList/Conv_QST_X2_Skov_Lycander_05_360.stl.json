 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I know the risks. Where are the pieces of Lilith's blade?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.FD852",
   "szText": "One fragment is enshrined in Lycander, hidden in my old abode. Another lies in Athulua, at the edge of death and tides. The last is lost in Celestia, where nothing returns.",
   "hLabel": 1568933264
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.FD852",
   "szText": "PLAYER LEAD IN: “Where are the pieces of Lilith’s blade?”  Exhausted after the fight.                                              ",
   "hLabel": 3431820221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "Enough damn riddles.",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.6D03F",
   "szText": "irritated",
   "hLabel": 3210763048
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.FD852",
   "szText": "I will set you on this path, but you must walk it yourself. With each step comes wisdom. And wisdom is your only true defense against our Mother’s influence.",
   "hLabel": 3310742424
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.FD852",
   "szText": "Exhausted after the fight.    ",
   "hLabel": 878662085
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.FD852",
   "szText": "Lilith will never change. Do not let her change you.",
   "hLabel": 209937187
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.FD852",
   "szText": "A final clear warning. Exhausted after the fight.    ",
   "hLabel": 1555664624
  }
 ],
 "ptMapStringTable": "0"
}
