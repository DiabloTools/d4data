 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Who was that?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.23AE2D",
   "szText": "Never mind that. We're looking for Bartuc.",
   "hLabel": 4083660112
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.23AE2D",
   "szText": "That demon's head alone is not enough for me to get the information we need.",
   "hLabel": 2438532680
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.23AE2D",
   "szText": "We need eyes. The eyes of the First Khazra, which have been raiding here in Hawezar.",
   "hLabel": 1113612748
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.23AE2D",
   "szText": "I need to go prepare the skull. When you have the eyes, meet me at my safehouse to the north.",
   "hLabel": 451152782
  }
 ],
 "ptMapStringTable": "0"
}
