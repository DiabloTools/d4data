   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Neither are you. Your 'savior' has left you behind.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.229214",
   "szText": "Wrong! We chose to stay, knowing that we would never bathe in his Pools of Creation.",
   "hLabel": 1110933727
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.229214",
   "szText": "Adamant, utterly resolved.",
   "hLabel": 2456661164
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.229214",
   "szText": "We die here so this wretched world can be reborn! In Hatred!",
   "hLabel": 448473761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.229214",
   "szText": "Emphasis on \"here.\" Exultant, ready to die",
   "hLabel": 1794201198
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCFFD",
   "szText": "NO!",
