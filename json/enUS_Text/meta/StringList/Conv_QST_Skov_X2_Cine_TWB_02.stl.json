 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "The Tree of Whispers 2",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1DCFFD",
   "szText": "A world forever trapped between Heaven and Hell.",
   "hLabel": 1852236997
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.1DCFFD",
   "szText": "saying goodbye",
   "hLabel": 3311569458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCFFD",
   "szText": "She created this Sanctuary, even though she knew that all of it...all of it could be swept away at any moment.",
   "hLabel": 1189777031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCFFD",
   "szText": "But she believed someone would choose to walk in her footsteps.",
   "hLabel": 3530431878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1DCFFD",
   "szText": "Someone would stand in defiance of fate itself and protect this fragile world.",
   "hLabel": 527317065
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1DCFFD",
   "szText": "You could call it madness.",
   "hLabel": 3177156929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCFFD",
   "szText": "I call it...hope.",
   "hLabel": 2514696963
  }
 ],
 "ptMapStringTable": "0"
}
