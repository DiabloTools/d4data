{
 "__fileName__": "enUS_Text/meta/StringList/Quest_S09_QST_HoradricSecrets_01.stl",
 "__snoID__": 2272901,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Tyrael's Chosen",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase97Description",
   "szText": "I heard rumor of another Relic at the very end of Calibel's Mine. I should clear it out and search it.",
   "hLabel": 41701509
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback106Header",
   "szText": "Find the Relic within Calibel's Mine",
   "hLabel": 1281528845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase108Description",
   "szText": "I should search the body I found in Kor Valar and read the journal beside it to see if this is related to the note that I found in Calibel's Mine.",
   "hLabel": 952617550
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback110Header",
   "szText": "Search the corpse",
   "hLabel": 1791425640
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase184Description",
   "szText": "Donan's note mentioned an artifact in Broken Bulwark, under Eldhaime. It could be in a chest or urn, though with the chaos of Eldhaime's fall I should also search any corpses I find.",
   "hLabel": 4025655506
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback188Header",
   "szText": "Find the Relic within Broken Bulwark",
   "hLabel": 1214624919
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase189Description",
   "szText": "There must be other Horadric Relics out there. I should ask around and see if anyone's seen anything noteworthy.",
   "hLabel": 3836965815
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback191Header",
   "szText": "Ask a villager for rumors",
   "hLabel": 433053745
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback215Header",
   "szText": "Inspect the Relic",
   "hLabel": 1613143342
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase196Description",
   "szText": "I found a note from a bandit in Calibel's Mine that references a shield on a dead Horadrim's body in Kor Valar. If it's true, it's worth retrieving for safekeeping.",
   "hLabel": 2704827669
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback200Header",
   "szText": "Find the Relic in Kor Valar",
   "hLabel": 4076968072
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase203Description",
   "szText": "I should tell Bryona what I found, and see if she can keep the Relic safe in Cerrigar.",
   "hLabel": 2135372042
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback205Header",
   "szText": "Speak with Bryona",
   "hLabel": 1944373325
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase209Description",
   "szText": "Who knows what else could be hiding in Eldhaime? I should do a thorough sweep to find out if any other Horadric Relics are within.",
   "hLabel": 2767937872
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback213Header",
   "szText": "Search Eldhaime for clues to find other artifacts",
   "hLabel": 3325174700
  }
 ],
 "ptMapStringTable": "0"
}
