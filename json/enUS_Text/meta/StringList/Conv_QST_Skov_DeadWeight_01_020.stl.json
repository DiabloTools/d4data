   "szLabel": "MenuLabel",
   "szText": "\"What's the trouble?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25A393",
   "szText": "A willing pair of hands, are you? Good. Maybe you can help.",
   "hLabel": 2440850254
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25A393",
   "szText": "Name’s Maera. I keep things organized around here. Supplies, contracts, whatever the miners need. Today we…had a complication.",
   "hLabel": 1778390288
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25A393",
   "szText": "I'll need you to keep what you're about to see to yourself. Come with me.",
   "hLabel": 1115930322
  }
 ],
