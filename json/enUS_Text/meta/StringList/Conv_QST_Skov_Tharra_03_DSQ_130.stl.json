 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "[Experience Memory]",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "Do you think we’ll be remembered in songs? Like Camilla Drown-Foe or Atrera the Lion?",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCC9B",
   "szText": "Atrera = A-treh-ra    A younger, bright eyed hopeful dreaming about the future",
   "hLabel": 3140844812
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8FD7",
   "szText": "It’s a wonder you’ve dug any latrines. Captain will have our hides if she returns and we’re not done.",
   "hLabel": 1131116761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1D8FD7",
   "szText": "Playful banter. Teasing. Younger Adreona ",
   "hLabel": 2476844198
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "Adreona the Stalwart! Spear of Temis!",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "Cheering a future hero",
   "hLabel": 1815924880
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8FD7",
   "szText": "(laughs) Tharra, wielder of the shovel!",
   "hLabel": 4101164125
  }
 ],
