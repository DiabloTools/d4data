   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What happened, scout? Where are the rest of you?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.24C9AC",
   "szText": "We left to find reinforcements—got cut off. The others are surrounded to the north!",
   "hLabel": 2463791528
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.24C9AC",
   "szText": "Wounded, urgent",
   "hLabel": 3923123989
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.1DCC9B",
   "szText": "We'll take care of them. Get yourselves back to the Garrison.",
   "hLabel": 2790809777
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.1DCC9B",
   "szText": "Terse, reassuring",
   "hLabel": 4250142238
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.24C9AC",
