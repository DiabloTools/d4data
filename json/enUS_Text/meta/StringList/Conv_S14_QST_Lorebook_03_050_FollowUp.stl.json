 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"That prayer, 'Unto Him Hereafter'...\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "Reads almost like one of our devotionals... What Father Dymus recites at midwinter supper.",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Disturbed",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27ED42",
   "szText": "Makes my stomach turn. But there’s been only one Death I know of in history, and he was destroyed by all accounts.",
   "hLabel": 1780959073
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.27ED42",
   "szText": "Disgusted then puzzled",
   "hLabel": 3126686510
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27ED42",
   "szText": "Might be this one’s just a metaphor... Maybe let's pray it is.",
   "hLabel": 1118499107
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.27ED42",
   "szText": "Doubts it",
   "hLabel": 2464226544
  }
 ],
 "ptMapStringTable": "0"
}
