  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.6D03F",
   "szText": "Neyrelle gave her life for this thing. Gave her life for something bigger than herself and all the rest of us. A true Horadrim.",
