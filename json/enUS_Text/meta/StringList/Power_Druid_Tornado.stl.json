  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod11_Description",
   "szText": "Extend the duration of {c_important}Tornado{/c} by {c_number}[SF_18]{/c} second. Additionally, hitting a {u}{c_important}Vulnerable{/u}{/c} enemy extends the duration further by {c_number}[SF_19|1|]{/c} seconds, up to a maximum of {c_number}[SF_20]{/c} seconds.",
