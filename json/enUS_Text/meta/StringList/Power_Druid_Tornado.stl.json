  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{c_label}Spirit Cost: {/c}{c_resource}{Resource Cost}{/c}\r\n{if:ADVANCED_TOOLTIP}{c_label}Lucky Hit Chance: {/c}{c_resource}[{Combat Effect Chance}|%|]{/c}\r\n{/if}Conjure a swirling tornado for {c_number}[SF_4]{/c} seconds that deals {c_number}{PAYLOAD:DAMAGE}{/c} damage to enemies.",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": "\r\n{icon:bullet,1.2} Damage {icon:arrow,1.2} {c_number}{payload:DAMAGE}{/c}",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod8_Description",
   "szText": "{c_important}Tornadoes{/c} gain a stacking {c_number}[SF_35*100|x%|]{/c} damage bonus each second while active. After {c_number}[SF_36]{/c} seconds, {c_important}Tornadoes{/c} gain a {c_number}[SF_37*100|%|]{/c} Critical Strike Chance.",
   "hLabel": 1360065851
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod8_Name",
   "szText": "Swelling Storm",
   "hLabel": 2765954616
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod19_Description",
   "szText": "After colliding with the target, {c_important}Tornado{/c} explodes into {c_number}[SF_29]{/c} {c_important}Mini-Tornadoes{/c} that seek enemies dealing {c_number}{payload:UPGRADEB_MINI_DAMAGE}{/c} damage. {c_important}Mini-Tornadoes{/c} have half the normal duration.",
   "hLabel": 1841451661
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod19_Name",
   "szText": "Explosive Tornado",
   "hLabel": 3422335946
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod17_Description",
   "szText": "Two {c_important}Tornadoes{/c} can merge into a {c_important}Greater Tornado{/c}. {c_important}Greater Tornadoes{/c} are {c_number}[SF_33*100|%|]{/c} larger and deal {c_number}[SF_34*100|+%|]{/c} bonus damage. ",
   "hLabel": 3473162123
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod17_Name",
   "szText": "Greater Tornado",
   "hLabel": 3344065160
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod0_Description",
   "szText": "Each time you cast {c_important}Tornado{/c}, there is a {c_number}[{SF_17}*100|%|]{/c} chance to spawn an additional {c_important}Tornado{/c}.",
   "hLabel": 3591940403
