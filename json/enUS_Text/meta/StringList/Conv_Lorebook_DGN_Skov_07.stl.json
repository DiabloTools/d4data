  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.228087",
   "szText": "\"North Atanos tidepools. Seen the fish-heads dragging heavy sacks at low tide. Must have a hoard somewhere abouts...",
   "hLabel": 2435815778
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.228087",
   "szText": "Terse. Grinning at the notion of a \"hoard\" (treasure)",
   "hLabel": 3781543215
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.228087",
   "szText": "You were clever enough to steal from me, you can steal from them to pay me back. Fail to do so, and I'll feed your guts to the gulls.\" –Hooklatch",
   "hLabel": 1773355812
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.228087",
   "szText": "Sinister, grinning. Clear threat.",
   "hLabel": 3119083249
  }
 ],
