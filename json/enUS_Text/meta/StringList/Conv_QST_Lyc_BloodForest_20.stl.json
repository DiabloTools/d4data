 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I found no family, just a single dead pilgrim who was stripped naked.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.249D87",
   "szText": "Oh, that’s because I’m wearing his clothes, idiot. Those pirates you fought? Another crew, after the same treasure we were.",
   "hLabel": 1775820219
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.249D87",
   "szText": "drops to menancing and smug on \"Idiot\". Diction is also looser, rougher, tough-guy style.",
   "hLabel": 3121547656
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.249D87",
   "szText": "I should thank you for clearing them out, but that’s just not my way.",
   "hLabel": 1113360253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.249D87",
   "szText": "Smug, likes hearing himself talk",
   "hLabel": 2459087690
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.249D87",
   "szText": "Lads! Lasses! Now!",
   "hLabel": 450900287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.249D87",
   "szText": "call to arms",
   "hLabel": 1796627724
  }
 ],
 "ptMapStringTable": "0"
}
