{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_X2_Cine_HLB.stl",
 "__snoID__": 2289332,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "[PH]",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.6D03F",
   "szText": "I know Akarat's tricks. Temptation and corruption—the same bloody game, over and over.",
   "hLabel": 1533805628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.6D03F",
   "szText": "Offscreen. Voice raised, frustrated.",
   "hLabel": 2879533065
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.6D03F",
   "szText": "He is death.",
   "hLabel": 4116741566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.6D03F",
   "szText": "Offscreen.",
   "hLabel": 1167501707
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "(sighs)",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.6D03F",
   "szText": "One sigh, mentally resetting himself after an emotional note.",
   "hLabel": 4245791867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.6D03F",
   "szText": "My friend...",
   "hLabel": 670873552
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.6D03F",
   "szText": "Voice softening.",
   "hLabel": 2533760509
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "I let him use me. I'm sorry.",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1D8FD7",
   "szText": "You call Akarat \"death\"? Only one has ever left me bleeding out on the floor.",
   "hLabel": 1221299078
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1D8FD7",
   "szText": "Breathing heavily. Emphasis on \"Akarat.\"",
   "hLabel": 2680631539
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "(chokes)",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.6D03F",
   "szText": "Fearful, struggling.",
   "hLabel": 1498731690
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1D8FD7",
   "szText": "You are a failed guardian. Of your land, your people, your legacy. I won't be.",
   "hLabel": 4191346442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1D8FD7",
   "szText": "Whispered, hissing.",
   "hLabel": 1355711607
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.6D03F",
   "szText": "(gasps) (coughs)",
   "hLabel": 692678850
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1D8FD7",
   "szText": "Stay on Athulua and condemn yourself, but I will suffer sparing you no longer.",
   "hLabel": 3528886476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1D8FD7",
   "szText": "Determined, spiteful, dismissive.",
   "hLabel": 693251641
  }
 ],
 "ptMapStringTable": "0"
}
