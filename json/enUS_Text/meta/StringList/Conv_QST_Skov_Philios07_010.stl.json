{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Philios07_010.stl",
 "__snoID__": 2415220,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I know how to fight Mephisto.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6D03F",
   "szText": "What did Lilith tell you?",
   "hLabel": 1512000330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BAE4",
   "szText": "The blade is real. Neyrelle was right.",
   "hLabel": 3639732837
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "I never doubted her. But what makes it so special?",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.6D03F",
   "szText": "Pick up line",
   "hLabel": 4245791867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4",
   "szText": "It can do more than kill Mephisto—it can banish him to a place called the Void.",
   "hLabel": 1932985372
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.BAE4",
   "szText": "still trying to make sense of it, the terms are unfamiliar to them",
   "hLabel": 3795872329
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.6D03F",
   "szText": "I’ll be damned. That’s why Neyrelle believed it would “break the cycle.”",
   "hLabel": 1533805628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.6D03F",
   "szText": "Awe, realization",
   "hLabel": 2879533065
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.6D03F",
   "szText": "The Void is where Lilith herself was locked away…before Elias freed her. If we banish Mephisto there, he can’t be reborn in Hell. He can’t meddle with the fate of humankind. Almost too good to be true. Where is this blade?",
   "hLabel": 4116741566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.6D03F",
   "szText": "Putting the pieces together. Glimpsing hope.",
   "hLabel": 1167501707
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BAE4",
   "szText": "There's a catch. It’s shattered. Lilith guessed we could start looking in the Temple of Life.",
   "hLabel": 3874545195
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "To Lycander, then. I’ll make ready.",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4",
   "szText": "Wait. I think you were right—this might’ve been too risky.",
   "hLabel": 1776443800
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "Oh, no. Don’t say that, friend. This is one pot that can’t be unstirred.",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.6D03F",
   "szText": "Take heart. Come what may, I won’t let you face it alone.",
   "hLabel": 1023908833
  }
 ],
 "ptMapStringTable": "0"
}
