  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase90Description",
   "szText": "The wolf spirit Hluttred appeared to me when I completed the first of the druid rites. Perhaps she is trying to show me something.",
