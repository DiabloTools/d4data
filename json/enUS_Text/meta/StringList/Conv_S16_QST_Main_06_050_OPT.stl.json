 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": " \"If Death isn't Malthael, who or what could it be?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCFFD",
   "szText": "If the Nameless can be believed, and that is quite an \"if,\" Death is no angel and no demon.",
   "hLabel": 2457582095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCFFD",
   "szText": "Thinking aloud",
   "hLabel": 3803309532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "Perhaps \"he\" is made of both? Or neither? I have lived a very long time, but more beings dwell in Eternity than anyone can know.",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCFFD",
   "szText": "I fear we'll meet this one soon.",
   "hLabel": 1132662163
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DCFFD",
   "szText": "Dread",
