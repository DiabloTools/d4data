 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What is your opinion on Athrpa trying to fix the Sightless Eye?\"  ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22A176",
   "szText": "Tread carefully with Athrpa. The first lesson all Seers learn is that seeking specific visions is ruinous. We are mere vessels for visions, not their keepers.",
   "hLabel": 2437290250
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2541C4",
   "szText": "But…what if Athrpa could restore the Eye? Think of what it would change—",
   "hLabel": 1114312366
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2541C4",
   "szText": "Athrpa = ATH-ruh-pah  ",
   "hLabel": 2460039803
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.22A176",
   "szText": "Do not mistake the Oracle's indulgence for trust. Lest Athrpa do something drastic. Think on it no more.",
   "hLabel": 449910352
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.22A176",
   "szText": "Athrpa = ATH-ruh-pah  ",
   "hLabel": 1795637789
  }
 ],
 "ptMapStringTable": "0"
