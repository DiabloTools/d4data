{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_EchoingHatred_01_030.stl",
 "__snoID__": 2446840,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Echoes? Coming from this artifact?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.251FCD",
   "szText": "They are the voices of the dead. Awakened when the Lord of Hatred screamed his last.",
   "hLabel": 2439182252
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.251FCD",
   "szText": "Somber, heavy, weary. Disturbed by the memory of the scream.",
   "hLabel": 3784909689
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.251FCD",
   "szText": "I hear them day and night, clawing their way back to our living world.",
   "hLabel": 1776722286
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.251FCD",
   "szText": "Disturbed, weary. This has kept her up nights.",
   "hLabel": 3122449723
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.251FCD",
   "szText": "We will need the Sightless Eye. Set it here.",
   "hLabel": 120572371
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.251FCD",
   "szText": "Nodding. Calmly bracing herself. ",
   "hLabel": 1466299808
  }
 ],
 "ptMapStringTable": "0"
}
