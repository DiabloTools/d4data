{
 "__fileName__": "enUS_Text/meta/StringList/Conv_X2_Collectibles_Skov_Skartara_01.stl",
 "__snoID__": 2467555,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.FD852",
   "szText": "Mother, I beg you: cease this madness. This needless cruelty!",
   "hLabel": 1568933264
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.FD852",
   "szText": "At his wit's end, begging.",
   "hLabel": 3431820221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BD31C",
   "szText": "Needless? They were going to kill you. All of you.",
   "hLabel": 4147119990
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.BD31C",
   "szText": "A mix of surprised and offended.",
   "hLabel": 1715039651
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.FD852",
   "szText": "How would you know? You slaughtered them before they had a chance to answer for themselves.",
   "hLabel": 2439837844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.FD852",
   "szText": "Trying to contain anger/hurt.",
   "hLabel": 7757505
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.FD852",
   "szText": "Angels, demons, even other Firstborn.",
   "hLabel": 727806486
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.FD852",
   "szText": "Trying to contain anger/hurt.",
   "hLabel": 2590693443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BD31C",
   "szText": "I made the necessary choice to keep you safe from those who would do you harm.",
   "hLabel": 3305993212
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.BD31C",
   "szText": "Lost her patience, not entertaining Rathma's insolence anymore.",
   "hLabel": 873912873
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BD31C",
   "szText": "If you leave your destiny up to such childish fantasies as diplomacy, prepare to be disappointed. Or worse.",
   "hLabel": 1917219333
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.BD31C",
   "szText": "Firm, \"I won't say this again\" feel",
   "hLabel": 3262946770
  }
 ],
 "ptMapStringTable": "0"
}
