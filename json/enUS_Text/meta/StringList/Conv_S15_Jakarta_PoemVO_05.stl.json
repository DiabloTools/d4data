   "szLabel": "DisembodiedVoice",
   "szText": "Deckard Cain",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27B44D",
   "szText": "The elders denied the tales were true,",
   "hLabel": 2443259006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27B44D",
   "szText": "Blind to the hoof tracks, deaf to the “moo.”",
   "hLabel": 1780799040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27B44D",
   "szText": "Yet they knew the danger waiting any who dared,",
   "hLabel": 1118339074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.27B44D",
   "szText": "To follow the hoof tracks down, down, down...",
   "hLabel": 455879108
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.27B44D",
   "szText": "In search of the Horned Beast’s lair.",
   "hLabel": 4088386438
  }
 ],
