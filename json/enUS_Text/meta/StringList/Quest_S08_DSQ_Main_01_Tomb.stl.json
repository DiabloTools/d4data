 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Ice-Rimed Crypt",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "A forgotten crypt buried in the snow.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase42Description",
   "szText": "The crypt is frozen over with ice and overrun with strange demons. I need to find the source.",
   "hLabel": 2162183707
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback41Header",
   "szText": "Search for the source of the strange demons",
   "hLabel": 1248479483
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase43Description",
   "szText": "I've found a Knight battling demons. It looks like he could use my assistance.",
   "hLabel": 2983439228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback45Header",
   "szText": "Assist the Knight",
   "hLabel": 2119384063
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase49Description",
   "szText": "We need to venture deeper into the crypt and find the source of these strange demons.",
   "hLabel": 3616005058
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback51Header",
   "szText": "Search for the source of the demons",
   "hLabel": 917249500
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase54Description",
   "szText": "I must fight the creature that Belial has summoned to kill me.",
   "hLabel": 841355870
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback53Header",
   "szText": "Slay the summoned Apparition",
   "hLabel": 3500185438
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase58Description",
   "szText": "I should listen to what this stranger has to say. ",
   "hLabel": 4126377954
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback60Header",
   "szText": "Wait for the stranger",
   "hLabel": 3589518844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase63Description",
   "szText": "I should speak with Sayeena about what just transpired with Belial. She might know more about the demon.",
   "hLabel": 1351728766
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback62Header",
   "szText": "Speak with Sayeena",
   "hLabel": 1877487486
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase66Description",
   "szText": "It seems the Knight wishes to speak with me.",
   "hLabel": 3815495329
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback68Header",
   "szText": "Speak with the Knight",
   "hLabel": 1036360708
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase84Description",
   "szText": "I should leave the crypt.",
   "hLabel": 541273825
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback83Header",
   "szText": "Leave the crypt",
   "hLabel": 2506495489
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase91Description",
   "szText": "I must fight the creature that Belial has summoned to kill me.",
   "hLabel": 3704102975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback93Header",
   "szText": "Slay the Apparition",
