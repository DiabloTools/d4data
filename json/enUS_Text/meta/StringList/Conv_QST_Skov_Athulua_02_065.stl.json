{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_02_065.stl",
 "__snoID__": 2460794,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why didn't you join us against Lilith?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCFFD",
   "szText": "I told myself I'd make the journey. That I needed time to prepare, but...(sighs) I was lost. In doubt and fear.",
   "hLabel": 2514696963
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1DCFFD",
   "szText": "Regret, shame, admitting the truth",
   "hLabel": 3974029424
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1DCFFD",
   "szText": "Had I made the right choices? What happened in my absence? Who might I have saved had I not been so...",
   "hLabel": 1852236997
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.1DCFFD",
   "szText": "Admitting his struggle, frustrated with himself",
   "hLabel": 3311569458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.6D03F",
   "szText": "Human?",
   "hLabel": 3275614788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.6D03F",
   "szText": "Helping. Empathetic",
   "hLabel": 326374929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.1DCFFD",
   "szText": "You excuse me too easily.",
   "hLabel": 836502082
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.1DCFFD",
   "szText": "Surprised. Balking.",
   "hLabel": 2295834543
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.6D03F",
   "szText": "I excuse nothing. You’ll have to make it up to us.",
   "hLabel": 3785511583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.6D03F",
   "szText": "Smiling, teasing.",
   "hLabel": 836271724
  }
 ],
 "ptMapStringTable": "0"
}
