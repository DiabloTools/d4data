{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Philios_TheCostofMiracles_IGC01.stl",
 "__snoID__": 2401300,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What's this about a gift from Akarat?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24A3D2",
   "szText": "One week ago, my sister was attacked by a swarm of overgrown insects. Now, something awful grows inside of her.",
   "hLabel": 2439665751
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24A3D2",
   "szText": "thankful someone will listen",
   "hLabel": 3785393188
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24A3D2",
   "szText": "It chitters in the night. It writhes. It will carve her open!",
   "hLabel": 1777205785
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24A3E4",
   "szText": "As I have told you, I had a vision of Akarat. He promised to bless our family as a reward for my devotion. This is that—",
   "hLabel": 452285888
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.24A3E4",
   "szText": "Letting his frustration get the better of him.",
   "hLabel": 1798013325
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24A3E0",
   "szText": "(screams)",
   "hLabel": 1114745850
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.24A3E0",
   "szText": "In unbearbale agony. ",
   "hLabel": 2460473287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.24A3E4",
   "szText": "I must tend to her.",
   "hLabel": 4084793218
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.24A3E4",
   "szText": "hurried",
   "hLabel": 1135553359
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.24A3E4",
   "szText": "Stay here until you have purged those blasphemous thoughts from your mind.",
   "hLabel": 1204928171
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.24A3E4",
   "szText": "To Olaros, frustrated.",
   "hLabel": 2664260632
  }
 ],
 "ptMapStringTable": "0"
}
