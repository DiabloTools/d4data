  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.258D91",
   "szText": "I’ve never seen the waters so generous! Perhaps the Eclipse was a good omen.",
   "hLabel": 2439430196
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "I remember you saying hard work makes harder hands, uncle.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCC9B",
   "szText": "A little cheeky.",
   "hLabel": 3140844812
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.258D91",
   "szText": "I’ve had enough of hard work. Let the fish come easy for once.",
   "hLabel": 1114510264
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.258D91",
   "szText": "Tired and rueful with a touch of wry humor",
   "hLabel": 2460237701
  }
 ],
