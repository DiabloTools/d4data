{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Celestia1_02_027.stl",
 "__snoID__": 2496267,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What made you decide to stay?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCC9B",
   "szText": "I have not decided anything.",
   "hLabel": 2457577341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCC9B",
   "szText": "slightly sharp",
   "hLabel": 3803304778
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B.Dru",
   "szText": "When we first met, I thought you feral. The Queenslayer’s hound.",
   "hLabel": 2429471416
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B.Nec",
   "szText": "When we first met, I thought you lost. A Priest of Rathma who had forgotten the Balance.",
   "hLabel": 2429481859
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B.Rog",
   "szText": "When we first met, I thought you a criminal. The Queenslayer’s cutthroat.",
   "hLabel": 2429486549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B.Sor",
   "szText": "When we first met, I thought you dangerous. A power-hungry mage.",
   "hLabel": 2429487649
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B.War",
   "szText": "When we first met, I thought you a villain. The Queenslayer’s master.",
   "hLabel": 2429491543
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B.Spi",
   "szText": "When we first met, I thought you misguided. The Queenslayer’s puppet.",
   "hLabel": 2429487673
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B.Bar",
   "szText": "When we first met, I thought you a brute. The Queenslayer’s muscle.",
   "hLabel": 2429468674
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B.Pal",
   "szText": "When we first met, I thought you misguided. The Queenslayer’s puppet.",
   "hLabel": 2429483914
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "But I watched you. And despite everything, you seemed to act for the good of Skovos. I believed you were someone I could count on.",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "hurt",
   "hLabel": 1815924880
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line16.1DCC9B",
   "szText": "Now? Now I wonder if I was right the first time.",
   "hLabel": 3861657107
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir16.1DCC9B",
   "szText": "torn",
   "hLabel": 1026022272
  }
 ],
 "ptMapStringTable": "0"
}
