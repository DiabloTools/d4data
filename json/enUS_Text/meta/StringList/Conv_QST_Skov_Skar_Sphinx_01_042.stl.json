{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Skar_Sphinx_01_042.stl",
 "__snoID__": 2384618,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What are you?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.244C6E",
   "szText": "I could ask you the same, one whose soul is stained by Hatred.",
   "hLabel": 2438099391
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.244C6E",
   "szText": "I am Phix. I have shared knowledge for as long as the rivers have flowed.",
   "hLabel": 540901810
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.244C6E",
   "szText": "If you are not here to learn, then what do you seek?",
   "hLabel": 450719493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.244C64",
   "szText": "Wait! Uh—oh great tutor. We ARE here to learn. I wish to know what the Firstborn knew.",
   "hLabel": 1113179410
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.244C64",
   "szText": "panicked, trying to seize his opportunity",
   "hLabel": 2458906847
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.244C6E",
   "szText": "The \"Firstborn?\" ...Ah. Yes, there is some of them in you. But you stare at shadows and think the ground black.",
   "hLabel": 4173409140
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.244C6E",
   "szText": "not immediately sure who the “Firstborn” are, then realization sets in",
   "hLabel": 1337774305
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.244C6E",
   "szText": "Prove yourself. Answer me this...",
   "hLabel": 1203361776
  }
 ],
 "ptMapStringTable": "0"
}
