 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"There is writing on the wall...\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCFFD",
   "szText": "\"No angel of Heaven\"...",
   "hLabel": 2457582095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCFFD",
   "szText": "Frowning, puzzled",
   "hLabel": 3803309532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line6.1DCFFD",
   "szText": "These might be the ravings of a broken man, but whatever \"Death\" the Nameless reveres, I do not think it can be Malthael. It is someone, or something, else.",
   "hLabel": 801432180
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir6.1DCFFD",
   "szText": "Tired, trying to think",
   "hLabel": 2147159617
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.1DCFFD",
   "szText": "So our war continues. That is...if you will still stand with me?",
   "hLabel": 138972214
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.1DCFFD",
   "szText": "Hoping Player will still help him, knowing how he failed the Nameless",
   "hLabel": 1484699651
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line18.1DCFFD",
   "szText": "(sighs) Fair enough.",
   "hLabel": 3199201895
  }
 ],
 "ptMapStringTable": "0"
}
