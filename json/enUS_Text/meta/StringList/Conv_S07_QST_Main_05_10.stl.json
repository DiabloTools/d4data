 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What is going on?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1F9FF1",
   "szText": "That accursed talisman you and Caidin found has forced our hand. Rotten or no, we must restore these heads to the Tree...and learn what witch has defiled them.",
   "hLabel": 1795984566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1F9FF1",
   "szText": "Bitter. Angry. Urgent.",
   "hLabel": 3141712003
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1FA017",
   "szText": "I’d almost rather not know. For them, the Tree will demand a punishment unlike any before...and we'll be the ones to deliver it.",
   "hLabel": 472441565
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1FA017",
   "szText": "Dread. Heartsick.",
   "hLabel": 1818169002
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1FA02A",
   "szText": "A witch makes their own choices. Enter the ritual circle, and let us begin.",
   "hLabel": 1134901606
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1FA02A",
   "szText": "Terse. Grim. Let's get on with it.",
   "hLabel": 2480629043
  }
 ],
 "ptMapStringTable": "0"
}
