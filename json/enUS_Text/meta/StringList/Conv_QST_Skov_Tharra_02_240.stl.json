 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": " \"Are you going to heed Oracle Cyra's advice?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "I did not realize how deep the wound ran. But how could it not? I never got to face Adreona. Look into her eyes.",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "Tight and bitter",
   "hLabel": 1815924880
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCC9B",
   "szText": "(sigh) The Cavern of Echoes isn’t far from where I was raised.  Meet me there. This will be my final Passage.",
   "hLabel": 3530427124
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1DCC9B",
   "szText": "Deep sigh, then accepts the next step.",
   "hLabel": 694792289
  }
 ],
