 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Have you read 'My Absolution'?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "Aye... If you overlook the unspeakable sin and the justification for mass-murder, you might almost feel sorry for him.",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Bitter sarcasm, contempt",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.27ED42",
   "szText": "But who is he, where is he, and how do we kill him? Hard to say from this happy tale, even assuming he ain't talking shite.",
   "hLabel": 1780959073
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.27ED42",
   "szText": "Thinking aloud",
   "hLabel": 3126686510
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.27ED42",
   "szText": "Buried or not, bastards like this ain’t content to hide for long... He’ll show hisself sooner or later.",
   "hLabel": 1118499107
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.27ED42",
   "szText": "Concerned",
   "hLabel": 2464226544
  }
 ],
