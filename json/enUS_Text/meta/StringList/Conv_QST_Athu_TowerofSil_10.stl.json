 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Do you need help?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25AFEF",
   "szText": "Are you squeamish? If not, then yes.",
   "hLabel": 2440907296
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25AFEF",
   "szText": "weary, determined, convicted",
   "hLabel": 3786634733
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25AFEF",
   "szText": "We’ve got Drowned corpses piling up from battle. They’re infecting wildlife and spreading disease. My entire unit is down.",
   "hLabel": 1778447330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25AFEF",
   "szText": "The only safe way to dispose of the bodies is with Burial Fire, and I’m fresh out. If you gather the ingredients, I’ll prepare the bodies.",
   "hLabel": 1115987364
  }
 ],
 "ptMapStringTable": "0"
}
