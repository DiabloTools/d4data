 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"That makes Yorin your nephew. Did you know him?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.21FCD5",
   "szText": "Ah, Yorin. The boy had his mother’s laugh, his father’s tact. I taught him how to skip stones, when he was still young.",
   "hLabel": 2436339948
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.21FCD5",
   "szText": "smiling, but still grieving the loss",
   "hLabel": 3782067385
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.21FCD5",
   "szText": "When I parted with his family, he was the only one who didn’t understand. He never stopped writing me, asking when I’d come round for dinner again.",
   "hLabel": 1773879982
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.21FCD5",
   "szText": "sad",
   "hLabel": 3119607419
  }
 ],
 "ptMapStringTable": "0"
}
