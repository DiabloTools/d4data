   "szLabel": "Line7.251FCD",
   "szText": "(sighs) You were down so long I thought you had joined the dead! Well fought, indeed.",
   "hLabel": 451802354
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.251FCD",
   "szText": "Deep relief. Congratulating.",
   "hLabel": 1797529791
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.251FCD",
   "szText": "There you are, at long last! You went still as a winter stone. Remarkable.",
   "hLabel": 1535674620
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir10.251FCD",
   "szText": "Deep relief, amazed.",
   "hLabel": 2995007081
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.251FCD",
   "szText": "(laughs) The echoes are barely a whisper in my ears. We are safe...and I might sleep tonight.",
   "hLabel": 541984671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.251FCD",
   "szText": "Deep relief, appreciation.",
