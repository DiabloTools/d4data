  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.255B66",
   "szText": "A warm, excited greeting. She hasn't seen her friend in many years. ",
   "hLabel": 3122587584
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.219CC0",
   "szText": "Laurel… Please don’t get up.",
   "hLabel": 2434722745
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.219CC0",
   "szText": "She says the name fondly, but is saddened that her friend has magically aged so much. She urges Laurel not to exert herself. ",
   "hLabel": 3780450182
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.255B66",
   "szText": "Nonsense.",
   "hLabel": 1114400181
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.255B66",
   "szText": "Brushing off her friend's concern.",
   "hLabel": 2460127618
  }
 ],
