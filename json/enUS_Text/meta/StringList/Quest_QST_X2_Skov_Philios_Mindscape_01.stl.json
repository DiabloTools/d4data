   "hLabel": 2089588174
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase233Description",
   "szText": "Lilith looks as if she's seen a ghost. If the Pools of Creation are real enough to scare her, I need to know what they are.",
