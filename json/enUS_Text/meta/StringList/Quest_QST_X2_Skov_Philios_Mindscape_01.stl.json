   "__typeHash__": 3844612145,
   "szLabel": "Callback226Header",
   "szText": "Reach Lilith",
   "hLabel": 2573381328
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase230Description",
   "szText": "Lilith is giving me one chance to convince her. Lorath's advice better pay off, or this may have all been for nothing.",
   "hLabel": 3666490730
  },
  {
