  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase227Description",
   "szText": "Lilith is awake, and she is fighting to keep me out. But I cannot afford to back down now. She will help me, one way or another.",
   "hLabel": 3788683664
  },
  {
   "__type__": "StringTableEntry",
