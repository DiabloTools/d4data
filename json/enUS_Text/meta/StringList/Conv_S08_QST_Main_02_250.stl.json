 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What do you know of this buried outpost?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2101F5",
   "szText": "When the Cathedral moved its troops from it, cultists moved in. Defiled the place.",
   "hLabel": 1771885000
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2101F5",
   "szText": "The troops returned and slew the cultists, but the damage was done.",
   "hLabel": 1109425034
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.2101F5",
   "szText": "The Cathedral buried the place, rather than try to reclaim it.",
   "hLabel": 4079472398
  }
 ],
 "ptMapStringTable": "0"
}
