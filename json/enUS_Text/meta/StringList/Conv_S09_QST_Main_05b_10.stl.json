 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"This is the only way to purge Astaroth's blood.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.229BD8",
   "szText": "Not you too. What if he gets out? And sets all of Sanctuary ablaze?",
   "hLabel": 2435907618
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.21FCD5",
   "szText": "They’ve killed him before. They’ll kill him again! This is our only shot, Davish. Come with us. Fight with us!",
   "hLabel": 4081467380
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.21FCD5",
   "szText": "incensed",
   "hLabel": 1132227521
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.229BD8",
   "szText": "How many times have I defended you in front of the elders? What are they going to say?",
   "hLabel": 538710037
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.229BD8",
   "szText": "amazed, hurt, he’s already made up his mind",
   "hLabel": 1998042498
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.229BD8",
   "szText": "This isn’t you, Bryona.",
   "hLabel": 3508757401
  }
 ],
 "ptMapStringTable": "0"
}
