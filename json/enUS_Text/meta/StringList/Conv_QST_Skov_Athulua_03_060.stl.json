{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_03_060.stl",
 "__snoID__": 2259554,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"We must go to the Foundering Caverns. What's the situation there?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line63.24C67B",
   "szText": "“Situation?” (scoffs) You’re talking about the source of every arse-rotten Drowned in Athulua!",
   "hLabel": 1724169527
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir63.24C67B",
   "szText": "Scoffing. It's a ridiculous, suicidal notion.",
   "hLabel": 3183501988
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line65.24C67C",
   "szText": "We sent scouts to the Caverns when this all started, but none returned. What do you hope to achieve there?",
   "hLabel": 1061709562
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir65.24C67C",
   "szText": "Giving the latest news. Then curious, intrigued.",
   "hLabel": 2521042023
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line67.24C67B",
   "szText": "You cannot be entertaining this... Going to the Caverns is suicide. The best they’ll do is provoke them!",
   "hLabel": 399249595
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir67.24C67B",
   "szText": "Disbelief, adamant, protesting",
   "hLabel": 1858582056
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line69.24C67C",
   "szText": "Tyrael has proven himself a capable ally.",
   "hLabel": 4031756926
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir69.24C67C",
   "szText": "Containing anger, calmly arguing",
   "hLabel": 1196122091
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line71.1DCFFD",
   "szText": "Captains—",
   "hLabel": 63817286
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir71.1DCFFD",
   "szText": "Attempting to interject, interrupted",
   "hLabel": 1523149747
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line73.24C67B",
   "szText": "And we have fought side-by-side since we were spearmaidens! Listen to me! We need to leave!",
   "hLabel": 3678481976
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir73.24C67B",
   "szText": "Temper flaring, determined to convince her (save her)",
   "hLabel": 842847141
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line75.24C67C",
   "szText": "I will not abandon this island!",
   "hLabel": 3016022011
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir75.24C67C",
   "szText": "Erupting, furious, determined",
   "hLabel": 180387176
  }
 ],
 "ptMapStringTable": "0"
}
