 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What makes Atanos so dangerous?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCC9B",
   "szText": "The flood didn’t just kill the island, it cursed the Ancients who died here...and all who died after. They are the Drowned.",
   "hLabel": 2457577341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCC9B",
   "szText": "Grim. Revealing the origin of the Drowned--who the Player/Tharra just narrowly defeated.",
   "hLabel": 3803304778
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "Beyond them, you’ve got disease, mud-sinks, pirates...all manner of sleepless horrors lurking in these ruins.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCC9B",
   "szText": "Listing dangers, each of which has killed her soldiers",
   "hLabel": 3140844812
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCC9B",
   "szText": "We’d best get moving.",
   "hLabel": 1132657409
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DCC9B",
   "szText": "Abrupt, eager to leave",
   "hLabel": 2478384846
  }
 ],
 "ptMapStringTable": "0"
}
