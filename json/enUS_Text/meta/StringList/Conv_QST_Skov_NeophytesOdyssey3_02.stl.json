 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Where are the other pilgrims you were traveling with?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.228AA8",
   "szText": "They’ve been taken to some place called the “Garden of Akarat.”",
   "hLabel": 2435870493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.228AA8",
   "szText": "Worried",
   "hLabel": 3781597930
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.228AA8",
   "szText": "It happened after we made camp. Pilgrims in strange robes approached us—we welcomed them, of course. But then…we saw that they were not alone.",
   "hLabel": 1110950561
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.228AA8",
   "szText": "Worried",
   "hLabel": 2456677998
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.228AA8",
   "szText": "Morlu trailed in their footsteps.",
   "hLabel": 448490595
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.228AA8",
   "szText": "Worried",
   "hLabel": 1794218032
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.228AA8",
   "szText": "These heretics…one of them must know where the Garden of Akarat is. We have to save Adoné and the others who were taken there.",
   "hLabel": 4080997925
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.228AA8",
   "szText": "Worried. \"these heretics\" refers to the strange robed people who took away the other pilgrims.",
   "hLabel": 1131758066
  }
 ],
 "ptMapStringTable": "0"
}
