   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Let us venture forward.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.20FFCC",
   "szText": "This is a cursed place, overrun with Belial's cultists and who knows what else. I am not a fighter. I'll need you to keep them away from me.",
   "hLabel": 2435157307
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.20FFCC",
   "szText": "Move quickly. The longer we linger, the more opportunity for Belial to plant his lies in our minds.",
   "hLabel": 1772697341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.20FFCC",
   "szText": "We can start the ritual once we reach the adytum.",
   "hLabel": 1110237375
  }
 ],
 "ptMapStringTable": "0"
