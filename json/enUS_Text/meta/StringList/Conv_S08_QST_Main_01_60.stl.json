 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Who are you? What are you doing here, Knight?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.2101F5",
   "szText": "I'm Jarius, pledged to the Cathedral of Light. And I’m killing demons, of course.",
   "hLabel": 4079472398
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2101F5",
   "szText": "This is my crusade, to wipe them all from Sanctuary!",
   "hLabel": 2434344966
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2101F5",
   "szText": "These demons, though, these are different. They’re some new breed, and growing in number.",
   "hLabel": 1771885000
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2101F5",
   "szText": "But I will find the cause, and I will put an end to it. This I swear.",
   "hLabel": 1109425034
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.2101F5",
   "szText": "Care to join me?",
   "hLabel": 446965068
  }
 ],
 "ptMapStringTable": "0"
}
