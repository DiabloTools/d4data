   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase5Description",
   "szText": "We found Tharra and her Amazons by the shore, watching the temple go down. I should tell her what has happened. This victory is hers too.",
