  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "BreadcrumbDescription",
   "szText": "Tyrael and I have escaped the Pools and emerged back in Atanos. I banished Mephisto from this world, yet the ground shakes beneath us. What is happening?",
   "hLabel": 4222796379
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "With Mephisto gone, the Temple of Union is sinking back into the sea, taking the Pools of Creation with it. Tyrael suggests we head to the shore to watch. Hard to believe it's real.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0OutsideSubzoneHeader",
   "szText": "Go to the shore with Tyrael",
   "hLabel": 220322285
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
