 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Achaia?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8BEB",
   "szText": "She was an ancient Oracle. The curator of these halls, and the urns’ creator.",
   "hLabel": 2456032413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8BEB",
   "szText": "Those were her words before leaving the order. Before disappearing into shadow.",
   "hLabel": 1793572447
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8BEB",
   "szText": "It seems she is still alive, and her animosity has survived with her.",
   "hLabel": 1131112481
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1D8BEB",
   "szText": "This blood is an invitation. To those who can see. Sisters in sacrifice.",
   "hLabel": 468652515
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "I accept—but only to see fate returned to its owners.",
   "hLabel": 4101159845
  }
 ],
 "ptMapStringTable": "0"
}
