 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Astaroth",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.BF6E6",
   "szText": "Your Druid friend is eager to summon me. To kill me. I heard it, the edge in her voice.",
   "hLabel": 2014602055
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.BF6E6",
   "szText": "smiling",
   "hLabel": 3877489012
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BF6E6",
   "szText": "Only through Mephisto’s will would it be possible. If it were anyone else calling on me, he would keep me trapped here, in Hell.",
   "hLabel": 1917296145
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.BF6E6",
   "szText": "But it’s you. So he's letting me go. It seems he would take joy from my death at your hands, wanderer. No matter. Let us wound and be wounded again.",
   "hLabel": 205264787
  }
 ],
 "ptMapStringTable": "0"
}
