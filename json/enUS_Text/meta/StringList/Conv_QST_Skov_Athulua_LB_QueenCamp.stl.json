{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_LB_QueenCamp.stl",
 "__snoID__": 2501146,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Torn Letter",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Adreona",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.1D8FD7",
   "szText": "Oh Lorath, how did we get here? So far from the time we shared. Like that day you stormed into my camp, mad with some need for an audience with me.",
   "hLabel": 2480084112
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.1D8FD7",
   "szText": "Somber, confused. Then reaching for a happy memory",
   "hLabel": 3939416573
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.1D8FD7",
   "szText": "Incensed by the noise, I burst from my tent, and there you were—entangled with my guards like a badger in a fishing net.",
   "hLabel": 2789269129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.1D8FD7",
   "szText": "Smiling. She can still see how ridiculous he looked.",
   "hLabel": 4248601590
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.1D8FD7",
   "szText": "I tried my best not to laugh, which made you laugh. And then we laughed together, and for a moment, we forgot the world.",
   "hLabel": 2126809163
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.1D8FD7",
   "szText": "Smiling, wistful",
   "hLabel": 3586141624
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.1D8FD7",
   "szText": "What changed, Lorath? How could you do this to me?",
   "hLabel": 1464349197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.1D8FD7",
   "szText": "Somber and confused again. Hurt.",
   "hLabel": 2923681658
  }
 ],
 "ptMapStringTable": "0"
}
