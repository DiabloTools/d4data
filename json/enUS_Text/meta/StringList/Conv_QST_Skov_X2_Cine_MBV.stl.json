 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Lord of Hatred RTC placeholder.",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BD9D3",
   "szText": "(grunts)",
   "hLabel": 3659036662
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.BD9D3",
   "szText": "Weak, labored. He is dying. But he is trying to poison the Player's victory and tell him \"nothing you do will change fate.\"",
   "hLabel": 709796803
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BD9D3",
   "szText": "Here it is. Victory. (grunt) So much effort simply to return where we began.",
   "hLabel": 1564192221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.BD9D3",
   "szText": "Weak, labored. He is dying. But he is trying to poison the Player's victory and tell him \"nothing you do will change fate.\"",
   "hLabel": 3427079178
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BD9D3",
   "szText": "You, alone. Just as I found you.",
   "hLabel": 4147128159
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.BD9D3",
   "szText": "Weak, labored. He is dying. But he is trying to poison the Player's victory and tell him \"nothing you do will change fate.\"",
   "hLabel": 1715047820
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BD9D3",
   "szText": "You sacrificed everything, but changed nothing.",
   "hLabel": 2435096801
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.BD9D3",
   "szText": "Weak, labored. He is dying.",
   "hLabel": 3016462
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.BD9D3",
   "szText": "I will be reborn in Hell, and you will be forgotten.",
   "hLabel": 723065443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.BD9D3",
   "szText": "Weak, labored. He is dying.",
   "hLabel": 2585952400
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BAE4",
   "szText": "You're not going back to Hell.",
   "hLabel": 1619902228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.BAE4",
   "szText": "Quiet, hissing.",
   "hLabel": 3482789185
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BAE4",
   "szText": "(grunts)",
   "hLabel": 2989640983
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.BD9D3",
   "szText": "(pained roar)",
   "hLabel": 205196144
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.BD9D3",
   "szText": "Mephisto roars in pain after being stabbed by the Player.",
