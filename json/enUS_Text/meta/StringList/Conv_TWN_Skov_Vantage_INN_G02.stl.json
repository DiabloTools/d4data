   "szLabel": "MenuLabel",
   "szText": "\"Does the camp have enough supplies?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2444DB",
   "szText": "Not even close. We’re spread too thin. The battle has as many fronts as this island has shores.",
   "hLabel": 2438049723
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2444DB",
   "szText": "But by the Ancients’ wisdom, misery’s the stage for glory! Let them come. If death’s our fate, we’ll leave Sanctuary legend-bound.",
   "hLabel": 1775589757
  }
 ],
