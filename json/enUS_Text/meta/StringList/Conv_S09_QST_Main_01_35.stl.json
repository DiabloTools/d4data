   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are you allowed to send people to squat at Donan's estate?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line4.21FCD5",
   "szText": "If I weren’t, no one’s stopped me.",
   "hLabel": 1442649999
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir4.21FCD5",
   "szText": "white lie",
   "hLabel": 2788377436
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.21FCD5",
   "szText": "Listen. These people have nowhere to go. Had their homes and farms razed flat when Astaroth broke free.",
   "hLabel": 3509189731
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.21FCD5",
   "szText": "All because of Donan. It’s only right he give a little something back, eh?",
   "hLabel": 2846729765
  }
 ],
