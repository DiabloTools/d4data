 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "A Divine Missive",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "A mysterious voice calls out for assistance against the demonic invasion of Sanctuary.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "A voice has called out to me, though I cannot tell where it comes from. It is telling me to come to the College of Light in the Fractured Peaks.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Follow the Angelic Voice",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase75Description",
   "szText": "A voice has called out to me, though I cannot tell where it comes from. It is telling me to come to the College of Light in the Fractured Peaks.",
   "hLabel": 30900929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback74Header",
   "szText": "Follow the voice to the College of Light",
   "hLabel": 4129193441
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase78Description",
   "szText": "I've found a portal in the College of Light that seems to be emitting an angelic glow. I should follow the voice as it seems to want to lend me aid.",
   "hLabel": 2494667492
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback77Header",
   "szText": "Enter the portal within the College of Light",
   "hLabel": 3708630052
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase87Description",
   "szText": "Hadriel wishes to speak with me about lending his aid to the fight against the demonic presence within Sanctuary.",
   "hLabel": 3005040388
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback91Header",
   "szText": "Speak with Hadriel",
   "hLabel": 3887296864
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase88Description",
   "szText": "Hadriel wishes to offer his blessing to me and lend aid against the forces of the Lesser Evils that are invading Sanctuary.",
   "hLabel": 3826295909
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback93Header",
   "szText": "Receive Hadriel's Blessing",
   "hLabel": 2175265506
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase89Description",
   "szText": "I need to approach Hadriel to see what he has to say about what is going on in Sanctuary.",
   "hLabel": 352584134
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback95Header",
   "szText": "Approach the Angel",
   "hLabel": 463234148
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback103Header",
   "szText": "Return to the Heavenly Forge",
   "hLabel": 1702092234
  }
 ],
