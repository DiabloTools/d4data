 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Cursed urns?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.235BFC",
   "szText": "Yes. The fate urns created from the offering. Desdemona’s showed she would be torn in half. Lycus showed he would drown.",
   "hLabel": 1774489934
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.235C3F",
   "szText": "I will be smothered by darkness. All around. Suffocating…",
   "hLabel": 2436949309
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.235C3F",
   "szText": "fearful, shaken",
   "hLabel": 3782676746
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.235C46",
   "szText": "Stop it! You don’t see me hiding in an open field because a pot showed me smashed by stones.",
   "hLabel": 1112029362
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.235C46",
   "szText": "Is that why Mikkos clings to you? You have him afraid of his own shadow.",
   "hLabel": 449569396
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.235C4A",
   "szText": "Shadow?",
   "hLabel": 4082076769
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.235C4A",
   "szText": "confused",
   "hLabel": 1132836910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.235BFC",
   "szText": "Leave him out of this!",
   "hLabel": 1202212285
  }
 ],
 "ptMapStringTable": "0"
}
