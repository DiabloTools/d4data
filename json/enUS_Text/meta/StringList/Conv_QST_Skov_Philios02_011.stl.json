   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What brought you to Skovos, before?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "Tyrael did. It was me, him, and Donan. We were going to rebuild the Horadric Order.",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.6D03F",
   "szText": "It wasn’t a complete waste of time. Made some damn good friends. Adreona, for one.",
   "hLabel": 1533805628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.6D03F",
   "szText": "Maybe things would’ve turned out different, if I’d stayed.",
   "hLabel": 4116741566
  }
 ],
 "ptMapStringTable": "0"
}
