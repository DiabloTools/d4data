  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24FBBF",
   "szText": "I was only able to secure passage for one of us. You—you should go.",
   "hLabel": 2439896605
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24FBBF",
   "szText": "Kindhearted. They want what is best for their loved one.",
   "hLabel": 3785624042
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24FBBF",
   "szText": "I know your health has been failing. You can’t hide it from me.",
   "hLabel": 1777436639
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24FBBF",
   "szText": "Kindhearted. They want what is best for their loved one.",
