   "szLabel": "Line35.24C67B",
   "szText": "You, mainlander! What's your purpose here?",
   "hLabel": 3788706806
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.24C67B",
   "szText": "To Player. Barking, terse, suspicious.",
   "hLabel": 953071971
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.229670",
   "szText": "They saved us, captain—",
   "hLabel": 3122365594
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.229670",
   "szText": "Confused by captain's suspicion, respectfully defending the Player.",
   "hLabel": 286730759
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.24C67B",
   "szText": "My question stands.",
