{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_03b_40.stl",
 "__snoID__": 2123174,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "(Approach Ouna)",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1FA02A",
   "szText": "Be calm now Fal’thane, shepherd of the Caoi Dulra... Do you remember what happened to you?",
   "hLabel": 2459821538
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1FA02A",
   "szText": "Gentle. Caring.",
   "hLabel": 3805548975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2067F5",
   "szText": "I remember...my son. Taken while I was hunting. None could find him, but the Tree... The Tree knew.",
   "hLabel": 1770921235
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2067F5",
   "szText": "Disoriented. Painful memories surfacing.",
   "hLabel": 3116648672
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2067F5",
   "szText": "I took the oath, and the heads smiled! Told me my boy lay in ashes, in the belly of a khazra slag-pit!",
   "hLabel": 1108461269
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2067F5",
   "szText": "Darkening. Tearful anguish. Remembering the worst moment of his life.",
   "hLabel": 2454188706
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.2067F5",
   "szText": "To Hell with the Tree! I’ll never go back! I’ll—",
   "hLabel": 4078508633
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.2067F5",
   "szText": "Tearful rage. Anguish.",
   "hLabel": 1129268774
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1FA02A",
   "szText": "Sleep.",
   "hLabel": 1225083923
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1FA02A",
   "szText": "Gentle. Sad.",
   "hLabel": 2684416384
  }
 ],
 "ptMapStringTable": "0"
}
