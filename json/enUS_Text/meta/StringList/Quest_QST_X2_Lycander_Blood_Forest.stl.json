   "szLabel": "Name",
   "szText": "Blood in the Red Forest",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "A pilgrim wants to lay his family to rest. ",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase8Description",
   "szText": "A pilgrim named Olistis has asked me to clear out the pirates that slaughtered his family. They are in the Red Forest nearby. ",
   "hLabel": 1557588493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback110Header",
   "szText": "Slay the Pirates",
   "hLabel": 1791425640
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase18Description",
   "szText": "I could find no signs of Olistis' family, but there was a body of a pilgrim stripped naked. I should ask Olistis about this. ",
   "hLabel": 3094831582
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback17Header",
   "szText": "Speak with Olistis",
   "hLabel": 1401042654
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase21Description",
   "szText": "Olistis lied and his pirates ambushed me. I need to fight my way out. ",
   "hLabel": 2972638648
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback20Header",
   "szText": "Confront Olistis",
   "hLabel": 619471480
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase30Description",
   "szText": "Olistis and his pirates are dead. I should return to the Amazon Guard and tell her what happened. ",
   "hLabel": 3483011544
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback29Header",
   "szText": "Speak to the Amazon Guard",
   "hLabel": 3652748609
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase66Description",
   "szText": "A pilgrim named Olistis has asked me to clear out the pirates that slaughtered his family. They are in the Red Forest nearby. ",
   "hLabel": 3815495329
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback65Header",
   "szText": "Find the Wagon",
   "hLabel": 1456924097
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase11Description",
   "szText": "I dealt with the pirates that killed Olistis' family. But something seems off. I should take a look around.",
   "hLabel": 1641010231
  },
  {
   "__type__": "StringTableEntry",
