 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2289FE",
   "szText": "YEAH! (laughs) At long damn LAST!",
   "hLabel": 2435827143
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2289FE",
   "szText": "Shouting to the heavens, triumphant.",
   "hLabel": 3781554580
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2289FE",
   "szText": "Oh, you beautiful bastard! (pants) I am redeemed! (sighs) But the glory belongs to you.",
   "hLabel": 1773367177
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2289FE",
   "szText": "Awash in gratitude. Proud of Player.",
   "hLabel": 3119094614
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2289FE",
   "szText": "Enjoy it while you can. Nothing lasts forever. Not for we mortals.",
   "hLabel": 1110907211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2289FE",
   "szText": "Intimate, sincere. These are his last words.",
   "hLabel": 2456634648
  }
 ],
