   "szLabel": "Line1.244665",
   "szText": "I can’t do it!",
   "hLabel": 2438050338
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24466E",
   "szText": "Yes, you can, mate! Throw it!",
   "hLabel": 1775590420
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.244665",
   "szText": "But...! But it is gold. It is valuable. And soft, and shiny…",
   "hLabel": 1113130406
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24466E",
   "szText": "Have you already forgotten the finger you chewed off your hand for that accursed coin? Now, chuck it into the sea, you besotted fool!",
   "hLabel": 450670488
  }
 ],
 "ptMapStringTable": "0"
}
