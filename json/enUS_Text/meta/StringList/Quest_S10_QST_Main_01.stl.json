{
 "__fileName__": "enUS_Text/meta/StringList/Quest_S10_QST_Main_01.stl",
 "__snoID__": 2338410,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Sands of Chaos",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Chaos Rifts have been sighted throughout Sanctuary, spitting out demons from Hell. What could be causing them?",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "I should speak with the warrior who helped me slay these demons. She might know more about these rifts.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Speak with Stranger",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase11Description",
   "szText": "Shyan wants to discuss more about these Chaos Rifts in Yelesna.",
   "hLabel": 1641010231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback10Header",
   "szText": "Speak with Shyan",
   "hLabel": 950701463
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase14Description",
   "szText": "Shyan is part of an ancient order called the Viz Jaq'taar. She said that they will reward me if I help them quell the Chaos Rift demons that are spreading through Sanctuary.",
   "hLabel": 4104776794
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback13Header",
   "szText": "Inspect the Reputation Board",
   "hLabel": 530138074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase20Description",
   "szText": "I heard a villager shouting about a demon portal opening and his family being killed. I should ask him about it.",
   "hLabel": 2151383127
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback22Header",
   "szText": "Speak with Villager",
   "hLabel": 3202407418
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase31Description",
   "szText": "The villager in Ked Bardu spoke of a portal by the shoreline with demons pouring out. I should investigate.",
   "hLabel": 9299769
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback44Header",
   "szText": "Investigate the Portal in the Wretched Sands",
   "hLabel": 827916094
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback33Header",
   "szText": "Slay Demons and Destroy the Chaos Rift",
   "hLabel": 4162645404
  }
 ],
 "ptMapStringTable": "0"
}
