   "szLabel": "MenuLabel",
   "szText": "\"You have the gift of foresight?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.22902A",
   "szText": "What gift I possess is not prophecy as you mortals understand. It is the burden of possibilities. Visions of what might be.",
   "hLabel": 448471661
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.22902A",
   "szText": "For your companion, I see a few paths ahead. Few are fair.",
