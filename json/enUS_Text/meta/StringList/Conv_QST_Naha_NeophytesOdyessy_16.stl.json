{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Naha_NeophytesOdyessy_16.stl",
 "__snoID__": 2290735,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Is everyone safe?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.22B189",
   "szText": "I—I think so. We saved them.",
   "hLabel": 1202588608
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.22B189",
   "szText": "Relieved",
   "hLabel": 2661921069
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.228AA8",
   "szText": "By the grace of Akarat! I’m sorry to have dragged you both into this. Thank you for your aid.",
   "hLabel": 538672912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.228AA8",
   "szText": "Relieved. Emphasis on \"grace.\"",
   "hLabel": 1998005373
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.22B189",
   "szText": "Wait, Bnatros. Something pushed me to make a stand for you. Perhaps it was the Light. Perhaps it was hope. I don’t know, but it made me feel like I had a purpose.",
   "hLabel": 4172635972
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.22B189",
   "szText": "Speaking something from their heart that they've been thinking about recently.",
   "hLabel": 1337001137
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.22B189",
   "szText": "I would like to join your pilgrimage, if you will have me.",
   "hLabel": 3510176006
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.228AA8",
   "szText": "Oh, I would be honored. We will walk in Akarat’s footsteps together—and we will see the truth with our own eyes.",
   "hLabel": 2846260310
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.228AA8",
   "szText": "Happy to have a new friend--a new believer at his side.",
   "hLabel": 10625475
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.22B189",
   "szText": "I look forward to it. Now, let's leave this place before the pirates return, hm?",
   "hLabel": 1831981125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.22B189",
   "szText": "Through a smile--feeling like she has a purpose for the first time in a while.",
   "hLabel": 3291313586
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.22B189",
   "szText": "And safe travels on your own road, mainlander.",
   "hLabel": 1169521159
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.22B189",
   "szText": "To Player",
   "hLabel": 2628853620
  }
 ],
 "ptMapStringTable": "0"
}
