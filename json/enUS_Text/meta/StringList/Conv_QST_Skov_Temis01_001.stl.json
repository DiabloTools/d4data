   "szLabel": "Line1.24FBB7",
   "szText": "(vomits)",
   "hLabel": 2439896558
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24FBC2",
   "szText": "Oh, look at him. The farmers down the road have sturdier sea legs.",
   "hLabel": 1777436620
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24FBC6",
   "szText": "Mainlanders. Never set foot on a ship, but think they can sail to the arse end of the Twin Seas.",
   "hLabel": 1114976658
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24FBC2",
   "szText": "Missed his sandals, at least. The last one tracked his sick right by my doorway.",
   "hLabel": 452516688
  }
 ],
 "ptMapStringTable": "0"
}
