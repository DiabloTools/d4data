   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Nothing for me, thank you... Are you celebrating something?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.289362",
   "szText": "(sighs) Not much to celebrate these days...",
   "hLabel": 2442970437
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.289362",
   "szText": "Turns a little somber",
   "hLabel": 3788697874
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.289362",
   "szText": "Out there, the dead might take you, demons might skin you, the ground might swallow you whole, but in here? In here, we’re okay.",
   "hLabel": 1780510471
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.289362",
   "szText": "Grateful for a moment's peace. Proud to provide it to others.",
   "hLabel": 3126237908
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.289362",
   "szText": "So, we celebrate! Being honest, you look like you could use it.",
   "hLabel": 1118050505
  }
 ],
