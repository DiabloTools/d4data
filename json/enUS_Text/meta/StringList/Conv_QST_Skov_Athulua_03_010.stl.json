{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_03_010.stl",
 "__snoID__": 1949132,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"We're searching for a weapon to use against Mephisto.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.1DCFFD",
   "szText": "What sort of weapon?",
   "hLabel": 2128354565
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.1DCFFD",
   "szText": "Curious. Do tell.",
   "hLabel": 3587687026
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.6D03F",
   "szText": "A bone from the body of Lilith, fashioned into a blade...since broken into pieces.",
   "hLabel": 871345662
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.6D03F",
   "szText": "In a little pain, explaining",
   "hLabel": 2217073099
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.BAE4",
   "szText": "We've found one of them. Another is said to be hidden here, on this island.",
   "hLabel": 1355880411
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.BAE4",
   "szText": "Trying to reassure. The plan is solid...ish.",
   "hLabel": 3218767368
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.1DCFFD",
   "szText": "Does Mephisto know of this?",
   "hLabel": 803434633
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.1DCFFD",
   "szText": "Taking it all in. Concerned.",
   "hLabel": 2262767094
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line49.6D03F",
   "szText": "He does.",
   "hLabel": 2613154822
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir49.6D03F",
   "szText": "Unfortunately...",
   "hLabel": 3958882259
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line53.1DCFFD",
   "szText": "That could explain the Drowned. He might very well have sent them to stop you from finding it.",
   "hLabel": 4082667014
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir53.1DCFFD",
   "szText": "Piecing things together.",
   "hLabel": 1247032179
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line55.1DCFFD",
   "szText": "Any leads?",
   "hLabel": 3420207048
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line57.6D03F",
   "szText": "Maybe. There is a place to the south where legends say the Drowned first arose. The Foundering Caverns.",
   "hLabel": 3993956197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir57.6D03F",
   "szText": "Dawning realization",
   "hLabel": 1044716338
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line59.1DCFFD",
   "szText": "We must speak with the Amazons about them, ask for recent reports.",
   "hLabel": 2095287116
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir59.1DCFFD",
   "szText": "Encouraged, we have a plan",
   "hLabel": 3554619577
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line61.1DCFFD",
   "szText": "Let's find who's in charge.",
   "hLabel": 2404472133
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir61.1DCFFD",
   "szText": "Standing, ready to go.",
   "hLabel": 3863804594
  }
 ],
 "ptMapStringTable": "0"
}
