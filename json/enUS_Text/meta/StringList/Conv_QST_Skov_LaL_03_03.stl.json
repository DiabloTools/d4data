 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Tymon...\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B56B",
   "szText": "A true hero’s fate—ultimately undone by the weakness that surrounds them.",
   "hLabel": 2440888317
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25B56B",
   "szText": "pragmatic, wry",
   "hLabel": 3786615754
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B56B",
   "szText": "But I will make sure your story is known, Tymon. Your derring-do immortalized, as respect from one fool to another.",
   "hLabel": 1778428351
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.25B56B",
   "szText": "warm, confident",
   "hLabel": 3124155788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B56B",
   "szText": "I normally have no taste for trite blood sacrifices. Such a mess, so many stains…",
   "hLabel": 1115968385
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.25B56B",
   "szText": "addressing pirates; playful, intentionally demeaning",
   "hLabel": 2461695822
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25B56B",
   "szText": "But today, for Tymon…Kakkos will make an exception.",
   "hLabel": 453508419
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.25B56B",
   "szText": "sincere, strong",
   "hLabel": 1799235856
  }
 ],
 "ptMapStringTable": "0"
}
