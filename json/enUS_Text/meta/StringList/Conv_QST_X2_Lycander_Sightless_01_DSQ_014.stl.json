   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You've never done this trial before? How are Seers tested now?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.219CC0",
   "szText": "Without the Great Eye, the old ways became unnecessary. Our visions are less intense now, so the trials became gentler.",
   "hLabel": 2434722745
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.219CC0",
   "szText": "I wonder how many of us would still wear the title of Seer if this was the test we faced.",
   "hLabel": 1772262779
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.219CC0",
   "szText": "Reflective. She is genuinely unsure. ",
   "hLabel": 3117990216
  }
 ],
 "ptMapStringTable": "0"
}
