{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_X2_Cine_HAP.stl",
 "__snoID__": 2282970,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Lord of Hatred CC placeholder.",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D90EA",
   "szText": "Lay your hatred down, that the waters may bring you into the light.",
   "hLabel": 2456013899
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1D90EA",
   "szText": "Mid-sermon.",
   "hLabel": 3801741336
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4",
   "szText": "Mephisto! That’s enough!",
   "hLabel": 1932985372
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.BAE4",
   "szText": "Projecting, outraged.",
   "hLabel": 3795872329
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BD9D3",
   "szText": "My dear friend, here at last to save them. But they come freely.",
   "hLabel": 2435096801
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.BD9D3",
   "szText": "In Akarat's form blending with Mephisto's voice, mockingly amused.",
   "hLabel": 3016462
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BD9D3",
   "szText": "Exactly like you. You're so very human, born to hate.",
   "hLabel": 4147128159
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.BD9D3",
   "szText": "In Akarat's form with Mephisto's voice. Taunting, mocking.",
   "hLabel": 1715047820
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.BD9D3",
   "szText": "(unintelligible)",
   "hLabel": 2456902099
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.BD9D3",
   "szText": "Fractured and ambient.",
   "hLabel": 3802629536
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.BD9D3",
   "szText": "And I am Hate.",
   "hLabel": 723065443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.BD9D3",
   "szText": "Offscreen. Taunting, mocking. Emphasis on \"am.\"",
   "hLabel": 2585952400
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4",
   "szText": "(grunts)",
   "hLabel": 2911370197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.BAE4",
   "szText": "Focused",
   "hLabel": 479289858
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1D90EA",
   "szText": "My daughter's trinket...",
   "hLabel": 1188208835
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.1D90EA",
   "szText": "Combined with Mephisto's voice. Spitting with anger.",
   "hLabel": 2647541296
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BD9D3",
   "szText": "You impetuous fool.",
   "hLabel": 1076100724
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.BD9D3",
   "szText": "Combined with Akarat's voice. Spitting with anger.",
   "hLabel": 2421828161
  }
 ],
 "ptMapStringTable": "0"
}
