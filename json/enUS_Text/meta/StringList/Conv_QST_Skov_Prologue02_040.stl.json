 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Mephisto spoke to me—he possessed the preacher.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6D03F",
   "szText": "Hm. Not all of his followers are sheep. He’s using these Hands of Akarat to do his dirty work while he keeps up his benevolent image.",
   "hLabel": 1512000330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.6D03F",
   "szText": "Contemplative, putting the pieces together about what they've seen so far. ",
   "hLabel": 3374887287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "He knows we’re after him then. We’ll need to move fast.",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.6D03F",
   "szText": "Contemplative, putting the pieces together about what they've seen so far. ",
   "hLabel": 1662855929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "Let's get the crew together and patch up the ship. It won’t be long before we reach the isles…",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.6D03F",
   "szText": "Contemplative, putting the pieces together about what they've seen so far. ",
   "hLabel": 4245791867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25DBC7",
   "szText": "Land ho!",
   "hLabel": 453630740
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.25DBC7",
   "szText": "Calling out on the deck of the ship--he has spotted land.",
   "hLabel": 1799358177
  }
 ],
