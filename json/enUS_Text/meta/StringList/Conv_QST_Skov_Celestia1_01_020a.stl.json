{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Celestia1_01_020a.stl",
 "__snoID__": 2612744,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What is Queen Adreona doing here?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line6.1DCC9B",
   "szText": "She came here looking for Cyra. They’ve been arguing since I arrived.",
   "hLabel": 801427426
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir6.1DCC9B",
   "szText": "murmured",
   "hLabel": 2147154863
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.BAE4",
   "szText": "Nothing else?",
   "hLabel": 3835409802
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.BAE4",
   "szText": "murmured",
   "hLabel": 768248343
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.1DCC9B",
   "szText": "Mm... I’ve seen Adreona like this before. She’s learned something, something important. I know not what.",
   "hLabel": 1554069709
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.BAE4",
   "szText": "Tharra, I must tell you something.",
   "hLabel": 1659037621
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir12.BAE4",
   "szText": "murmured, clandestine",
   "hLabel": 3521924578
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.1DCC9B",
   "szText": "Sh-sh. Tell me when this is over. The Oracle speaks.",
   "hLabel": 229149777
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir14.1DCC9B",
   "szText": "whisper",
   "hLabel": 1688482238
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8BEB",
   "szText": "This is all a trick. All of it.",
   "hLabel": 1793572447
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8FD7",
   "szText": "A trick? You have seen the sky. Your own people have seen it: Sanctuary is dying.",
   "hLabel": 1131116761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1D8FD7",
   "szText": "And Akarat can save us.",
   "hLabel": 2866426510
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1D8FD7",
   "szText": "entreating",
   "hLabel": 30791675
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1D8BEB",
   "szText": "Akarat lies! He has woven all of these calamities for your eyes to see.",
   "hLabel": 3175607247
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1D8BEB",
   "szText": "entreating",
   "hLabel": 339972412
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCC9B",
   "szText": "The Oracle is right!",
   "hLabel": 2514692209
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1D8FD7",
   "szText": "Tharra. You are alive.",
   "hLabel": 1850691595
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.1D8FD7",
   "szText": "hushed with relief",
   "hLabel": 3310024056
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCC9B",
   "szText": "The Hands of Akarat plotted the invasion of Athulua. I saw it with my own eyes.",
   "hLabel": 1189772277
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1DCC9B",
   "szText": "And I was not the only one.",
   "hLabel": 527312311
  }
 ],
 "ptMapStringTable": "0"
}
