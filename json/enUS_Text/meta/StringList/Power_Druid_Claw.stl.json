  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{if:SF_17}{c_label}Spirit Cost: {/c}{c_resource}{Resource Cost}{/c}\r\n{/if}{c_label}Generate Spirit:{/c_label} {c_resource}{SF_3}{/c_resource}\r\n{if:ADVANCED_TOOLTIP}{c_label}Lucky Hit Chance: {/c}{c_resource}[{Combat Effect Chance}|%|]{/c}\r\n{/if}Shapeshift into a Werewolf and claw at enemies dealing {c_number}{if:Mod.UpgradeB}{payload:UPGRADEB_DAMAGE}{/c} Lightning{else}{payload:TOOLTIP_DAMAGE}{/c} Physical{/if} damage.",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": "\r\n{icon:bullet,1.2} Damage {icon:arrow,1.2} {if:Mod.UpgradeB}{c_number}{payload:UPGRADEB_DAMAGE}{/c}{else}{c_number}{payload:DAMAGE}{/c}{/if}",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod0_Description",
