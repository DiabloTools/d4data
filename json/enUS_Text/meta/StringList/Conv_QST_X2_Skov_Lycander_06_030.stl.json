 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "Tell me. How do you plan to kill Akarat?",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "An ancient blade. Older than the Firstborn.",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCC9B",
   "szText": "And you need this because, if you are to be believed, Akarat is actually a Prime Evil. Is that right?",
   "hLabel": 2457577341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "If he were a man, my dagger would’ve done the job in Temis, and we wouldn’t be having this conversation now.",
   "hLabel": 3253809490
  }
 ],
 "ptMapStringTable": "0"
}
