   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"We're here for you and your Amazons. Where do you need us?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCC9B",
   "szText": "Right here. The Drowned have been picking at us all day, wearing us down for their final push across the bridge into Temis.",
   "hLabel": 4102704773
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1DCC9B",
   "szText": "Tired, bitter.",
   "hLabel": 1153464914
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "They're in for a rude surprise.",
