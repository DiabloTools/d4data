{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_NeophytesOdyssey2_13.stl",
 "__snoID__": 2361553,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"She's in shock, Bnatros.\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.22B189",
   "szText": "They butchered Ahul and Kor. Tore them to pieces. Yet they spared me.",
   "hLabel": 540128642
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.22B189",
   "szText": "In shock. Remembering the things that happened. But when she gets to \"they spared me,\" she is intrigued, perplexed. Pronunciation: AHOOL, KORE",
   "hLabel": 1999461103
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.228AA8",
   "szText": "You’re covered in blood. And what about Kela and Devrik? Did they escape?",
   "hLabel": 2846260310
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.228AA8",
   "szText": "Concerned",
   "hLabel": 10625475
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.22B189",
   "szText": "Both taken. To the Garden of Akarat.",
   "hLabel": 3156901057
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.22B189",
   "szText": "Still numb, in shock.",
   "hLabel": 321266222
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.228AA8",
   "szText": "The Garden of Akarat? What is that?",
   "hLabel": 2492985361
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.228AA8",
   "szText": "He has never heard of this place before.",
   "hLabel": 3952317822
  }
 ],
 "ptMapStringTable": "0"
}
