 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "The One That Got Away",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Why does Shi Yugong want fish so badly? There is more to this story.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase13Description",
   "szText": "It took some doing, but I've caught five of the rarest fish in all of Estuar. I must show them to Shi Yugong. Perhaps one of them is the fish of his dreams, and his memory will be restored? Stranger things have happened.",
   "hLabel": 3283521273
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback12Header",
   "szText": "Speak with Shi Yugong",
   "hLabel": 3533637401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase16Description",
   "szText": "Shi Yugong says he has lost all of his memories, replaced by a recurring dream of a strange fish with glowing eyes. Catching it may be a fool's errand...but it's a fine excuse to seek the rarest fish of the Fractured Peaks, Scosglen, Dry Steppes, Hawezar, Kehjistan and Nahantu.",
   "hLabel": 1452320540
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback18Header",
   "szText": "Fish an Augur of Civo",
   "hLabel": 2692510623
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback78Header",
   "szText": "Fish a Morayaga",
   "hLabel": 705130725
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback79Header",
   "szText": "Fish a Crookfish",
   "hLabel": 1996598694
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback80Header",
   "szText": "Fish a Zakarati",
   "hLabel": 2927058878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback81Header",
   "szText": "Fish a Neme-senga",
   "hLabel": 4218526847
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback82Header",
   "szText": "Fish a Drakonbeard",
   "hLabel": 1215027520
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase85Description",
   "szText": "It took some doing, but I've caught five of the rarest fish in all of Estuar. I must show them to Shi Yugong. Perhaps one of them is the fish of his dreams, and his memory will be restored? Stranger things have happened.",
   "hLabel": 1362529346
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback84Header",
   "szText": "Return to Shi Yugong",
   "hLabel": 3797963458
  }
 ],
