 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What do you know of 'Kakkos?'\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B56B",
   "szText": "Stories say it was a trickster demon. Fancied toying with mortals. But that’s all tale. Reality is rarely so simple—and often misconstrued.",
   "hLabel": 2440888317
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.25B56B",
   "szText": "pragmatic, playful undertone",
   "hLabel": 3786615754
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B56B",
   "szText": "Some say Kakkos was respected, even welcomed, in ancient times. Offerings were made to jape your neighbor, or “punish” a fool.",
   "hLabel": 1778428351
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B56B",
   "szText": "But drowned children? Pfft…a sodden joke.",
   "hLabel": 1115968385
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.25B56B",
   "szText": "disgusted (by idea of drowning children), wry",
   "hLabel": 2461695822
  }
 ],
 "ptMapStringTable": "0"
}
