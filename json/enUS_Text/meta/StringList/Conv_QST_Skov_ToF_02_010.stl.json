{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_ToF_02_010.stl",
 "__snoID__": 2359865,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What's happened?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.235C46",
   "szText": "Melania ran off into the crypt. She’s looking for the \"eternal brazier.\"",
   "hLabel": 2436949294
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8BEB",
   "szText": "The \"flame that lights fate, eternal.\" A brazier used by the first Oracles, but it cannot protect her.",
   "hLabel": 1131112481
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "I fear it may only hasten her fate.",
   "hLabel": 4101159845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1D8BEB",
   "szText": "sombre",
   "hLabel": 1151919986
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.235C46",
   "szText": "I need to stay with her. Protect her...but, you saw my urn! A crypt!?",
   "hLabel": 1202211679
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.235C46",
   "szText": "exasperated",
   "hLabel": 2661544140
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.235C46",
   "szText": "At least bathe and gild me before I’m sacrificed.",
   "hLabel": 539751713
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.235C46",
   "szText": "exasperated, mocking",
   "hLabel": 1999084174
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1D8BEB",
   "szText": "Your caution is sound—but darkness will find her, no matter where she hides.",
   "hLabel": 4191342162
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1D8BEB",
   "szText": "sombre",
   "hLabel": 1355707327
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.235C46",
   "szText": "Goat’s backside. You’re right.",
   "hLabel": 3509799077
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.235C46",
   "szText": "frustrated, accepting",
   "hLabel": 674164242
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.235C46",
   "szText": "I’m coming, Melania!",
   "hLabel": 2847339111
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.235C46",
   "szText": "calling out",
   "hLabel": 11704276
  }
 ],
 "ptMapStringTable": "0"
}
