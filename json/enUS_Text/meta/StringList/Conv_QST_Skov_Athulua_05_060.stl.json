 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line32.1DCC9B",
   "szText": "Did anyone else make it?",
   "hLabel": 505267345
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir32.1DCC9B",
   "szText": "Post-combat, catching breath, terse. Commander-mode.",
   "hLabel": 1964599806
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line34.24AD3F",
   "szText": "We're it, Captain... But the Drowned are massing at the amphitheater.",
   "hLabel": 4119914881
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir34.24AD3F",
   "szText": "Catching breath, regretful but focused on the task",
   "hLabel": 1284280046
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line36.1DCC9B",
   "szText": "Then everyone, catch your breath. We’re finishing this.",
   "hLabel": 3475314709
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir36.1DCC9B",
   "szText": "Locking in, grim determination",
   "hLabel": 639679874
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line38.24AD3F",
   "szText": "Yes, Captain!",
   "hLabel": 2794994949
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir38.24AD3F",
   "szText": "Locking in, emboldened",
   "hLabel": 4254327410
  }
 ],
