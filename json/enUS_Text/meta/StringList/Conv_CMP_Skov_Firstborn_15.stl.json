 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2289FE",
   "szText": "I’ll be damned! No one has bested all three Trials. Not since me.",
   "hLabel": 2435827143
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2289FE",
   "szText": "Excited. Darkens a bit at \"Not since me.\"",
   "hLabel": 3781554580
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2289FE",
   "szText": "Only the “Big One” remains, strongest I ever faced... Strike it down, and you will be a legend.",
   "hLabel": 1773367177
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2289FE",
   "szText": "Turning serious, focused. Looking Player in the eye.",
   "hLabel": 3119094614
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2289FE",
   "szText": "And I can rest easy.",
   "hLabel": 1110907211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2289FE",
   "szText": "Turning inward. Anxous, hopeful",
   "hLabel": 2456634648
  }
 ],
 "ptMapStringTable": "0"
}
