{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Tharra_02_230.stl",
 "__snoID__": 2461058,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Tharra has completed the three trials, as you requested.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "Then the foundation between us is laid. Holdfast to the tenets - yours and ours - and the bond shall endure.",
   "hLabel": 4101159845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "When did Adreona cast those tenets aside?",
   "hLabel": 1222839726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCC9B",
   "szText": "A little bitter",
   "hLabel": 2682172187
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1D8BEB",
   "szText": "She did not believe she had. She believed herself faithful still. And that was what made her dangerous.",
   "hLabel": 558834832
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1D8BEB",
   "szText": "Measured. Grim understanding rather than anger",
   "hLabel": 2018167293
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1D8BEB",
   "szText": "You still bleed from her betrayal. Ignoring the wound makes it fester, Tharra. To heal it, go to the Cavern of Echoes.",
   "hLabel": 4191342162
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1D8BEB",
   "szText": "Gentle but firm - calm authority and compassion",
   "hLabel": 1355707327
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCC9B",
   "szText": "Thank you, Oracle.",
   "hLabel": 3530427124
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1DCC9B",
   "szText": "Genuine  thank you. ",
   "hLabel": 694792289
  }
 ],
 "ptMapStringTable": "0"
}
