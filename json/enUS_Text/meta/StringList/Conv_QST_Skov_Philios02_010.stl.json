 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What is it?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "She wants to waken Lilith? Is she mad?",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "Look. I’ve been there. Weighing my life against a glimmer of hope.",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.6D03F",
   "szText": "I sold my soul to that damned Tree, and did it matter? No. Donan still died and Neyrelle died. I can’t—",
   "hLabel": 1023908833
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.6D03F",
   "szText": "Sanctuary can’t afford to lose you too. Are you sure you want to do this?",
   "hLabel": 3606844771
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4",
   "szText": "Lorath, we might have to. Let's at least hear what the Oracle has to say.",
   "hLabel": 2911370197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.6D03F",
   "szText": "(sighs) This isn’t the “help” I’d wanted from her.",
   "hLabel": 4116741566
  }
 ],
 "ptMapStringTable": "0"
}
