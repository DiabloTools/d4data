   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Have the pilgrims given you much trouble?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2446F5",
   "szText": "No. But they bring ill tidings.",
   "hLabel": 1775591956
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2446F4",
   "szText": "They’re harmless fools!",
   "hLabel": 1113131989
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.2446F5",
   "szText": "Think. No tradeships out of Kurast have docked in weeks. Now, these pilgrims are pouring out of the mainland. Something’s coming.",
   "hLabel": 450672024
  }
 ],
 "ptMapStringTable": "0"
}
