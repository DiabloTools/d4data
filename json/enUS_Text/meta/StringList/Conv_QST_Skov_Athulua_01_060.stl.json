  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.1DCC9B",
   "szText": "With that, my Queen marched the legion to follow Akarat. I couldn't stop her.",
   "hLabel": 2128349811
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.1DCC9B",
   "szText": "Somber. Regretful. ",
   "hLabel": 3587682272
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.1DCC9B",
   "szText": "She believes he is the only hope for our isles—worth leaving this one to burn. Only a fraction of us stayed to defend it.",
   "hLabel": 1465889845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.1DCC9B",
   "szText": "Somber, bitter. The situation is bleak.",
   "hLabel": 2925222306
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.1DCC9B",
   "szText": "I tried to bring Lorath with me, but he would not be moved. He might still be sitting in the Queen’s camp.",
   "hLabel": 803429879
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.1DCC9B",
   "szText": "Apologetic. Giving direction.",
   "hLabel": 2262762340
  }
 ],
 "ptMapStringTable": "0"
}
