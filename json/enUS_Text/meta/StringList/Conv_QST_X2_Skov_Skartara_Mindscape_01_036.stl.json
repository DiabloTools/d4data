  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BD9D3.M",
   "szText": "He wakes in a barn, your blood in his veins. A gift he doesn’t want, from a being he can’t understand. What is the first thing he thinks to do?",
   "hLabel": 506645449
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BD9D3.F",
   "szText": "She wakes in a barn, your blood in her veins. A gift she doesn’t want, from a being she can’t understand. What is the first thing she thinks to do?",
   "hLabel": 506645442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.BD9D3.M",
