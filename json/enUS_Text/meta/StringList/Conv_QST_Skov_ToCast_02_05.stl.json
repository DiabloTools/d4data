  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"It's going to be dangerous in there.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24ED9B",
   "szText": "I know, but…this Tear killed Migoso. She deserved better. I want—no, I need to avenge her.",
   "hLabel": 2439861489
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24ED9B",
   "szText": "Shaky, but steeling himself",
   "hLabel": 3785588926
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24ED9B",
   "szText": "I know I am no help in a fight, but I’ve studied these artifacts. I believe I can destroy this Tear.",
   "hLabel": 1777401523
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24ED9B",
   "szText": "A little defensive, making a case for himself",
   "hLabel": 3123128960
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24ED9B",
   "szText": "I won’t slow you down this time. Let’s go.",
   "hLabel": 1114941557
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.24ED9B",
   "szText": "Firm. ",
   "hLabel": 2460668994
  }
 ],
