{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Celestia1_01_043.stl",
 "__snoID__": 2298772,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "[No menu text. This simple+ automatically triggers when previous choice ends.]",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8FD7",
   "szText": "Spearmaidens, chain the demon.",
   "hLabel": 4101164125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCC9B",
   "szText": "Please, Adreona—",
   "hLabel": 2514692209
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1D8BEB",
   "szText": "I am responsible!",
   "hLabel": 1850687315
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.1D8BEB",
   "szText": "voice raised",
   "hLabel": 3310019776
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1D8FD7",
   "szText": "Cyra?",
   "hLabel": 1188231629
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1D8BEB",
   "szText": "I am responsible. I took this mainlander in, and I woke Lilith within them.",
   "hLabel": 525767383
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.1D8FD7",
   "szText": "I will not hear this.",
   "hLabel": 834956680
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.1D8FD7",
   "szText": "heart falling",
   "hLabel": 2294289141
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.1D8BEB",
   "szText": "Mephisto comes to Skovos. And only his daughter might stop him.",
   "hLabel": 172492434
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.1D8BEB",
   "szText": "insistent",
   "hLabel": 1631824895
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.1D8FD7",
   "szText": "Is this why you were not at my side in Temis?",
   "hLabel": 3142544078
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.1D8BEB",
   "szText": "Yes.",
   "hLabel": 2480079832
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.1D8FD7",
   "szText": "(scoffs)",
   "hLabel": 2789269129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.1D8BEB",
   "szText": "Whatever punishment you choose...you choose it for me as well.",
   "hLabel": 2126804883
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.1D8FD7",
   "szText": "Tharra, gather the spearmaidens. We move out.",
   "hLabel": 801889231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.1D8FD7",
   "szText": "ash in her mouth",
   "hLabel": 2261221692
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.1DCC9B",
   "szText": "I... Of course, my Queen.",
   "hLabel": 1465889845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line53.1D8BEB",
   "szText": "Where do you go?",
   "hLabel": 4081117332
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line55.1D8FD7",
   "szText": "To Akarat's side.",
   "hLabel": 3418661646
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line57.1D8FD7",
   "szText": "We are fighting a war. And now that war may be lost because you thought you could wrangle fate alone.",
   "hLabel": 2756201680
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line59.1D8FD7",
   "szText": "So be it. You fight alone. As do I.",
   "hLabel": 2093741714
  }
 ],
 "ptMapStringTable": "0"
}
