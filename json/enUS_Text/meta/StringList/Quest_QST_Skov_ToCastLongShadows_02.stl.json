 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase101Description",
   "szText": "Drollon has gone to Saltwind to find the pirate Ailon, who may know what became of the Tear of the Firstborn. Saltwind is dangerous - I should catch up with him. ",
   "hLabel": 3793763495
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase109Description",
   "szText": "Drollon has gone to Saltwind to find the pirate Ailon, who may know what became of the Tear of the Firstborn. Saltwind is dangerous - I should catch up with him. ",
   "hLabel": 1773873071
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "A Pirate's Plunder",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Drollon's missing shipment was taken by pirates who may have ties to Saltwind.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase7Description",
   "szText": "Ailon made good on her word and told us about a hidden cove the pirates call home. Drollon and I should investigate. ",
   "hLabel": 736332972
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback9Header",
   "szText": "Discover the Hidden Cove",
   "hLabel": 965040047
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase39Description",
   "szText": "I should enter the Hidden Cove to get the missing shipment from the pirates.",
   "hLabel": 2284376641
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback38Header",
   "szText": "Enter the {WORLD:QST_Skov_ToCastLongShadows_Black_Market}",
   "hLabel": 2030050657
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase50Description",
   "szText": "I reunited with Drollon in Saltwind, a pirate settlement. He has had no luck finding the Tear of the Firstborn, but perhaps if I speak to the woman mentioned on a map we found on Migoso's ship, I'll get answers.",
   "hLabel": 1851301082
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback52Header",
   "szText": "Speak with Ailon",
   "hLabel": 2208717469
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase58Description",
   "szText": "Ailon is a tough woman and refuses to share information without payment. I should give her what she asks; we do not have time to dawdle.",
   "hLabel": 4126377954
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback57Header",
   "szText": "Pay the bribe",
   "hLabel": 76122722
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase65Description",
   "szText": "Drollon wants to talk before we enter the cave. I should hear him out. ",
   "hLabel": 2994239808
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback64Header",
   "szText": "Speak with Drollon",
   "hLabel": 165456128
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback95Header",
   "szText": "Speak with Drollon",
   "hLabel": 463234148
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback100Header",
   "szText": "Find Drollon",
   "hLabel": 2122655623
  }
