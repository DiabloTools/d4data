   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "PTRCopy_Confirm_Body",
   "szText": "You are about to copy your character data from the live game to the Public Test Realm (PTR). Please note that the most recent record of your live character data is from {s1}. Proceeding will overwrite any existing character data on the PTR.\r\n\r\nLive seasonal characters will be converted to PTR eternal characters. Seasonal powers from the live game will not carry over to the PTR.\r\n\r\nOnce the copy process is complete, the game will need to be relaunched.",
   "hLabel": 2402478475
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "PTRCopy_Success_Body",
   "szText": "Account copy successful. The game will need to be restarted for changes to take effect.",
   "hLabel": 3734850742
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "PTRCopy_Failure_Body",
   "szText": "Account copy cannot be completed at this time. Please try again later.",
