 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why did Ouna take you from the Tree?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.207D85",
   "szText": "Why would a daughter save her family? The people who raised her, who gave her knowledge, when every day she watched. Them. Suffer.",
   "hLabel": 2433464625
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.207D85",
   "szText": "Offended. Feels the answer is obvious.",
   "hLabel": 3779192062
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.207D85",
   "szText": "She saw that forever is too high a price. For the answers we gave her, she will give us new life!",
   "hLabel": 1108544693
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.207D85",
   "szText": "Somber, then hopeful",
   "hLabel": 2454272130
  }
 ],
 "ptMapStringTable": "0"
}
