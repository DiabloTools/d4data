{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_X2_Lycander_Sightless_03_DSQ_160_SP.stl",
 "__snoID__": 2381094,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are you certain you want to see your vision, despite the warnings?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.219CC0",
   "szText": "No. But I've come this far.",
   "hLabel": 2434722745
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.219CC0",
   "szText": "I see…oceans boiled by hellfire. Cities turned to bone. Children born marked. Weeping and gnashing of teeth. All voices fall silent, not by death, but in dread. It waits behind the veil...shapeless, waiting.",
   "hLabel": 1109802813
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.219CC0",
   "szText": "Etranced by a terrible vision, each image unfolding with mounting dread and intensity. It physically hurts to see such horrible things. ",
   "hLabel": 2455530250
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.219CC0",
   "szText": "TERROR. We open the gate for him—",
   "hLabel": 447342847
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.219CC0",
   "szText": "Highest intesnity ",
   "hLabel": 1793070284
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.219CC0",
   "szText": "Now I know…",
   "hLabel": 1199985130
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.219CC0",
   "szText": "Soft, weak voice. ",
   "hLabel": 2659317591
  }
 ],
 "ptMapStringTable": "0"
}
