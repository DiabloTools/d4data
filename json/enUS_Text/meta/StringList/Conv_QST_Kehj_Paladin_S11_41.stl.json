   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What do you plan to do now?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.24B8C5",
   "szText": "Return to the road. If the Wardens ever call to her, we’d welcome her beneath our mantle.",
   "hLabel": 1171902039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.24B8C5",
   "szText": "Speaking to Wanderer. Hopeful",
