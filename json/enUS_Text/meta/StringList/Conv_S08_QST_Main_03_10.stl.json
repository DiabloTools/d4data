   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are you ready to banish Belial?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.20FFCC",
   "szText": "Yes, but not here. A place with a strong connection to Belial gives us the best chance of success.",
   "hLabel": 2435157307
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.20FFCC",
   "szText": "We must go to the Temple of Belial in Kehjistan. It’s dangerous, but so are you.",
   "hLabel": 1772697341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.20FFCC",
   "szText": "Meet me outside the temple. I will show you the way inside.",
   "hLabel": 1110237375
  }
 ],
