  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "I see now that you will never bend to reason. You are a creature of violence and only a violent death will suffice.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2808AB",
   "szText": "Bitter, grim",
   "hLabel": 3788381353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2808AB",
   "szText": "I have captured Tyrael. He now lies buried in the same cold earth where he once buried me.",
   "hLabel": 1780193950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2808AB",
   "szText": "Bitter, cold",
   "hLabel": 3125921387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2808AB",
   "szText": "I hope he is still alive, gasping in that darkness... I suggest you hurry.",
   "hLabel": 1117733984
  },
