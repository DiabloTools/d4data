 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"This ends now, Achaia.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.235C4D",
   "szText": "All ends, in time. Yet knowing that end is not so simple…",
   "hLabel": 2436949340
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.235C4D",
   "szText": "It requires a price of flesh. Of silent suffering.",
   "hLabel": 449569442
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.235C4D",
   "szText": "A thousand fleeting lives. Forgotten.",
   "hLabel": 4082076772
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1D8BEB",
   "szText": "And you believe yourself their voice?",
   "hLabel": 1221294798
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.235C4D",
   "szText": "I am a memento of their sacrifice. A vigil to their vengeance.",
   "hLabel": 539751759
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.235C4D",
   "szText": "I am wrath.",
   "hLabel": 4172259089
  }
 ],
 "ptMapStringTable": "0"
}
