{
 "__fileName__": "enUS_Text/meta/StringList/Quest_S14_QST_Intro.stl",
 "__snoID__": 2616518,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "A Gospel of Despair",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "A bird has arrived with a letter from Tyrael.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "I arrived in Kyovashad to discover a little bird with a message in its claw. By some magic, it seems to be for me. Best take a look.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Read the bird's message",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase8Description",
   "szText": "The message certainly qualifies as \"a gospel of despair.\" But who wrote it and what are they after? I should see what Dannica knows.",
   "hLabel": 1557588493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback7Header",
   "szText": "Ask Dannica about the scroll",
   "hLabel": 2677071405
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase11Description",
   "szText": "That little bird held a message from Tyrael, asking me to go to Zarbinzet. It seems a new \"death cult\" has reared its head in Hawezar. Can no victory simply last?",
   "hLabel": 1641010231
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback10Header",
   "szText": "Ask about the death cult in Zarbinzet",
   "hLabel": 950701463
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase16Description",
   "szText": "I asked Dannica what the matter was, and she threw a bit of parchment at my feet. No harm in giving it a read.",
   "hLabel": 1452320540
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase19Description",
   "szText": "The church bells were tolling in Zarbinzet when I arrived. Following the procession, I overheard the tirade of a young crusader. Perhaps she knows something?",
   "hLabel": 3916087103
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback18Header",
   "szText": "Speak with Dannica",
   "hLabel": 2692510623
  }
 ],
 "ptMapStringTable": "0"
}
