  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BD9D3",
   "szText": "They’re all like this, you know. Driven by instinct. Rutting in the mud, until satisfied or dead.",
   "hLabel": 3306001381
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BD9D3",
   "szText": "Your son. His obsessions. His flighty heart.",
   "hLabel": 1076100724
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BD9D3",
   "szText": "Your servant, Elias. His desperate need for a mother’s bosom.",
   "hLabel": 3659036662
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BD9D3",
   "szText": "All of them, Lilith.",
   "hLabel": 1585997519
  }
 ],
