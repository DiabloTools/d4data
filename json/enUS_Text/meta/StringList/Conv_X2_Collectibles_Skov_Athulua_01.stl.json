{
 "__fileName__": "enUS_Text/meta/StringList/Conv_X2_Collectibles_Skov_Athulua_01.stl",
 "__snoID__": 2450971,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.84B74",
   "szText": "Linarian, I have no time for these games.",
   "hLabel": 1512701728
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.84B74",
   "szText": "Annoyed, dismissive, weary",
   "hLabel": 3375588685
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.FD852",
   "szText": "I am not playing, Father. You said yourself that Sanctuary will never truly be safe—that evil threatens her from outside and within.",
   "hLabel": 4151869202
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.FD852",
   "szText": "Serious. Making his case.",
   "hLabel": 1719788863
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.FD852",
   "szText": "Let us prepare together! Your spear against my staff—",
   "hLabel": 2439837844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.FD852",
   "szText": "Light-hearted. Seeking connection.",
   "hLabel": 7757505
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.84B74",
   "szText": "I said NO!",
   "hLabel": 671574950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.84B74",
   "szText": "Snapping, fearful. ",
   "hLabel": 2534461907
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.84B74",
   "szText": "Put...put it down.",
   "hLabel": 3254510888
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.84B74",
   "szText": "Afraid, trying not to show it. Defusing a dangerous situation.",
   "hLabel": 822430549
  }
 ],
 "ptMapStringTable": "0"
}
