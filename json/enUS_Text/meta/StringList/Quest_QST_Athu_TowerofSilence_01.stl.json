 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "Tower of Silence",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Drowned corpses are piling up and spreading an unusual sickness in the Amazon garrison. An Amazon pyrekeeper needs your help to burn them. ",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase15Description",
   "szText": "I have the ingredients for Burial Fire. I need to accompany Sehrei to the Deadhouse in Temis, where the bodies will be burned. ",
   "hLabel": 631065019
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback14Header",
   "szText": "Escort Sehrei to the Deadhouse",
   "hLabel": 1821606043
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase34Description",
   "szText": "I have gathered the ingredients for Burial Fire. I need to return to the Athulua garrison and inform Sehrei.",
   "hLabel": 2473066332
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback33Header",
   "szText": "Bring the items to Sehrei",
   "hLabel": 4162645404
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase43Description",
   "szText": "I arrived with Sehrei at the Deadhouse and infected crabs have spilled out of the entrance. I need to slay them before we can enter.",
   "hLabel": 2983439228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback42Header",
   "szText": "Slay the infected crabs",
   "hLabel": 2539947452
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase65Description",
   "szText": "Sehrei and I slayed the infected crabs. It's time to enter the Deadhouse and burn the Drowned corpses spreading the disease.",
   "hLabel": 2994239808
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback67Header",
   "szText": "Enter the {WORLD:QST_Athu_TowerofSilence_01}",
   "hLabel": 4039860035
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "Sehrei the pyrekeeper has tasked me with getting ingredients for the Amazon's Burial Fire, a potent flame that is capable of burning Drowned corpses. I should search the area.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Gather Quicklime: {DONE_OVER_NEEDED} from Drowned",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase110Description",
   "szText": "Sehrei the pyrekeeper has tasked me with getting ingredients for the Amazon's Burial Fire, a potent flame that is capable of burning Drowned corpses. I should search the area.",
   "hLabel": 9169095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback125Header",
   "szText": "Gather Resin:  {DONE_OVER_NEEDED} from Central Athulua ",
