 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "(Say nothing.)",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1D90EA",
   "szText": "Mmm, silence...it speaks volumes, does it not?",
   "hLabel": 2866403716
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1D90EA",
   "szText": "Nodding, ominous",
   "hLabel": 30768881
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1D90EA",
   "szText": "After all, how could one put into words the evil you have inflicted?",
   "hLabel": 3175588733
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.1D90EA",
   "szText": "Disappointed, somber",
   "hLabel": 339953898
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1D90EA",
   "szText": "The slaughter of the Fractured Peaks, the burning of Scosglen, the bleeding of Caldeum, the corruption of blessed Nahantu—will you not confess these crimes?",
   "hLabel": 2513128767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1D90EA",
   "szText": "Listing atrocities, pressing Player to repent",
   "hLabel": 3972461228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1D90EA",
   "szText": "Then I must drag you into the Light.",
   "hLabel": 1850668801
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.1D90EA",
   "szText": "Disappointed, somber. In the next breath, he will seize the demon (Lilith) inside the Player.",
   "hLabel": 3310001262
  }
 ],
 "ptMapStringTable": "0"
}
