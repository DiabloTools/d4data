 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Akarat lies to you. No demon lives within me.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8FD7",
   "szText": "Is that so?",
   "hLabel": 2456036693
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1D8FD7",
   "szText": "When my murderer left Temis, I had him followed. And he met you. The stranger with haunted eyes.",
   "hLabel": 1793576727
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1D8FD7",
   "szText": "My scouts followed you all the way to the Temple of Life. And you emerged...with a shard of Lilith’s bone.",
   "hLabel": 1131116761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8FD7",
   "szText": "So when Akarat tells me that Lilith is the cause of our troubles, and that she walks in a mortal’s skin? I believe him.",
   "hLabel": 4101164125
  }
 ],
 "ptMapStringTable": "0"
}
