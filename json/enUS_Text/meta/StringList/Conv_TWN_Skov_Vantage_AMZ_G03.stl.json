 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2444D5",
   "szText": "Don’t gulp it all down! Save some for the others.",
   "hLabel": 2438049678
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2444D6",
   "szText": "What others? Ugh, give it here.",
   "hLabel": 1775589713
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2444D6",
   "szText": "slurred speech; drunk",
   "hLabel": 3121317150
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2444D5",
   "szText": "For the dead, you sot. For Hela and the rest. We’ve got to—to pour out offerings for them.",
   "hLabel": 1113129746
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.2444D6",
   "szText": "They wouldn't... wouldn’t want you to waste it. Not our Hela. She’d want us to drink every drop, I know it.",
   "hLabel": 450669781
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.2444D6",
   "szText": "Choked back sob.",
   "hLabel": 1796397218
  }
 ],
