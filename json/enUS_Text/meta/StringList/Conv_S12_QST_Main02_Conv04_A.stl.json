 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Is she well?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.262312",
   "szText": "Don't concern yourself with her, she's always been overly cautious. But Teyana knows our cause is worth the risks we take.",
   "hLabel": 2440346871
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.262312",
   "szText": "Initially dismissive, then kinder. ",
   "hLabel": 3786074308
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.262312",
   "szText": "Use the key, enter the portal, and explore your power. I assure you, you will be entirely yourself when you return.",
   "hLabel": 1115426939
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.262312",
   "szText": "Reassuring. ",
   "hLabel": 2461154376
  }
 ],
 "ptMapStringTable": "0"
}
