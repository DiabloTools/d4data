{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_X2_Skov_Lycander_02_110.stl",
 "__snoID__": 2411903,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Please, listen. We're here to help.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "And who are you? His keeper?",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "We come with the Oracle’s blessing.",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCC9B",
   "szText": "I haven’t seen or heard from the Oracle in weeks.",
   "hLabel": 4102704773
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1DCC9B",
   "szText": "Not disdain, but disappointment. Lorath isn't making a convincing argument in Tharra's mind. RE-RECORD.",
   "hLabel": 1153464914
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "If not her, then trust Adreona. Years ago, I helped her defend Skovos. She must have spoken of me—of the Horadrim.",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCC9B",
   "szText": "Do you take me for a fool? I saw you slaughter her in front of all of Temis.",
   "hLabel": 4192887090
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BAE4",
   "szText": "Enough. Forget words. Our actions will speak for us. Let us help secure the Temple. Then, you may cast your judgment.",
   "hLabel": 1854714586
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1DCC9B",
   "szText": "(sighs)",
   "hLabel": 2867967158
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1DCC9B",
   "szText": "thinking it over",
   "hLabel": 32332323
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.1DCC9B",
   "szText": "You do as I say. Am I clear?",
   "hLabel": 3177152175
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCC9B",
   "szText": "Fetch me my weapon from that beast’s corpse.",
   "hLabel": 2514692209
  }
 ],
 "ptMapStringTable": "0"
}
