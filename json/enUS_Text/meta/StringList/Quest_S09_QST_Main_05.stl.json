 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "The Unseeable Demands Their Gaze",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "Bryona wasn't in Cerrigar, but Davish has made himself at home in her space. Perhaps he can tell me where she went.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Speak with Davish",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase10Description",
   "szText": "Davish let me know that Bryona left for the Horadric Vault on her own. I should make sure she's all right. ",
   "hLabel": 819754710
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback12Header",
   "szText": "Find Bryona at the Horadric Vault",
   "hLabel": 3533637401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase15Description",
   "szText": "There are other blood relics out there that still pose a threat to the people of Sanctuary. I should retrieve another one. It seems they were stashed in Horadric Strongrooms, which can be found in Nightmare Dungeons.",
   "hLabel": 631065019
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback17Header",
   "szText": "Enter a Strongroom and retrieve a {ITEM:S09_QST_Main_DGN_AstarothBloodItem}",
   "hLabel": 1401042654
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback59Header",
   "szText": "Use a Nightmare Sigil to find Strongrooms",
   "hLabel": 2659058660
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase46Description",
   "szText": "I should see if Bryona and Davish are all right after the ritual we attempted failed. ",
   "hLabel": 1152238495
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback51Header",
   "szText": "Return to Cerrigar",
   "hLabel": 917249500
  }
 ],
 "ptMapStringTable": "0"
}
