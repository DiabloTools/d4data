 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "The Unseeable Demands Their Gaze",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "The Horadrim know defeat intimately. It is never the end.",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "Bryona wasn't in Cerrigar, but Davish has made himself at home in her space. Perhaps he can tell me where she went.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Speak with Davish",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase10Description",
   "szText": "Davish let me know that Bryona left for the Horadric Vault on her own. I should make sure she's all right. ",
   "hLabel": 819754710
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback12Header",
   "szText": "Find Bryona in the Horadric Vault",
   "hLabel": 3533637401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase15Description",
   "szText": "The blood relic I recovered was but one of several, each a vessel of Astaroth's power hidden across Sanctuary. As long as these relics remain, so does Astaroth.\r\n\r\nBryona believes the Horadrim sealed these relics within Strongrooms - protected chambers buried deep within Nightmare Dungeons. I need to use a Nightmare Sigil to access these chambers.",
   "hLabel": 631065019
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback59Header",
   "szText": "Use a Nightmare Sigil to find a Strongroom",
   "hLabel": 2659058660
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback67Header",
   "szText": "Retrieve a {ITEM:S09_QST_Main_DGN_AstarothBloodItem} from a Strongroom",
   "hLabel": 4039860035
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase46Description",
   "szText": "I should see if Bryona and Davish are all right after the ritual we attempted failed. ",
   "hLabel": 1152238495
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback74Header",
   "szText": "Return to Cerrigar",
   "hLabel": 4129193441
  }
 ],
 "ptMapStringTable": "0"
}
