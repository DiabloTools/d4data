 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You are Ouna? What is your craft?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1FA02A",
   "szText": "I saw you when you came here with your friend...Lorath. You did not see me though, up in the branches.",
   "hLabel": 562623957
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1FA02A",
   "szText": "Recalling a previous meeting. Curious.",
   "hLabel": 2021956418
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1FA02A",
   "szText": "Maybe...I can open your eyes? To see the forms that hide in shadow, then draw them to your flame. Learn this, and you will fear no darkness.",
   "hLabel": 4195131287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1FA02A",
   "szText": "Hopeful. Eager to teach.",
   "hLabel": 1359496452
  }
 ],
 "ptMapStringTable": "0"
}
