   "szLabel": "Name",
   "szText": "Oaths and Debts",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase14Description",
   "szText": "Gelena tracked the missing head to a derelict house, of all places. I must find it, so it can be returned to the Tree.",
   "hLabel": 4104776794
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback13Header",
   "szText": "Search for the head",
   "hLabel": 530138074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase35Description",
   "szText": "A witch of Hawezar has asked for my help in retrieving a lost head from the Tree of Whispers.",
   "hLabel": 3294321853
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback135Header",
   "szText": "Help Gelena find the source of the whisper",
   "hLabel": 3291338223
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase120Description",
   "szText": "The head, unwilling to go back, called on flesh tainted by its rot to fight us off. Now that I've retrieved the head, it must be returned to the Tree.",
   "hLabel": 1340797512
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback119Header",
   "szText": "Speak with Gelena by the Tree of Whispers",
   "hLabel": 529735473
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase121Description",
   "szText": "In exchange for my aid in returning a lost head to the Tree of Whispers, Gelena offered me a prize: a witch's power. I should see what mysterious arts she is capable of.",
   "hLabel": 2162053033
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback123Header",
   "szText": "View the Coven's Favor",
   "hLabel": 1039632268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase63Description",
   "szText": "A witch of Hawezar has asked for my help in retrieving a lost head from the Tree of Whispers.",
   "hLabel": 1351728766
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback62Header",
   "szText": "Speak with Gelena",
   "hLabel": 1877487486
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "Someone tracked me down in Gea Kul and called out to me. It seems they could use my aid.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback113Header",
   "szText": "Speak with Gelena",
