  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Description",
   "szText": "\"Nature is full of traps. Webs. Vines. But when a succubus gets their hooks in you, what material do they use? Your own desire, your own folly. You are your own downfall! Master thyself above all! Or else they will hold dominion over you...\" -Magister Nairan, a week before his disappearance",
   "hLabel": 2789670820
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Quote",
   "szText": "So easily do they succumb.",
   "hLabel": 138338510
  },
