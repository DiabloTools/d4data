 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How are you, Tyrael?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCFFD",
   "szText": "Me? Well...my injuries are healing, slow but sure. The medica said I should stay off my feet and rest, but...I suppose Lorath rubbed off on me.",
   "hLabel": 560384514
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1DCFFD",
   "szText": "Surprised, evasive at first",
   "hLabel": 2019716975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCFFD",
   "szText": "When I’m working, I'd swear I can hear him grumbling in my ear, questioning strategies like he’s still with me. Like all the rest.",
   "hLabel": 3530431878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1DCFFD",
   "szText": "Somber, bittersweet.",
   "hLabel": 694797043
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1DCFFD",
   "szText": "Thank you. For asking.",
   "hLabel": 2867971912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1DCFFD",
   "szText": "Touched, sincere",
   "hLabel": 32337077
  }
 ],
 "ptMapStringTable": "0"
}
