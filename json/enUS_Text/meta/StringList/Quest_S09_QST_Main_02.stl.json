  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase0Description",
   "szText": "I should check in with Bryona and see if she's found a way to purge Astaroth's blood.",
   "hLabel": 3577478917
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback2Header",
   "szText": "Speak with Bryona",
   "hLabel": 514698856
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase8Description",
   "szText": "There are other blood relics out there that still pose a threat to the people of Sanctuary. I should retrieve another one. It seems they were stashed in Horadric Strongrooms, which can be found in Nightmare Dungeons.",
   "hLabel": 1557588493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback64Header",
   "szText": "Enter a Strongroom and retrieve a {ITEM:S09_QST_Main_DGN_AstarothBloodItem}",
   "hLabel": 165456128
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback96Header",
   "szText": "Use a Nightmare Sigil to find Strongrooms",
   "hLabel": 1754702117
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase54Description",
   "szText": "I should take the blood relic back to Cerrigar so it can be contained in the Wayfinder.",
   "hLabel": 841355870
  },
