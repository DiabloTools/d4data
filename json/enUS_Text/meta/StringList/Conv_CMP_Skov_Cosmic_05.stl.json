 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What exactly are these 'Anchors'?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.243A4F",
   "szText": "It is said they were an experiment, designed by the Firstborn known as Rathma. One hewn from alabaster, the other obsidian, to maintain what he called “the Balance.”",
   "hLabel": 2438061211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.243A4F",
   "szText": "Reserved, academic",
   "hLabel": 3783788648
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.243A4F",
   "szText": "We use them to balance the Angelic and Infernal energies here. Should the Anchors ever fail, disaster would follow.",
   "hLabel": 1775601245
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.243A4F",
   "szText": "Reserved and academic, then worried",
   "hLabel": 3121328682
  }
 ],
 "ptMapStringTable": "0"
}
