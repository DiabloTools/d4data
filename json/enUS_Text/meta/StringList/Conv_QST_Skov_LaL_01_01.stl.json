{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_LaL_01_01.stl",
 "__snoID__": 2487308,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Missing children?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B56B",
   "szText": "Plucked from the fields like ripe olives, and taken far too voraciously to be mere coincidence.",
   "hLabel": 2440888317
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B5D8",
   "szText": "And we won’t lose another! I’ll find the culprit, and I’ll…I’ll…",
   "hLabel": 1778429827
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B56B",
   "szText": "St-St-Stammer them into submission? Ugh, you’ve got the countenance of a lion, but the roar of a lamb.",
   "hLabel": 1115968385
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.25B56B",
   "szText": "criticising with supportive undertone",
   "hLabel": 2461695822
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25B56B",
   "szText": "One must not be meek when mettle is required. The children need a “hero,” not a milksop.",
   "hLabel": 453508419
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.25B5D8",
   "szText": "You’re right… Tymon the Timid, no more.",
   "hLabel": 4086017225
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.25B56B",
   "szText": "That’s it! No child leaves a silent trail. We need only find the fruit of their folly.",
   "hLabel": 1206150702
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.25B56B",
   "szText": "And I wager derring-do is far from foreign to you, friend. Oh, you’ve scars that’d put the scribes to shame.",
   "hLabel": 543690736
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.25B56B",
   "szText": "directed at player",
   "hLabel": 2003023197
  }
 ],
 "ptMapStringTable": "0"
}
