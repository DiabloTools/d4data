 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What will be your first act as Queen?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCC9B",
   "szText": "My first act? It is the fifth you should be asking about.",
   "hLabel": 2457577341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCC9B",
   "szText": "playing it up – she hasn’t really thought that far ahead. close proximity",
   "hLabel": 3803304778
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "No, in truth...I fear what I do will not be popular among the Askari.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCC9B",
   "szText": "sobering, genuine",
   "hLabel": 3140844812
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCC9B",
   "szText": "Those pilgrims, they did not follow Akarat on a whim. They were starving, and desperate, and terrified. And Skovos did nothing to aid them.",
   "hLabel": 1132657409
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DCC9B",
   "szText": "Playful and warm",
   "hLabel": 2478384846
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "It is time for us to rejoin the world. To heal it.",
   "hLabel": 470197443
  }
 ],
 "ptMapStringTable": "0"
}
