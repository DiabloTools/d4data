   "szLabel": "MenuLabel",
   "szText": "\"Are you okay?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "Heh, besides that thing scaring me half to death?",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.6D03F",
   "szText": "Affronted, slightly winded",
   "hLabel": 3210763048
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4",
   "szText": "You seem plenty alive to me. More than its master can say.",
   "hLabel": 1776443800
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "Was this the fellow tracking me, then?",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.6D03F",
   "szText": "Well, seeing as it hasn’t torn my guts out yet...can't be too bad. Why not bring it along?",
