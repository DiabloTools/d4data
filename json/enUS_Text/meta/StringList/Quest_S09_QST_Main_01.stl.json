  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback202Header",
   "szText": "Pick up {ITEM} ",
   "hLabel": 2364936714
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase131Description",
   "szText": "At Eldhaime, I retrieved an object that demons had been fighting over. Perhaps Bryona knows what it is.",
   "hLabel": 3493681450
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback133Header",
   "szText": "Speak with Bryona",
   "hLabel": 708402285
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase65Description",
   "szText": "The device I found in Eldhaime led me to a Horadric relic containing Astaroth's blood. I should inform Bryona.",
   "hLabel": 2994239808
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback64Header",
   "szText": "Speak with Bryona",
   "hLabel": 165456128
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase38Description",
   "szText": "The blood relic I found matches a slot on the Horadric device that led me to it. Perhaps they fit together. ",
   "hLabel": 1463121120
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback37Header",
