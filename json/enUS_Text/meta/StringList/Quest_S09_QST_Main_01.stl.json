  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase20Description",
   "szText": "The Druid Bryona asked for my aid in clearing demons out of Eldhaime Keep. She awaits me at Firebreak Manor.",
   "hLabel": 2151383127
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback19Header",
   "szText": "Meet Bryona at Firebreak Manor",
   "hLabel": 3983978592
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase26Description",
   "szText": "Demons swarm from Eldhaime. I need to find out what drew them here.",
   "hLabel": 2783948957
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
