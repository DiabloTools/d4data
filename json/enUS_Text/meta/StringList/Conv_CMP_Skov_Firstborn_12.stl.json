   "szLabel": "Line1.2289FE",
   "szText": "The Trial of Stone, built by my Askarra. Hm, and a hard woman she was.",
   "hLabel": 2435827143
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2289FE",
   "szText": "Nostalgic, somber. Misses Askarra (his wife)",
   "hLabel": 3781554580
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2289FE",
   "szText": "She never once showed me mercy.",
   "hLabel": 1773367177
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2289FE",
   "szText": "Nostalgic, smiling, somber. He lost her long ago.",
