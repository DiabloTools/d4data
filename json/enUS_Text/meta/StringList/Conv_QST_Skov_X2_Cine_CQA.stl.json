{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_X2_Cine_CQA.stl",
 "__snoID__": 2325740,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "CQA",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "Hochyh chyhil múrchyo, lam lu...",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCFFD",
   "szText": "Heavy with grief, intimate, reciting an old Horadric eulogy. PRONUNCIATION: (Hoch cheel meer'ko, lam loo) TRANSLATION: Lay down your arms, old friend.",
   "hLabel": 3140849566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCFFD",
   "szText": "Lay down your arms, old friend...",
   "hLabel": 1132662163
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DCFFD",
   "szText": "To Lorath, but translating for the Player. Heavy with grief, intimate.",
   "hLabel": 2478389600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCFFD",
   "szText": "Your duty is done.",
   "hLabel": 470202197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCFFD",
   "szText": "To Lorath. Grieving, intimate, reassuring.",
   "hLabel": 1815929634
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BAE4",
   "szText": "\"Duty.\" He gave everything he had for it, and this? This is his reward?!",
   "hLabel": 3874545195
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.BAE4",
   "szText": "Grief turns dark. Anger mounts-- not at Tyrael, but Lorath's fate.",
   "hLabel": 807383736
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.BAE4",
   "szText": "Betrayed and murdered! Damned to eternity on the Tree of Whispers! And all the while...",
   "hLabel": 1619902228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.BAE4",
   "szText": "Grieving, angry, ranting. Lorath isn't just dead, he's condemned to suffer.",
   "hLabel": 3482789185
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.BAE4",
   "szText": "Mephisto laughs, as we fall.",
   "hLabel": 1698173014
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.BAE4",
   "szText": "Seething, bitter. Mephisto has killed all our friends. He is winning.",
   "hLabel": 3561059971
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCFFD",
   "szText": "Lorath was the last of my Order. Perhaps the one I knew best.",
   "hLabel": 4192891844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1DCFFD",
   "szText": "Implied agreement. Solemn. Grieving. ",
   "hLabel": 1357257009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCFFD",
   "szText": "He would tell us to leave him here. To ride out with your Mother's weapon, and drive it into Mephisto's heart.",
   "hLabel": 3530431878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1DCFFD",
   "szText": "Somber then resolute. This is what Lorath would want. This is what we must do.",
   "hLabel": 694797043
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1DCFFD",
   "szText": "To save as many souls as we can.",
   "hLabel": 2867971912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.1DCFFD",
   "szText": "Solemn. A call to action.",
   "hLabel": 32337077
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4",
   "szText": "The dead deserve nothing...while the living are in danger.",
   "hLabel": 2911370197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.BAE4",
   "szText": "Recalling Lorath's exact words. A painful agreement.",
   "hLabel": 479289858
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCFFD",
   "szText": "Hm. So he said. But we will bury him, at least.",
   "hLabel": 2514696963
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1DCFFD",
   "szText": "Sad smile, recognizing Lorath's words. Comforting Player.",
   "hLabel": 3974029424
  }
 ],
 "ptMapStringTable": "0"
}
