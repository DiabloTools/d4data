 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You said the Horadrim helped fight the reapers before. Could the Úllo Sar be related?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1DCFFD",
   "szText": "All the Horadrim who stood against the reapers were slain. All except for Lorath Nahr, of course.",
   "hLabel": 2457582095
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1DCFFD",
   "szText": "Somber, especially for Lorath",
   "hLabel": 3803309532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "But Lorath was the very last Horadrim. The Úllo Sar must be pretenders, defiling their memory with this...suicide.",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCFFD",
   "szText": "Frowning, reassuring himself",
   "hLabel": 3140849566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCFFD",
   "szText": "We must learn who they are and deal with them. Swiftly.",
   "hLabel": 1132662163
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DCFFD",
   "szText": "Grim, determined",
   "hLabel": 2478389600
  }
 ],
 "ptMapStringTable": "0"
}
