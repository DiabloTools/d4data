{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_X2_Cine_CRS.stl",
 "__snoID__": 2325737,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Begin.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "Hm. This...this was Tal Rasha’s hand.",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.6D03F",
   "szText": "amazement, recognition",
   "hLabel": 4245791867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCFFD",
   "szText": "Oh, yes. Heh. He couldn’t stop shaking, he was so eager. Humble, too. Hopeful.",
   "hLabel": 1795122129
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1DCFFD",
   "szText": "nostalgic",
   "hLabel": 3140849566
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCFFD",
   "szText": "But that was a long time ago.",
   "hLabel": 470202197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.1DCFFD",
   "szText": "Hm.",
   "hLabel": 3144089480
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "Ah. You forgot.",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCFFD",
   "szText": "Ah, yes.",
   "hLabel": 1222844480
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCFFD",
   "szText": "remembering",
   "hLabel": 2682176941
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCFFD",
   "szText": "You remind me of him, you know.",
   "hLabel": 4192891844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1DCFFD",
   "szText": "smiling",
   "hLabel": 1357257009
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "Hah. Is my handwriting that bad?",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1DCFFD",
   "szText": "(laughs) Only sometimes. But it’s more than that.",
   "hLabel": 3530431878
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1DCFFD",
   "szText": "friendly and warm",
   "hLabel": 694797043
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.1DCFFD",
   "szText": "Do you remember when we first met?",
   "hLabel": 2867971912
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.6D03F",
   "szText": "It's cruel to test an old man’s memory.",
   "hLabel": 1533805628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCFFD",
   "szText": "You asked this old man how it felt to become mortal. No one else had.",
   "hLabel": 2514696963
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1DCFFD",
   "szText": "amused",
   "hLabel": 3974029424
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.6D03F",
   "szText": "I was presumptuous.",
   "hLabel": 2404710208
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCFFD",
   "szText": "You were compassionate.",
   "hLabel": 1189777031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.1DCFFD",
   "szText": "You showed me how to be human. That’s how I knew the Order was in good hands when I left.",
   "hLabel": 527317065
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.1DCFFD",
   "szText": "And it still is. Look. We’ve shaped the blade that will banish a Prime Evil.",
   "hLabel": 836502082
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.BAE4",
   "szText": "(grunts)",
   "hLabel": 4281108952
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.BAE4",
   "szText": "disoriented, stumbling",
   "hLabel": 1849028613
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.6D03F",
   "szText": "What’s wrong?",
   "hLabel": 2073480225
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.6D03F",
   "szText": "fading, muffled",
   "hLabel": 3419207662
  }
 ],
 "ptMapStringTable": "0"
}
