 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What happened to it?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.244C6E",
   "szText": "War is a cancer, stained one. It consumes until there is nothing left to consume. Then it consumes itself.",
   "hLabel": 872131793
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line14.244C6E",
   "szText": "When the Purge found us, I watched as the amphitheater filled with the blood of my friends, pupils, and countrymen. And I could do nothing.",
   "hLabel": 209671827
  }
 ],
 "ptMapStringTable": "0"
}
