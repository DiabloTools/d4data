   "szText": "Bloodstained Cloth",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.228083",
   "szText": "\"Arms, legs, stomach, I am burning from inside! Why, Akarat, why bid me go and see?! The earth is gashed open–spilling blasphemy–into me! Into EVERYONE!",
   "hLabel": 2435815774
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.228083",
   "szText": "In agony, tearful confusion, mounting terror",
   "hLabel": 3781543211
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.228083",
   "szText": "ALL must turn to follow your Light! They must beg for it!\"",
   "hLabel": 1773355808
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.228083",
   "szText": "Desperate declaration, violent and sinister in the end.",
   "hLabel": 3119083245
  }
 ],
