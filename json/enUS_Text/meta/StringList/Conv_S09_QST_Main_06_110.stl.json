 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Astaroth is dead, and his blood is gone for good.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line32.21FCD5",
   "szText": "I can feel it. Can’t sense his presence anymore.",
   "hLabel": 484029952
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir32.21FCD5",
   "szText": "amazed, relieved",
   "hLabel": 1943362413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line34.21FCD5",
   "szText": "Braega would’ve spun songs about this day. She made merry like a madwoman, dancing and belting from the tabletop. Always did, when we returned from battle.",
   "hLabel": 4116537282
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line36.21FCD5",
   "szText": "...I’d like to spend some time with her and Donan, at Firebreak. Join me, if you’d like—Donan owes us a few slaps upside the head for what we’ve done here today.",
   "hLabel": 3454077316
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir36.21FCD5",
   "szText": "fond on the last sentence",
   "hLabel": 618442481
  }
 ],
 "ptMapStringTable": "0"
}
