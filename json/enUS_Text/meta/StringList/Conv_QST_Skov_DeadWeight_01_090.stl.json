 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Turn yourself in, Korax.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25A398",
   "szText": "And feed crows on a gibbet? (cough) For what? That merchant was a thief! I told him about my treasure, and he tried to steal it!",
   "hLabel": 2440850259
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25A398",
   "szText": "Now the whole town wants a piece. And you…",
   "hLabel": 1115930327
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25A398",
   "szText": "You're a thief, too. Just like the rest of them.",
   "hLabel": 1778390293
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.25A398",
   "szText": "Just go away, leave me be!",
   "hLabel": 453470361
  }
 ],
 "ptMapStringTable": "0"
}
