 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why did you turn against your father?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BD31C",
   "szText": "Because I finally understood him.",
   "hLabel": 1076092555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BD31C",
   "szText": "All he wanted was a stage upon which to play out his little perversions. And everything he made...was built for that purpose. Including me.",
   "hLabel": 3659028493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BD31C",
   "szText": "I chose to make something beyond him. Beyond myself. And he would not abide that.",
   "hLabel": 1585989350
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.BD31C",
   "szText": "reminiscing",
   "hLabel": 2931716787
  }
 ],
 "ptMapStringTable": "0"
}
