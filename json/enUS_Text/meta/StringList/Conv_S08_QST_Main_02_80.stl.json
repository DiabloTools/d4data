   "szLabel": "MenuLabel",
   "szText": "\"I have the Flayed Mask. Jarius helped me find the buried sanctum.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.20FFCC",
   "szText": "You found it more quickly than I expected.",
   "hLabel": 2435157307
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.20FFCC",
   "szText": "I also wasn’t expecting help from a Cathedral Knight.",
