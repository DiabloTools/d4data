 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Yes, Ouna?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1FA02A",
   "szText": "I have no right to ask this of you, but you must undo what I have done. Follow the whispers. Bring the heads back...where they belong.",
   "hLabel": 2459821538
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1FA02A",
   "szText": "Her final request. Fear mounting. Looking Player dead in the eyes.",
   "hLabel": 3805548975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1F9FF1",
   "szText": "You should go now, wanderer.",
   "hLabel": 1133524600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1F9FF1",
   "szText": "Heavy. Somber. Gentle.",
   "hLabel": 2479252037
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1F9FF1",
   "szText": "Come, Ouna. Let us sit.",
   "hLabel": 471064634
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1F9FF1",
   "szText": "Holding back tears. Gentle. Intimate.",
   "hLabel": 1816792071
  }
 ],
 "ptMapStringTable": "0"
}
