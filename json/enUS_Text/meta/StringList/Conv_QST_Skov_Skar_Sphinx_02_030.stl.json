 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are you able to continue?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.244C64",
   "szText": "Yes. Yes, of course. But...how do you do it? You see it too, do you not?",
   "hLabel": 119489461
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.244C64",
   "szText": "The cycle. The endless cycle, repeated again and again. We fight and we die, so that, what, our children may eagerly greet the next apocalypse?",
   "hLabel": 3510949125
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.244C64",
   "szText": "tears welling",
   "hLabel": 675314290
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.244C64",
   "szText": "I would rather be blind than suffer this \"truth...\"",
   "hLabel": 2848489159
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.244C64",
   "szText": "(sighs) We should keep moving.",
   "hLabel": 4173409091
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.244C64",
   "szText": "Tired. Defeated.",
   "hLabel": 1337774256
  }
 ],
 "ptMapStringTable": "0"
}
