{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_EchoingHatred_01_050.stl",
 "__snoID__": 2446845,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Mephisto's scream raised the dead?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.251FCD",
   "szText": "He brought Queen Adreona back to life with a gesture. But his scream...",
   "hLabel": 2439182252
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.251FCD",
   "szText": "Making a point, then disturbed by the memory. She can still feel/hear it.",
   "hLabel": 3784909689
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.251FCD",
   "szText": "It tore through our isles, shook the ground beneath our feet... And all at once I heard the dead scream in kind. Voices beyond counting.",
   "hLabel": 1776722286
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.251FCD",
   "szText": "Deeply disturbed by the memory, recounting her experience. She's used to hearing the dead, but not like this...",
   "hLabel": 3122449723
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.251FCD",
   "szText": "They are not simply awake. They are mad with hatred.",
   "hLabel": 1114262320
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.251FCD",
   "szText": "Disturbed, grim, foreboding.",
   "hLabel": 2459989757
  }
 ],
 "ptMapStringTable": "0"
}
