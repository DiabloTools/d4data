  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.1DCFFD",
   "szText": "Lorath thinks himself a barnacle on our hull. But we know the truth of it.  He is our compass, pointing the way.",
