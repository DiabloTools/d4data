 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You knew Neyrelle's mother. Did she ever talk about her daughter?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.BD31C",
   "szText": "Oh, yes. Vhenard spent long hours telling me stories. The way her daughter would curl up at the bottom of the carriage. The way the candlelight would shine in her eyes...",
   "hLabel": 1076092555
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.BD31C",
   "szText": "with a bittersweet smile",
   "hLabel": 2421819992
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BD31C",
   "szText": "The dead girl - that was her, wasn't it?",
   "hLabel": 3659028493
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.BAE4",
   "szText": "...",
   "hLabel": 2911370197
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.BD31C",
   "szText": "I see. Then her mother's sacrifice was for naught.",
   "hLabel": 4168925288
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.BD31C",
   "szText": "And who is to blame?",
   "hLabel": 2456893930
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.BD31C",
   "szText": "(Player is to blame)",
   "hLabel": 3802621367
  }
 ],
 "ptMapStringTable": "0"
}
