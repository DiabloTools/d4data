   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How did your sister get infected?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24A3D2",
   "szText": "How else? She's young, and thought herself invincible.",
   "hLabel": 2439665751
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24A3D2",
   "szText": "A little bitter, but also affectionate",
   "hLabel": 3785393188
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24A3D2",
   "szText": "We had a garden outside of town that we had to abandon as demons moved in. She hoped to salvage a few potatoes she grew herself. She has no green thumb but she was proud of this small success.",
   "hLabel": 1777205785
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24A3D2",
   "szText": "She came home covered in bug bites. I thought they had healed, but now…",
   "hLabel": 1114745819
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.24A3D2",
   "szText": "Worried ",
   "hLabel": 2460473256
  }
 ],
