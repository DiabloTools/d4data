{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_02_064.stl",
 "__snoID__": 2460776,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You've been in the West all this time? Why?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCFFD",
   "szText": "Lorath and I parted when his beard was still brown. We had just settled into the Vault in the Mistral Woods.",
   "hLabel": 2514696963
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1DCFFD",
   "szText": "Nostalgic. This is the nice part of the story.",
   "hLabel": 3974029424
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.6D03F",
   "szText": "A better time. Hopeful.",
   "hLabel": 2404710208
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.6D03F",
   "szText": "Nostalgic.",
   "hLabel": 3750437645
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCFFD",
   "szText": "Those years passed like days. My body slowed, my reflection changed. And I became aware of time in a way I had never known.",
   "hLabel": 1189777031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.1DCFFD",
   "szText": "Regretful. Trying to explain himself.",
   "hLabel": 2649109492
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.6D03F",
   "szText": "You felt it running out.",
   "hLabel": 3275614788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.6D03F",
   "szText": "Realizing. Empathetic.",
   "hLabel": 326374929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.1DCFFD",
   "szText": "Once we had the Vault in order, I found my excuse to leave. You had Estuar well in hand, but the West? Ahh, the West needed me.",
   "hLabel": 836502082
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.1DCFFD",
   "szText": "Regretful. Mocks his own logic.",
   "hLabel": 2295834543
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.1DCFFD",
   "szText": "So I wandered from Kingsport to the Dreadlands and back. I helped where I could, never stayed long, and still time caught up with me.",
   "hLabel": 174042116
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.1DCFFD",
   "szText": "Regretful. Realizes he was foolish.",
   "hLabel": 1633374577
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD",
   "szText": "I confess I heard rumors of demons returning to Estuar, but I...",
   "hLabel": 3806549446
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD",
   "szText": "Hesitating at the hard part. Regret and shame.",
   "hLabel": 970914611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.6D03F",
   "szText": "What, Tyrael?",
   "hLabel": 361448867
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.6D03F",
   "szText": "Empathetic, encouraging",
   "hLabel": 1707176304
  }
 ],
 "ptMapStringTable": "0"
}
