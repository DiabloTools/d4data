   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "To live is to suffer. So say the scriptures of every creed in every tongue since the dawn of our kind.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2808AB",
   "szText": "Somber, sincere, calm",
   "hLabel": 3788381353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.2808AB",
   "szText": "We who live know this well. We’ve known anguish and pain. Terror, destruction, and hatred. We have reached for the comfort of false prophets and buried the one true answer.",
   "hLabel": 545456335
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.2808AB",
   "szText": "Death is salvation. And we, the brothers and sisters of the Úllo Sar, shall welcome it. Join us.",
   "hLabel": 4177963665
  }
 ],
 "ptMapStringTable": "0"
}
