{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_02_040.stl",
 "__snoID__": 2259411,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Old friend? Who are you?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCFFD",
   "szText": "You know, as long as I’ve lived, I have never known how to answer that question.",
   "hLabel": 2514696963
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1DCFFD",
   "szText": "Amused with himself. Still at a loss.",
   "hLabel": 3974029424
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.6D03F",
   "szText": "I'd like you to meet Tyrael. Once an angel, now a mortal man. Founder of the Horadric Order. And a sorely missed, very old friend.",
   "hLabel": 2404710208
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.6D03F",
   "szText": "Weary, smiling. Pleased to see his friend.",
   "hLabel": 3750437645
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line51.BAE4.Pal",
   "szText": "By the Light...",
   "hLabel": 1984766179
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir51.BAE4.Pal",
   "szText": "To self, amazed, reverent. Meeting a legendary angel in person.",
   "hLabel": 2059916688
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line27.1DCFFD",
   "szText": "I've aged better than you.",
   "hLabel": 1189777031
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir27.1DCFFD",
   "szText": "Smiling, gently teasing.",
   "hLabel": 2649109492
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.6D03F",
   "szText": "(laughs) Aye, that you have. But...where have you been? I tried to find you.",
   "hLabel": 3275614788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.6D03F",
   "szText": "Laughs wearily, smiling. Then confused.",
   "hLabel": 326374929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line31.1DCFFD",
   "szText": "I was in the West, doing what I could for the people there. I’m afraid the years slipped away from me. Until, one morning, a bird landed at my feet.",
   "hLabel": 836502082
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir31.1DCFFD",
   "szText": "Regretful, hiding shame then redirecting.",
   "hLabel": 2295834543
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line33.1DCFFD",
   "szText": "It brought a message from someone called \"Neyrelle.\" She warned that Mephisto was coming to Skovos. But Lorath Nahr would be in pursuit.",
   "hLabel": 174042116
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.1DCFFD",
   "szText": "Warm, telling the story. Here to help and glad to see Lorath.",
   "hLabel": 1633374577
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD.Bar",
   "szText": "She said you would be with him. The noble barbarian who saved her soul.",
   "hLabel": 2896146441
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD.Bar",
   "szText": "Smiling, warm, recognizing the Player from their description",
   "hLabel": 3130672118
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD.Dru",
   "szText": "She said you would be with him. The stout-hearted druid who saved her soul.",
   "hLabel": 2896149183
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD.Dru",
   "szText": "Smiling, warm, recognizing the Player from their description",
   "hLabel": 3130674860
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD.Nec",
   "szText": "She said you would be with him. The grim-eyed necromancer who saved her soul.",
   "hLabel": 2896159626
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD.Nec",
   "szText": "Smiling, warm, recognizing the Player from their description",
   "hLabel": 3130685303
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD.Pal",
   "szText": "She said you would be with him. The pilgrim of Light who saved her soul.",
   "hLabel": 2896161681
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD.Pal",
   "szText": "Smiling, warm, recognizing the Player from their description",
   "hLabel": 3130687358
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD.Sor",
   "szText": "She said you would be with him. The brilliant sorcerer who saved her soul.",
   "hLabel": 2896165416
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD.Sor",
   "szText": "Smiling, warm, recognizing the Player from their description",
   "hLabel": 3130691093
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD.Spi",
   "szText": "She said you would be with him. The tenacious spiritborn who saved her soul.",
   "hLabel": 2896165440
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD.Spi",
   "szText": "Smiling, warm, recognizing the Player from their description",
   "hLabel": 3130691117
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD.Rog",
   "szText": "She said you would be with him. The good-hearted rogue who saved her soul.",
   "hLabel": 2896164316
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD.Rog",
   "szText": "Smiling, warm, recognizing the Player from their description",
   "hLabel": 3130689993
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD.War",
   "szText": "She said you would be with him. The demon-haunted warlock who saved her soul.",
   "hLabel": 2896169310
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD.War",
   "szText": "Smiling, warm, recognizing the Player from their description",
   "hLabel": 3130694987
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD",
   "szText": "She said you would be with him. The tireless wanderer who saved her soul.",
   "hLabel": 3806549446
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCFFD",
   "szText": "Smiling, warm, recognizing the Player from their description",
   "hLabel": 970914611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.1DCFFD",
   "szText": "I had hoped to meet her. Did she not come with you?",
   "hLabel": 1465894599
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.1DCFFD",
   "szText": "Looking around. Curious, disappointed.",
   "hLabel": 2925227060
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.6D03F",
   "szText": "She... Her duty is done.",
   "hLabel": 30218884
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.6D03F",
   "szText": "Hesitant. Sudden grief. Using an old Horadric idiom for death.",
   "hLabel": 1375946321
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line49.1DCFFD",
   "szText": "I see...",
   "hLabel": 140974667
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir49.1DCFFD",
   "szText": "Somber, solemn",
   "hLabel": 1600307128
  }
 ],
 "ptMapStringTable": "0"
}
