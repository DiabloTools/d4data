 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I'm sorry, Drollon.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24ED9B",
   "szText": "It’s my fault. Migoso and all of her crew are dead because of me and that damned Tear! If I hadn’t found it, if I hadn’t—",
   "hLabel": 2439861489
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24ED9B",
   "szText": "losing a battle with tears",
   "hLabel": 3785588926
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24ED9B",
   "szText": "No, Drollon, now is not the time to wallow. Uh, we can infer that pirates took the Tear to Saltwind. That is where I should head next.",
   "hLabel": 1777401523
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24ED9B",
   "szText": "Picking himself up for his friend's sake",
   "hLabel": 3123128960
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24ED9B",
   "szText": "Please, friend, meet me there. The Tear of the Firstborn must be destroyed before it can hurt anyone else.",
   "hLabel": 1114941557
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.24ED9B",
   "szText": "shaky, slightly desperate",
   "hLabel": 2460668994
  }
 ],
 "ptMapStringTable": "0"
}
