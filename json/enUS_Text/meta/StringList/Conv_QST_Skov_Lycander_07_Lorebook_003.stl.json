   "szLabel": "DisembodiedVoice",
   "szText": "Rathma",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.FD852",
   "szText": "It's cathartic, seeing relics of my youth untouched by years gone by. Preparing for death has made me sentimental.",
   "hLabel": 1568933264
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.FD852",
   "szText": "Narratorial, reading journal aloud ... sentimental",
   "hLabel": 3431820221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.FD852",
   "szText": "My time is coming to an end. I've seen it in visions, I feel it in my core.",
   "hLabel": 4151869202
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.FD852",
   "szText": "Narratorial, reading journal aloud ... grave",
   "hLabel": 1719788863
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.FD852",
   "szText": "Even now, I can’t bring myself to destroy Mother’s “gift.” I fear it's the only thing that will save us when the time comes.",
   "hLabel": 2439837844
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.FD852",
   "szText": "Narratorial, reading journal aloud ... grave",
