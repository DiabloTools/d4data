   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"A terrible fate for a father...\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1FA02A",
   "szText": "His story is common as autumn leaves. Everyone on the Tree believed that their question was worth the price, but most answers mean little in the forever that follows.",
   "hLabel": 2459821538
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1FA02A",
   "szText": "Somber. Bitter. Cares for the heads, not the Tree.",
   "hLabel": 3805548975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1FA02A",
   "szText": "I hope Lorath’s question was worth it.",
   "hLabel": 1797361572
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1FA02A",
   "szText": "Sincere. Somber.",
