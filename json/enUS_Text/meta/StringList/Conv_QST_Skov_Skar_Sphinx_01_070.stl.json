 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"He is the one who found this place.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.244C6E",
   "szText": "And what do you believe yourself worthy of, little sieve?",
   "hLabel": 4083226823
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.244C64",
   "szText": "I wish to see the truth—to see the world for how it truly is.",
   "hLabel": 1203361727
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.244C6E",
   "szText": "Hm. So be it. I can grant you sight, but I cannot make you see.",
   "hLabel": 540901810
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.244C6E",
   "szText": "the monkey’s paw curls, disapproving",
   "hLabel": 2000234271
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.244C6E",
   "szText": "I will grant you what you seek. But do not mistake the light for shelter.",
   "hLabel": 4173409140
  }
 ],
 "ptMapStringTable": "0"
}
