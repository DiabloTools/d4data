{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Tharra_01_090.stl",
 "__snoID__": 2383758,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You want me to be your witness for a 'Passage'? What does that entail?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "It is a rite as old as the Amazons. Through a series of trials, I must honor the foremothers and prove my mind and body fit to rule. No two Passages are the same.",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1DCC9B",
   "szText": "As my witness, you will be my right hand in the trials and observe my conduct on behalf of the council.",
   "hLabel": 4102704773
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "We begin at First Queen Antia’s tomb in Lycander. Find me there.",
   "hLabel": 1222839726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCC9B",
   "szText": "Antia = Ant-ee-uh",
   "hLabel": 2682172187
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCC9B",
   "szText": "And thank you.",
   "hLabel": 560379760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1DCC9B",
   "szText": "Genuine and soft.",
   "hLabel": 2019712221
  }
 ],
 "ptMapStringTable": "0"
}
