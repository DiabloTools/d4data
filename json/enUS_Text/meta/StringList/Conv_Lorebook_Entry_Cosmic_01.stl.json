 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Curator's Log",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.243A54",
   "szText": "I am a steward of the past. I've never had nor wanted the Oracle’s Sight but, this morning, as I touched the Infernal Anchor...I saw it crack open.",
   "hLabel": 2438061194
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.243A54",
   "szText": "Weary, restless, disturbed. Hasn't slept since she had this vision.",
   "hLabel": 3783788631
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.243A54",
   "szText": "Its black glass tumbled into a fiery abyss, and all the demons of Hell surged forth. Writhing, laughing, screaming—each in celebration.",
   "hLabel": 1775601228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.243A54",
   "szText": "Weary, restless, disturbed.",
   "hLabel": 3121328665
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.243A54",
   "szText": "I must be going mad. It cannot be real.",
   "hLabel": 1113141262
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.243A54",
   "szText": "Weary, disturbed, attempting denial.",
   "hLabel": 2458868699
  }
 ],
 "ptMapStringTable": "0"
}
