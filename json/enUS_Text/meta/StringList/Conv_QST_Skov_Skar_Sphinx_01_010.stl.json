   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What's this about a Firstborn ruin?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.244C64",
   "szText": "Yes! Thank you. That is the proper response.",
   "hLabel": 2438099342
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.244C64",
   "szText": "I have tried convincing my friends to explore it further, but...",
   "hLabel": 1534591710
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.248F53",
   "szText": "It is too dangerous that deep in the mines. You know that, Thales. We’d be dead before you could get through the door.",
   "hLabel": 1775786357
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.244C64",
   "szText": "Really? Wonderful. I'll meet you at the entrance. Just need to gather a few things...",
   "hLabel": 119489461
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.244C64",
   "szText": "(pure excitement at first, then thoughtful) ",
   "hLabel": 1465216898
  }
 ],
