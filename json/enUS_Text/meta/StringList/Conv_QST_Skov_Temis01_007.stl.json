 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24FBB7",
   "szText": "So you admit you worship demons?",
   "hLabel": 2439896558
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24FBB7",
   "szText": "growing frustrated",
   "hLabel": 3785623995
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24FBB3",
   "szText": "No, we respect demons. Same as angels.",
   "hLabel": 1777436588
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.24FBB7",
   "szText": "But they’re not the same! One is-is-is evil!",
   "hLabel": 1114976626
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.24FBB3",
   "szText": "Ugh, evil, good, you cannot touch these things, you cannot hold them. They are not real.",
   "hLabel": 452516656
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.24FBB3",
   "szText": "But blood—blood is real. And my blood bears my ancestors, angels and demons both, same as you. Same as anyone.",
   "hLabel": 4085023986
  }
 ],
 "ptMapStringTable": "0"
}
