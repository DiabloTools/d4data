 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why are you skulking around?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.218EB3",
   "szText": "Oh! No, no, I'm not skulking. I'm, uh—",
   "hLabel": 2434688956
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.218EB3",
   "szText": "startled, caught off guard",
   "hLabel": 3780416393
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.218EB3",
   "szText": "Ah, fine, you caught me. I need a spear and the guard is far too good at her job.",
   "hLabel": 447309058
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.218EB3",
   "szText": "giving in",
   "hLabel": 1793036495
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.218EB3",
   "szText": "Don’t look at me like that! My unit has been taken by a sea hag. You know they do awful things to the dead?",
   "hLabel": 4079816388
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.218EB3",
   "szText": "Defensive",
   "hLabel": 1130576529
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.218EB3",
   "szText": "I just want to put my sisters to rest. If you could talk to the guard, just for a moment, I can grab what I need.",
   "hLabel": 1199951341
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.218EB3",
   "szText": "Determined",
   "hLabel": 2659283802
  }
 ],
 "ptMapStringTable": "0"
}
