{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_05_090.stl",
 "__snoID__": 2260601,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Is everyone all right?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line32.1DCC9B",
   "szText": "Not all of us... Let's see who remains.",
   "hLabel": 505267345
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir32.1DCC9B",
   "szText": "Tired, somber, then turning to address her sisters",
   "hLabel": 1964599806
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line40.1DCC9B",
   "szText": "Sisters! Eyes and ears, on me.",
   "hLabel": 3122039760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir40.1DCC9B",
   "szText": "Raising a hand, asking for attention",
   "hLabel": 286404925
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line42.1DCC9B",
   "szText": "You've each done enough. You disobeyed your Queen, bled for your home...lost more than your share.",
   "hLabel": 2459579794
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir42.1DCC9B",
   "szText": "Somber, sincere, grateful",
   "hLabel": 3918912255
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line44.1DCC9B",
   "szText": "My friend here believes we have a chance to end this invasion. I believe them, but there will be a cost, and I am not your Queen. I can’t order you to follow.",
   "hLabel": 1797119828
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir44.1DCC9B",
   "szText": "Honest",
   "hLabel": 3256452289
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line46.24C9AC",
   "szText": "To the death, Captain!",
   "hLabel": 1116826630
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir46.24C9AC",
   "szText": "Raising spear, shouted (3/4), ready to serve",
   "hLabel": 2576159091
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line48.2508DB",
   "szText": "(war-chant)",
   "hLabel": 453718807
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line50.1DCC9B",
   "szText": "Very well. I'll see you all back at the garrison. We must prepare.",
   "hLabel": 781384913
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir50.1DCC9B",
   "szText": "Nodding, grateful, bracing for what comes next.",
   "hLabel": 2240717374
  }
 ],
 "ptMapStringTable": "0"
}
