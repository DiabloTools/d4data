   "szLabel": "MenuLabel",
   "szText": "\"Have you found anything?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.6D03F",
   "szText": "Maybe. This land we stand on, the stories say Lilith and Inarius fought here...and they left a curse in their wake.",
   "hLabel": 1865035611
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
