  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.6D03F",
   "szText": "I think it’s the blade. I think it’s here, buried somewhere in those ruins.",
   "hLabel": 2735940191
  },
