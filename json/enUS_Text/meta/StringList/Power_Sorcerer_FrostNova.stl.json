  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "desc",
   "szText": "{if:SF_4}{c_label}Cooldown:{/c_label} {c_resource}{Cooldown Time}{/c} seconds\r\n{/if}{if:SF_3}{c_label}Charges:{/c} {c_resource}{SF_2}{/c}\r\n{c_label}Charge Cooldown:{/c_label} {c_resource}{Recharge Time}{/c} seconds\r\n{/if}Unleash a torrent of frost, {c_important}{u}Freezing{/u}{/c} enemies around you for {c_number}{buffduration:FREEZE}{/c} seconds.",
   "hLabel": 3707583
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "rankup_desc",
   "szText": "\r\n{icon:bullet,1.2} Freeze Duration {icon:arrow,1.2} {c_number}[SF_11|1|]{/c} seconds",
   "hLabel": 4074074671
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Description",
   "szText": "Enemies that die while {u}{c_important}Frozen{/c}{/u} by {c_important}Frost Nova{/c} have a {c_number}[SF_35*100|%|]{/c} chance to unleash an additional {c_important}Frost Nova{/c}. ",
   "hLabel": 628601524
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod1_Name",
   "szText": "Shatter",
   "hLabel": 2492006865
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod0_Description",
   "szText": "{c_important}Frost Nova{/c} is now cast at a target location, and each enemy {u}{c_important}Frozen{/c}{/u} by it reduces the cooldowns of your {c_important}Frost{/c} Skills by {c_number}[SF_20|1|]{/c} seconds.",
   "hLabel": 3591940403
