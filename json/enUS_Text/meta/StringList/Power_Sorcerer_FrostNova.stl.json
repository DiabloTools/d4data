  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod0_Name",
   "szText": "Cold Front",
   "hLabel": 2452871472
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod5_Description",
   "szText": "Instead of {u}{c_important}Freezing{/c}{/u}, {c_important}Frost Nova{/c} forms an aura of frigid mist around you that deals {c_number}{dot:UPGRADE_C_DOT_TOOLTIP}{/c} Frostbite damage over {c_number}{buffduration:UPGRADE_C_MAIN_AURA}{/c} seconds.",
   "hLabel": 1660147896
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod5_Name",
   "szText": "Freezing Mist",
   "hLabel": 2648548437
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Mod6_Description",
   "szText": "{c_important}Frost Nova's{/c} Size is increased by {c_number}[SF_8 * 100|%|]{/c}.",
