{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_ToF_01_021.stl",
 "__snoID__": 2359830,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"A theft of fate?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1D8BEB",
   "szText": "Yes. The urns’ creator pulls the strings—fingers hiding in darkness.",
   "hLabel": 2456032413
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.235BFC",
   "szText": "But you can see their paths, Oracle. See who’s doing this to us.",
   "hLabel": 1112029968
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1D8BEB",
   "szText": "What is there to see? Faces without futures. Paths cut.",
   "hLabel": 468652515
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1D8BEB",
   "szText": "Five fingers once. Now only three.",
   "hLabel": 4101159845
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.235BFC",
   "szText": "Three? But only four of us took part in the—",
   "hLabel": 1202212285
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1D8BEB",
   "szText": "Five fingers. Five urns.",
   "hLabel": 558834832
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.235BFC",
   "szText": "No. Mikkos!",
   "hLabel": 4172259649
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.235BFC",
   "szText": "horrified; running off",
   "hLabel": 1336624814
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.1D8BEB",
   "szText": "Fate is not fair…and too rarely kind.",
   "hLabel": 3528882196
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.1D8BEB",
   "szText": "sombre",
   "hLabel": 693247361
  }
 ],
 "ptMapStringTable": "0"
}
