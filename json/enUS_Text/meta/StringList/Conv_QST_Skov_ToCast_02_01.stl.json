   "szLabel": "MenuLabel",
   "szText": "\"Any leads on the Tear of the Firstborn?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24ED9B",
