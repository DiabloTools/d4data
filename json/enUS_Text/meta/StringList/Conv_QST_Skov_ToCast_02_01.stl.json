   "hLabel": 2439861489
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24ED9B",
   "szText": "Happy to see the Player, relieved they came.",
   "hLabel": 3785588926
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24ED9B",
   "szText": "I tried to investigate on my own, but the pirates are eager to fight. I was nearly stabbed!",
   "hLabel": 1777401523
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24ED9B",
