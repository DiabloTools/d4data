   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What happens if Mephisto makes it to the Pools?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BD31C",
   "szText": "I do not know.",
   "hLabel": 1564184052
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.BD31C",
   "szText": "Shall he taint the Pools, and forever change your nature? Shall he destroy the Pools, and all people with it?",
   "hLabel": 4147119990
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.BD31C",
   "szText": "No. These are the ways of his brothers. Whatever my father intends...it is far worse.",
   "hLabel": 2435088632
  }
 ],
 "ptMapStringTable": "0"
}
