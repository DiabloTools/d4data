   "szLabel": "MenuLabel",
   "szText": "\"I saw Akarat's corpse myself. His pilgrims are being deceived.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.229BD8",
