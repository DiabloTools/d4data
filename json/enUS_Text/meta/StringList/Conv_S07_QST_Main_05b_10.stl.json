{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S07_QST_Main_05b_10.stl",
 "__snoID__": 2105962,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Any sign of Ouna?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1F9FF1",
   "szText": "There are signs of Ouna all over Estuar! The moment I sense her in one place, she darts away to another. But I feel I am close to--",
   "hLabel": 2458444532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1F9FF1",
   "szText": "Exhausted. Frustrated.",
   "hLabel": 3804171969
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.1FA017",
   "szText": "We ain’t close to nothing, she's seen to that! But if we can’t find where she is, how about where she’s been?",
   "hLabel": 4104948895
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.1FA017",
   "szText": "Exhausted and grim...then, an idea.",
   "hLabel": 1155709036
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1FA017",
   "szText": "Years ago, she’d run to a hiding place when she was ill...when she’d had enough of my fussing. It’s a small cave near the border of Teganze.",
   "hLabel": 562623882
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1FA017",
   "szText": "Thinking aloud. Bittersweet memory, but it could be a lead",
   "hLabel": 2021956343
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1F9FF1",
   "szText": "I have sensed her in that area more than once. She may have left something behind. Meet me there, wanderer, quick as you can.",
   "hLabel": 4193754281
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1F9FF1",
   "szText": "Seizing on the idea. Urgent. Terse.",
   "hLabel": 1358119446
  }
 ],
 "ptMapStringTable": "0"
}
