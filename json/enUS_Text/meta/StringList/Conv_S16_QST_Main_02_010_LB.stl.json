 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "Úllo Sar Missive - Prophecy",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Unknown",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.2808AB",
   "szText": "From the birth of our race, we have run blind through the darkness. Hunted by the monsters who created us. Desperate to believe we might one day bask in the light.",
   "hLabel": 2442653916
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.2808AB",
   "szText": "Calm, somber",
   "hLabel": 3788381353
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2808AB",
   "szText": "Yet the promises of every prophet have proven false. All save for one. Death—whose prophecy has and must come true for every mortal being.",
   "hLabel": 1780193950
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.2808AB",
   "szText": "Calm, somber, honest",
   "hLabel": 3125921387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2808AB",
   "szText": "It is time to stop running. Time to turn and spread our arms and embrace Death. To be carried, at last, to His Fortress Eternal.",
   "hLabel": 1117733984
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2808AB",
   "szText": "Calm, comforting. This is good news.",
   "hLabel": 2463461421
  }
 ],
 "ptMapStringTable": "0"
}
