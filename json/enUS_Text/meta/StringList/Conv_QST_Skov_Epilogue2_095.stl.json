{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Epilogue2_095.stl",
 "__snoID__": 2426018,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Lorath...\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "Ours...c-cannot be...",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.6D03F",
   "szText": "PLAYER LEAD IN: \"Lorath...\"    -- Lorath speaks, but his soul is broken. He is not fully present. Mumbling, drawing the words out. Voice breaks a bit--a hint of suffering.",
   "hLabel": 1662855929
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCFFD",
   "szText": "His soul is lost...in such pain. I will prepare the torch.",
   "hLabel": 1132662163
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DCFFD",
   "szText": "Heartbroken, seeing the state of his old dear friend.",
   "hLabel": 2478389600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.2525C5",
   "szText": "Sacrilege! You can't!",
   "hLabel": 451784883
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.2525C5",
   "szText": "The heads on the Tree rage in defiance. They don't want us to burn the Tree down.",
   "hLabel": 1797512320
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.8DD12",
   "szText": "We only took what he promised! What was owed!",
   "hLabel": 3256237842
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.8DD12",
   "szText": "The heads on the Tree rage in defiance. They don't want us to burn the Tree down.",
   "hLabel": 824157503
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCFFD",
   "szText": "And what is Lorath owed? You have his memories, you know what he gave to protect this world, time and time again!",
   "hLabel": 1222844480
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCFFD",
   "szText": "Tyrael speaks to the Tree. Snapping, firm. He has heard enough from the heads.",
   "hLabel": 2682176941
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCFFD",
   "szText": "We are indebted to him, beyond hope of repayment. Mercy is all we can offer now. And each of you will share in it.",
   "hLabel": 560384514
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1DCFFD",
   "szText": "Tyrael gets a hold of his anger. He is calmer now, more focused in his delivery.",
   "hLabel": 2019716975
  }
 ],
 "ptMapStringTable": "0"
}
