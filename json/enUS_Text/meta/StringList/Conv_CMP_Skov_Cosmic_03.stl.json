{
 "__fileName__": "enUS_Text/meta/StringList/Conv_CMP_Skov_Cosmic_03.stl",
 "__snoID__": 2374379,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.BAE4",
   "szText": "What is this place?",
   "hLabel": 3561462051
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.BAE4",
   "szText": "Wary, taking in surroundings. Unsure what they're getting involved with.",
   "hLabel": 494300592
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.243A4F",
   "szText": "A house for our most ancient treasures—those of the Angels and the Demons.",
   "hLabel": 119451330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.243A4F",
   "szText": "Walking and talking. Reserved, shy, academic.",
   "hLabel": 1465178767
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line10.243A4F",
   "szText": "We balance their energies with two powerful relics. We call them “the Anchors,” but one of them has become...unstable of late.",
   "hLabel": 1534553579
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir10.243A4F",
   "szText": "Walking and talking. Academic, turning anxious at the end.",
   "hLabel": 2993886040
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line12.243A4F",
   "szText": "Curator Ludea has refused to leave its side. She won’t eat, won’t sleep. She just stares at it...crying.",
   "hLabel": 872093613
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir12.243A4F",
   "szText": "Worried, anxious.",
   "hLabel": 2331426074
  }
 ],
 "ptMapStringTable": "0"
}
