{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_01_024.stl",
 "__snoID__": 2410122,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You needed help. I need to find someone: Lorath Nahr.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.24C67B",
   "szText": "What, that old fool who cut our Queen's throat? I suggest you leave his fate to the Drowned...along with the rest of the island.",
   "hLabel": 3788706806
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.24C67B",
   "szText": "Scoffing, then firm.",
   "hLabel": 953071971
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.24C67B",
   "szText": "The entire Amazon legion is marching west to follow Akarat, by order of the Queen. If you're smart, you'll do the same.",
   "hLabel": 3126246840
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.24C67B",
   "szText": "Firm, clear. Brooks no argument.",
   "hLabel": 290612005
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.229670",
   "szText": "Captain, Athulua is our home. Can we really just abandon it?",
   "hLabel": 2459905628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.229670",
   "szText": "Finds courage to protest (all due respect). This doesn't feel right.",
   "hLabel": 3919238089
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.24C67B",
   "szText": "The Queen commands and we obey.",
   "hLabel": 2772971891
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.24C67B",
   "szText": "Snapping, direct, irritated by this 2nd interruption.",
   "hLabel": 4232304352
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.24AD3F",
   "szText": "Drowned! Drowned sighted!",
   "hLabel": 2110490017
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.24AD3F",
   "szText": "Shouted in alarm. Enemies incoming!",
   "hLabel": 3569822478
  }
 ],
 "ptMapStringTable": "0"
}
