{
 "__fileName__": "enUS_Text/meta/StringList/Conv_S14_QST_Main_06_020.stl",
 "__snoID__": 2623997,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"It was a reaper. They have returned.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.27ED42",
   "szText": "The reapers? Returned?",
   "hLabel": 2443419039
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.27ED42",
   "szText": "Stunned",
   "hLabel": 3789146476
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line17.27ED42",
   "szText": "(laughs)",
   "hLabel": 3516268822
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir17.27ED42",
   "szText": "Delirious. The news is so terrible she can't help but laugh.",
   "hLabel": 680633987
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line6.27ED42",
   "szText": "(sighs) No! But what can you do but laugh?",
   "hLabel": 787269124
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir6.27ED42",
   "szText": "Laughter settling",
   "hLabel": 2132996561
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line8.2808AB",
   "szText": "Nothing. Against the reapers, against Death itself? There is nothing you can do.",
   "hLabel": 124044035
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir8.2808AB",
   "szText": "Somber, confident",
   "hLabel": 1469771472
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.27ED42",
   "szText": "(scoffs) By the Light...",
   "hLabel": 546221458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.27ED42",
   "szText": "Taken off guard, at a loss",
   "hLabel": 2005553919
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.2808AB",
   "szText": "I am no one, brave child. And for all your might, neither are you.",
   "hLabel": 3162228750
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.2808AB",
   "szText": "Somber. Regarding the Player.",
   "hLabel": 326593915
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line24.2808AB",
   "szText": "Journey well.",
   "hLabel": 2168538801
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir24.2808AB",
   "szText": "Somber, sincere. Means \"Die well\"",
   "hLabel": 3627871262
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line26.27ED42",
   "szText": "Yeah, well, piss off you shriveled old todger! We ain't about to lay down and die!",
   "hLabel": 1506843958
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line28.27ED42",
   "szText": "We bloody ain't!",
   "hLabel": 844383992
  }
 ],
 "ptMapStringTable": "0"
}
