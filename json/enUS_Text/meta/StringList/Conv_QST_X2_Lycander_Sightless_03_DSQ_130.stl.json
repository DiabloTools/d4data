 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"The corruption is gone. Is the Sightless Eye pure again?\"  ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.22902A",
   "szText": "The anchor of Hatred is uprooted, but the Eye will not stir without what first consecrated it: angel’s blood.",
   "hLabel": 2435851559
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.219CC0",
   "szText": "Will you give it freely, Lycander?",
   "hLabel": 1109802813
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.219CC0",
   "szText": "Measured and probing. A little dangerous. Athrpa would fight the angel to get what she is after.",
   "hLabel": 2455530250
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.22902A",
   "szText": "You ask for more than blood. You ask for me to partake in your doom. But I swore I would not steer humanity’s fate. So be it.",
   "hLabel": 448471661
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.22902A",
   "szText": "Grave and resolute",
   "hLabel": 1794199098
  }
 ],
 "ptMapStringTable": "0"
}
