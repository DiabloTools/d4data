   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What happened to Jarius? Didn't he escape?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.20FFCC",
   "szText": "If he is not here, he didn’t make it out. The lies have taken hold of his reality.",
   "hLabel": 2435157307
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.20FFCC",
   "szText": "Belial pulling us into his realm was just a hint of what he means to do.",
   "hLabel": 1110237375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.20FFCC",
   "szText": "We must continue destroying his Apparitions until we find a way to stop him once and for all.",
   "hLabel": 4080284739
  }
 ],
 "ptMapStringTable": "0"
}
