   "szLabel": "Line41.1DCFFD",
   "szText": "As for you, Lorath...rest.",
   "hLabel": 2790814531
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.1DCFFD",
   "szText": "Turning to leave. Caring, paternal.",
   "hLabel": 4250146992
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.6D03F",
   "szText": "I don't see how.",
   "hLabel": 3454281600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.6D03F",
   "szText": "Seriously doubts he can rest.",
   "hLabel": 505041741
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.1DCFFD",
   "szText": "For you.",
   "hLabel": 1465894599
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.1DCFFD",
