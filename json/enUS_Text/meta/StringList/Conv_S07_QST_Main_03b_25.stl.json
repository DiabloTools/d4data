 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Fal'thane came to this place?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1FA02A",
   "szText": "Memories are all the heads have left. If Fal’thane remembered this as a place of comfort, he might not care what has become of it. Or even see it.",
   "hLabel": 2459821538
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1FA02A",
   "szText": "Somber. Worried.",
   "hLabel": 3805548975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1FA02A",
   "szText": "Like all of them, he is lost in the rot. We must find him.",
   "hLabel": 1797361572
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1FA02A",
   "szText": "Worried. Determined to do something.",
   "hLabel": 3143089009
  }
 ],
 "ptMapStringTable": "0"
}
