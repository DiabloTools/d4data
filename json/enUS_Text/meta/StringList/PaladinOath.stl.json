  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Oath1Description",
   "szText": "Attacking with your {c_important}Devotion Core{/c} and {c_important}Ultimate{/c} skills grants {c_important}Zealot{/c} stacks that make those skills hit an additional time per stack.  {c_important}Basic{/c} skills refresh these stacks.",
   "hLabel": 1169021761
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Oath2Description",
   "szText": "Casting a {c_important}Juggernaut{/c} Skill consumes a stack of {c_important}{u}Resolve{/u}{/c} to deal {c_number}20%{/c} more damage.\r\n\r\nGain a {c_important}{u}Resolve{/u}{/c} stack every {c_number}3{/c} seconds.",
   "hLabel": 1990277282
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Oath3Description",
   "szText": "Your {c_important}{u}Judgement{/u}{/c} marks now also explode for additional damage around the judged character and can be set off early with your {c_important}Divine Core{/c} skills.\r\n\r\nYour {c_important}Divine Basic{/c} skills now apply {c_important}{u}Judgement{/u}{/c}.",
   "hLabel": 2811532803
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Oath4Description",
   "szText": "Casting an {c_red}[PH]{/c}{c_important}Angelic{/c} skill will grant {c_important}{u}Arbiter{/u}{/c} for {c_number}6{/c} seconds.",
   "hLabel": 3632788324
