  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Who was that Askari?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.219008",
   "szText": "Alio was a shrewd warrior, once. Now, just a coward. She abandoned her fellow Amazons to save her own skin.",
   "hLabel": 2434665531
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.219008",
   "szText": "Fondness, moving into disappointment",
   "hLabel": 3780392968
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.219008",
   "szText": "Her weapon was taken as punishment. I should have known she'd try something like this.",
   "hLabel": 1772205565
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.219008",
   "szText": "disappointment shifts to herself for her inaction.",
   "hLabel": 3117933002
  }
 ],
