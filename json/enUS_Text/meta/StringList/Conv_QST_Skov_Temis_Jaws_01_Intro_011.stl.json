 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Why were you investigating the Kraken in the first place?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.241F1B",
   "szText": "See, a Kraken’s belly is a treasure trove. There’s parasites in there that make the best bait.",
   "hLabel": 2437994679
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.241F1B",
   "szText": "leaning in, conspiratorial",
   "hLabel": 3783722116
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.244C28",
   "szText": "And where did that get you? Down one arm and no eel.",
   "hLabel": 1775639248
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.244C28",
   "szText": "Growing tired of the Player taking this seriously.",
   "hLabel": 3121366685
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.241F1B",
   "szText": "When I get my hands on that eel, it will all be worth it.",
   "hLabel": 1113074747
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.241F1B",
   "szText": "defensive, resolute in her beliefs",
   "hLabel": 2458802184
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.244C28",
   "szText": "Hand.",
   "hLabel": 450719316
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.244C28",
   "szText": "smug. Reminding Myveli that she has only one hand now.",
   "hLabel": 1796446753
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.241F1B",
   "szText": "Very funny. Bastard.",
   "hLabel": 4083122111
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.241F1B",
   "szText": "Mock anger, but damn close to true",
   "hLabel": 1133882252
  }
 ],
