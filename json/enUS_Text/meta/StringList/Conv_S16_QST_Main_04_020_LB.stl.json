  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.2808AB",
   "szText": "Their souls are gathered in Pandemonium. Each one at peace—safe in Death's embrace as they will be forevermore.",
   "hLabel": 1780193950
  },
