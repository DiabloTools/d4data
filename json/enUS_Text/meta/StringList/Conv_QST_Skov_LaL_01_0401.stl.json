   "szLabel": "MenuLabel",
   "szText": "\"'Zelos?'\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.25B56B",
   "szText": "There’s an old story of a child falling overboard a merchant’s vessel, drowning in the churn of the sea. When they retrieved his body, they found a cache of gold alongside his remains.",
   "hLabel": 2440888317
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.25B56B",
   "szText": "It’s a tale from centuries ago, but whispers spoke of brigands who saw a drowned child as a mark of luck. Offerings made for fortune received.",
   "hLabel": 1778428351
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.25B56B",
   "szText": "They were known as the “Zelos.”",
   "hLabel": 1115968385
  }
 ],
 "ptMapStringTable": "0"
}
