{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_02_066.stl",
 "__snoID__": 2460805,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Neyrelle's message convinced you to come? What changed?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line23.1DCFFD",
   "szText": "Of all the wonders I’ve seen, I am confounded by that bird. No idea how it found me. It might have happened in a dream...but the message was real.",
   "hLabel": 2514696963
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir23.1DCFFD",
   "szText": "Smiling, puzzled. ",
   "hLabel": 3974029424
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line25.1DCFFD",
   "szText": "Here was a determined young woman reminding me, in the language of my Order, to fulfill my duty to this world. I felt like such a fool.",
   "hLabel": 1852236997
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir25.1DCFFD",
   "szText": "Reflecting, impressed, ashamed of himself",
   "hLabel": 3311569458
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line29.6D03F",
   "szText": "Aye. She had a way with that.",
   "hLabel": 3275614788
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir29.6D03F",
   "szText": "Recognizing Neyrelle in the story. Reflective. Choking up a bit.",
   "hLabel": 326374929
  }
 ],
 "ptMapStringTable": "0"
}
