 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Name",
   "szText": "The Priestess Horadrim",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase147Description",
   "szText": "I should travel to Orbei and search for corpses within its Forgotten Depths.",
   "hLabel": 1162908401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback152Header",
   "szText": "Find the relic within {WORLD:DGN_Step_ForgottenDepths}",
   "hLabel": 3049441646
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase148Description",
   "szText": "I heard a rumor that there may be another Relic in Mercy's Reach. I can only assume that anything valuable would be locked up safely in some reliquary or perhaps secreted away by the goatmen who have occupied the place.",
   "hLabel": 1984163922
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback154Header",
   "szText": "Find the relic within {WORLD:DGN_Frac_MercysReach}",
   "hLabel": 1337410288
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase149Description",
   "szText": "The note mentioned a library near Caldeum that may have a Relic. Perhaps the Sunken Library will have some secrets within its chests that I can find.",
   "hLabel": 2805419443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback156Header",
   "szText": "Find the relic within {WORLD:DGN_Kehj_SunkenLibrary}",
   "hLabel": 3920346226
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase169Description",
   "szText": "The trail to find more relics has gone cold. I should place these relics with the others in Cerrigar. ",
   "hLabel": 1173708981
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback190Header",
   "szText": "Place the relics: {DONE_OVER_NEEDED}",
   "hLabel": 3436553072
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase171Description",
   "szText": "The trail for more Relics seems to have gone cold. Maybe someone or something in Firebreak Manor will point me to another Horadric Relic.",
   "hLabel": 230260526
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback175Header",
   "szText": "Speak with the Villager about relics",
   "hLabel": 1966418291
  }
 ],
 "ptMapStringTable": "0"
}
