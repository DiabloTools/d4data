{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_05_010.stl",
 "__snoID__": 1949828,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"We need every Amazon we can find. We're going to attack the Foundering Caverns.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCC9B",
   "szText": "The Caverns? You want to face the Drowned horde in their own lair?",
   "hLabel": 3806544692
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir35.1DCC9B",
   "szText": "Surprised. Skeptical.",
   "hLabel": 970909857
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line37.BAE4",
   "szText": "The second piece of Lilith's blade is likely hidden inside. Just as the first was hidden on Lycander.",
   "hLabel": 142683228
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir37.BAE4",
   "szText": "Dropping the bomb. ",
   "hLabel": 2005570185
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line39.1DCC9B",
   "szText": "So that is why the Drowned are killing my island...",
   "hLabel": 2481624760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir39.1DCC9B",
   "szText": "Seething in realization",
   "hLabel": 3940957221
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line41.1DCFFD",
   "szText": "We can end it at the Caverns, but we need your Amazons. As many as we can muster.",
   "hLabel": 2790814531
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir41.1DCFFD",
   "szText": "Refocusing, confident",
   "hLabel": 4250146992
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line43.1DCC9B",
   "szText": "You passed a unit on your way in. Tyrael, take my seal and escort them back to the garrison.",
   "hLabel": 2128349811
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir43.1DCC9B",
   "szText": "Locking in, commanding",
   "hLabel": 3587682272
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line45.1DCFFD",
   "szText": "I'll see it done.",
   "hLabel": 1465894599
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir45.1DCFFD",
   "szText": "Nodding agreement",
   "hLabel": 2925227060
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line47.1DCC9B",
   "szText": "As for you, come with me. The rest of my sisters are fighting for the marina.",
   "hLabel": 803429879
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir47.1DCC9B",
   "szText": "Giving orders to move on",
   "hLabel": 2262762340
  }
 ],
 "ptMapStringTable": "0"
}
