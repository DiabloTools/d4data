 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Is the cleansing ritual ready?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1F9FF1",
   "szText": "The ritual is prepared. As for the rest of us...",
   "hLabel": 2458444532
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1F9FF1",
   "szText": "A little weary. Concerned that Caidin might not be ready.",
   "hLabel": 3804171969
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1FA017",
   "szText": "Aye, I'm ready! To summon a passel of wyrms to defend a horrible tree...",
   "hLabel": 1797361497
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.1FA017",
   "szText": "Quick to reassure, then grumbling. Nervous.",
   "hLabel": 3143088934
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1FA02A",
   "szText": "Join us in the ritual circle, wanderer. We will begin.",
   "hLabel": 1134901606
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1FA02A",
   "szText": "Inviting. Ready.",
   "hLabel": 2480629043
  }
 ],
 "ptMapStringTable": "0"
}
