 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Zerae's Spear will kill you!\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.218EB3",
   "szText": "I know what I took! (sighs) I know what this spear will do to me. I...I’m ready for it.",
   "hLabel": 2434688956
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.218EB3",
   "szText": "defensive, angry",
   "hLabel": 3780416393
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.218EB3",
   "szText": "When I saw the hag turn my sisters, I...I ran. I was branded a coward, with no way to set things right.",
   "hLabel": 1772228990
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.218EB3",
   "szText": "I want—no, I need to free my unit. With Zerae’s spear...I can. Help me. Please.",
   "hLabel": 1109769024
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.218EB3",
   "szText": "Pushing emotion down.",
   "hLabel": 2455496461
  }
 ],
 "ptMapStringTable": "0"
