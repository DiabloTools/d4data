 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "DisembodiedVoice",
   "szText": "Tal Rasha",
   "hLabel": 155764431
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.255902",
   "szText": "Zoltun has withdrawn again. Claiming he’s on the verge of a breakthrough with the Soulstones.",
   "hLabel": 2439275262
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.255902",
   "szText": "“Nothing can distract me,” he says.",
   "hLabel": 1776815296
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.255902",
   "szText": "Until now.",
   "hLabel": 1114355330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.255902",
   "szText": "Redbrush oil, black pepper, and clams. A recipe from his homeland.",
   "hLabel": 451895364
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.255902",
   "szText": "Once it began to boil in the common room, the scent of home finally drew Zoltun out of his chambers.",
   "hLabel": 4084402694
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.255902",
   "szText": "He scarfed down five bowls. (chuckles) Granted, he scurried right back to his books...but I’ll still take it as a victory.",
   "hLabel": 1204537647
  }
 ],
 "ptMapStringTable": "0"
}
