   "szLabel": "MenuLabel",
   "szText": "\"I killed a Kraken and found an arm. Is it yours?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.241F1B",
   "szText": "Well, I’ll be damned. A little chewed up, but definitely my own flesh and bone. Thank you.",
   "hLabel": 2437994679
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.241F1B",
