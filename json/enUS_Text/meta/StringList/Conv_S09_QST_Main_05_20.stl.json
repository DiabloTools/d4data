 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Davish. Where's Bryona?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.229BD8",
   "szText": "Off on her own. Again. Ugh.",
   "hLabel": 1201170003
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.229BD8",
   "szText": "frustrated, tipsy",
   "hLabel": 2660502464
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.229BD8",
   "szText": "It’s all or nothing with her. One bump in the road, and she flips the whole carriage. But this... It’s over the line, innit? This Wayfinder stuff. I mean, demon blood?",
   "hLabel": 538710037
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.229BD8",
   "szText": "She ran off for the Horadric Vault. Wherever the hell it is. Ha. Why tell me? I'm only her best friend. Tell her to come back. Please.",
   "hLabel": 4171217367
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.229BD8",
   "szText": "vulnerable, just miserable after the pause",
   "hLabel": 1335582532
  }
 ],
 "ptMapStringTable": "0"
}
