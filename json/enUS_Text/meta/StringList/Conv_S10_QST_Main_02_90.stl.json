   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What do we do now?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.23AE2D",
   "szText": "All is not lost. There's an ancient Viz-Jaq'taar technique that allows me to glean information from dead demons such as these. It can lead us to Bartuc.",
   "hLabel": 451152782
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.23AE2D",
   "szText": "I'll need to take the head of this Fell Council demon to my order for more instruction. It will require some time.",
   "hLabel": 4083660112
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.23AE2D",
   "szText": "Meet me back in Yelesna.",
   "hLabel": 1203795065
  }
 ],
