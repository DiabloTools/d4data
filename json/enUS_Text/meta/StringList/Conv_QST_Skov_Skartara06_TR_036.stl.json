  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line35.1DCFFD",
   "szText": "His finger traced the runes. His lips moved silently, as he read them. And then, when he was done, he smiled.",
