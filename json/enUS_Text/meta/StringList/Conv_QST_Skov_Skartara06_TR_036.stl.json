   "szLabel": "Line33.1DCFFD",
   "szText": "His eyes bored into me. He took my gauntlet in his hand.",
   "hLabel": 174042116
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir33.1DCFFD",
