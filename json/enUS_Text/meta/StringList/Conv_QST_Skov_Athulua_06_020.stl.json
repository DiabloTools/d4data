{
 "__fileName__": "enUS_Text/meta/StringList/Conv_QST_Skov_Athulua_06_020.stl",
 "__snoID__": 2260666,
 "__type__": "StringListDefinition",
 "__typeHash__": 3672216444,
 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"What have I missed?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.6D03F",
   "szText": "We have a mad sketch of a desperate plan, but it's the best chance we've got to breach the Caverns.",
   "hLabel": 1512000330
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.6D03F",
   "szText": "Anxious but committed",
   "hLabel": 3374887287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCFFD",
   "szText": "Every Drowned in Athulua was dispatched from there—all to deny us what is hidden inside. The second piece of Lilith's blade.",
   "hLabel": 1132662163
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.1DCFFD",
   "szText": "Calm, cool, collected",
   "hLabel": 2478389600
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "So we'll march south in force. Provoke the Drowned out of their hole and crush them in the open.",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "Firm, determined",
   "hLabel": 1815924880
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.24C67B",
   "szText": "With undersupplied archers, broken ballistae, and a handful of Amazons...",
   "hLabel": 1777279489
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.24C67B",
   "szText": "Skeptical, sober",
   "hLabel": 3123006926
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "And Askari fire. It burns like hell when exposed to water. I’ve brewed several pots.",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.6D03F",
   "szText": "Chiming in, a little proud",
   "hLabel": 821729151
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCFFD",
   "szText": "While you were meant to be resting?",
   "hLabel": 1222844480
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCFFD",
   "szText": "Raising an eyebrow. A little smile.",
   "hLabel": 2682176941
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.6D03F",
   "szText": "Alchemy is restful.",
   "hLabel": 153004253
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.6D03F",
   "szText": "Matter of fact.",
   "hLabel": 1498731690
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.1DCC9B",
   "szText": "Regardless... Assuming the day is ours, I’ll show you into the Caverns. Then you’ll have your second piece. Questions?",
   "hLabel": 4192887090
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir15.1DCC9B",
   "szText": "Mildly amused, then back to business.",
   "hLabel": 1357252255
  }
 ],
 "ptMapStringTable": "0"
}
