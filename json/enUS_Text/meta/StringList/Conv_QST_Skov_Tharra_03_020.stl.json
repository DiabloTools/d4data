 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"You grew up around here?\" ",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.1DCC9B",
   "szText": "Adreona and I both. Not much here but saltfins and the old capital ruins. I used to sneak off, pretend I was defending the city.",
   "hLabel": 1795117375
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.1DCC9B",
   "szText": "Got caught, of course. They made me clean the fishing nets for weeks. After that, I practically begged the Amazons to train me.",
   "hLabel": 1132657409
  }
 ],
 "ptMapStringTable": "0"
}
