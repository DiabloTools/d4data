 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How did I get here?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.6D03F",
   "szText": "I found you drifting in a coffin, clutching a severed finger. What happened?",
   "hLabel": 2382904910
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4.Bar",
   "szText": "I’m not sure…the temple began to sink and I thought I drowned…",
   "hLabel": 2167314783
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4.Dru",
   "szText": "I’m not sure…the temple began to sink and I thought I drowned…",
   "hLabel": 2167317525
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4.Pal",
   "szText": "I was in a temple of shadows. Then the water rose, filled my lungs...",
   "hLabel": 2167330023
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4.Nec",
   "szText": "I’m not sure…the temple began to sink and I thought I drowned…",
   "hLabel": 2167327968
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4.Rog",
   "szText": "I’m not sure…the temple began to sink and I thought I drowned…",
   "hLabel": 2167332658
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4.Sor",
   "szText": "I’m not sure…the temple began to sink and I thought I drowned…",
   "hLabel": 2167333758
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4.Spi",
   "szText": "I’m not sure…the temple began to sink and I thought I drowned…",
   "hLabel": 2167333782
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line19.BAE4.War",
   "szText": "I uh...I was in the temple. It started sinking and...I went under.",
   "hLabel": 2167337652
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir19.BAE4.War",
   "szText": "Hazy, exhausted, trying to remember.",
   "hLabel": 2242488161
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.6D03F",
   "szText": "Temple? So the coffin was a gateway.",
   "hLabel": 3253809490
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.6D03F",
   "szText": "Curious, lost in thought a little",
   "hLabel": 821729151
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line21.6D03F",
   "szText": "What of Elias’ immortality?",
   "hLabel": 1533805628
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir21.6D03F",
   "szText": "Getting back to business--back to what's important",
   "hLabel": 2879533065
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4.Dru",
   "szText": "He's stored his life essence in a piece of himself.",
   "hLabel": 1896112017
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4.Pal",
   "szText": "This lonely finger holds his life essence.",
   "hLabel": 1896124515
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4.Nec",
   "szText": "He's stored his life essence in a piece of himself.",
   "hLabel": 1896122460
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line15.BAE4.Rog",
   "szText": "He's stored his life essence in a piece of himself.",
   "hLabel": 1896127150
