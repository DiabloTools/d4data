   "szLabel": "MenuLabel",
   "szText": "Ouna enters bossroom",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.1FA02A",
   "szText": "Fal'thane! It's Ouna, I've come to help you—",
   "hLabel": 2459821538
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.1FA02A",
   "szText": "Gently calling to a friend. Loving concern.",
   "hLabel": 3805548975
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line5.2067F5",
   "szText": "N-nothing but ashes... ASHES!",
   "hLabel": 1108461269
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir5.2067F5",
   "szText": "Disoriented. In pain. Extreme distress.",
   "hLabel": 2454188706
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1FA02A",
   "szText": "The rot has driven him mad. We have to cut him free!",
   "hLabel": 472441640
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1FA02A",
   "szText": "Upset to see him suffer. Determined to help.",
   "hLabel": 1818169077
  }
 ],
