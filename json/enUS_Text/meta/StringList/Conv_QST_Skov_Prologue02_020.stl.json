 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"Are you hurt?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.24A5AA",
   "szText": "No. Just scared out of my wits. I knew we shoulda' brought the cat aboard for good luck. No one would listen to me.",
   "hLabel": 2439667877
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.24A5AA",
   "szText": "Terrified. Trying to survive as the ship comes under attack from a storm and monstrous creatures. NOT spoken in the middle of battle. It's a quiet moment between fighting.",
   "hLabel": 3785395314
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.6D03F",
   "szText": "You can bring the cat next time. Stay here while we clear the way.",
   "hLabel": 4094936268
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.6D03F",
   "szText": "Calming the sailors. All business.",
   "hLabel": 1662855929
  }
 ],
 "ptMapStringTable": "0"
}
