   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I thought the Amazon and Oracle orders were allies. Why does this place unsettle you?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.245E86",
   "szText": "Our castes have been strained for decades, even before Adreona. Since then, it’s only worsened.",
   "hLabel": 2438137525
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.245E86",
   "szText": "And if I’m honest? Those Seers unsettle me. Try to meet them eye to eye, and they look right through you.",
   "hLabel": 1775677559
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.245E86",
   "szText": "Uneasy but conversational",
   "hLabel": 3121404996
  }
 ],
