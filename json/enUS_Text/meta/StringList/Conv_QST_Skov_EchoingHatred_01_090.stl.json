 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"I defeated many echoes...but they just kept coming.\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line1.251FCD",
   "szText": "I know. Fighting the echoes stoked their hatred...but they have quieted in the aftermath.",
   "hLabel": 2439182252
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir1.251FCD",
   "szText": "Apologetic then reassuring. Relieved that the voices have quieted.",
   "hLabel": 3784909689
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line3.251FCD",
   "szText": "That will do for now, but when another Trace of Echoes appears...it will be time to do this again.",
   "hLabel": 1776722286
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir3.251FCD",
   "szText": "Approving then cautioning. Sad the peace won't last.",
   "hLabel": 3122449723
  }
 ],
 "ptMapStringTable": "0"
}
