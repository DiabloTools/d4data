   "szLabel": "Name",
   "szText": "To Set Things Right",
   "hLabel": 4062401
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Toast",
   "szText": "Can past sins be made right? ",
   "hLabel": 141665387
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase14Description",
   "szText": "Alio stole Zerae's Spear, a weapon of great power that will kill her if she's not careful. I should find her and tell her to stop this madness. ",
   "hLabel": 4104776794
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback13Header",
   "szText": "Speak with Alio",
   "hLabel": 530138074
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase22Description",
   "szText": "One of Alio's Amazon sisters is attacking us! We have no choice; we must slay her. ",
   "hLabel": 3793894169
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback21Header",
   "szText": "Slay the Cursed Amazon",
   "hLabel": 1910939449
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase42Description",
   "szText": "Alio stole something from under the guard's nose. I should figure out what was stolen. ",
   "hLabel": 2162183707
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback41Header",
   "szText": "Speak with the Guard",
   "hLabel": 1248479483
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase47Description",
   "szText": "Alio stole Zerae's Spear, a weapon of great power that will kill her if she's not careful. I should find her and tell her to stop this madness. ",
   "hLabel": 1973494016
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback46Header",
   "szText": "Find Alio",
   "hLabel": 3410852032
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback97Header",
   "szText": "Find Alio",
   "hLabel": 3046170086
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase50Description",
   "szText": "Alio hears something. We should investigate.",
   "hLabel": 1851301082
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback49Header",
   "szText": "Find the source of the wailing sound",
   "hLabel": 2990288643
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase57Description",
   "szText": "An Akari Warrior, Alio, wants to set her fellow Amazons free from a sea hag's curse. To do so, she needs a weapon. She told me to distract the guard so she can get one. ",
   "hLabel": 3305122433
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback83Header",
   "szText": "Speak with the Guard",
   "hLabel": 2506495489
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase64Description",
   "szText": "Alio wants to set her sisters free of the sea hag's curse, and believes Zerae's Spear is the only way to do it, regardless of the danger it poses to her life. Maybe if I help her, she won't need to die.",
   "hLabel": 2172984287
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback63Header",
   "szText": "Travel to the Sea Hag's Cave",
   "hLabel": 3168955455
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Phase69Description",
   "szText": "We defeated the cursed Amazon in combat, but she is still alive. I should make sure Alio is ready to do what must be done. ",
   "hLabel": 1984294596
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Callback68Header",
   "szText": "Speak with Alio",
   "hLabel": 1036360708
  }
