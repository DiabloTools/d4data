 "arStrings": [
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "MenuLabel",
   "szText": "\"How bad is it out there? How many have turned?\"",
   "hLabel": 4215274549
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line7.1DCC9B",
   "szText": "Everything went dark on our way here...but by their torches, I’d say half the Amazon legion. All shouting Akarat’s name.",
   "hLabel": 470197443
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir7.1DCC9B",
   "szText": "Catching breath, giving grim news",
   "hLabel": 1815924880
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line9.BAE4",
   "szText": "Half? Where is Tyrael?",
   "hLabel": 3874545195
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir9.BAE4",
   "szText": "Shock then concern",
   "hLabel": 807383736
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line11.1DCC9B",
   "szText": "His fight is in Atanos. Right now, ours is here. Sister against sister...",
   "hLabel": 1222839726
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir11.1DCC9B",
   "szText": "Grim, focused, then a touch of regret",
   "hLabel": 2682172187
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "Line13.1DCC9B",
   "szText": "Follow me!",
   "hLabel": 560379760
  },
  {
   "__type__": "StringTableEntry",
   "__typeHash__": 3844612145,
   "szLabel": "VoiceDir13.1DCC9B",
   "szText": "Focused. To the task.",
   "hLabel": 2019712221
  }
 ],
 "ptMapStringTable": "0"
}
